# EU legislation: defined terms (generated by build_legislation_vocabulary; do not edit)
# Source: the definitions articles of 02010L0040-20231220, 02017R1926-20240304, 32026R0253
# '# shared' marks a label that is also a label in docs/ontology/standards/.
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix eulex: <https://napcore.eu/ontology/eu-legislation#> .

eulex:MMTIS-multimodal_travel_information a skos:Concept ;
    skos:prefLabel "multimodal travel information"@en ;
    skos:definition "means information derived from any static, historic, observed or dynamic travel and traffic data, or any combination thereof, for end users, provided through any communication means, covering at least two modes of transport and allowing the possibility to compare transport modes;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-travel_information_service a skos:Concept ;
    skos:prefLabel "travel information service"@en ;
    skos:definition "means an ITS service, including digital maps, that provides data users, and end users, with travel and traffic information of at least one transport mode;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-dynamic_travel_and_traffic_data a skos:Concept ;
    skos:prefLabel "dynamic travel and traffic data"@en ;
    skos:definition "means data relating to different transport modes that change often, or data on unexpected events or circumstances, as listed in the Annex;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-static_travel_and_traffic_data a skos:Concept ;
    skos:prefLabel "static travel and traffic data"@en ;
    skos:definition "means data relating to different transport modes that do not change often, or data on planned changes, as listed in the Annex;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-historic_travel_and_traffic_data a skos:Concept ;
    skos:prefLabel "historic travel and traffic data"@en ;
    skos:definition "means data relating to traffic characteristics, used to calculate average delays, depending on the hour, day and season, which is based on previous measurements, including rate of congestion, average speeds, and average travel times;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-observed_data a skos:Concept ;
    skos:prefLabel "observed data"@en ;
    skos:definition "means operational data related to travel and traffic, such as the length of and reason for delays and cancellations, resulting from and collected during service operations;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-data_user a skos:Concept ;
    skos:prefLabel "data user"@en ;
    skos:definition "means any public or private entity, such as transport authorities, transport operators, travel information service providers, digital map producers, transport on demand service providers and infrastructure managers, or any other entity using data listed in the Annex to create multimodal travel information, or where provided by the terms and conditions determined by the data holder, using the data for other purposes;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-transport_authority a skos:Concept ;
    skos:prefLabel "transport authority"@en ;
    skos:definition "means any public authority responsible for the traffic management or the planning, control or management of a given transport network or transport service, or both, falling within its territorial competence;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-transport_operator a skos:Concept ;
    skos:prefLabel "transport operator"@en ;
    skos:definition "means any public or private entity that is responsible for the maintenance and management of the transport service;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-transport_on_demand_service_provider a skos:Concept ;
    skos:prefLabel "transport on demand service provider"@en ;
    skos:definition "means any public or private provider of transport on demand service to end users;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-data_holder a skos:Concept ;
    skos:prefLabel "data holder"@en ;
    skos:definition "means any legal person, public or private entity, such as transport authorities, transport operators, infrastructure managers or transport on demand service providers, who has the right to grant access to or to share the data under its control, listed in the Annex, in accordance with applicable Union or national law;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-transport_on_demand_service a skos:Concept ;
    skos:prefLabel "transport on demand service"@en ;
    skos:definition "means a service which requires interaction between the transport on demand service provider and the end user before delivery;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-end_user a skos:Concept ;
    skos:prefLabel "end user"@en ;
    skos:definition "means any natural or legal person who has access to travel information services;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-metadata a skos:Concept ;
    skos:prefLabel "metadata"@en ;
    skos:definition "means a structured description of the contents of the data facilitating the discovery and use of the data;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-routing_result a skos:Concept ;
    skos:prefLabel "routing result"@en ;
    skos:definition "means the travel itinerary in a digital machine-readable format resulting from an end users’ journey request with reference to the handover point or points used;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-handover_point a skos:Concept ;
    skos:prefLabel "handover point"@en ;
    skos:definition "means the station, stop or location at which two travel information services’ routing results are linked to produce a journey;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-access_point a skos:Concept ;
    skos:prefLabel "access point"@en ;
    skos:definition "means a digital interface where data listed in the Annex together with the corresponding metadata are made accessible for reuse to data users, or where the sources and metadata of those data are made accessible for reuse to data users;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-data_update a skos:Concept ;
    skos:prefLabel "data update"@en ;
    skos:definition "means any modification of the existing data, including its deletion or the insertion of new or additional elements;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-discovery_service a skos:Concept ;
    skos:prefLabel "discovery service"@en ;
    skos:definition "means a service allowing for the search of the requested data using the contents of the corresponding metadata and displaying such contents;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-accessibility_of_the_data a skos:Concept ;
    skos:prefLabel "accessibility of the data"@en ;
    skos:definition "means the possibility to request and obtain the data at any time in a digital machine-readable format;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-comprehensive_trans_European_transport_network a skos:Concept ;
    skos:prefLabel "comprehensive trans-European transport network"@en ;
    skos:altLabel "TEN-T"@en ;
    skos:definition "means the transport infrastructure and measures referred to in Article 6(2) of Regulation (EU) No 1315/2013;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-timeliness_of_data a skos:Concept ;
    skos:prefLabel "timeliness of data"@en ;
    skos:definition "means the availability of up to date data provided to data users and end users sufficiently in advance to be useful;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-travel_information_service_provider a skos:Concept ;
    skos:prefLabel "travel information service provider"@en ;
    skos:definition "means any public or private provider of at least one travel and traffic information, to data users and end users, excluding a mere converter of information;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-linking_of_service a skos:Concept ;
    skos:prefLabel "linking of service"@en ;
    skos:definition "means the connection of local, regional, and national travel information services which are interlinked via technical interfaces to provide routing results or other application programming interfaces (APIs) results based on static, historic, observed and/or dynamic travel and traffic data;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:MMTIS-access_node a skos:Concept ;
    skos:prefLabel "access node"@en ;
    skos:definition "means a pre-defined location where passengers may board or leave scheduled transport or transport on demand."@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_2> ;
    skos:inScheme eulex:MMTIS .

eulex:ITSD-Intelligent_Transport_Systems a skos:Concept ;
    skos:prefLabel "Intelligent Transport Systems"@en ;
    skos:altLabel "ITS"@en ;
    skos:definition "means systems in which information and communication technologies are applied in the field of road transport, including infrastructure, vehicles and users, and in traffic management and mobility management, as well as for interfaces with other modes of transport;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-interoperability a skos:Concept ;
    skos:prefLabel "interoperability"@en ;
    skos:definition "means the capacity of systems and the underlying business processes to exchange data and share information and knowledge, making the continuity of ITS services possible;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-ITS_application a skos:Concept ;
    skos:prefLabel "ITS application"@en ;
    skos:definition "means an operational instrument for the application of ITS;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-ITS_service a skos:Concept ;
    skos:prefLabel "ITS service"@en ;
    skos:definition "means the provision of an ITS application through a well-defined organisational and operational framework with the aim of contributing to user safety, efficiency, sustainable mobility or comfort, or of facilitating or supporting transport and travel operations;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-ITS_service_provider a skos:Concept ;
    skos:prefLabel "ITS service provider"@en ;
    skos:definition "means any provider of an ITS service, whether public or private;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-ITS_user a skos:Concept ;
    skos:prefLabel "ITS user"@en ;
    skos:definition "means any user of ITS applications or services including travellers, vulnerable road users, road transport infrastructure users and operators, fleet managers and operators of emergency services;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-vulnerable_road_users a skos:Concept ;
    skos:prefLabel "vulnerable road users"@en ;
    skos:definition "means non-motorised road users, such as pedestrians and cyclists as well as motor-cyclists and persons with disabilities or reduced mobility and orientation;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-nomadic_device a skos:Concept ;
    skos:prefLabel "nomadic device"@en ;
    skos:definition "means a portable communication or information device that can be brought inside the vehicle to support the driving task and/or the transport operations;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-platform a skos:Concept ;
    skos:prefLabel "platform"@en ;
    skos:definition "means an on-board or off-board unit enabling the deployment, provision, exploitation and integration of ITS applications and services;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-architecture a skos:Concept ;
    skos:prefLabel "architecture"@en ;
    skos:definition "means the conceptual design that defines the structure, behaviour and integration of a given system in its surrounding context;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-interface a skos:Concept ;
    skos:prefLabel "interface"@en ;
    skos:definition "means a facility between systems which provides the media through which they can connect and interact;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-compatibility a skos:Concept ;
    skos:prefLabel "compatibility"@en ;
    skos:definition "means the general ability of a device or system to work with another device or system without modification;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-continuity_of_services a skos:Concept ;
    skos:prefLabel "continuity of services"@en ;
    skos:definition "means the ability to ensure seamless services on transport networks across the Union;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-road_data a skos:Concept ;
    skos:prefLabel "road data"@en ;
    skos:definition "means data on road infrastructure characteristics, including fixed traffic signs and their regulatory safety attributes as well as infrastructure for recharging and for refuelling with alternative fuels;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-traffic_data a skos:Concept ;
    skos:prefLabel "traffic data"@en ;
    skos:definition "means historic and real-time data on road traffic characteristics;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-travel_data a skos:Concept ;
    skos:prefLabel "travel data"@en ;
    skos:definition "means basic data such as public transport timetables and tariffs, necessary to provide multi-modal travel information before and during the trip to facilitate travel planning, booking and adaptation;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-specification a skos:Concept ;
    skos:prefLabel "specification"@en ;
    skos:definition "means a binding measure laying down provisions containing requirements, procedures or any other relevant rules;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-standard a skos:Concept ;
    skos:prefLabel "standard"@en ;
    skos:definition "means standard as defined in Article 2(1) of Regulation (EU) No 1025/2012 of the European Parliament and of the Council ( 1 );"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-cooperative_intelligent_transport_systems a skos:Concept ;
    skos:prefLabel "cooperative intelligent transport systems"@en ;
    skos:altLabel "C-ITS"@en ;
    skos:definition "means intelligent transport systems that enable ITS users to interact and cooperate by exchanging secured and trusted messages, without any prior knowledge of each other and in a non-discriminatory manner;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-C_ITS_service a skos:Concept ;
    skos:prefLabel "C-ITS service"@en ;
    skos:definition "means an ITS service provided through C-ITS;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-availability_of_data a skos:Concept ;
    skos:prefLabel "availability of data"@en ;
    skos:definition "means that data exists in a digital machine-readable format;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-national_access_point a skos:Concept ;
    skos:prefLabel "national access point"@en ;
    skos:altLabel "NAP"@en ;
    skos:definition "means a digital interface set up by a Member State that constitutes a single point of access to data, as defined in specifications referred to in Article 6;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-accessibility_of_data a skos:Concept ;
    skos:prefLabel "accessibility of data"@en ;
    skos:definition "means that it is possible to request and to obtain data in a digital machine-readable format;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-multimodal_digital_mobility_service a skos:Concept ;
    skos:prefLabel "multimodal digital mobility service"@en ;
    skos:definition "means a service providing information on traffic and travel data, such as the location of transport facilities, schedules, availability or fares for more than one transport mode, which may include features enabling the making of reservations, bookings or payments, or the issuing of tickets;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-underlying_information a skos:Concept ;
    skos:prefLabel "underlying information"@en ;
    skos:definition "means information within the scope of this Directive that has been determined to be relevant for informing road and ITS users, in particular by road authorities where they are responsible for such information;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:ITSD-primary_road a skos:Concept ;
    skos:prefLabel "primary road"@en ;
    skos:definition "means a road outside urban areas, designated by a Member State, that connects major cities or regions, or both, and that is not classified as part of the comprehensive trans-European road network or as a motorway."@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02010L0040-20231220#art_4> ;
    skos:inScheme eulex:ITSD .

eulex:TELTSI-data a skos:Concept ;
    skos:prefLabel "data"@en ;
    skos:definition "means a machine-readable representation of acts, facts or information and any compilation of such acts, facts or information intended to be shared in a harmonised and structured format;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-data_sharing a skos:Concept ;
    skos:prefLabel "data sharing"@en ;
    skos:definition "means the provision of data by a data holder to a data recipient for the purpose of the joint or individual use of such data, directly or through an intermediary, for example under open or commercial licences subject to a fee or free of charge;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-rail_ticketing a skos:Concept ;
    skos:prefLabel "rail ticketing"@en ;
    skos:definition "means the process comprising at least one of the following for passenger rail transport services: (a) | the digital presentation of passenger rail transport services for journey planning;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-rail_product a skos:Concept ;
    skos:prefLabel "rail product"@en ;
    skos:definition "means a tailored service in relation to a passenger rail transport service linked to a tariff;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-ticket a skos:Concept ;
    skos:prefLabel "ticket"@en ;
    skos:definition "means a ticket as defined in Article 3, point (7), of Regulation (EU) 2021/782;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-reservation a skos:Concept ;
    skos:prefLabel "reservation"@en ;
    skos:definition "means a reservation as defined in Article 3, point (8), of Regulation (EU) 2021/782;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-rail_transport_service a skos:Concept ;
    skos:prefLabel "rail transport service"@en ;
    skos:definition "means a scheduled service for carriage by rail between a point of departure and a point of arrival and covers transport services for goods, passengers, luggage, bicycles or cars, and tailored transport arrangements, as well as passenger assistance including services for re-routing and journey continuation;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-operator_of_rail_freight_service_facility a skos:Concept ;
    skos:prefLabel "operator of rail freight service facility"@en ;
    skos:definition "means operators of service facilities as defined in Article 3, point (12), of Directive 2012/34/EU, that provide services necessary for operating a freight rail transport service and whose service facilities are listed in point (2), subpoints (b), (c), (d) and (g), of Annex II to Directive 2012/34/EU and are connected to the trans-European transport network as specified in Annex II to Regulation (EU) 2024/1679, limited to the multimodal freight terminals identified pursuant to Article 36 of that Regulation;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-telematics_stakeholder a skos:Concept ;
    skos:prefLabel "telematics stakeholder"@en ;
    skos:definition "means the following data holders or data recipients whose activities entail the use of telematics applications for passenger and freight services’: (a) | railway undertakings;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-Union_bodies a skos:Concept ;
    skos:prefLabel "Union bodies"@en ;
    skos:definition "means Union bodies as defined in Article 2, point (27), of Regulation (EU) 2023/2854;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-public_sector_body a skos:Concept ;
    skos:prefLabel "public sector body"@en ;
    skos:definition "means public sector body as defined in Article 2, point (28), of Regulation (EU) 2023/2854;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-data_holder a skos:Concept ;
    skos:prefLabel "data holder"@en ;
    skos:definition "means a natural or legal person that has the right to use or an obligation to produce and make available data;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-data_recipient a skos:Concept ;
    skos:prefLabel "data recipient"@en ;
    skos:definition "means a natural or legal person that has the right to access the data produced and made available by the data holder under specified access conditions for use;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-access_to_data a skos:Concept ;
    skos:prefLabel "access to data"@en ;
    skos:definition "means the right to consult the data with or without control over it, distinctively from other rights and obligations relating to its use for non-commercial or commercial purposes;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-national_access_point a skos:Concept ;
    skos:prefLabel "national access point"@en ;
    skos:definition "means a national access point within the meaning of Article 3 of Commission Delegated Regulation (EU) 2017/1926;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-ERA_Ontology a skos:Concept ;
    skos:prefLabel "ERA Ontology"@en ;
    skos:definition "means a technical document issued by the Agency pursuant to Article 4(8) of Directive (EU) 2016/797, setting out human-readable and machine-readable data definitions and presentations and the associated quality and accuracy requirements for data elements of the Union rail system;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-data_element a skos:Concept ;
    skos:prefLabel "data element"@en ;
    skos:definition "means a field, value, or attribute of the data shared, which is structured in a consistent manner with the overall protocol used for data sharing and carries essential information that contributes to the meaning and purpose of the data shared, enabling data sharing between systems, applications or organisations;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-reference_data a skos:Concept ;
    skos:prefLabel "reference data"@en ;
    skos:definition "means a data set of standardised and interoperable single identifiers to be used as a basis for data sharing in a specific domain;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-metadata a skos:Concept ;
    skos:prefLabel "metadata"@en ;
    skos:definition "means metadata as defined in Article 2, point (2), of Regulation (EU) 2023/2854;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-multi_network_process a skos:Concept ;
    skos:prefLabel "multi-network process"@en ;
    skos:definition "means a process that is affected by the operation of a rail transport service across two or more networks managed by different infrastructure managers or operators of rail freight service facilities;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-direct_rail_transport_service a skos:Concept ;
    skos:prefLabel "direct rail transport service"@en ;
    skos:definition "means a rail transport service that may include intermediate commercial stops between its origin and destination but does not involve any transfer of passengers or freight between trains;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-application_programming_interface a skos:Concept ;
    skos:prefLabel "application programming interface"@en ;
    skos:altLabel "API"@en ;
    skos:definition "means a set of functions, procedures, definitions and protocols for interoperable data sharing between telematics applications;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-station_manager a skos:Concept ;
    skos:prefLabel "station manager"@en ;
    skos:definition "means a station manager as defined in Article 3, point (3), of Regulation (EU) 2021/782;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-minimum_connection_time a skos:Concept ;
    skos:prefLabel "minimum connection time"@en ;
    skos:definition "means the minimum amount of time that is sufficient for a passenger to connect between the access nodes of two consecutive passenger transport services included in a journey;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-journey a skos:Concept ;
    skos:prefLabel "journey"@en ; # shared
    skos:definition "means an end-to-end trip of a passenger or a load that can include multiple legs;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-public_departure_time a skos:Concept ;
    skos:prefLabel "public departure time"@en ;
    skos:definition "means the boarding time limit for passengers, that is the point in time when access to the train, platform or station is closed in preparation for departure and after which passengers are no longer allowed to board and that takes into account the time that may be required for the check-in of passengers, bicycles, or luggage;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-public_arrival_time a skos:Concept ;
    skos:prefLabel "public arrival time"@en ;
    skos:definition "means the alighting time for passengers, that is the point in time when the doors of the train are opened at the destination platform or terminal and disembarkation is allowed for passengers;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-working_timetable a skos:Concept ;
    skos:prefLabel "working timetable"@en ;
    skos:definition "means working timetable as defined in Article 3, point (28), of Directive 2012/34/EU that is used for capacity and traffic management as referred to in Section 2 of the Annex to this Regulation;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-meta_station a skos:Concept ;
    skos:prefLabel "meta station"@en ;
    skos:definition "means a group of stations within a functional urban area, including one or more urban nodes listed in Annex II to Regulation (EU) 2024/1679, that may extend across multiple Member States and where distinct stations can be reached by connecting urban transport modes and urban transport services, whether scheduled or unscheduled;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-access_node a skos:Concept ;
    skos:prefLabel "access node"@en ;
    skos:definition "means access node as defined in Article 2, point (25), of Delegated Regulation (EU) 2017/1926;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-applicant a skos:Concept ;
    skos:prefLabel "applicant"@en ;
    skos:definition "means applicant as defined in Article 3, point (19), of Directive 2012/34/EU;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-passenger_timetable a skos:Concept ;
    skos:prefLabel "passenger timetable"@en ;
    skos:definition "means the date and time of passenger rail transport services operated as a commercial service by a railway undertaking during a given time interval that are used in the context of rail ticketing and rail passenger travel information referred to in Section 4 of the Annex;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-shunting_movement a skos:Concept ;
    skos:prefLabel "shunting movement"@en ;
    skos:definition "means shunting movements as defined in Table 1 of the Annex to Implementing Regulation (EU) 2019/773 (‘OPE TSI’);"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-freight_customer a skos:Concept ;
    skos:prefLabel "freight customer"@en ;
    skos:definition "means the entity that has issued the consignment information to the relevant freight railway undertaking and which may be a logistics service provider, an intermodal transport operator, a freight forwarder, a fleet manager of empty wagons, or where relevant the data holder, that has concluded a contract of carriage covering transport services for goods;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-intermodal_transport_operator a skos:Concept ;
    skos:prefLabel "intermodal transport operator"@en ;
    skos:definition "means an entity that organises freight transport services connecting two or more freight terminals with more than one transport mode;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-consignment_note a skos:Concept ;
    skos:prefLabel "consignment note"@en ;
    skos:definition "means a transport document referred to in Article 6 of Council Regulation No 11 (34);"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-distributor a skos:Concept ;
    skos:prefLabel "distributor"@en ; # shared
    skos:definition "means an entity that, deriving from contractual provisions, has: (a) | the technical capacity to combine one or more rail products from one or more railway undertakings, for the purpose of supplying them to an issuer or a retailer;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-journey_planner a skos:Concept ;
    skos:prefLabel "journey planner"@en ;
    skos:definition "means a search engine used to find an optimal journey based on defined criteria set out by its user;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-issuer a skos:Concept ;
    skos:prefLabel "issuer"@en ; # shared
    skos:definition "means an entity that has the legal and technical capacity, deriving from contractual provisions, to issue, for a retailer, a ticket on which the parties to the contract of carriage are indicated;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-attributing_system a skos:Concept ;
    skos:prefLabel "attributing system"@en ;
    skos:definition "means the railway undertaking’s digital system that hosts the online catalogue of individual rail transport services and that enables distributors to check the availability of those services and make reservations;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-retailer a skos:Concept ;
    skos:prefLabel "retailer"@en ; # shared
    skos:definition "means an entity that: (a) | has the legal and technical capacity, deriving from contractual provisions, to combine, or combine and sell, one or more rail products made available to it by one or more distributors;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-tariff a skos:Concept ;
    skos:prefLabel "tariff"@en ; # shared
    skos:definition "means the aggregated data established by a railway undertaking, or, where relevant, by the data holder, that provides all relevant details of a tariff, including the rail transport service price due by a distributor to the railway undertaking and the associated attributes and conditions;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-offer a skos:Concept ;
    skos:prefLabel "offer"@en ;
    skos:definition "means the aggregated data established by a distributor combining applicable tariffs that include the rail product price due by the retailer to the distributor and which may vary from the price set out by the railway undertaking due to the application of automated pricing rules, discounts or other commercial conditions;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-yielded_price a skos:Concept ;
    skos:prefLabel "yielded price"@en ;
    skos:definition "means the price associated to a tariff resulting from the application of an algorithm based on variables, referred to as the yielding rule;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-ticket_control_organisation a skos:Concept ;
    skos:prefLabel "ticket control organisation"@en ;
    skos:altLabel "TCO"@en ;
    skos:definition "means an organisation empowered to inspect passenger tickets, including at platform access doors;"@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

eulex:TELTSI-data_quality a skos:Concept ;
    skos:prefLabel "data quality"@en ;
    skos:definition "means the degree of fitness for use at which the characteristics of data satisfy the stated and implied level of accuracy, completeness, consistency, timeliness and uniqueness of datasets, and create actionable insights for other users under specified conditions."@en ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#art_3> ;
    skos:inScheme eulex:TELTSI .

# Provisions that name a standard (eulex:namesStandard), generated from the same acts.
eulex:MMTIS-art_4 a eulex:Provision ; rdfs:label "MMTIS Art. 4"@en ; dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_4> ; eulex:namesStandard "NeTEx" , "Transmodel" .
eulex:MMTIS-art_5 a eulex:Provision ; rdfs:label "MMTIS Art. 5"@en ; dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:02017R1926-20240304#art_5> ; eulex:namesStandard "SIRI" .
eulex:TELTSI-app_C a eulex:Provision ; rdfs:label "TEL TSI App. C"@en ; dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32026R0253#app_C> ; eulex:namesStandard "NeTEx" , "Transmodel" .
