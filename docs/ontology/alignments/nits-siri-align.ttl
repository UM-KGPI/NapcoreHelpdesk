#################################################################
# Ontology Header
#################################################################

<https://napcore.eu/ontology/nits/align/siri>
    a owl:Ontology ;
    dct:title "NITS–SIRI Alignment Ontology"@en ;
    dct:description "Alignment ontology connecting XSD-derived SIRI concepts to abstract core concepts defined in the NAPCORE ITS Core Ontology. Enables cross-standard reasoning and real-time information discovery."@en ;
    dct:creator "NAPCORE Working Group" ;
    dct:created "2026-04-17"^^xsd:date ;
    owl:versionIRI <https://napcore.eu/ontology/nits/align/siri/0.3> ;
    owl:versionInfo "0.3-full-heuristic-pipeline" ;
    owl:imports <https://napcore.eu/ontology/nits/core> ;
    owl:imports <http://www.siri.org.uk/siri/2.1> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

#################################################################
# Heuristic Alignment (2026-09-21, fully pipeline-generated)
#
# All entries below are generated by applying the heuristic
# name-pattern rules from `manage.py ontology_alignment_gap`
# (backend/helpdesk/management/commands/ontology_alignment_gap.py,
# _HEURISTIC_RULES) to every current siri.ttl class, with no
# hand-curated exceptions -- kept fully reproducible/regenerable
# from source rather than mixing in manually-maintained entries.
# Superseded 0.2 note: the previous version kept 14 hand-authored
# entries (some using owl:equivalentClass/rdfs:subClassOf with more
# specific categories, e.g. PtSituationElement -> Situation+Event,
# DatedCall/EstimatedCall/RecordedCall -> JourneyComponent) that a
# regeneration pass can't reproduce. Folded into this pass for pipeline
# consistency; some semantic precision was lost as a result -- see
# git history (0.2-heuristic-bulk-pass) to recover the hand-picks.
# Uses skos:closeMatch throughout -- these are name-pattern guesses,
# not verified semantic claims.
#################################################################

