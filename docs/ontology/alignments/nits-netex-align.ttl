@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

@prefix nits:  <https://napcore.eu/ontology/nits#> .
@prefix netex: <https://netex.org.uk/netex/2.0#> .

#################################################################
# Ontology Header
#################################################################

<https://napcore.eu/ontology/nits/align/netex>
    a owl:Ontology ;
    dct:title "NITS–NeTEx Alignment Ontology"@en ;
    dct:description "Alignment ontology connecting NeTEx concepts to abstract core concepts defined in the NAPCORE ITS Core Ontology. Enables cross-standard reasoning and question routing."@en ;
    dct:creator "NAPCORE Working Group" ;
    dct:created "2026-04-17"^^xsd:date ;
    owl:versionIRI <https://napcore.eu/ontology/nits/align/netex/0.3> ;
    owl:versionInfo "0.3-realignment-pass" ;
    owl:imports <https://napcore.eu/ontology/nits/core> ;
    owl:imports <https://netex.org.uk/netex/2.0> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

#################################################################
# Core Transport Concept Alignments
#################################################################

netex:Journey
    owl:equivalentClass nits:Journey .

netex:ServiceJourney
    skos:closeMatch nits:Journey .

netex:ServiceJourneyPattern
    skos:closeMatch nits:JourneyPattern .

netex:JourneyPattern
    owl:equivalentClass nits:JourneyPattern .

netex:StopPlace
    skos:closeMatch nits:Stop .

netex:ScheduledStopPoint
    owl:equivalentClass nits:Stop .

netex:Quay
    skos:closeMatch nits:Stop .

netex:Route
    skos:closeMatch nits:Journey .

netex:Line
    owl:equivalentClass nits:Line .

netex:Network
    owl:equivalentClass nits:Network .

#################################################################
# Spatial Concept Alignments
#################################################################

#################################################################
# Actor & Governance Alignments
#################################################################

netex:Organisation
    owl:equivalentClass nits:Organisation .

netex:Authority
    owl:equivalentClass nits:Authority .

netex:Operator
    skos:closeMatch nits:Actor ;
    skos:closeMatch nits:Organisation .

#################################################################
# Temporal Concept Alignments
#################################################################

netex:DayType
    skos:closeMatch nits:TemporalEntity .

netex:OperatingPeriod
    skos:closeMatch nits:TemporalEntity .

netex:ServiceCalendar
    skos:closeMatch nits:DataArtifact .

#################################################################
# Accessibility & Facility Alignments
#################################################################

netex:AccessibilityAssessment
    skos:closeMatch nits:DataArtifact .

netex:AccessEquipment
    skos:closeMatch nits:DataArtifact .

netex:PassengerEquipment
    skos:closeMatch nits:DataArtifact .

#################################################################
# Fare & Product Alignments
#################################################################

# Core fare framework
netex:FareProduct
    skos:closeMatch nits:DataArtifact .

netex:PreassignedFareProduct
    skos:closeMatch nits:DataArtifact .

netex:Tariff
    skos:closeMatch nits:DataArtifact .

netex:FareFrame
    skos:closeMatch nits:DataArtifact .

# Fare structure
netex:FareStructureElement
    skos:closeMatch nits:DataArtifact .

netex:ValidableElement
    skos:closeMatch nits:DataArtifact .

netex:FareTable
    skos:closeMatch nits:DataArtifact .

# Distribution & packaging
netex:SalesOfferPackage
    skos:closeMatch nits:DataArtifact .

netex:SalesOfferPackageElement
    skos:closeMatch nits:DataArtifact .

# Geographic pricing
netex:DistanceMatrixElement
    skos:closeMatch nits:DataArtifact .

netex:GeographicalInterval
    skos:closeMatch nits:DataArtifact .

netex:FareSection
    skos:closeMatch nits:DataArtifact .

# Zones
netex:FareZone
    skos:closeMatch nits:SpatialEntity .

netex:TariffZone
    skos:closeMatch nits:SpatialEntity .

netex:GroupOfTariffZones
    skos:closeMatch nits:SpatialEntity .

# Pricing rules & parameters
netex:PricingRule
    skos:closeMatch nits:DataArtifact .

netex:GenericParameterAssignment
    skos:closeMatch nits:DataArtifact .

netex:TimeInterval
    skos:closeMatch nits:DataArtifact .

# Passenger eligibility
netex:UserProfile
    skos:closeMatch nits:DataArtifact .

#################################################################
# XSD-Grounded Extended Alignments
#################################################################

netex:StopArea
    skos:closeMatch nits:SpatialEntity .

netex:DeadRun
    skos:closeMatch nits:Journey .

netex:Vehicle
    skos:closeMatch nits:System .

#################################################################
# Heuristic Bulk Alignment Pass (2026-09-20)
#
# Everything below was generated by applying the same heuristic
# name-pattern rules used by `manage.py ontology_alignment_gap`
# (backend/helpdesk/management/commands/ontology_alignment_gap.py,
# _HEURISTIC_RULES) to the 881 netex.ttl classes that had no prior
# alignment entry. Uses skos:closeMatch (not rdfs:subClassOf or
# owl:equivalentClass) throughout, matching this file's own existing
# convention for heuristic/uncertain matches above -- these are name-
# pattern guesses, not verified semantic claims, and should be
# tightened to owl:equivalentClass or corrected on human review.
#################################################################

