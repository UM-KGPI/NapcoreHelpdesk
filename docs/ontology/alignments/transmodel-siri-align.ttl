@prefix siri: <https://siri.org.uk/siri/1.3#> .

<https://napcore.eu/ontology/align/transmodel-siri>
    a owl:Ontology ;
    dct:title "Transmodel-SIRI Direct Alignment"@en ;
    dct:description "Class-level alignment from Transmodel (the conceptual reference) to SIRI, generated by name and reviewed through curation. SKOS mapping properties only, so nothing enters OWL inference."@en ;
    dct:created "2026-10-19"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

tmalign:transmodelDefinitionStatus
    a owl:AnnotationProperty ;
    rdfs:label "Transmodel definition status"@en ;
    skos:definition "How a standard concept's definition compares to the definition of the Transmodel concept it is aligned to: equivalent (same meaning, wording may differ); extends (Transmodel definition plus standard-specific notes); differs (different wording or scope; Transmodel is the reference); missing (one of the two definitions is empty)."@en .

tmalign:alignmentMethod
    a owl:AnnotationProperty ;
    rdfs:label "alignment method"@en ;
    skos:definition "How the link to Transmodel was made: name-match (generated, pending review) or curated (set by a reviewer)."@en .

siri:CompoundTrain
    skos:exactMatch tm:COMPOUND_TRAIN ;
    tmalign:transmodelDefinitionStatus "differs" ;
    tmalign:alignmentMethod "name-match" .

