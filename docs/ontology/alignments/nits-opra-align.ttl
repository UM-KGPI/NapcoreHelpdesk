#################################################################
# Abstract base classes (left unaligned; alignment is inherited from
# whichever concrete subclass anchors it, per docs/ontology/README.md's
# modeling conventions)
#################################################################

# opra:AbstractCtxIndicator, opra:AbstractLogEntry, opra:AbstractLoggableObject,
# opra:TypeOfDelay: skipped (enumeration/abstract base class, not a
# standalone retrieval target).
