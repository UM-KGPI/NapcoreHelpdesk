@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

@prefix nits: <https://napcore.eu/ontology/nits#> .
@prefix opra: <https://transmodel-cen.eu/opra/1.0#> .

#################################################################
# Ontology Header
#################################################################

<https://napcore.eu/ontology/nits/align/opra>
    a owl:Ontology ;
    dct:title "NITS–OpRa Alignment Ontology"@en ;
    dct:description "Alignment ontology connecting XSD-derived OpRa concepts to abstract core concepts defined in the NAPCORE ITS Core Ontology. Enables cross-standard reasoning over OpRa operational raw data (capacity, service intensity, delay, and indicator concepts)."@en ;
    dct:creator "NAPCORE Working Group" ;
    dct:created "2026-04-17"^^xsd:date ;
    owl:versionIRI <https://napcore.eu/ontology/nits/align/opra/0.3> ;
    owl:versionInfo "0.3-closematch-consistency" ;
    owl:imports <https://napcore.eu/ontology/nits/core> ;
    owl:imports <https://transmodel-cen.eu/opra/1.0> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

# Superseded 0.1-draft note: the previous version of this file aligned a
# hand-modeled "journey planning" vocabulary (opra:JourneyPlan, opra:Trip,
# opra:Leg, opra:Vehicle, opra:BookingArrangement, ...) that has zero overlap
# with the concepts actually present in standards/opra.ttl once that ontology
# was rebuilt from the OpRa XSD schemas. OpRa ("Operational Raw Data") is a
# KPI/indicator reporting standard, not a journey-planning standard, so that
# vocabulary never matched the real schema. This version aligns the 106
# concepts that are actually extracted from the current OpRa XSD tree.
#
# 0.3 note: every entry below is a blind name-pattern heuristic guess (same
# categorizer as nits-netex-align.ttl's bulk pass), not a verified semantic
# claim, so they use skos:closeMatch rather than rdfs:subClassOf -- 0.2
# originally used rdfs:subClassOf, which overstated confidence relative to
# nits-netex-align.ttl's convention for equivalent-confidence heuristic
# matches. Tighten to owl:equivalentClass or correct on human review.

#################################################################
# Journey/Service-scoped Indicators -> nits:Journey / nits:Service / nits:Network
#################################################################

opra:CancelledDatedVehicleJourneyCount
    skos:closeMatch nits:Journey .

opra:CancelledDatedVehicleJourneyDiscoveryDelivery
    skos:closeMatch nits:Journey .

opra:CancelledDatedVehicleJourneyDiscoveryRequest
    skos:closeMatch nits:Journey .

opra:CancelledDatedVehicleJourneysRequest
    skos:closeMatch nits:Journey .

opra:LateDatedVehicleJourneyCount
    skos:closeMatch nits:Journey .

opra:LateDatedVehicleJourneyDiscoveryDelivery
    skos:closeMatch nits:Journey .

opra:LateDatedVehicleJourneyDiscoveryRequest
    skos:closeMatch nits:Journey .

opra:LateDatedVehicleJourneysRequest
    skos:closeMatch nits:Journey .

opra:LoadOverJourneyDistance
    skos:closeMatch nits:Journey .

opra:MeanCapacityOverJourneyDistance
    skos:closeMatch nits:Journey .

opra:MeanCapacityOverNetworkDistance
    skos:closeMatch nits:Network .

opra:ServiceDelivery
    skos:closeMatch nits:Service .

opra:ServiceRequest
    skos:closeMatch nits:Service .

#################################################################
# Capacity, Indicator, Log, and Performance Concepts -> nits:DataArtifact
#
# nits:DataArtifact is the core ontology's abstract root for reported/derived
# data records; used here as the default anchor for OpRa's capacity,
# indicator, log-entry, and performance-reporting concepts, which do not map
# more specifically onto another nits: category.
#################################################################

opra:ActualCapacity
