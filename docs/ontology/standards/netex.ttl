@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .

@prefix netex: <https://netex.org.uk/netex/2.0#> .
@prefix opra: <https://transmodel-cen.eu/opra/1.0#> .
@prefix siri: <https://siri.org.uk/siri/1.3#> .
@prefix transmodel: <https://transmodel-cen.eu/6.2/> .

<https://netex.org.uk/netex/2.0>
    a owl:Ontology ;
    dct:title "NETEX Ontology with Schema Relationships"@en ;
    dct:description "OWL ontology with extracted inheritance and composition relationships from XSD."@en ;
    owl:versionInfo "0.4-expanded-classes-and-structure-suffixes" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

#################################################################
# Concepts with Semantic Relationships
#################################################################

netex:AbstractGroupMember
    a owl:Class ;
    skos:definition "Abstract member of a GROUP OF ENTITY MEMBERs."@en ;
    skos:prefLabel "abstract group member"@en ;
    skos:altLabel "abstract member of a group"@en ;
    skos:altLabel "abstractgroupmember"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_genericFramework/netex_grouping_version.xsd"@en .

netex:AcceptedDriverPermit
    a owl:Class ;
    skos:definition "Accepted TYPE OF DRIVER PERMIT for a given SIMPLE VEHICLE TYPE. +v2.0"@en ;
    skos:prefLabel "accepted driver permit"@en ;
    skos:altLabel "accepted type of driver permit"@en ;
    skos:altLabel "accepteddriverpermit"@en ;
    rdfs:subClassOf netex:DataManagedObject ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_vehicleType_version.xsd"@en .

netex:Access
    a owl:Class ;
    skos:definition "The physical (spatial) possibility for a passenger to access or leave the public transport system. This link may be used during a trip for:- the walking movement of a passenger from a PLACE (origin of the trip) to a STOP POINT (origin of the PT TRIP), or- the walking movement from a STOP POINT (destination of the PT TRIP) to a PLACE (destination of the trip)."@en ;
    skos:prefLabel "access"@en ;
    rdfs:subClassOf netex:Transfer ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_access_version.xsd"@en .

netex:AccessEquipment
    a owl:Class ;
    skos:definition "Specialisation of PLACE EQUIPMENT dedicated to access (e.g. lifts, entrances, stairs, ramps, etc.)."@en ;
    skos:prefLabel "access equipment"@en ;
    skos:altLabel "accessequipment"@en ;
    skos:altLabel "specialisation of place equipment dedicated"@en ;
    rdfs:subClassOf netex:PlaceEquipment ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_ifopt/netex_ifopt_equipmentAccess_version.xsd"@en .

netex:AccessFacility
    a owl:Class ;
    skos:definition "Classification of SITE ACCESS FACILITY."@en ;
    skos:prefLabel "access facility"@en ;
    skos:altLabel "accessfacility"@en ;
    skos:altLabel "classification of site access facility"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:AccessFacilityList
    a owl:Class ;
    skos:definition "List of SITE ACCESS FACILITies."@en ;
    skos:prefLabel "access facility list"@en ;
    skos:altLabel "accessfacilitylist"@en ;
    skos:altLabel "list of site access facilities"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:AccessMode
    a owl:Class ;
    skos:definition "Access MODE for SITEs and VEHICLE MEETING POINTs. Also used for TRANSFER and if in OTHER LEG of the TRIP a monomodal non-public transport is used."@en ;
    skos:prefLabel "access mode"@en ;
    skos:altLabel "access mode for sites and"@en ;
    skos:altLabel "accessmode"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_mode_support.xsd"@en .

netex:AccessRightInProduct
    a owl:Class ;
    skos:definition "A VALIDABLE ELEMENT as a part of a PRE-ASSIGNED FARE PRODUCT, including its possible order in the set of all VALIDABLE ELEMENTs grouped together to define the access right assigned to that PRE-ASSIGNED FARE PRODUCT."@en ;
    skos:prefLabel "access right in product"@en ;
    skos:altLabel "accessrightinproduct"@en ;
    rdfs:comment "Extracted from: xsd/netex_part_3/part3_fares/netex_fareProduct_version.xsd"@en .

netex:AccessRightParameterAssignment
    a owl:Class ;
    skos:definition "The assignment of a fare parameter (referring to geography, time, quality or usage) to an element of a fare system (access right, validated access, control mean, etc.)."@en ;
    skos:prefLabel "access right parameter assignment"@en ;
    skos:altLabel "accessrightparameterassignment"@en ;
    skos:altLabel "assignment of a fare"@en ;
    rdfs:comment "Extracted from: xsd/netex_part_3/part3_fares/netex_accessRightParameter_version.xsd"@en .

netex:AccessSpace
    a owl:Class ;
    skos:definition "An area within a STOP PLACE that does not give direct access to transport vehicles. May be connected to QUAYS by PATH LINKs."@en ;
    skos:prefLabel "access space"@en ;
    skos:altLabel "accessspace"@en ;
    rdfs:subClassOf netex:StopPlaceSpace ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_ifopt/netex_ifopt_stopPlace_version.xsd"@en .

netex:AccessSummary
    a owl:Class ;
    skos:definition "Summary of a feature used in NAVIGATION PATH."@en ;
    skos:prefLabel "access summary"@en ;
    skos:altLabel "accesssummary"@en ;
    skos:altLabel "summary of a feature used"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_environment_version.xsd"@en .

netex:AccessVehicleEquipment
    a owl:Class ;
    skos:definition "Specialisation of VEHICLE EQUIPMENT for ACCESS providing information such as low floor, ramp, access area dimensions, etc."@en ;
    skos:prefLabel "access vehicle equipment"@en ;
    skos:altLabel "accessvehicleequipment"@en ;
    skos:altLabel "specialisation of vehicle equipment for"@en ;
    rdfs:subClassOf netex:PassengerEquipment ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_equipmentVehiclePassenger_version.xsd"@en .

netex:AccessZone
    a owl:Class ;
    skos:definition "An identified storey (ground, first, basement, mezzanine, etc) within an interchange building or SITE on which SITE COMPONENTs reside. A PATH LINK may connect components on different ACCESS ZONEs."@en ;
    skos:prefLabel "access zone"@en ;
    skos:altLabel "accesszone"@en ;
    rdfs:subClassOf netex:Zone ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_ifopt/netex_ifopt_site_version.xsd"@en .

netex:AccessibilityAssessment
    a owl:Class ;
    skos:definition "The accessibility characteristics of an entity used by passengers such as a STOP PLACE, or a STOP PLACE COMPONENT. Described by ACCESSIBILITY LIMITATIONs, and/or a set of SUITABILITies."@en ;
    skos:prefLabel "accessibility assessment"@en ;
    skos:altLabel "accessibilityassessment"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_genericFramework/netex_accessibility/netex_acsb_accessibility.xsd"@en .

netex:AccessibilityInfoFacility
    a owl:Class ;
    skos:definition "Classification of ACCESSIBILITY INFO FACILITY type - TPEG pti23."@en ;
    skos:prefLabel "accessibility info facility"@en ;
    skos:altLabel "accessibilityinfofacility"@en ;
    skos:altLabel "classification of accessibility info facility"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:AccessibilityInfoFacilityList
    a owl:Class ;
    skos:definition "List of ACCESSIBILITY INFO FACILITies."@en ;
    skos:prefLabel "accessibility info facility list"@en ;
    skos:altLabel "accessibilityinfofacilitylist"@en ;
    skos:altLabel "list of accessibility info facilities"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:AccessibilityLimitation
    a owl:Class ;
    skos:definition "A categorisation of the ACCESSIBILITY characteristics of a STOP PLACE COMPONENT such as a STOP PATH LINK, STOP PLACE or ACCESS SPACE to indicate its usability by passengers with specific needs, for example, those needing wheelchair access, step-free access or wanting to avoid confined spaces such as lifts."@en ;
    skos:prefLabel "accessibility limitation"@en ;
    skos:altLabel "accessibilitylimitation"@en ;
    skos:altLabel "categorisation of the accessibility"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_genericFramework/netex_accessibility/netex_acsb_accessibility.xsd"@en .

netex:AccessibilityTool
    a owl:Class ;
    skos:definition "Classification of ACCESSIBILITY TOOLs."@en ;
    skos:prefLabel "accessibility tool"@en ;
    skos:altLabel "accessibilitytool"@en ;
    skos:altLabel "classification of accessibility tools"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:AccessibilityToolList
    a owl:Class ;
    skos:definition "List of ACCESSIBILITY TOOLs."@en ;
    skos:prefLabel "accessibility tool list"@en ;
    skos:altLabel "accessibilitytoollist"@en ;
    skos:altLabel "list of accessibility tools"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:Accommodation
    a owl:Class ;
    skos:definition "Allowed combinations of accommodation."@en ;
    skos:prefLabel "accommodation"@en ;
    skos:altLabel "allowed combinations of accommodation"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:AccommodationAccess
    a owl:Class ;
    skos:definition "Classification of ACCOMMODATION ACCESS type -"@en ;
    skos:prefLabel "accommodation access"@en ;
    skos:altLabel "accommodationaccess"@en ;
    skos:altLabel "classification of accommodation access type"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:AccommodationAccessList
    a owl:Class ;
    skos:definition "List of ACCOMMODATION ACCESS."@en ;
    skos:prefLabel "accommodation access list"@en ;
    skos:altLabel "accommodationaccesslist"@en ;
    skos:altLabel "list of accommodation access"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:AccommodationFacility
    a owl:Class ;
    skos:definition "Classification of ACCOMMODATION FACILITY type - TPEG pti23."@en ;
    skos:prefLabel "accommodation facility"@en ;
    skos:altLabel "accommodationfacility"@en ;
    skos:altLabel "classification of accommodation facility type"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:AccommodationFacilityList
    a owl:Class ;
    skos:definition "List of ACCOMMODATION FACILITies."@en ;
    skos:prefLabel "accommodation facility list"@en ;
    skos:altLabel "accommodationfacilitylist"@en ;
    skos:altLabel "list of accommodation facilities"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:AccountableElement
    a owl:Class ;
    skos:definition "A period of a driver's DUTY during which (s)he is continuously working without a BREAK. PAUSEs during which (the)he remains responsible for the vehicle may be included."@en ;
    skos:prefLabel "accountable element"@en ;
    skos:altLabel "accountableelement"@en ;
    rdfs:subClassOf netex:DataManagedObject ;
    rdfs:comment "Extracted from: xsd/netex_part_2/part2_vehicleService/netex_duty_version.xsd"@en .

netex:ActivatedEquipment
    a owl:Class ;
    skos:definition "An EQUIPMENT activated by the passage of a vehicle at an ACTIVATION POINT or on an ACTIVATION LINK."@en ;
    skos:prefLabel "activated equipment"@en ;
    skos:altLabel "activatedequipment"@en ;
    skos:altLabel "equipment activated by the"@en ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_networkDescription/netex_activation_version.xsd"@en .

netex:ActivationAssignment
    a owl:Class ;
    skos:definition "An assignment of an ACTIVATION POINT/LINK to an ACTIVATED EQUIPMENT related on its turn to a TRAFFIC CONTROL POINT. The considered ACTIVATION POINT/LINK will be used to influence the control process for that TRAFFIC CONTROL POINT (e.g. to fix priorities as regards the processing of competing requests from different ACTIVATION POINTs/LINKs)."@en ;
    skos:prefLabel "activation assignment"@en ;
    skos:altLabel "activationassignment"@en ;
    skos:altLabel "assignment of an activation"@en ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_networkDescription/netex_activation_version.xsd"@en .

netex:ActivationLink
    a owl:Class ;
    skos:definition "A LINK where a control process is activated when a vehicle passes it."@en ;
    skos:prefLabel "activation link"@en ;
    skos:altLabel "activationlink"@en ;
    skos:altLabel "link where a control"@en ;
    rdfs:subClassOf netex:Link ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_networkDescription/netex_activation_version.xsd"@en .

netex:ActivationPoint
    a owl:Class ;
    skos:definition "A POINT where a control process is activated when a vehicle passes it. EQUIPMENT may be needed for the activation."@en ;
    skos:prefLabel "activation point"@en ;
    skos:altLabel "activationpoint"@en ;
    skos:altLabel "point where a control"@en ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_networkDescription/netex_activation_version.xsd"@en .

netex:ActualVehicleEquipment
    a owl:Class ;
    skos:definition "An item of EQUIPMENT of a particular type actually available in an individual VEHICLE."@en ;
    skos:prefLabel "actual vehicle equipment"@en ;
    skos:altLabel "actualvehicleequipment"@en ;
    skos:altLabel "item of equipment of"@en ;
    rdfs:subClassOf netex:PassengerEquipment ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_equipmentVehiclePassenger_version.xsd"@en .

netex:AdditionalDriverOption
    a owl:Class ;
    skos:definition "Parameters relating to paying by AdditionalDriverOption for a product. +v1.1"@en ;
    skos:prefLabel "additional driver option"@en ;
    skos:altLabel "additionaldriveroption"@en ;
    rdfs:comment "Extracted from: xsd/netex_part_5/part5_fm/netex_nm_usageParameterRental_version.xsd"@en .

netex:AddressablePlace
    a owl:Class ;
    skos:definition "A PLACE which may have an address."@en ;
    skos:prefLabel "addressable place"@en ;
    skos:altLabel "addressableplace"@en ;
    skos:altLabel "place which may have"@en ;
    rdfs:subClassOf netex:Place ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_address_version.xsd"@en .

netex:AdministrativeZone
    a owl:Class ;
    skos:definition "A ZONE relating to the management responsibilities of an ORGANISATION. For example to allocate bus stop identifiers for a region."@en ;
    skos:prefLabel "administrative zone"@en ;
    skos:altLabel "administrativezone"@en ;
    skos:altLabel "zone relating to the"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_genericFramework/netex_organisation_version.xsd"@en .

netex:AllVehicleModes
    a owl:Class ;
    skos:definition "All PUBLIC TRANSPORT MODEs including self drive."@en ;
    skos:prefLabel "all public transport modes including"@en ;
    skos:altLabel "all vehicle modes"@en ;
    skos:altLabel "allvehiclemodes"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_mode_support.xsd"@en .

netex:AllowedLineDirection
    a owl:Class ;
    skos:definition "A set of allowed DIRECTIONs that can be used on a given ROUTE."@en ;
    skos:prefLabel "allowed line direction"@en ;
    skos:altLabel "allowedlinedirection"@en ;
    skos:altLabel "set of allowed directions"@en ;
    rdfs:subClassOf netex:DataManagedObject ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_networkDescription/netex_line_version.xsd"@en .

netex:AlternativeModeOfOperation
    a owl:Class ;
    skos:definition "Any publicly advertised mode of operation different from the CONVENTIONAL MODE OF OPERATION, for example: VEHICLE SHARING, VEHICLE RENTAL, VEHICLE POOLING. +v1.2.2"@en ;
    skos:prefLabel "alternative mode of operation"@en ;
    skos:altLabel "alternativemodeofoperation"@en ;
    skos:altLabel "any publicly advertised mode of"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_modeOfOperation_version.xsd"@en .

netex:AlternativeQuayDescriptor
    a owl:Class ;
    skos:definition "An element of a STOP PLACE describing part of its structure."@en ;
    skos:prefLabel "alternative quay descriptor"@en ;
    skos:altLabel "alternativequaydescriptor"@en ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_ifopt/netex_ifopt_stopPlace_version.xsd"@en .

netex:AmountOfPriceUnitProduct
    a owl:Class ;
    skos:definition "A FARE PRODUCT consisting in a stored value of PRICE UNITs: an amount of money on an electronic purse, amount of units on a value card etc."@en ;
    skos:prefLabel "amount of price unit product"@en ;
    skos:altLabel "amountofpriceunitproduct"@en ;
    skos:altLabel "fare product consisting in"@en ;
    rdfs:comment "Extracted from: xsd/netex_part_3/part3_fares/netex_fareProduct_version.xsd"@en .

netex:Assignment
    a owl:Class ;
    skos:definition "A set of properties to be applied to an another element. It has a name and an order."@en ;
    skos:prefLabel "assignment"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_genericFramework/netex_assignment_version.xsd"@en .

netex:AssistanceBookingService
    a owl:Class ;
    skos:definition "Information about how to book assistance for wheelchair and disabled users."@en ;
    skos:prefLabel "assistance booking service"@en ;
    skos:altLabel "assistancebookingservice"@en ;
    rdfs:subClassOf netex:LocalService ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_ifopt/netex_assistanceBooking_version.xsd"@en .

netex:AssistanceFacility
    a owl:Class ;
    skos:definition "Classification of ASSISTANCE FACILITY."@en ;
    skos:prefLabel "assistance facility"@en ;
    skos:altLabel "assistancefacility"@en ;
    skos:altLabel "classification of assistance facility"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:AssistanceFacilityList
    a owl:Class ;
    skos:definition "List of ASSISTANCE FACILITies."@en ;
    skos:prefLabel "assistance facility list"@en ;
    skos:altLabel "assistancefacilitylist"@en ;
    skos:altLabel "list of assistance facilities"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:AssistanceService
    a owl:Class ;
    skos:definition "Specialisation of LOCAL SERVICE for ASSISTANCE providing information like language, accessibility trained staff, etc."@en ;
    skos:prefLabel "assistance service"@en ;
    skos:altLabel "assistanceservice"@en ;
    skos:altLabel "specialisation of local service for"@en ;
    rdfs:subClassOf netex:LocalService ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_ifopt/netex_ifopt_localService_version.xsd"@en .

netex:AudibleSignalsAvailable
    a owl:Class ;
    skos:definition "Whether a PLACE has audible signals for the visually impaired."@en ;
    skos:prefLabel "audible signals available"@en ;
    skos:altLabel "audiblesignalsavailable"@en ;
    skos:altLabel "whether a place has audible"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_genericFramework/netex_accessibility/netex_acsb_limitations.xsd"@en .

netex:Authority
    a owl:Class ;
    skos:definition "The ORGANISATION under which the responsibility of organising the transport service in a certain area is placed."@en ;
    skos:prefLabel "authority"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_transportOrganisation_version.xsd"@en .

netex:AvailabilityCondition
    a owl:Class ;
    skos:definition "VALIDITY CONDITION stated in terms of DAY TYPES and PROPERTIES OF DAYs."@en ;
    skos:prefLabel "availability condition"@en ;
    skos:altLabel "availabilitycondition"@en ;
    skos:altLabel "validity condition stated in terms"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_availabilityCondition_version.xsd"@en .

netex:BatteryEquipment
    a owl:Class ;
    skos:definition "Specialisation of INSTALLED EQUIPMENT for BATTERY. +v1.2.2"@en ;
    skos:prefLabel "battery equipment"@en ;
    skos:altLabel "batteryequipment"@en ;
    skos:altLabel "specialisation of installed equipment for"@en ;
    rdfs:subClassOf netex:InstalledEquipment ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_nm_equipmentEnergy_version.xsd"@en .

netex:BeaconPoint
    a owl:Class ;
    skos:definition "A POINT where a beacon or similar device to support the automatic detection of vehicles passing by is located."@en ;
    skos:prefLabel "beacon point"@en ;
    skos:altLabel "beaconpoint"@en ;
    skos:altLabel "point where a beacon"@en ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_networkDescription/netex_activation_version.xsd"@en .

netex:BedEquipment
    a owl:Class ;
    skos:definition "A specialisation of SPOT EQUIPMENT describing the detailed properties of a bed. +v2.0"@en ;
    skos:prefLabel "bed equipment"@en ;
    skos:altLabel "bedequipment"@en ;
    skos:altLabel "specialisation of spot equipment"@en ;
    rdfs:subClassOf netex:InstalledEquipment ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_spotEquipment_version.xsd"@en .

netex:BerthFacility
    a owl:Class ;
    skos:definition "Classification of BERTHFACILITY type - TPEG pti23."@en ;
    skos:prefLabel "berth facility"@en ;
    skos:altLabel "berthfacility"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

netex:Blacklist
    a owl:Class ;
    skos:definition "A list of items (TRAVEL DOCUMENTs, CONTRACTs etc) the validity of which has been cancelled temporarily or permanently, for a specific reason like loss of the document, technical malfunction, no credit on bank account, offences committed by the customer, etc."@en ;
    skos:prefLabel "blacklist"@en ;
    rdfs:subClassOf netex:DataManagedObject ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_securityList_version.xsd"@en .

netex:Block
    a owl:Class ;
    skos:definition "The work of a vehicle from the time it leaves a PARKING POINT after parking until its next return to park at a PARKING POINT. Any subsequent departure from a PARKING POINT after parking marks the start of a new BLOCK. The period of a BLOCK has to be covered by DUTies."@en ;
    skos:prefLabel "block"@en ;
    rdfs:subClassOf netex:DataManagedObject ;
    rdfs:comment "Extracted from: xsd/netex_part_2/part2_vehicleService/netex_vehicleService_version.xsd"@en .

netex:BoardingPermission
    a owl:Class ;
    skos:definition "Classification of BOARDING PERMISSION - UIC 7161 Code list."@en ;
    skos:prefLabel "boarding permission"@en ;
    skos:altLabel "boardingpermission"@en ;
    skos:altLabel "classification of boarding permission"@en ;
    rdfs:comment "Extracted from: xsd/netex_framework/netex_reusableComponents/netex_facility_version.xsd"@en .

