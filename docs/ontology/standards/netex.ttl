    skos:prefLabel "journey pattern run time"@en ;
    skos:altLabel "journeypatternruntime"@en ;
    skos:altLabel "time taken to traverse"@en ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_tacticalPlanning/netex_journeyPatternTimings_version.xsd"@en .

netex:JourneyPatternWaitTime
    a owl:Class ;
