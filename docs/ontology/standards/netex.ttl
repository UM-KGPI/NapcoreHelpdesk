    skos:prefLabel "headway interval information that is"@en ;
    skos:altLabel "journey pattern headway"@en ;
    skos:altLabel "journeypatternheadway"@en ;
    rdfs:comment "Extracted from: xsd/netex_part_1/part1_tacticalPlanning/netex_journeyPatternTimings_version.xsd"@en .

netex:JourneyPatternLayover
    a owl:Class ;
