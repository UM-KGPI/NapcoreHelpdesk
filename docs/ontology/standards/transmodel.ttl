  ; rdfs:subClassOf tm:PRICEABLE_OBJECT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SeriesConstraintIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SERIES CONSTRAINT." ]
