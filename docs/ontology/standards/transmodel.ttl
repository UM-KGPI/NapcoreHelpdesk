  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AccountDetectReentryEventIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACCOUNT DETECT RE-ENTRY EVENT." ]
  .

tm:ACCOUNT_DETECT_NO_CHECK_OUT_EVENT a owl:Class ;
  rdfs:label "ACCOUNT DETECT NO CHECK OUT EVENT"
  ; rdfs:comment "The detection that a passenger has failed to check out at the end of a trip.  NOTE: This may be triggered by a subsequent check in on a new journey or by back office processes looking for unmatched check in and check out events within a specified window."
  ; skos:definition "The detection that a passenger has failed to check out at the end of a trip.  NOTE: This may be triggered by a subsequent check in on a new journey or by back office processes looking for unmatched check in and check out events within a specified window."
  ; rdfs:subClassOf tm:ACCOUNT_PROCESSING_EVENT
