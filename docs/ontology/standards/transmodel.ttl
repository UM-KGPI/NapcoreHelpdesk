  .

tm:VEHICLE_JOURNEY a owl:Class ;
  rdfs:label "VEHICLE JOURNEY"
  ; rdfs:comment "The planned movement of a type of public transport vehicle (indicated by a VEHICLE TYPE, TRAIN or COMPOUND TRAIN) on a DAY TYPE from the start point to the end point of a JOURNEY PATTERN on a specified ROUTE.  NOTE: A DATED VEHICLE Journey uses a SERVICE CALENDAR to resolve the DAY TYPE for the VEHICLE JOURNEY into specific dates of operation."
  ; skos:definition "The planned movement of a type of public transport vehicle (indicated by a VEHICLE TYPE, TRAIN or COMPOUND TRAIN) on a DAY TYPE from the start point to the end point of a JOURNEY PATTERN on a specified ROUTE.  NOTE: A DATED VEHICLE Journey uses a SERVICE CALENDAR to resolve the DAY TYPE for the VEHICLE JOURNEY into specific dates of operation."
  ; rdfs:subClassOf tm:JOURNEY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VehicleJourneyIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE JOURNEY." ]
  ; ea:attribute [ ea:name "DepartureTime" ; ea:position 2 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Departure time of VEHICLE JOURNEY." ]
  ; ea:attribute [ ea:name "JourneyDuration" ; ea:position 3 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Duration of VEHICLE JOURNEY." ]
  .

tm:TYPE_OF_SERVICE a owl:Class ;
  rdfs:label "TYPE OF SERVICE"
  ; rdfs:comment "A classification for VEHICLE JOURNEYs, SPECIAL SERVICEs and DEAD RUNs to express some common properties of journeys to be taken into account in the scheduling and/or operations control process."
  ; skos:definition "A classification for VEHICLE JOURNEYs, SPECIAL SERVICEs and DEAD RUNs to express some common properties of journeys to be taken into account in the scheduling and/or operations control process."
  ; rdfs:subClassOf tm:TYPE_OF_VALUE
