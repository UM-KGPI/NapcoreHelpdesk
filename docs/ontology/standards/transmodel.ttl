  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfFrameIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF FRAME." ]
  ; ea:attribute [ ea:name "Periodicity" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "How long frames of this content are valid for by default." ]
  ; ea:attribute [ ea:name "Nature" ; ea:position 3 ; ea:typeName "DataNatureEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "How long frames of this content are valid for by default." ]
  ; ea:attribute [ ea:name "ModificationSet" ; ea:position 4 ; ea:typeName "ModificationSetEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether all contained instances or just deltas must be present." ]
  ; ea:attribute [ ea:name "Versioning" ; ea:position 5 ; ea:typeName "VersioningEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "How version numbers should be used." ]
  .

tm:VERSION_FRAME a owl:Class ;
  rdfs:label "VERSION FRAME"
  ; rdfs:comment "A set of VERSIONS referring to the same DATA SOURCE and belonging to the same TYPE OF FRAME.  NOTE: A FRAME may be restricted by VALIDITY CONDITIONs."
  ; skos:definition "A set of VERSIONS referring to the same DATA SOURCE and belonging to the same TYPE OF FRAME.  NOTE: A FRAME may be restricted by VALIDITY CONDITIONs."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VersionFrameIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VERSION FRAME." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of VERSION FRAME." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of VERSION FRAME." ]
  .

tm:TYPE_OF_VALIDITY a owl:Class ;
  rdfs:label "TYPE OF VALIDITY"
  ; rdfs:comment "A classification of the validity of TYPEs OF FRAME; e.g., as a frame for schedules designed for DAY TYPEs, or for specific OPERATING DAYs."
