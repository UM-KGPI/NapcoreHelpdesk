  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of OPERATIONAL CONTEXT." ]
  ; ea:attribute [ ea:name "ShortName" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Short name of OPERATIONAL CONTEXT." ]
  .

tm:GROUP_OF_OPERATORS a owl:Class ;
  rdfs:label "GROUP OF OPERATORS"
  ; rdfs:comment "A group of OPERATORs having for instance common schemes for fare collection or passenger information."
  ; skos:definition "A group of OPERATORs having for instance common schemes for fare collection or passenger information."
