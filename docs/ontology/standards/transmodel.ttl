  .

tm:ASSIGNED_DUTY a owl:Class ;
  rdfs:label "ASSIGNED DUTY"
  ; rdfs:comment "A DUTY to which specific timed work has been assigned."
  ; skos:definition "A DUTY to which specific timed work has been assigned."
  ; rdfs:subClassOf tm:DUTY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AssignedDutyIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ASSIGNED DUTY." ]
  .

tm:TASK a owl:Class ;
  rdfs:label "TASK"
  ; rdfs:comment "Any continuous piece of non-driving work, performed by a driver."
  ; skos:definition "Any continuous piece of non-driving work, performed by a driver."
  ; rdfs:subClassOf tm:NON_DRIVING_SPELL
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Name" ; ea:position 1 ; ea:typeName "MultilingualString" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Name of TASK." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "TaskIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TASK." ]
  .

tm:BREAK_FACILITY a owl:Class ;
  rdfs:label "BREAK FACILITY"
  ; rdfs:comment "A canteen, cafe, kiosk or any place where drivers have toilet and refreshment facilities."
  ; skos:definition "A canteen, cafe, kiosk or any place where drivers have toilet and refreshment facilities."
  ; rdfs:subClassOf tm:TYPE_OF_VALUE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "BreakFacilityIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of BREAk FACILITY." ]
  .

tm:STAND_BY a owl:Class ;
  rdfs:label "STAND-BY"
  ; rdfs:comment "A non-driving period of a driver's DUTY when the driver must wait ready to take on any specified piece of work instantly."
  ; skos:definition "A non-driving period of a driver's DUTY when the driver must wait ready to take on any specified piece of work instantly."
  ; rdfs:subClassOf tm:NON_DRIVING_SPELL
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "StandByIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of STAND-BY." ]
  .

tm:NON_DRIVING_SPELL a owl:Class ;
  rdfs:label "NON-DRIVING SPELL"
  ; rdfs:comment "A continuous period in a STRETCH when a driver is performing some non-driving TASK or waiting on STAND-BY."
  ; skos:definition "A continuous period in a STRETCH when a driver is performing some non-driving TASK or waiting on STAND-BY."
  ; rdfs:subClassOf tm:SPELL
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "NonDrivingSpellIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of NON-DRIVING SPELL." ]
  .

tm:DRIVING_SPELL a owl:Class ;
  rdfs:label "DRIVING SPELL"
  ; rdfs:comment "A continuous period in a STRETCH, during which a driver is on duty in one vehicle."
  ; skos:definition "A continuous period in a STRETCH, during which a driver is on duty in one vehicle."
  ; rdfs:subClassOf tm:SPELL
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DrivingSpellIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DRIVING SPELL." ]
  .

tm:TYPE_OF_TASK a owl:Class ;
  rdfs:label "TYPE OF TASK"
  ; rdfs:comment "A classification of a TASK."
  ; skos:definition "A classification of a TASK."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfTaskIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF TASK." ]
  .

tm:SPELL a owl:Class ;
  rdfs:label "SPELL"
  ; rdfs:comment "A continuous period in a STRETCH, when a driver is on duty on one vehicle or performing one other type of work."
  ; skos:definition "A continuous period in a STRETCH, when a driver is on duty on one vehicle or performing one other type of work."
  ; rdfs:subClassOf tm:ACCOUNTABLE_ACTIVITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SpellIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SPELL." ]
  ; ea:attribute [ ea:name "StartTime" ; ea:position 2 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Start time of STRETCH." ]
  ; ea:attribute [ ea:name "StartTimeDayOffset" ; ea:position 3 ; ea:typeName "DayOffsetType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Day offset of start time from OPERATING DAY." ]
  ; ea:attribute [ ea:name "EndTime" ; ea:position 4 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "End time of STRETCH." ]
  ; ea:attribute [ ea:name "EndTimeDayOffset" ; ea:position 5 ; ea:typeName "DayOffsetType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Day offset of end time from start time" ]
  .

tm:STRETCH a owl:Class ;
  rdfs:label "STRETCH"
  ; rdfs:comment "A STRETCH is a period of a driver's DUTY during which the driver is continuously working without a BREAK but that may include PAUSEs during which the driver remains responsible for the vehicle."
  ; skos:definition "A STRETCH is a period of a driver's DUTY during which the driver is continuously working without a BREAK but that may include PAUSEs during which the driver remains responsible for the vehicle."
  ; rdfs:subClassOf tm:TIME_ACCOUNTABLE_ACTIVITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "StretchIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of STRETCH." ]
  .

tm:BREAK a owl:Class ;
  rdfs:label "BREAK"
  ; rdfs:comment "A period of time within a DUTY PART during which the driver is not responsible for a vehicle and can rest, usually at a BREAK FACILITY."
  ; skos:definition "A period of time within a DUTY PART during which the driver is not responsible for a vehicle and can rest, usually at a BREAK FACILITY."
  ; rdfs:subClassOf tm:ACCOUNTABLE_ACTIVITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "BreakIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of BREAK." ]
  .

tm:PAUSE a owl:Class ;
  rdfs:label "PAUSE"
  ; rdfs:comment "A period of paid driver time at the end of a SERVICE JOURNEY or during or after a DEAD RUN when the driver is responsible for the VEHICLE, but resting in the VEHICLE or in a designated BREAK FACILITY near the POINT where the VEHICLE has stopped."
  ; skos:definition "A period of paid driver time at the end of a SERVICE JOURNEY or during or after a DEAD RUN when the driver is responsible for the VEHICLE, but resting in the VEHICLE or in a designated BREAK FACILITY near the POINT where the VEHICLE has stopped."
  ; rdfs:subClassOf tm:TIME_ACCOUNTABLE_ACTIVITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PauseIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PAUSE." ]
  .

tm:TYPE_OF_ALLOWANCE a owl:Class ;
  rdfs:label "TYPE OF ALLOWANCE"
  ; rdfs:comment "A classification of additional paid times, including the information whether the allowance is given before or after the main activity."
  ; skos:definition "A classification of additional paid times, including the information whether the allowance is given before or after the main activity."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "PreOrPost" ; ea:position 1 ; ea:typeName "Boolean" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Designator stating whether the ALLOWANCE is before or after the main activity." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "TypeOfAllowanceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF ALLOWANCE." ]
  .

tm:FILL_IN_TIME a owl:Class ;
  rdfs:label "FILL IN TIME"
  ; rdfs:comment "A non-productive period of driver time that is the result of the duty cutting procedure or is introduced to prolong a DRIVING SPELL to a minimum length."
  ; skos:definition "A non-productive period of driver time that is the result of the duty cutting procedure or is introduced to prolong a DRIVING SPELL to a minimum length."
  ; rdfs:subClassOf tm:ACCOUNTABLE_ACTIVITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FillInTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FILL IN TIME." ]
  .

tm:TIME_ALLOWANCE a owl:Class ;
  rdfs:label "TIME ALLOWANCE"
  ; rdfs:comment "A fixed paid time allowed to perform certain activities to prepare for or to complete the work assigned either to a BLOCK, a DUTY, a DUTY PART, a STRETCH or a SPELL."
  ; skos:definition "A fixed paid time allowed to perform certain activities to prepare for or to complete the work assigned either to a BLOCK, a DUTY, a DUTY PART, a STRETCH or a SPELL."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Duration" ; ea:position 1 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Duration of TIME ALLOWANCE." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "TimeAllowanceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TIME ALLOWANCE." ]
  .

tm:DRIVER_TRIP a owl:Class ;
  rdfs:label "DRIVER TRIP"
  ; rdfs:comment "A planned non-driving movement of a driver within a DUTY PART between two TIMING POINTs that may include using one or several VEHICLE JOURNEYs on vehicles driven by other drivers."
  ; skos:definition "A planned non-driving movement of a driver within a DUTY PART between two TIMING POINTs that may include using one or several VEHICLE JOURNEYs on vehicles driven by other drivers."
  ; rdfs:subClassOf tm:ACCOUNTABLE_ACTIVITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DriverTripIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DRIVER TRIP." ]
  .

tm:DRIVER_TRIP_TIME a owl:Class ;
  rdfs:label "DRIVER TRIP TIME"
  ; rdfs:comment "The time allowed for a driver to cover a particular DRIVER TRIP during a specified TIME BAND."
  ; skos:definition "The time allowed for a driver to cover a particular DRIVER TRIP during a specified TIME BAND."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DriverTripTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DRIVER TRIP TIME." ]
  ; ea:attribute [ ea:name "Duration" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Allotted time to conduct DRIVER TRIP." ]
  .

tm:DUTY_TYPE a owl:Class ;
  rdfs:label "DUTY TYPE"
  ; rdfs:comment "A classification of a DUTY, in terms of working hours within the day."
  ; skos:definition "A classification of a DUTY, in terms of working hours within the day."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Name" ; ea:position 1 ; ea:typeName "MultilingualString" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Name of DUTY TYPE." ]
