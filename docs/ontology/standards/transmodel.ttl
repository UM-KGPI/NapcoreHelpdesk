  .

tm:POINT_PROJECTION a owl:Class ;
  rdfs:label "POINT PROJECTION"
  ; rdfs:comment "An oriented correspondence from one POINT of a source layer, onto an entity in a target layer: e.g., a POINT, LINK, LINK SEQUENCE, or COMPLEX FEATURE, within a defined TYPE OF PROJECTION."
  ; skos:definition "An oriented correspondence from one POINT of a source layer, onto an entity in a target layer: e.g., a POINT, LINK, LINK SEQUENCE, or COMPLEX FEATURE, within a defined TYPE OF PROJECTION."
  ; rdfs:subClassOf tm:PROJECTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PointProjectionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of POINT PROJECTION." ]
  ; ea:attribute [ ea:name "Distance" ; ea:position 2 ; ea:typeName "DistanceType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Distance along projection" ]
  .

tm:LINK_PROJECTION a owl:Class ;
  rdfs:label "LINK PROJECTION"
  ; rdfs:comment "An oriented correspondence from one LINK of a source layer, onto an entity in a target layer: e.g., LINK SEQUENCE, COMPLEX FEATURE, within a defined TYPE OF PROJECTION."
  ; skos:definition "An oriented correspondence from one LINK of a source layer, onto an entity in a target layer: e.g., LINK SEQUENCE, COMPLEX FEATURE, within a defined TYPE OF PROJECTION."
  ; rdfs:subClassOf tm:PROJECTION
