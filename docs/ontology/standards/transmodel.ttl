  ; ea:attribute [ ea:name "DepartureTime" ; ea:position 3 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Departure time of SPECIAL SERVICE." ]
  ; ea:attribute [ ea:name "JourneyDuration" ; ea:position 4 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Duration of SPECIAL SERVICE." ]
  ; ea:attribute [ ea:name "Print" ; ea:position 5 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether this journey should be visible to the public in print media channels." ]
  .

tm:TEMPLATE_SERVICE_JOURNEY a owl:Class ;
  rdfs:label "TEMPLATE SERVICE JOURNEY"
  ; rdfs:comment "A passenger carrying TEMPLATE VEHICLE JOURNEY.  NOTE: It may represent multiple journeys."
  ; skos:definition "A passenger carrying TEMPLATE VEHICLE JOURNEY.  NOTE: It may represent multiple journeys."
  ; rdfs:subClassOf tm:SERVICE_JOURNEY
  ; rdfs:subClassOf tm:TEMPLATE_VEHICLE_JOURNEY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TemplateServiceJourneyIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TEMPLATE SERVICE JOURNEY." ]
  .

tm:DEFAULT_SERVICE_JOURNEY_RUN_TIME a owl:Class ;
  rdfs:label "DEFAULT SERVICE JOURNEY RUN TIME"
  ; rdfs:comment "The default time taken to traverse a TIMING LINK during a SERVICE JOURNEY, for a specified TIME DEMAND TYPE.  NOTE: Can be superseded by a JOURNEY PATTERN RUN TIME or a VEHICLE JOURNEY RUN TIME."
  ; skos:definition "The default time taken to traverse a TIMING LINK during a SERVICE JOURNEY, for a specified TIME DEMAND TYPE.  NOTE: Can be superseded by a JOURNEY PATTERN RUN TIME or a VEHICLE JOURNEY RUN TIME."
  ; rdfs:subClassOf tm:JOURNEY_TIMING
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DefaultServiceRunTimeIdType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identifier of DEFAULT SERVICE JOURNEY RUN TIME." ]
  ; ea:attribute [ ea:name "RunTime" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Run time as a duration." ]
  .

tm:DEFAULT_DEAD_RUN_RUN_TIME a owl:Class ;
  rdfs:label "DEFAULT DEAD RUN RUN TIME"
  ; rdfs:comment "The default time taken to traverse a TIMING LINK during a DEAD RUN, for a specified TIME DEMAND TYPE.  NOTE: Can be superseded by a JOURNEY PATTERN RUN TIME or a VEHICLE JOURNEY RUN TIME."
  ; skos:definition "The default time taken to traverse a TIMING LINK during a DEAD RUN, for a specified TIME DEMAND TYPE.  NOTE: Can be superseded by a JOURNEY PATTERN RUN TIME or a VEHICLE JOURNEY RUN TIME."
  ; rdfs:subClassOf tm:JOURNEY_TIMING
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DefaultDeadRunRunTimeIdType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identifier of DEFAULT DEAD RUN RUN TIME." ]
  ; ea:attribute [ ea:name "RunTime" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time to make a DEAD RUN." ]
  .

tm:TURNAROUND_TIME_LIMIT a owl:Class ;
  rdfs:label "TURNAROUND TIME LIMIT"
  ; rdfs:comment "The maximum time for which a vehicle may be scheduled to wait at a particular TIMING POINT (often included in a TURN STATION) without being returned to a PARKING POINT.  NOTE1: Can be superseded by a DEAD RUN.  NOTE2: Optionally, a minimum time for a vehicle to turn its direction may also be recorded."
  ; skos:definition "The maximum time for which a vehicle may be scheduled to wait at a particular TIMING POINT (often included in a TURN STATION) without being returned to a PARKING POINT.  NOTE1: Can be superseded by a DEAD RUN.  NOTE2: Optionally, a minimum time for a vehicle to turn its direction may also be recorded."
  ; rdfs:subClassOf tm:JOURNEY_TIMING
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TurnaroundTimeLimitIdType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identifier of TURNAROUND TIME LIMIT" ]
  ; ea:attribute [ ea:name "MinimumDuration" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Minimum time deeded for turnaround" ]
  ; ea:attribute [ ea:name "MaximumDuration" ; ea:position 3 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Maximum time deeded for turnaround" ]
  .

tm:VEHICLE_TYPE_PREFERENCE a owl:Class ;
  rdfs:label "VEHICLE TYPE PREFERENCE"
  ; rdfs:comment "The preference for the use of a particular VEHICLE TYPE for a SERVICE JOURNEY PATTERN, depending on the DAY TYPE and TIME DEMAND TYPE.  NOTE1: The rank of preferences must be recorded.   NOTE2: Different VEHICLE TYPEs may be given the same rank."
  ; skos:definition "The preference for the use of a particular VEHICLE TYPE for a SERVICE JOURNEY PATTERN, depending on the DAY TYPE and TIME DEMAND TYPE.  NOTE1: The rank of preferences must be recorded.   NOTE2: Different VEHICLE TYPEs may be given the same rank."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VehicleTypePreferenceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE TYPE PREFERENCE." ]
  ; ea:attribute [ ea:name "Rank" ; ea:position 2 ; ea:typeName "positiveInteger" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Ranking of VEHICLE TYPE PREFERENCE." ]
  .

tm:JOURNEY_PATTERN_LAYOVER a owl:Class ;
  rdfs:label "JOURNEY PATTERN LAYOVER"
  ; rdfs:comment "Time allowance at the end of each journey on a specified JOURNEY PATTERN, to allow for delays and for other purposes.   NOTE: This layover supersedes any global layover and can be superseded by a VEHICLE JOURNEY LAYOVER on a specific journey."
  ; skos:definition "Time allowance at the end of each journey on a specified JOURNEY PATTERN, to allow for delays and for other purposes.   NOTE: This layover supersedes any global layover and can be superseded by a VEHICLE JOURNEY LAYOVER on a specific journey."
  ; rdfs:subClassOf tm:JOURNEY_PATTERN_TIMING
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyPatternLayoverIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY PATTERN LAYOVER." ]
  .

tm:JOURNEY_PATTERN_HEADWAY a owl:Class ;
  rdfs:label "JOURNEY PATTERN HEADWAY"
  ; rdfs:comment "Time interval between vehicles at a certain TIMING POINT for VEHICLE JOURNEYs running on a certain JOURNEY PATTERN.  NOTE1: Can be superseded by the VEHICLE JOURNEY HEADWAY on a specific journey.  NOTE2: This information must be consistent with HEADWAY JOURNEY GROUP if available (HEADWAY JOURNEY GROUP being a more detailed way of describing headway services)."
  ; skos:definition "Time interval between vehicles at a certain TIMING POINT for VEHICLE JOURNEYs running on a certain JOURNEY PATTERN.  NOTE1: Can be superseded by the VEHICLE JOURNEY HEADWAY on a specific journey.  NOTE2: This information must be consistent with HEADWAY JOURNEY GROUP if available (HEADWAY JOURNEY GROUP being a more detailed way of describing headway services)."
  ; rdfs:subClassOf tm:JOURNEY_PATTERN_TIMING
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyPatternHeadwayIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY PATTERN HEADWAY." ]
  .

tm:JOURNEY_PATTERN_RUN_TIME a owl:Class ;
  rdfs:label "JOURNEY PATTERN RUN TIME"
  ; rdfs:comment "The time taken to traverse a TIMING LINK in a particular JOURNEY PATTERN, for a specified TIME DEMAND TYPE.  NOTE: Supersedes the DEFAULT SERVICE JOURNEY RUN TIME and DEFAULT DEAD RUN RUN TIME but can be superseded by a VEHICLE JOURNEY RUN TIME on a specific journey."
  ; skos:definition "The time taken to traverse a TIMING LINK in a particular JOURNEY PATTERN, for a specified TIME DEMAND TYPE.  NOTE: Supersedes the DEFAULT SERVICE JOURNEY RUN TIME and DEFAULT DEAD RUN RUN TIME but can be superseded by a VEHICLE JOURNEY RUN TIME on a specific journey."
  ; rdfs:subClassOf tm:JOURNEY_PATTERN_TIMING
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyPatternRunTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY PATTERN RUN TIME." ]
  .

tm:JOURNEY_PATTERN_WAIT_TIME a owl:Class ;
  rdfs:label "JOURNEY PATTERN WAIT TIME"
  ; rdfs:comment "The time a vehicle has to wait at a specific TIMING POINT IN JOURNEY PATTERN, for a specified TIME DEMAND TYPE.  NOTE: Can be superseded by a VEHICLE JOURNEY WAIT TIME on a specific journey."
  ; skos:definition "The time a vehicle has to wait at a specific TIMING POINT IN JOURNEY PATTERN, for a specified TIME DEMAND TYPE.  NOTE: Can be superseded by a VEHICLE JOURNEY WAIT TIME on a specific journey."
  ; rdfs:subClassOf tm:JOURNEY_PATTERN_TIMING
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyPatternWaitTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY PATTERN WAIT TIME." ]
  .

tm:VEHICLE_JOURNEY_LAYOVER a owl:Class ;
  rdfs:label "VEHICLE JOURNEY LAYOVER"
  ; rdfs:comment "A time allowance at the end of a specified VEHICLE JOURNEY.  NOTE: This time supersedes any global layover or JOURNEY PATTERN LAYOVER."
  ; skos:definition "A time allowance at the end of a specified VEHICLE JOURNEY.  NOTE: This time supersedes any global layover or JOURNEY PATTERN LAYOVER."
  ; rdfs:subClassOf tm:JOURNEY_LAYOVER
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VehicleJourneyLayoverIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE JOURNEY LAYOVER." ]
  .

tm:VEHICLE_JOURNEY_HEADWAY a owl:Class ;
  rdfs:label "VEHICLE JOURNEY HEADWAY"
  ; rdfs:comment "Time interval between vehicles at a certain TIMING POINT for a certain VEHICLE JOURNEY (to be understood as the duration between this and the previous VEHICLE JOURNEY).  NOTE1: Supersedes JOURNEY PATTERN HEADWAY.  NOTE2: This information must be consistent with HEADWAY JOURNEY GROUP if available (HEADWAY JOURNEY GROUP being a more detailed way of describing headway services)."
  ; skos:definition "Time interval between vehicles at a certain TIMING POINT for a certain VEHICLE JOURNEY (to be understood as the duration between this and the previous VEHICLE JOURNEY).  NOTE1: Supersedes JOURNEY PATTERN HEADWAY.  NOTE2: This information must be consistent with HEADWAY JOURNEY GROUP if available (HEADWAY JOURNEY GROUP being a more detailed way of describing headway services)."
  ; rdfs:subClassOf tm:JOURNEY_HEADWAY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VehicleJourneyHeadwayIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE JOURNEY HEADWAY." ]
  .

tm:VEHICLE_JOURNEY_WAIT_TIME a owl:Class ;
  rdfs:label "VEHICLE JOURNEY WAIT TIME"
  ; rdfs:comment "The time for a vehicle to wait at a particular TIMING POINT IN JOURNEY PATTERN on a specified VEHICLE JOURNEY.  NOTE: This wait time will override any applicable JOURNEY PATTERN WAIT TIME."
  ; skos:definition "The time for a vehicle to wait at a particular TIMING POINT IN JOURNEY PATTERN on a specified VEHICLE JOURNEY.  NOTE: This wait time will override any applicable JOURNEY PATTERN WAIT TIME."
  ; rdfs:subClassOf tm:JOURNEY_WAIT_TIME
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VehicleJourneyWaitTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE JOURNEY WAIT TIME." ]
  .

tm:RHYTHMICAL_JOURNEY_GROUP a owl:Class ;
  rdfs:label "RHYTHMICAL JOURNEY GROUP"
  ; rdfs:comment "A group of VEHICLE JOURNEYS following the same JOURNEY PATTERN having the same \"rhythm\" every hour (for example, runs at xxh10, xxh25 and xxh45, etc.) between a specified start and end time."
  ; skos:definition "A group of VEHICLE JOURNEYS following the same JOURNEY PATTERN having the same \"rhythm\" every hour (for example, runs at xxh10, xxh25 and xxh45, etc.) between a specified start and end time."
  ; rdfs:subClassOf tm:JOURNEY_FREQUENCY_GROUP
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "RhythmicalJourneyGroupIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of RHYTHMICAL JOURNEY GROUP." ]
  .

tm:HEADWAY_JOURNEY_GROUP a owl:Class ;
  rdfs:label "HEADWAY JOURNEY GROUP"
  ; rdfs:comment "A group of VEHICLE JOURNEYs following the same JOURNEY PATTERN having the same HEADWAY INTERVAL between a specified start and end time (for example, every 10 min).  NOTE: May be used to simplify the presentation of timetables."
  ; skos:definition "A group of VEHICLE JOURNEYs following the same JOURNEY PATTERN having the same HEADWAY INTERVAL between a specified start and end time (for example, every 10 min).  NOTE: May be used to simplify the presentation of timetables."
  ; rdfs:subClassOf tm:JOURNEY_FREQUENCY_GROUP
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "HeadwayJourneyGroupIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of HEADWAY JOURNEY GROUP." ]
  .

tm:HEADWAY_INTERVAL a owl:Class ;
  rdfs:label "HEADWAY INTERVAL"
  ; rdfs:comment "A time interval or a duration defining a headway period and characterising a HEADWAY JOURNEY GROUP (e.g., every 10 min, every 4-6 min)."
  ; skos:definition "A time interval or a duration defining a headway period and characterising a HEADWAY JOURNEY GROUP (e.g., every 10 min, every 4-6 min)."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "HeadwayIntervalIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of HEADWAY INTERVAL." ]
  ; ea:attribute [ ea:name "ScheduledHeadwayInterval" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Scheduled duration of HEADWAY INTERVAL." ]
  ; ea:attribute [ ea:name "MinimumHeadwayInterval" ; ea:position 3 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Minimum duration of HEADWAY INTERVAL." ]
  ; ea:attribute [ ea:name "MaximumHeadwayInterval" ; ea:position 4 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum duration of HEADWAY INTERVAL." ]
  .

tm:VEHICLE_JOURNEY_RUN_TIME a owl:Class ;
  rdfs:label "VEHICLE JOURNEY RUN TIME"
  ; rdfs:comment "The time taken to traverse a specified TIMING LINK IN JOURNEY PATTERN on a specified VEHICLE JOURNEY.  NOTE: This gives the most detailed control over times and supersedes the JOURNEY PATTERN RUN TIME, the DEFAULT SERVICE JOURNEY RUN TIME and the DEFAULT DEAD RUN RUN TIME."
  ; skos:definition "The time taken to traverse a specified TIMING LINK IN JOURNEY PATTERN on a specified VEHICLE JOURNEY.  NOTE: This gives the most detailed control over times and supersedes the JOURNEY PATTERN RUN TIME, the DEFAULT SERVICE JOURNEY RUN TIME and the DEFAULT DEAD RUN RUN TIME."
  ; rdfs:subClassOf tm:JOURNEY_RUN_TIME
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VehicleJourneyRunTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE JOURNEY RUN TIME." ]
  .

tm:JOURNEY_FREQUENCY_GROUP a owl:Class ;
  rdfs:label "JOURNEY FREQUENCY GROUP"
  ; rdfs:comment "A group of JOURNEYs defined in order to describe special behaviour like frequency-based services or rhythmical services (for example, runs at xxh10, xxh25 and xxh45); this is especially useful for passenger information)."
  ; skos:definition "A group of JOURNEYs defined in order to describe special behaviour like frequency-based services or rhythmical services (for example, runs at xxh10, xxh25 and xxh45); this is especially useful for passenger information)."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FrequencyGroupIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FREQUENCY GROUP." ]
  ; ea:attribute [ ea:name "FirstDepartureTime" ; ea:position 2 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time of first departure in group." ]
  ; ea:attribute [ ea:name "LastDepartureTime" ; ea:position 3 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time of last departure in group." ]
  ; ea:attribute [ ea:name "DayOffset" ; ea:position 4 ; ea:typeName "DayOffsetType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Offset of end time day from start time." ]
  .

tm:DEFAULT_INTERCHANGE a owl:Class ;
  rdfs:label "DEFAULT INTERCHANGE"
  ; rdfs:comment "A quality parameter fixing the acceptable duration (standard and maximum) for an INTERCHANGE to be planned between two SCHEDULED STOP POINTs.  NOTE: This parameter will be used to control whether any two VEHICLE JOURNEYs serving those points may be in connection."
  ; skos:definition "A quality parameter fixing the acceptable duration (standard and maximum) for an INTERCHANGE to be planned between two SCHEDULED STOP POINTs.  NOTE: This parameter will be used to control whether any two VEHICLE JOURNEYs serving those points may be in connection."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DefaultInterchangeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DEFAULT INTERCHANGE." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 2 ; ea:typeName "MultlingualString" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Description of JOURNEY MEETING." ]
  ; ea:attribute [ ea:name "MaximumDuration" ; ea:position 3 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum wait time for DEFAULT INTERCHANGE." ]
  ; ea:attribute [ ea:name "StandardDuration" ; ea:position 4 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Standard wait time for DEFAULT INTERCHANGE." ]
  .

tm:SERVICE_JOURNEY_INTERCHANGE a owl:Class ;
  rdfs:label "SERVICE JOURNEY INTERCHANGE"
  ; rdfs:comment "The scheduled possibility for transfer of passengers between two SERVICE JOURNEYs at the same or different SCHEDULED STOP POINTs."
  ; skos:definition "The scheduled possibility for transfer of passengers between two SERVICE JOURNEYs at the same or different SCHEDULED STOP POINTs."
  ; rdfs:subClassOf tm:INTERCHANGE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ServiceJourneyInterchangeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SERVICE JOURNEY INTERCHANGE." ]
  ; ea:attribute [ ea:name "FromVisitNumber" ; ea:position 2 ; ea:typeName "integer" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Visit number of feeder journey (only needed if multiple visits)." ]
  ; ea:attribute [ ea:name "ToVisitNumber" ; ea:position 3 ; ea:typeName "integer" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Visit number of distributor journey (only needed if multiple visits)." ]
  .

tm:SERVICE_JOURNEY_PATTERN_INTERCHANGE a owl:Class ;
  rdfs:label "SERVICE JOURNEY PATTERN INTERCHANGE"
  ; rdfs:comment "A recognised/organised possibility for passengers to change public transport vehicles using two SCHEDULED STOP POINTs (which may be identical) on two particular SERVICE JOURNEY PATTERNs, including the maximum wait duration allowed and the standard duration to be aimed at.  NOTE1: Any specified durations override the DEFAULT INTERCHANGE durations.  NOTE2: Schedulers may use this entity for synchronisation of journeys."
  ; skos:definition "A recognised/organised possibility for passengers to change public transport vehicles using two SCHEDULED STOP POINTs (which may be identical) on two particular SERVICE JOURNEY PATTERNs, including the maximum wait duration allowed and the standard duration to be aimed at.  NOTE1: Any specified durations override the DEFAULT INTERCHANGE durations.  NOTE2: Schedulers may use this entity for synchronisation of journeys."
  ; rdfs:subClassOf tm:INTERCHANGE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ServiceJourneyPatternInterchangeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SERVICE JOURNEY PATTERN INTERCHANGE." ]
  .

tm:JOURNEY_MEETING a owl:Class ;
  rdfs:label "JOURNEY MEETING"
  ; rdfs:comment "A time constraint for one or several SERVICE JOURNEYs fixing interchanges between them and/or an external event (e.g., arrival or departure of a feeder line, opening time of the theatre, etc.)."
  ; skos:definition "A time constraint for one or several SERVICE JOURNEYs fixing interchanges between them and/or an external event (e.g., arrival or departure of a feeder line, opening time of the theatre, etc.)."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyMeetingIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY MEETING." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 2 ; ea:typeName "MultlingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of JOURNEY MEETING." ]
  ; ea:attribute [ ea:name "EarliestTime" ; ea:position 3 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Earliest time at which JOURNEY MEETING can take place." ]
  ; ea:attribute [ ea:name "LatestTime" ; ea:position 4 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Latest time at which JOURNEY MEETING can take place." ]
  ; ea:attribute [ ea:name "Reason" ; ea:position 5 ; ea:typeName "ReasonForMeetingEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Reason for JOURNEY MEETING." ]
  .

tm:INTERCHANGE a owl:Class ;
  rdfs:label "INTERCHANGE"
  ; rdfs:comment "The scheduled possibility for transfer of passengers at the same or different SCHEDULED STOP POINTs."
  ; skos:definition "The scheduled possibility for transfer of passengers at the same or different SCHEDULED STOP POINTs."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "InterchangeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of INTERCHANGE." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultlingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of INTERCHANGE." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultlingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of INTERCHANGE." ]
  ; ea:attribute [ ea:name "Priority" ; ea:position 4 ; ea:typeName "InterchangePriorityType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Priority assigned to INTERCHANGE." ]
  ; ea:attribute [ ea:name "StaySeated" ; ea:position 5 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether passengers can stay seated to make INTERCHANGE." ]
  ; ea:attribute [ ea:name "CrossBorder" ; ea:position 6 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether INTERCHANGE involves crossing a national border." ]
  ; ea:attribute [ ea:name "Planned" ; ea:position 7 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether INTERCHANGE is planned." ]
  ; ea:attribute [ ea:name "Guaranteed" ; ea:position 8 ; ea:typeName "ConnectionCertaintyEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether INTERCHANGE is guaranteed, that is distributor services may be held in order to ensure the connection." ]
  ; ea:attribute [ ea:name "Advertised" ; ea:position 9 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether INTERCHANGE is advertised as guaranteed." ]
  ; ea:attribute [ ea:name "Controlled" ; ea:position 10 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether INTERCHANGE is controlled" ]
  ; ea:attribute [ ea:name "DistributorMaxWaitDuration" ; ea:position 11 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum wait time a vehicle may wait for a connecting vehicle beyond the planned departure time." ]
  ; ea:attribute [ ea:name "TransferModes" ; ea:position 12 ; ea:typeName "AccessModeEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Modes by which transfer at the interchange can be made." ]
  .

tm:INTERCHANGE_RULE a owl:Class ;
  rdfs:label "INTERCHANGE RULE"
  ; rdfs:comment "Conditions governing the possibility of interchanging between two SERVICE JOURNEYs, stopping at the same or different SCHEDULED STOP POINTs, where at least one of the two SERVICE JOURNEYs is indicated indirectly by a DIRECTION, LINE or VEHICLE JOURNEY."
  ; skos:definition "Conditions governing the possibility of interchanging between two SERVICE JOURNEYs, stopping at the same or different SCHEDULED STOP POINTs, where at least one of the two SERVICE JOURNEYs is indicated indirectly by a DIRECTION, LINE or VEHICLE JOURNEY."
  ; rdfs:subClassOf tm:INTERCHANGE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "InterchangeRuleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of INTERCHANGE RULE." ]
  ; ea:attribute [ ea:name "MaximumWindow" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Window for maximum allowed duration between expected arrival time of feeder VEHICLE JOURNEY and planned departure time of distributor VEHICLE JOURNEY." ]
  ; ea:attribute [ ea:name "Exclude" ; ea:position 3 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether rule is to exclude interchanges of journeys that match the filter criteria." ]
  ; ea:attribute [ ea:name "Priority" ; ea:position 4 ; ea:typeName "integer" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Relative priority of rule compared to other rules." ]
  .

tm:INTERCHANGE_RULE_TIMING a owl:Class ;
  rdfs:label "INTERCHANGE RULE TIMING"
  ; rdfs:comment "Timings for an INTERCHANGE RULE for a given TIME DEMAND TYPE or TIME BAND."
  ; skos:definition "Timings for an INTERCHANGE RULE for a given TIME DEMAND TYPE or TIME BAND."
  ; rdfs:subClassOf tm:JOURNEY_TIMING
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "InterchangeRuleTimingIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of INTERCHANGE RULE TIMING." ]
  .

tm:INTERCHANGE_RULE_PARAMETER a owl:Class ;
  rdfs:label "INTERCHANGE RULE PARAMETER"
  ; rdfs:comment "Assignment of parameters characterising an INTERCHANGE RULE."
  ; skos:definition "Assignment of parameters characterising an INTERCHANGE RULE."
  ; rdfs:subClassOf tm:ASSIGNMENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "InterchangeRuleParameterIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of INTERCHANGE RULE PARAMETER." ]
  ; ea:attribute [ ea:name "MaximumInterchangeWindow" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum interval for making interchange." ]
  .

tm:PURPOSE_OF_JOURNEY_PARTITION a owl:Class ;
  rdfs:label "PURPOSE OF JOURNEY PARTITION"
  ; rdfs:comment "An operational purpose changing within a JOURNEY PATTERN and with this subdividing the SERVICE JOURNEY into JOURNEY PARTs."
  ; skos:definition "An operational purpose changing within a JOURNEY PATTERN and with this subdividing the SERVICE JOURNEY into JOURNEY PARTs."
  ; rdfs:subClassOf tm:TYPE_OF_VALUE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PurposeOfJourneyPartitionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PURPOSE OF JOURNEY PARTITION." ]
  .

tm:COUPLED_JOURNEY a owl:Class ;
  rdfs:label "COUPLED JOURNEY"
  ; rdfs:comment "A journey where two or more VEHICLE JOURNEYs originally planned as separately timed journeys, are combined throughout their complete VEHICLE JOURNEYs, running instead as a single timed VEHICLE JOURNEY."
  ; skos:definition "A journey where two or more VEHICLE JOURNEYs originally planned as separately timed journeys, are combined throughout their complete VEHICLE JOURNEYs, running instead as a single timed VEHICLE JOURNEY."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "CoupledJourneyIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of COUPLED JOURNEY." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of a COUPLED JOURNEY." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 3 ; ea:typeName "MultilingualSrring" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of COUPLED JOURNEY." ]
  .

tm:TYPE_OF_COUPLING a owl:Class ;
  rdfs:label "TYPE OF COUPLING"
  ; rdfs:comment "A classification for the functional reason for coupling of JOURNEY PARTs and BLOCK PARTs."
  ; skos:definition "A classification for the functional reason for coupling of JOURNEY PARTs and BLOCK PARTs."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfCouplingIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF COUPLING." ]
  .

tm:JOURNEY_PART a owl:Class ;
  rdfs:label "JOURNEY PART"
  ; rdfs:comment "A part of a VEHICLE JOURNEY created according to a specific functional purpose, for instance in situations when vehicle coupling or separating occurs."
  ; skos:definition "A part of a VEHICLE JOURNEY created according to a specific functional purpose, for instance in situations when vehicle coupling or separating occurs."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyPartIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY PART." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of a JOURNEY PART." ]
  ; ea:attribute [ ea:name "OperationalOrientation" ; ea:position 3 ; ea:typeName "VehicleOrientationEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether TRAIN is operating forwards or backwards for the JOURNEY PART.  NOTE: May also apply to certain VEHICLEs, e.g., a chain ferry." ]
  ; ea:attribute [ ea:name "StartTime" ; ea:position 4 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Start time of a JOURNEY PART." ]
  ; ea:attribute [ ea:name "EndTime" ; ea:position 5 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "End time of a JOURNEY PART." ]
  ; ea:attribute [ ea:name "VehicleOrientation" ; ea:position 6 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether ROLLING STOCK ITEM is operating forward or backwards for the JOURNEY PART." ]
  .

tm:JOURNEY_PART_COUPLE a owl:Class ;
  rdfs:label "JOURNEY PART COUPLE"
  ; rdfs:comment "Two or more JOURNEY PARTs of different VEHICLE JOURNEYs served simultaneously by a COMPOUND TRAIN.  NOTE: For trains, planned to run using a single train path (i.e., the infrastructure capacity needed to run a train between two places over a given time-period)"
  ; skos:definition "Two or more JOURNEY PARTs of different VEHICLE JOURNEYs served simultaneously by a COMPOUND TRAIN.  NOTE: For trains, planned to run using a single train path (i.e., the infrastructure capacity needed to run a train between two places over a given time-period)"
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Iid" ; ea:position 1 ; ea:typeName "JourneyPartCoupleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY PART COUPLE." ]
  ; ea:attribute [ ea:name "Order" ; ea:position 2 ; ea:typeName "positiveInteger" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Order of JOURNEY PART COUPLE within JOURNEY." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of JOURNEY PART COUPLE." ]
  .

tm:TYPE_OF_FLEXIBLE_SERVICE a owl:Class ;
  rdfs:label "TYPE OF FLEXIBLE SERVICE"
  ; rdfs:comment "A characterisation denoting the type of flexibility, e.g., if it is a virtual line service, flexible service with main route, corridor service, fixed stop area-wide flexible service, free area-wide flexible service or a mixed types of flexible service types."
  ; skos:definition "A characterisation denoting the type of flexibility, e.g., if it is a virtual line service, flexible service with main route, corridor service, fixed stop area-wide flexible service, free area-wide flexible service or a mixed types of flexible service types."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfFlexibleServiceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF FLEXIBLE SERVICE." ]
  .

tm:FLEXIBLE_SERVICE_PROPERTIES a owl:Class ;
  rdfs:label "FLEXIBLE SERVICE PROPERTIES"
  ; rdfs:comment "Flexibility characteristics of a SERVICE JOURNEY, e.g., cancelled unless ordered and/or timing may be adjusted at time of booking or even later for service optimisation purposes."
  ; skos:definition "Flexibility characteristics of a SERVICE JOURNEY, e.g., cancelled unless ordered and/or timing may be adjusted at time of booking or even later for service optimisation purposes."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FlexibleServicPropertiesIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FLEXIBLE SERVICE PROPERTIES." ]
  ; ea:attribute [ ea:name "CancellationPossible" ; ea:position 2 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether cancellation is always possible (meaning the Operator can decided to cancel a journey, usually because there are not enough passenger, or they are too busy to run the service.)" ]
  ; ea:attribute [ ea:name "ChangeOfTimePossible" ; ea:position 3 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether time of service may be moved (usually a passing time update to optimise the service if there are not enough passenger, or they are too busy to run the service.)" ]
  .

tm:JOURNEY_TIMING a owl:Class ;
  rdfs:label "JOURNEY TIMING"
  ; rdfs:comment "Time-related information referring to journey timing whose value depends on the time of use and so can be associated with a TIME DEMAND TYPE, TIME BAND or OPERATIONAL CONTEXT."
  ; skos:definition "Time-related information referring to journey timing whose value depends on the time of use and so can be associated with a TIME DEMAND TYPE, TIME BAND or OPERATIONAL CONTEXT."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyTimingIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY TIMING." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of JOURNEY TIMING." ]
  .

tm:JOURNEY_RUN_TIME a owl:Class ;
  rdfs:label "JOURNEY RUN TIME"
  ; rdfs:comment "The time taken to traverse a TIMING LINK on a specific VEHICLE JOURNEY or on VEHICLE JOURNEYs made using a specific JOURNEY PATTERN for a specified TIME DEMAND TYPE."
  ; skos:definition "The time taken to traverse a TIMING LINK on a specific VEHICLE JOURNEY or on VEHICLE JOURNEYs made using a specific JOURNEY PATTERN for a specified TIME DEMAND TYPE."
  ; rdfs:subClassOf tm:JOURNEY_TIMING
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyRunTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY RUN TIME." ]
  ; ea:attribute [ ea:name "RunTime" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Run duration of JOURNEY RUN TIME." ]
  .

tm:JOURNEY_WAIT_TIME a owl:Class ;
  rdfs:label "JOURNEY WAIT TIME"
  ; rdfs:comment "The time a vehicle has to wait at a specific TIMING POINT IN JOURNEY PATTERN, for a specified TIME DEMAND TYPE.  NOTE: This wait time can be superseded by a VEHICLE JOURNEY WAIT TIME."
  ; skos:definition "The time a vehicle has to wait at a specific TIMING POINT IN JOURNEY PATTERN, for a specified TIME DEMAND TYPE.  NOTE: This wait time can be superseded by a VEHICLE JOURNEY WAIT TIME."
  ; rdfs:subClassOf tm:JOURNEY_TIMING
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyWaitTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY WAIT TIME." ]
  ; ea:attribute [ ea:name "WaitTime" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Wait duration of JOURNEY WAIT TIME." ]
  .

tm:JOURNEY_LAYOVER a owl:Class ;
  rdfs:label "JOURNEY LAYOVER"
  ; rdfs:comment "Time allowance at the end of each journey to allow for delays and for other purposes."
  ; skos:definition "Time allowance at the end of each journey to allow for delays and for other purposes."
  ; rdfs:subClassOf tm:JOURNEY_TIMING
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyLayoverIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY LAYOVER." ]
  ; ea:attribute [ ea:name "Layover" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time spent at JOURNEY LAYOVER." ]
  .

tm:JOURNEY_HEADWAY a owl:Class ;
  rdfs:label "JOURNEY HEADWAY"
  ; rdfs:comment "Time interval between vehicles at a certain TIMING POINT.  NOTE: This information must be consistent with HEADWAY JOURNEY GROUP if available (HEADWAY JOURNEY GROUP being a more detailed way of describing headway services)."
  ; skos:definition "Time interval between vehicles at a certain TIMING POINT.  NOTE: This information must be consistent with HEADWAY JOURNEY GROUP if available (HEADWAY JOURNEY GROUP being a more detailed way of describing headway services)."
  ; rdfs:subClassOf tm:JOURNEY_TIMING
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyHeadwayIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY HEADWAY." ]
  .

tm:JOURNEY_ACCOUNTING a owl:Class ;
  rdfs:label "JOURNEY ACCOUNTING"
  ; rdfs:comment "Parameters characterising VEHICLE JOURNEYs or SPECIAL SERVICEs used for accounting purposes in particular in contracts between ORGANISATIONs."
  ; skos:definition "Parameters characterising VEHICLE JOURNEYs or SPECIAL SERVICEs used for accounting purposes in particular in contracts between ORGANISATIONs."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyAccountingIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY ACCOUNTING." ]
  ; ea:attribute [ ea:name "Distance" ; ea:position 2 ; ea:typeName "DistanceType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Distance to use in JOURNEY ACCOUNTING." ]
  ; ea:attribute [ ea:name "Duration" ; ea:position 3 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Duration to use for JOURNEY ACCOUNTING." ]
  ; ea:attribute [ ea:name "Partial" ; ea:position 4 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether all or some of journey is subject to ACCOUNTING." ]
  ; ea:attribute [ ea:name "AccountingType" ; ea:position 5 ; ea:typeName "JourneyAccountingEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Nature of JOURNEY ACCOUNTING." ]
  .

tm:NORMAL_DATED_VEHICLE_JOURNEY a owl:Class ;
  rdfs:label "NORMAL DATED VEHICLE JOURNEY"
  ; rdfs:comment "A DATED VEHICLE JOURNEY identical to a long-term planned VEHICLE JOURNEY, possibly updated according to short-term modifications of the PRODUCTION PLAN decided by the control staff."
  ; skos:definition "A DATED VEHICLE JOURNEY identical to a long-term planned VEHICLE JOURNEY, possibly updated according to short-term modifications of the PRODUCTION PLAN decided by the control staff."
  ; rdfs:subClassOf tm:DATED_VEHICLE_JOURNEY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "NormalDatedVehicleJourneyIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of NORMAL DATED VEHICLE JOURNEY." ]
  .

tm:DATED_VEHICLE_JOURNEY a owl:Class ;
  rdfs:label "DATED VEHICLE JOURNEY"
  ; rdfs:comment "A particular journey of a vehicle on a particular OPERATING DAY including all modifications possibly decided by the control staff."
  ; skos:definition "A particular journey of a vehicle on a particular OPERATING DAY including all modifications possibly decided by the control staff."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DatedVehicleJourneyIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DATED VEHICLE JOURNEY." ]
  ; ea:attribute [ ea:name "ValidityStatus" ; ea:position 2 ; ea:typeName "ServiceAlterationEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Service alteration type for NORMAL JOURNEY." ]
  .

tm:PASSING_TIME a owl:Class ;
  rdfs:label "PASSING TIME"
  ; rdfs:comment "Time data concerning public transport vehicles passing a particular POINT; e.g., arrival time, departure time, waiting time."
  ; skos:definition "Time data concerning public transport vehicles passing a particular POINT; e.g., arrival time, departure time, waiting time."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PassingTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PASSING TIME." ]
  ; ea:attribute [ ea:name "AlightAndReboard" ; ea:position 2 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether passengers can alight and re board at POINT IN PATTERN.." ]
  ; ea:attribute [ ea:name "ArrivalDayOffset" ; ea:position 3 ; ea:typeName "DayOffsetType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Day offset of arrival time from day of start of journey." ]
  ; ea:attribute [ ea:name "DepartureDayOffset" ; ea:position 4 ; ea:typeName "DayOffsetType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Day offset of departure time from day of start of journey." ]
  .

tm:TARGET_PASSING_TIME a owl:Class ;
  rdfs:label "TARGET PASSING TIME"
  ; rdfs:comment "Time data about when a public transport vehicle should pass a particular POINT IN JOURNEY PATTERN on a particular DATED VEHICLE JOURNEY, in order to match the latest valid plan."
  ; skos:definition "Time data about when a public transport vehicle should pass a particular POINT IN JOURNEY PATTERN on a particular DATED VEHICLE JOURNEY, in order to match the latest valid plan."
  ; rdfs:subClassOf tm:DATED_PASSING_TIME
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TargetPassingTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TARGET PASSING TIME." ]
  ; ea:attribute [ ea:name "AimedArrivalTime" ; ea:position 2 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Intended Arrival time at POINT IN JOURNEY PATTERN" ]
  ; ea:attribute [ ea:name "AimedDepartureTime" ; ea:position 3 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Intended Departure time at POINT IN JOURNEY PATTERN" ]
  ; ea:attribute [ ea:name "AimedNonstopPassingTime" ; ea:position 4 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Intended Passing time at POINT IN JOURNEY PATTERN if vehicle does not stop." ]
  ; ea:attribute [ ea:name "AimedWaitingTime" ; ea:position 5 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Aimed waiting time at POINT IN JOURNEY PATTERN." ]
  .

tm:DATED_PASSING_TIME a owl:Class ;
  rdfs:label "DATED PASSING TIME"
  ; rdfs:comment "A PASSING TIME on a particular OPERATING DAY."
  ; skos:definition "A PASSING TIME on a particular OPERATING DAY."
  ; rdfs:subClassOf tm:PASSING_TIME
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DatedPassingTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DATED PASSING TIME." ]
  .

tm:TIMETABLED_PASSING_TIME a owl:Class ;
  rdfs:label "TIMETABLED PASSING TIME"
  ; rdfs:comment "Long-term planned time data concerning public transport vehicles passing a particular POINT IN JOURNEY PATTERN on a specified VEHICLE JOURNEY for a certain DAY TYPE."
  ; skos:definition "Long-term planned time data concerning public transport vehicles passing a particular POINT IN JOURNEY PATTERN on a specified VEHICLE JOURNEY for a certain DAY TYPE."
  ; rdfs:subClassOf tm:PASSING_TIME
