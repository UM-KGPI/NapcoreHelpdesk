  .

tm:VEHICLE_STOPPING_PLACE a owl:Class ;
  rdfs:label "VEHICLE STOPPING PLACE"
  ; rdfs:comment "A place on the vehicle track where vehicles stop in order for passengers to board or alight from a vehicle.  NOTE1: A vehicle track is located on the respective INFRASTRUCTURE LINK for the MODE (RAILWAY ELEMENT of rail network, ROAD ELEMENT of road network, etc.).  NOTE2: A VEHICLE STOPPING PLACE may be served by one or more QUAYs."
  ; skos:definition "A place on the vehicle track where vehicles stop in order for passengers to board or alight from a vehicle.  NOTE1: A vehicle track is located on the respective INFRASTRUCTURE LINK for the MODE (RAILWAY ELEMENT of rail network, ROAD ELEMENT of road network, etc.).  NOTE2: A VEHICLE STOPPING PLACE may be served by one or more QUAYs."
  ; rdfs:subClassOf tm:STOP_PLACE_COMPONENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VehicleStoppingPlaceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE STOPPING PLACE." ]
  .

tm:VEHICLE_POSITION_ALIGNMENT a owl:Class ;
  rdfs:label "VEHICLE POSITION ALIGNMENT"
  ; rdfs:comment "The alignment of a particular BOARDING POSITION with the entrance of a VEHICLE as the result of positioning the VEHICLE at a particular VEHICLE STOPPING PLACE."
  ; skos:definition "The alignment of a particular BOARDING POSITION with the entrance of a VEHICLE as the result of positioning the VEHICLE at a particular VEHICLE STOPPING PLACE."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PositionAlignmentIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE POSITION ALIGNMENT." ]
  .

tm:VEHICLE_STOPPING_POSITION a owl:Class ;
  rdfs:label "VEHICLE STOPPING POSITION"
  ; rdfs:comment "The stopping position of a vehicle or one of its components as a Location.  NOTE1: May be specified as a ZONE corresponding to the bounding polygon of the vehicle, or one or more POINTs corresponding to parts of the vehicle such as a door.  NOTE2: If given as a single point, indicates the position for the door relative to an indicated side of the vehicle."
  ; skos:definition "The stopping position of a vehicle or one of its components as a Location.  NOTE1: May be specified as a ZONE corresponding to the bounding polygon of the vehicle, or one or more POINTs corresponding to parts of the vehicle such as a door.  NOTE2: If given as a single point, indicates the position for the door relative to an indicated side of the vehicle."
  ; rdfs:subClassOf tm:STOP_PLACE_COMPONENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VehicleStoppingPositionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE STOPPING POSITION." ]
  ; ea:attribute [ ea:name "Bearing" ; ea:position 2 ; ea:typeName "degrees" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Bearing of Position relative to North." ]
  .

tm:TYPE_OF_RELATION_TO_VEHICLE a owl:Class ;
  rdfs:label "TYPE OF RELATION TO VEHICLE"
  ; rdfs:comment "A classification of the way a VEHICLE STOPPING POSITION is used (e.g., front left, front right, back left, back right, driver left, driver right)."
  ; skos:definition "A classification of the way a VEHICLE STOPPING POSITION is used (e.g., front left, front right, back left, back right, driver left, driver right)."
  ; rdfs:subClassOf tm:TYPE_OF_VALUE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfRelationToVehicleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF RELATION TO VEHICLE." ]
  .

tm:TYPE_OF_JOURNEY_PATTERN a owl:Class ;
  rdfs:label "TYPE OF JOURNEY PATTERN"
  ; rdfs:comment "A classification of JOURNEY PATTERNs used to distinguish categories of JOURNEY PATTERN other than SERVICE JOURNEY PATTERN and DEAD RUN PATTERN."
  ; skos:definition "A classification of JOURNEY PATTERNs used to distinguish categories of JOURNEY PATTERN other than SERVICE JOURNEY PATTERN and DEAD RUN PATTERN."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
