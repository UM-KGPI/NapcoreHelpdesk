  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SpecialServiceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SPECIAL SERVICE." ]
