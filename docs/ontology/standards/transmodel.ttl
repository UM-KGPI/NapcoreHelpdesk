  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FlexibleStopPlaceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a FLEXIBLE STOP PLACE." ]
  ; ea:attribute [ ea:name "NameSuffix" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Suffix to use on name." ]
