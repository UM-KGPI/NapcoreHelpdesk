  ; ea:attribute [ ea:name "Description" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of DAY TYPE ASSIGNMENT." ]
