  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "TimetabledPassingTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TIMETABLE PASSING TIME." ]
  ; ea:attribute [ ea:name "DepartureTime" ; ea:position 3 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Departure time at POINT IN JOURNEY PATTERN." ]
  ; ea:attribute [ ea:name "WaitingTime" ; ea:position 4 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Waiting time at POINT IN JOURNEY PATTERN." ]
  ; ea:attribute [ ea:name "EarliestDepartureTime" ; ea:position 5 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Earliest Departure time at POINT IN JOURNEY PATTERN." ]
  ; ea:attribute [ ea:name "LatestArrivalTime" ; ea:position 6 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Latest Arrival time at POINT IN JOURNEY PATTERN." ]
  .

tm:BLOCK_PART a owl:Class ;
  rdfs:label "BLOCK PART"
  ; rdfs:comment "Part of a BLOCK corresponding to a specific JOURNEY PART of one of the VEHICLE JOURNEYs in a BLOCK."
  ; skos:definition "Part of a BLOCK corresponding to a specific JOURNEY PART of one of the VEHICLE JOURNEYs in a BLOCK."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Order" ; ea:position 1 ; ea:typeName "integer" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Order of BLOCK PART within BLOCK" ]
