  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "GenericPathLinkIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a GENERIC PATH LINK." ]
