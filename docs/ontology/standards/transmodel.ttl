  .

tm:GROUP_OF_SERVICES a owl:Class ;
  rdfs:label "GROUP OF SERVICES"
  ; rdfs:comment "A group of JOURNEYs, often known to its users by a name or a number."
  ; skos:definition "A group of JOURNEYs, often known to its users by a name or a number."
  ; rdfs:subClassOf tm:GROUP_OF_ENTITIES
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "GroupOfServicesIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of GROUP OF SERVICEs." ]
  .

tm:SERVICE_JOURNEY a owl:Class ;
  rdfs:label "SERVICE JOURNEY"
  ; rdfs:comment "A passenger carrying VEHICLE JOURNEY for one specified DAY TYPE.  NOTE: The pattern of working is in principle defined by a SERVICE JOURNEY PATTERN."
  ; skos:definition "A passenger carrying VEHICLE JOURNEY for one specified DAY TYPE.  NOTE: The pattern of working is in principle defined by a SERVICE JOURNEY PATTERN."
