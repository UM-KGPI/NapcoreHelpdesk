  .

tm:ROW_DRIVER a owl:Class ;
  rdfs:label "ROW/DRIVER"
  ; rdfs:comment "A row in a ROSTER MATRIX which is related to a theoretically available driver."
  ; skos:definition "A row in a ROSTER MATRIX which is related to a theoretically available driver."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "RowDriverIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ROW/DRIVER." ]
  .

tm:ROSTER_MATRIX a owl:Class ;
  rdfs:label "ROSTER MATRIX"
  ; rdfs:comment "A table showing the duty plan for a period of days and for a number of theoretically available drivers."
  ; skos:definition "A table showing the duty plan for a period of days and for a number of theoretically available drivers."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "RosterMatrixIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ROSTER MATRIX." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of ROSTER MATRIX." ]
  .

tm:ROSTER_ELEMENT a owl:Class ;
  rdfs:label "ROSTER ELEMENT"
  ; rdfs:comment "A cell in a ROSTER MATRIX where the individual DUTY to be performed by a theoretically available driver on a certain OPERATING DAY is entered or it is marked that it is a day of rest."
  ; skos:definition "A cell in a ROSTER MATRIX where the individual DUTY to be performed by a theoretically available driver on a certain OPERATING DAY is entered or it is marked that it is a day of rest."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "RosterElementIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ROSTER ELEMENT." ]
  .

tm:REST a owl:Class ;
  rdfs:label "REST"
  ; rdfs:comment "A representation of a day off for a driver, crew member or other EMPLOYEE."
  ; skos:definition "A representation of a day off for a driver, crew member or other EMPLOYEE."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "RestIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of REST." ]
  .

tm:COLUMN_DAY a owl:Class ;
  rdfs:label "COLUMN/DAY"
  ; rdfs:comment "A column in a ROSTER MATRIX which is related to an OPERATING DAY."
  ; skos:definition "A column in a ROSTER MATRIX which is related to an OPERATING DAY."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ColumnDayIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of COLUMN/DAY." ]
  .

tm:WORK a owl:Class ;
  rdfs:label "WORK"
  ; rdfs:comment "A WORK is a representation of a day on duty for a driver."
  ; skos:definition "A WORK is a representation of a day on duty for a driver."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "WorkIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of WORK." ]
  .

tm:ROSTER_CYCLE_ELEMENT a owl:Class ;
  rdfs:label "ROSTER CYCLE ELEMENT"
  ; rdfs:comment "A ROSTER CYCLE ELEMENT is an element of a ROSTER CYCLE which represents a day of work or rest for a theoretically available driver in the ordered sequence of days for that cycle."
  ; skos:definition "A ROSTER CYCLE ELEMENT is an element of a ROSTER CYCLE which represents a day of work or rest for a theoretically available driver in the ordered sequence of days for that cycle."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Order" ; ea:position 1 ; ea:typeName "positiveInteger" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Position of ROSTER CYCLE ELEMENT in the ROSTER CYCLE." ]
