  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ResponsibilityRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of RESPONSIBILITY ROLE." ]
  .

