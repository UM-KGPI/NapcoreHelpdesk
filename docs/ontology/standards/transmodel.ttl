  .

tm:SIMPLE_FEATURE a owl:Class ;
  rdfs:label "SIMPLE FEATURE"
  ; rdfs:comment "An abstract representation of elementary objects related to the spatial representation of the network; POINTs (0-dimensional objects), LINKs (1-dimensional objects) and ZONEs (2-dimensional objects) may be viewed as SIMPLE FEATUREs."
  ; skos:definition "An abstract representation of elementary objects related to the spatial representation of the network; POINTs (0-dimensional objects), LINKs (1-dimensional objects) and ZONEs (2-dimensional objects) may be viewed as SIMPLE FEATUREs."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SimpleFeatureIdTyoe" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SIMPLE FEATURE." ]
  .

tm:COMPLEX_FEATURE a owl:Class ;
  rdfs:label "COMPLEX FEATURE"
  ; rdfs:comment "An aggregate of SIMPLE FEATUREs and/or other COMPLEX FEATUREs."
  ; skos:definition "An aggregate of SIMPLE FEATUREs and/or other COMPLEX FEATUREs."
