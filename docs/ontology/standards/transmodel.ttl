  ; ea:kind "class"
  ; ea:attribute [ ea:name "Order" ; ea:position 1 ; ea:typeName "positiveInteger" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Order of ABSENCE during OPERATING DAY." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "AbsenceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ABSENCE." ]
  ; ea:attribute [ ea:name "StartTime" ; ea:position 3 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Start time of ABSENCE." ]
  ; ea:attribute [ ea:name "EndTime" ; ea:position 4 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "End time of ABSENCE." ]
  .

tm:ACCOUNTING_PERIOD a owl:Class ;
  rdfs:label "ACCOUNTING PERIOD"
  ; rdfs:comment "An ACCOUNTING PERIOD is a continuous interval between two OPERATING DAYs which will be used for accounting purposes."
  ; skos:definition "An ACCOUNTING PERIOD is a continuous interval between two OPERATING DAYs which will be used for accounting purposes."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Name" ; ea:position 1 ; ea:typeName "MultilingualString" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Name of ACCOUNTING PERIOD." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "AccountingPeriodIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACCOUNTING PERIOD." ]
  .

tm:WAGE_INCREASE a owl:Class ;
  rdfs:label "WAGE INCREASE"
  ; rdfs:comment "a WAGE INCREASE is an indication to the accountancy software that the performed work was affected by aggravating circumstances to such a degree that additional payment should be allotted."
  ; skos:definition "a WAGE INCREASE is an indication to the accountancy software that the performed work was affected by aggravating circumstances to such a degree that additional payment should be allotted."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Description" ; ea:position 1 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of WAGE INCREASE." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "WageIncreaseIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of WAGE INCREASE." ]
  .

tm:COST_CENTRE a owl:Class ;
  rdfs:label "COST CENTRE"
  ; rdfs:comment "A COST CENTRE is a business unit, or other type of classification used by an ORGANISATIONS's accountancy department, to which costs can be collected or attributed according to cost type and origin."
  ; skos:definition "A COST CENTRE is a business unit, or other type of classification used by an ORGANISATIONS's accountancy department, to which costs can be collected or attributed according to cost type and origin."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Description" ; ea:position 1 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of COST CENTRE." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "CostCentreIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of COST CENTRE." ]
  .

tm:ACCOUNT_ENTRY a owl:Class ;
  rdfs:label "ACCOUNT ENTRY"
  ; rdfs:comment "An ACCOUNT ENTRY is a record of aggregated ACTIVITY LOG ENTRY data per WAGE TYPE, EMPLOYEE and COST CENTRE for one OPERATING DAY that is used to transfer information on duties actually worked by drivers to an external accounting system."
  ; skos:definition "An ACCOUNT ENTRY is a record of aggregated ACTIVITY LOG ENTRY data per WAGE TYPE, EMPLOYEE and COST CENTRE for one OPERATING DAY that is used to transfer information on duties actually worked by drivers to an external accounting system."
  ; rdfs:subClassOf tm:LOG_ENTRY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "SumOfTimeWorked" ; ea:position 1 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Sum of worked time recorded in the ACCOUNT ENTRY." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "AccountEntryIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACCOUNT ENTRY." ]
  .

tm:WAGE_TYPE_ASSIGNMENT a owl:Class ;
  rdfs:label "WAGE TYPE ASSIGNMENT"
  ; rdfs:comment "A WAGE TYPE ASSIGNMENT is an assignment of a TYPE OF WAGE to a DAY TYPE and a TIME BAND."
  ; skos:definition "A WAGE TYPE ASSIGNMENT is an assignment of a TYPE OF WAGE to a DAY TYPE and a TIME BAND."
  ; rdfs:subClassOf tm:ASSIGNMENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "WageTypeAssignmentIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of WAGE TYPE ASSIGNMENT." ]
  .

tm:TYPE_OF_WAGE a owl:Class ;
  rdfs:label "TYPE OF WAGE"
  ; rdfs:comment "A TYPE OF WAGE is a classification used for wage accounting, which associates sums of work time recorded in ACCOUNT ENTRies to TIME BANDs relevant for accounting."
  ; skos:definition "A TYPE OF WAGE is a classification used for wage accounting, which associates sums of work time recorded in ACCOUNT ENTRies to TIME BANDs relevant for accounting."
  ; rdfs:subClassOf tm:TYPE_OF_VALUE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfWageIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF WAGE." ]
  .

tm:ACTIVITY_LOG_ENTRY a owl:Class ;
  rdfs:label "ACTIVITY LOG ENTRY"
  ; rdfs:comment "An ACTIVITY LOG ENTRY is a record, including the data needed for accounting, of the actual time worked (planned as well as unplanned), in a STRETCH, or spent for a BREAK, by an EMPLOYEE on a specified OPERATING DAY."
  ; skos:definition "An ACTIVITY LOG ENTRY is a record, including the data needed for accounting, of the actual time worked (planned as well as unplanned), in a STRETCH, or spent for a BREAK, by an EMPLOYEE on a specified OPERATING DAY."
  ; rdfs:subClassOf tm:LOG_ENTRY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "ActualStartTime" ; ea:position 1 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Actual start time of activity recorded in ACTIVITY LOG ENTRY." ]
  ; ea:attribute [ ea:name "ActualEndTime" ; ea:position 2 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Actual end time of activity recorded in ACTIVITY LOG ENTRY." ]
  ; ea:attribute [ ea:name "AccountingFactor" ; ea:position 3 ; ea:typeName "anyType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The proportion of the normal wage that is paid for the activity recorded in ACTIVITY LOG ENTRY." ]
  ; ea:attribute [ ea:name "AccountingTime" ; ea:position 4 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The full or reduced paid time applicable for the activity recorded in ACTIVITY LOG ENTRY." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 5 ; ea:typeName "ActivityLogEntryIdTye" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACTIVITY LOG ENTRY." ]
  .

tm:LOGICAL_DRIVER_CANCELLATION a owl:Class ;
  rdfs:label "LOGICAL DRIVER CANCELLATION"
  ; rdfs:comment "A LOGICAL DRIVER CANCELLATION is a CONTROL ACTION consisting in removing a LOGICAL DRIVER from the production plan."
  ; skos:definition "A LOGICAL DRIVER CANCELLATION is a CONTROL ACTION consisting in removing a LOGICAL DRIVER from the production plan."
  ; rdfs:subClassOf tm:DRIVER_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "LogicalDriverCancellationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of LOGICAL DRIVER CANCELLATION." ]
  .

tm:CHANGE_OF_DRIVER a owl:Class ;
  rdfs:label "CHANGE OF DRIVER"
  ; rdfs:comment "A CHANGE OF DRIVER is a CONTROL ACTION consisting in removing, at a certain point in time and space (in principle a RELIEF POINT), all work assigned to a LOGICAL DRIVER and of assigning it to another LOGICAL DRIVER."
  ; skos:definition "A CHANGE OF DRIVER is a CONTROL ACTION consisting in removing, at a certain point in time and space (in principle a RELIEF POINT), all work assigned to a LOGICAL DRIVER and of assigning it to another LOGICAL DRIVER."
  ; rdfs:subClassOf tm:DRIVER_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Time" ; ea:position 1 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time of CHANGE OF DRIVER." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "ChangeOfDriverIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CHANGE OF DRIVER." ]
  .

tm:DRIVER_CONTROL_ACTION a owl:Class ;
  rdfs:label "DRIVER CONTROL ACTION"
  ; rdfs:comment "A DRIVER CONTROL ACTION is a CONTROL ACTION affecting a LOGICAL DRIVER."
  ; skos:definition "A DRIVER CONTROL ACTION is a CONTROL ACTION affecting a LOGICAL DRIVER."
  ; rdfs:subClassOf tm:CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DriverControlActionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DRIVER CONTROL ACTION." ]
  .

tm:LOGICAL_DRIVER_CREATION a owl:Class ;
  rdfs:label "LOGICAL DRIVER CREATION"
  ; rdfs:comment "A LOGICAL DRIVER CREATION is a CONTROL ACTION consisting in creating a completely new LOGICAL DRIVER and assigning dated spells to this LOGICAL DRIVER."
  ; skos:definition "A LOGICAL DRIVER CREATION is a CONTROL ACTION consisting in creating a completely new LOGICAL DRIVER and assigning dated spells to this LOGICAL DRIVER."
  ; rdfs:subClassOf tm:DRIVER_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "LogicalDriverCreationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of LOGICAL DRIVER CREATION." ]
  .

tm:LOCATED_EVENT a owl:Class ;
  rdfs:label "LOCATED EVENT"
  ; rdfs:comment "An EVENT with additional location and timing information"
