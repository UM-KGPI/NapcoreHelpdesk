  .

tm:TIME_BAND a owl:Class ;
  rdfs:label "TIME BAND"
  ; rdfs:comment "A period in a day, significant for some aspect of public transport, e.g., similar traffic conditions or fare category."
  ; skos:definition "A period in a day, significant for some aspect of public transport, e.g., similar traffic conditions or fare category."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TimebandIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TIME BAND." ]
  ; ea:attribute [ ea:name "StartTime" ; ea:position 2 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Inclusive start time of TIME BAND." ]
  ; ea:attribute [ ea:name "EndTime" ; ea:position 3 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Inclusive end time of TIME BAND." ]
  ; ea:attribute [ ea:name "DayOffset" ; ea:position 4 ; ea:typeName "DayOffsetType" ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Day offset of end time from start time. If same day, zero." ]
  ; ea:attribute [ ea:name "Duration" ; ea:position 5 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Length of day - Alternative to use of end time -" ]
  .

tm:OPERATING_PERIOD a owl:Class ;
  rdfs:label "OPERATING PERIOD"
  ; rdfs:comment "A continuous interval of time between two OPERATING DAYs which will be used to define validities."
  ; skos:definition "A continuous interval of time between two OPERATING DAYs which will be used to define validities."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "OperatingPeriodIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of OPERATING PERIOD." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of OPERATING PERIOD." ]
  ; ea:attribute [ ea:name "Season" ; ea:position 3 ; ea:typeName "SeasonEnum" ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Season of OPERATING PERIOD." ]
  .

tm:DAY_OF_WEEK a owl:Class ;
  rdfs:label "DAY OF WEEK"
  ; rdfs:comment "A particular weekday (from Monday to Sunday)."
  ; skos:definition "A particular weekday (from Monday to Sunday)."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Day" ; ea:position 1 ; ea:typeName "DayOfWeekIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DAY OF WEEK." ]
