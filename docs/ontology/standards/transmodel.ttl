tm:FLEXIBLE_LINE a owl:Class ;
  rdfs:label "FLEXIBLE LINE"
  ; rdfs:comment "Specialisation of LINE for flexible service.  NOTE1: As the service on a LINE may not all be flexible, flexibility itself is described at JOURNEY PATTERN level (meaning that a separate JOURNEY PATTERN is needed for each type of flexibility available for the line).  NOTE2: Types of flexible services include: Virtual line services; Flexible service with a main route; Corridor services; Fixed stop area-wide flexible services; Free area-wide flexible services; Mixed combinations of flexible services of different types; Mixed combinations of flexible and regular services."
  ; skos:definition "Specialisation of LINE for flexible service.  NOTE1: As the service on a LINE may not all be flexible, flexibility itself is described at JOURNEY PATTERN level (meaning that a separate JOURNEY PATTERN is needed for each type of flexibility available for the line).  NOTE2: Types of flexible services include: Virtual line services; Flexible service with a main route; Corridor services; Fixed stop area-wide flexible services; Free area-wide flexible services; Mixed combinations of flexible services of different types; Mixed combinations of flexible and regular services."
  ; rdfs:subClassOf tm:LINE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "BookableLineIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FLEXIBLE LINE." ]
  ; ea:attribute [ ea:name "FlexibleLineType" ; ea:position 2 ; ea:typeName "FlexibleLineTypeEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of FLEXIBLE LINE." ]
  .

tm:FLEXIBLE_ROUTE a owl:Class ;
  rdfs:label "FLEXIBLE ROUTE"
  ; rdfs:comment "Specialisation of ROUTE for flexible service.  NOTE: May include both point and zonal areas and ordered and unordered sections."
  ; skos:definition "Specialisation of ROUTE for flexible service.  NOTE: May include both point and zonal areas and ordered and unordered sections."
  ; rdfs:subClassOf tm:ROUTE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FlexibleRouteIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FLEXIBLE ROUTE." ]
  ; ea:attribute [ ea:name "FlexibleRouteType" ; ea:position 2 ; ea:typeName "FlexibleRouteTypeEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of FLEXIBLE ROUTE." ]
  .

tm:ACTIVATED_EQUIPMENT a owl:Class ;
  rdfs:label "ACTIVATED EQUIPMENT"
  ; rdfs:comment "An equipment activated by the passage of a vehicle at an ACTIVATION POINT or on an ACTIVATION LINK."
  ; skos:definition "An equipment activated by the passage of a vehicle at an ACTIVATION POINT or on an ACTIVATION LINK."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ActivatedEquipmentIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACTIVATED EQUIPMENT." ]
  .

tm:ACTIVATION_POINT a owl:Class ;
  rdfs:label "ACTIVATION POINT"
  ; rdfs:comment "A POINT where a control process is activated when a vehicle passes it.  NOTE: EQUIPMENT may be needed for the activation."
  ; skos:definition "A POINT where a control process is activated when a vehicle passes it.  NOTE: EQUIPMENT may be needed for the activation."
  ; rdfs:subClassOf tm:POINT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ActivationPointIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACTIVATION POINT." ]
  ; ea:attribute [ ea:name "ActivationPointNumber" ; ea:position 2 ; ea:typeName "normalizedString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Number of ACTIVATION POINT." ]
  ; ea:attribute [ ea:name "ShortName" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Short Name of ACTIVATION POINT." ]
  .

tm:TYPE_OF_ACTIVATION a owl:Class ;
  rdfs:label "TYPE OF ACTIVATION"
  ; rdfs:comment "A classification of real-time processes that are activated when vehicles pass an ACTIVATION POINT or an ACTIVATION LINK."
  ; skos:definition "A classification of real-time processes that are activated when vehicles pass an ACTIVATION POINT or an ACTIVATION LINK."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfActivationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF ACTIVATION." ]
  .

tm:TRAFFIC_CONTROL_POINT a owl:Class ;
  rdfs:label "TRAFFIC CONTROL POINT"
  ; rdfs:comment "A POINT where the traffic flow can be influenced, e.g., traffic lights (lanterns), barriers."
  ; skos:definition "A POINT where the traffic flow can be influenced, e.g., traffic lights (lanterns), barriers."
  ; rdfs:subClassOf tm:POINT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TrafficControlPointIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TRAFFIC CONTROL POINT." ]
  .

tm:ACTIVATION_LINK a owl:Class ;
  rdfs:label "ACTIVATION LINK"
  ; rdfs:comment "A LINK where a control process is activated when a vehicle passes it."
  ; skos:definition "A LINK where a control process is activated when a vehicle passes it."
  ; rdfs:subClassOf tm:LINK
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ActivationLinkIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACTIVATION LINK." ]
  .

tm:TYPE_OF_TRAFFIC_CONTROL_POINT a owl:Class ;
  rdfs:label "TYPE OF TRAFFIC CONTROL POINT"
  ; rdfs:comment "A classification of TRAFFIC CONTROL POINTs."
  ; skos:definition "A classification of TRAFFIC CONTROL POINTs."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfTrafficControlPoint" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF TRAFFIC CONTROL POINT." ]
  .

tm:ACTIVATION_ASSIGNMENT a owl:Class ;
  rdfs:label "ACTIVATION ASSIGNMENT"
  ; rdfs:comment "An assignment of an ACTIVATION POINT or LINK to an ACTIVATED EQUIPMENT, related in its turn to a TRAFFIC CONTROL POINT.  NOTE: The considered ACTIVATION POINT or LINK will be used to influence the control process for that TRAFFIC CONTROL POINT (e.g., to fix priorities as regards the processing of competing requests from different ACTIVATION POINTs/LINKs)."
  ; skos:definition "An assignment of an ACTIVATION POINT or LINK to an ACTIVATED EQUIPMENT, related in its turn to a TRAFFIC CONTROL POINT.  NOTE: The considered ACTIVATION POINT or LINK will be used to influence the control process for that TRAFFIC CONTROL POINT (e.g., to fix priorities as regards the processing of competing requests from different ACTIVATION POINTs/LINKs)."
  ; rdfs:subClassOf tm:ASSIGNMENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ActivationAssignmentIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACTIVATION ASSIGNMENT." ]
  ; ea:attribute [ ea:name "Order" ; ea:position 2 ; ea:typeName "positiveInteger" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Order of ASSIGNMENT relative to other ASSIGNMENTs." ]
  .

tm:BEACON_POINT a owl:Class ;
  rdfs:label "BEACON POINT"
  ; rdfs:comment "A POINT where a beacon or similar device to support the automatic detection of vehicles passing by is located."
  ; skos:definition "A POINT where a beacon or similar device to support the automatic detection of vehicles passing by is located."
  ; rdfs:subClassOf tm:ACTIVATION_POINT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "BeaconPointIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of BEACON POINT." ]
  .

tm:RELIEF_POINT a owl:Class ;
  rdfs:label "RELIEF POINT"
  ; rdfs:comment "A TIMING POINT where a relief is possible, i.e., a driver may take on or hand over a vehicle.  NOTE: The vehicle may sometimes be left unattended even though it has passengers on board."
  ; skos:definition "A TIMING POINT where a relief is possible, i.e., a driver may take on or hand over a vehicle.  NOTE: The vehicle may sometimes be left unattended even though it has passengers on board."
  ; rdfs:subClassOf tm:TIMING_POINT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ReliefPointIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of RELIEF POINT." ]
  .

tm:GARAGE a owl:Class ;
  rdfs:label "GARAGE"
  ; rdfs:comment "A facility used for parking and maintaining vehicles.  NOTE1: PARKING POINTs in a GARAGE are called GARAGE POINTs.  NOTE2: Such a facility is often called a depot."
  ; skos:definition "A facility used for parking and maintaining vehicles.  NOTE1: PARKING POINTs in a GARAGE are called GARAGE POINTs.  NOTE2: Such a facility is often called a depot."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "GarageIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of GARAGE." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of GARAGE." ]
  .

tm:CREW_BASE a owl:Class ;
  rdfs:label "CREW BASE"
  ; rdfs:comment "A place where operating employees (e.g., drivers) report on and register their work."
  ; skos:definition "A place where operating employees (e.g., drivers) report on and register their work."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "CrewBaseIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CREW BASE." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of CREW BASE." ]
  .

tm:PARKING_POINT a owl:Class ;
  rdfs:label "PARKING POINT"
  ; rdfs:comment "A TIMING POINT where vehicles may stay unattended for a long time.  NOTE1: A vehicle's return to park at a PARKING POINT marks the end of a BLOCK.  NOTE2: Normally there are no passengers on board at a PARKING POINT."
  ; skos:definition "A TIMING POINT where vehicles may stay unattended for a long time.  NOTE1: A vehicle's return to park at a PARKING POINT marks the end of a BLOCK.  NOTE2: Normally there are no passengers on board at a PARKING POINT."
  ; rdfs:subClassOf tm:RELIEF_POINT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ParkingPointIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PARKING POINT." ]
  .

tm:GARAGE_POINT a owl:Class ;
  rdfs:label "GARAGE POINT"
  ; rdfs:comment "A subtype of PARKING POINT located in a GARAGE."
  ; skos:definition "A subtype of PARKING POINT located in a GARAGE."
  ; rdfs:subClassOf tm:PARKING_POINT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "GaragePointIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of GARAGE POINT." ]
  .

tm:SITE_COMPONENT a owl:Class ;
  rdfs:label "SITE COMPONENT"
  ; rdfs:comment "An element of a SITE describing a part of its structure.  NOTE: SITE COMPONENTs share common properties for data management, accessibility and other features."
  ; skos:definition "An element of a SITE describing a part of its structure.  NOTE: SITE COMPONENTs share common properties for data management, accessibility and other features."
  ; rdfs:subClassOf tm:SITE_ELEMENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SiteComponentIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SITE COMPONENT." ]
  .

tm:ENTRANCE a owl:Class ;
  rdfs:label "ENTRANCE"
  ; rdfs:comment "A physical entrance or exit to/from a SITE; may be a door, barrier, gate or other recognizable point of access."
  ; skos:definition "A physical entrance or exit to/from a SITE; may be a door, barrier, gate or other recognizable point of access."
  ; rdfs:subClassOf tm:SITE_COMPONENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "EntranceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ENTRANCE." ]
  ; ea:attribute [ ea:name "Label" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Label of ENTRANCE." ]
  ; ea:attribute [ ea:name "IsExternal" ; ea:position 3 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether ENTRANCE opens externally." ]
  ; ea:attribute [ ea:name "IsEntry" ; ea:position 4 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether ENTRANCE can be used for entry to SITE." ]
  ; ea:attribute [ ea:name "IsExit" ; ea:position 5 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether ENTRANCE can be used for exit from SITE." ]
  ; ea:attribute [ ea:name "Width" ; ea:position 6 ; ea:typeName "LengthType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Width of ENTRANCE." ]
  ; ea:attribute [ ea:name "Height" ; ea:position 7 ; ea:typeName "LengthType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Height of ENTRANCE." ]
  ; ea:attribute [ ea:name "DroppedKerbOutside" ; ea:position 8 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether there is a dropped curb outside ENTRANCE." ]
  ; ea:attribute [ ea:name "DropOffPointClose" ; ea:position 9 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether ENTRANCE is near Drop off point." ]
  .

tm:ACCESS_ZONE a owl:Class ;
  rdfs:label "ACCESS ZONE"
  ; rdfs:comment "A ZONE for which the duration needed to reach a particular STOP POINT is considered to be the same."
  ; skos:definition "A ZONE for which the duration needed to reach a particular STOP POINT is considered to be the same."
  ; rdfs:subClassOf tm:ZONE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AccessZoneIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACCESS ZONE." ]
  .

tm:VEHICLE_ENTRANCE a owl:Class ;
  rdfs:label "VEHICLE ENTRANCE"
  ; rdfs:comment "A physical entrance or exit to/from a SITE for a VEHICLE.  NOTE: May be a door, barrier, gate or other recognizable point of vehicle access."
  ; skos:definition "A physical entrance or exit to/from a SITE for a VEHICLE.  NOTE: May be a door, barrier, gate or other recognizable point of vehicle access."
  ; rdfs:subClassOf tm:ENTRANCE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VehicleEntranceId" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE ENTRANCE." ]
  ; ea:attribute [ ea:name "Public" ; ea:position 2 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether VEHICLE ENTRANCE can be used by private VEHICLEs." ]
  .

tm:SITE a owl:Class ;
  rdfs:label "SITE"
  ; rdfs:comment "A well known PLACE to which passengers may refer to indicate the origin or a destination of a trip."
  ; skos:definition "A well known PLACE to which passengers may refer to indicate the origin or a destination of a trip."
  ; rdfs:subClassOf tm:SITE_ELEMENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SiteIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SITE." ]
  ; ea:attribute [ ea:name "SiteType" ; ea:position 2 ; ea:typeName "SiteTypeEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of SITE." ]
  ; ea:attribute [ ea:name "AtCenter" ; ea:position 3 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether the site is central to the locality, referenced at town centre." ]
  ; ea:attribute [ ea:name "Locale" ; ea:position 4 ; ea:typeName "Locale" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Locale setting time zone, default language etc, for the STOP PLACE." ]
  .

tm:LEVEL a owl:Class ;
  rdfs:label "LEVEL"
  ; rdfs:comment "An identified storey (ground, first, basement, mezzanine, etc.) within an interchange building or SITE on which SITE COMPONENTs reside.  NOTE: A PATH LINK may connect components on different levels."
  ; skos:definition "An identified storey (ground, first, basement, mezzanine, etc.) within an interchange building or SITE on which SITE COMPONENTs reside.  NOTE: A PATH LINK may connect components on different levels."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "LevelIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of LEVEL." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of LEVEL." ]
  ; ea:attribute [ ea:name "ShortName" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Short name of LEVEL." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 4 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Further description of LEVEL." ]
  ; ea:attribute [ ea:name "PublicUse" ; ea:position 5 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of a nearby landmark which can be used to refer to SITE." ]
  ; ea:attribute [ ea:name "AllAreasWheelchair" ; ea:position 6 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether all areas of component are accessible in a Wheelchair." ]
  .

tm:SERVICE_SITE a owl:Class ;
  rdfs:label "SERVICE SITE"
  ; rdfs:comment "A sub-type of SITE which is of specific interest for the operator (e.g., where a joint service or a joint fee is proposed), other than a STOP PLACE."
  ; skos:definition "A sub-type of SITE which is of specific interest for the operator (e.g., where a joint service or a joint fee is proposed), other than a STOP PLACE."
  ; rdfs:subClassOf tm:SITE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ServiceSiteIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SERVICE SITE." ]
  .

tm:SITE_ELEMENT a owl:Class ;
  rdfs:label "SITE ELEMENT"
  ; rdfs:comment "A specialisation of ADDRESSABLE PLACE describing common properties of a SITE or a SITE COMPONENT, including accessibility."
  ; skos:definition "A specialisation of ADDRESSABLE PLACE describing common properties of a SITE or a SITE COMPONENT, including accessibility."
  ; rdfs:subClassOf tm:ADDRESSABLE_PLACE
  ; rdfs:subClassOf tm:ENVIRONMENT_PROPERTIES
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SiteElementIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SITE ELEMENT." ]
  ; ea:attribute [ ea:name "Image" ; ea:position 2 ; ea:typeName "anyUri" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "URL for image associated with SITE ELEMENT." ]
  ; ea:attribute [ ea:name "NameSuffix" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Suffix to use on Name." ]
  ; ea:attribute [ ea:name "Url" ; ea:position 4 ; ea:typeName "anyUri" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "URL associated with SITE ELEMENT." ]
  ; ea:attribute [ ea:name "CrossRoad" ; ea:position 5 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of nearest Cross road or crossing street on which SITE is on which can be used to locate stop." ]
  ; ea:attribute [ ea:name "Landmark" ; ea:position 6 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of nearby landmark that may be used to locate and / or distinguish SITE ELEMENT." ]
  ; ea:attribute [ ea:name "AllAreasWheelchair" ; ea:position 7 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether all areas of component are accessible in a Wheelchair." ]
  .

tm:STOP_PLACE a owl:Class ;
  rdfs:label "STOP PLACE"
  ; rdfs:comment "A place comprising one or more locations where vehicles may stop and where passengers may board or leave vehicles or prepare their trip.  NOTE: A STOP PLACE will usually have one or more well-known names."
  ; skos:definition "A place comprising one or more locations where vehicles may stop and where passengers may board or leave vehicles or prepare their trip.  NOTE: A STOP PLACE will usually have one or more well-known names."
  ; rdfs:subClassOf tm:SITE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "StopPlaceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a STOP PLACE." ]
  ; ea:attribute [ ea:name "Weighting" ; ea:position 2 ; ea:typeName "integer" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Default relative weighting to be used for STOP PLACE." ]
  ; ea:attribute [ ea:name "BorderCrossingPoint" ; ea:position 3 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether STOP PLACE is a border crossing." ]
  ; ea:attribute [ ea:name "LimitedUse" ; ea:position 4 ; ea:typeName "LimitedUseEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Categorisation of the stop as having topographic limitations which may affect its use in journey planners" ]
  .

tm:QUAY a owl:Class ;
  rdfs:label "QUAY"
  ; rdfs:comment "A place such as platform, stance, or quay side where passengers have access to PT vehicles, Taxis, cars or other means of transportation.  NOTE1: A QUAY may serve one or more VEHICLE STOPPING PLACEs and be associated with one or more SCHEDULED STOP POINTS.  NOTE2: A QUAY may contain other sub QUAYs.  NOTE3: A child QUAY must be physically contained within its parent QUAY."
  ; skos:definition "A place such as platform, stance, or quay side where passengers have access to PT vehicles, Taxis, cars or other means of transportation.  NOTE1: A QUAY may serve one or more VEHICLE STOPPING PLACEs and be associated with one or more SCHEDULED STOP POINTS.  NOTE2: A QUAY may contain other sub QUAYs.  NOTE3: A child QUAY must be physically contained within its parent QUAY."
  ; rdfs:subClassOf tm:STOP_PLACE_SPACE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "QuayIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of QUAY." ]
  ; ea:attribute [ ea:name "DestinationDisplay" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Destination shown on QUAY." ]
  ; ea:attribute [ ea:name "CompassBearing" ; ea:position 3 ; ea:typeName "CompassBearingType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Bearing of street relative to QUAY in degrees." ]
  ; ea:attribute [ ea:name "CompassOctant" ; ea:position 4 ; ea:typeName "CompassOctantEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Bearing of street relative to QUAY in compass quadrant." ]
  .

tm:TYPE_OF_STOP_PLACE a owl:Class ;
  rdfs:label "TYPE OF STOP PLACE"
  ; rdfs:comment "A classification for STOP PLACEs (e.g., complex, simple, multimodal, etc.)."
  ; skos:definition "A classification for STOP PLACEs (e.g., complex, simple, multimodal, etc.)."
