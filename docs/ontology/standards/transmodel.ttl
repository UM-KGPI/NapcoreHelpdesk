  .

tm:ADDRESSABLE_PLACE a owl:Class ;
  rdfs:label "ADDRESSABLE PLACE"
  ; rdfs:comment "A type of PLACE to which passengers may refer to indicate the origin or a destination of a trip and that is so specific that it has an ADDRESS."
  ; skos:definition "A type of PLACE to which passengers may refer to indicate the origin or a destination of a trip and that is so specific that it has an ADDRESS."
  ; rdfs:subClassOf tm:PLACE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AddressablePlaceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of an ADDRESSABLE PLACE." ]
  ; ea:attribute [ ea:name "Image" ; ea:position 2 ; ea:typeName "anyUri" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Image associated with ADDRESSABLE PLACE.  ." ]
  ; ea:attribute [ ea:name "Url" ; ea:position 3 ; ea:typeName "anyUri" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "URL associated with ADDRESSABLE PLACE." ]
  .

tm:POSTAL_ADDRESS a owl:Class ;
  rdfs:label "POSTAL ADDRESS"
  ; rdfs:comment "A specification of ADDRESS refining it by using the attributes used for conventional identification for mail.  NOTE: Comprises variously a building Identifier, Street name, Post code and other descriptors."
  ; skos:definition "A specification of ADDRESS refining it by using the attributes used for conventional identification for mail.  NOTE: Comprises variously a building Identifier, Street name, Post code and other descriptors."
  ; rdfs:subClassOf tm:ADDRESS
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PostalAddressIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of POSTAL ADDRESS." ]
  ; ea:attribute [ ea:name "HouseNumber" ; ea:position 2 ; ea:typeName "normalizedString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "House or building number of POSTAL ADDRESS." ]
  ; ea:attribute [ ea:name "BuildingName" ; ea:position 3 ; ea:typeName "normalizedString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Building name of POSTAL ADDRESS." ]
  ; ea:attribute [ ea:name "AddressLine1" ; ea:position 4 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "First line of POSTAL ADDRESS." ]
  ; ea:attribute [ ea:name "Street" ; ea:position 5 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Street name of POSTAL ADDRESS." ]
  ; ea:attribute [ ea:name "Town" ; ea:position 6 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Town of POSTAL ADDRESS." ]
  ; ea:attribute [ ea:name "PostCode" ; ea:position 7 ; ea:typeName "PostCodeType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Post code" ]
  ; ea:attribute [ ea:name "PostCodeExtension" ; ea:position 8 ; ea:typeName "normalizedString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Post code extension" ]
  ; ea:attribute [ ea:name "Province" ; ea:position 9 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Post code" ]
  .

tm:TOPOGRAPHIC_PLACE a owl:Class ;
  rdfs:label "TOPOGRAPHIC PLACE"
  ; rdfs:comment "A type of PLACE providing the topographical context when searching for or presenting travel information, for example as the origin or destination of a trip.  NOTE: It may be of any size (e.g., County, City, Town, Village) and of different specificity (e.g., Greater London, London, West End, Westminster, St James's parish)."
  ; skos:definition "A type of PLACE providing the topographical context when searching for or presenting travel information, for example as the origin or destination of a trip.  NOTE: It may be of any size (e.g., County, City, Town, Village) and of different specificity (e.g., Greater London, London, West End, Westminster, St James's parish)."
  ; rdfs:subClassOf tm:PLACE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TopographicalPlaceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a TOPOGRAPHIC PLACE." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Name of a TOPOGRAPHIC PLACE." ]
  ; ea:attribute [ ea:name "ShortName" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Short Name of a TOPOGRAPHIC PLACE." ]
  ; ea:attribute [ ea:name "Qualifier" ; ea:position 4 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name used to distinguish TOPOGRAPHIC PLACE from other similar named TOPOGRAPHIC PLACEs. This should not be included in the Name but may be added by applications in context." ]
  ; ea:attribute [ ea:name "Centre" ; ea:position 5 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether TOPOGRAPHIC PLACE lies at centre of settlement." ]
  .

tm:ADDRESS a owl:Class ;
  rdfs:label "ADDRESS"
  ; rdfs:comment "The descriptive data associated with a PLACE that can be used to describe the unique geographical context of a PLACE for the purposes of identifying it.  NOTE: May be refined as either a ROAD ADDRESS, a POSTAL ADDRESS or both."
  ; skos:definition "The descriptive data associated with a PLACE that can be used to describe the unique geographical context of a PLACE for the purposes of identifying it.  NOTE: May be refined as either a ROAD ADDRESS, a POSTAL ADDRESS or both."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AddressIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of an ADDRESS." ]
  ; ea:attribute [ ea:name "ShortName" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Short name of an ADDRESS." ]
  .

tm:COUNTRY a owl:Class ;
  rdfs:label "COUNTRY"
  ; rdfs:comment "A jurisdictional geographic boundary.  NOTE: A COUNTRY normally has a two-character IANA identifier."
  ; skos:definition "A jurisdictional geographic boundary.  NOTE: A COUNTRY normally has a two-character IANA identifier."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "CountryEnum" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of COUNTRY." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Name of COUNTRY." ]
  .

tm:ROAD_ADDRESS a owl:Class ;
  rdfs:label "ROAD ADDRESS"
  ; rdfs:comment "Specialization of ADDRESS using conventional characteristics such as road number and name for identification of a location along a road."
  ; skos:definition "Specialization of ADDRESS using conventional characteristics such as road number and name for identification of a location along a road."
  ; rdfs:subClassOf tm:ADDRESS
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "RoadAddressIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a ROAD ADDRESS." ]
  ; ea:attribute [ ea:name "RoadNumber" ; ea:position 2 ; ea:typeName "normalizedString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Number of ROAD." ]
  ; ea:attribute [ ea:name "RoadName" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of ROAD." ]
  ; ea:attribute [ ea:name "BearingCompass" ; ea:position 4 ; ea:typeName "CompassEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Bearing of ROAD at point of ADDRESS." ]
  ; ea:attribute [ ea:name "BearingDegrees" ; ea:position 5 ; ea:typeName "integer" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "BEARING in degrees at point of ADDRESS." ]
  ; ea:attribute [ ea:name "OddNumberRange" ; ea:position 6 ; ea:typeName "normalizedString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Odd number range of ADDRESS." ]
  ; ea:attribute [ ea:name "EvenNumberRange" ; ea:position 7 ; ea:typeName "normalizedString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Even number range of ADDRESS on road." ]
  .

tm:CONTROL_CENTRE a owl:Class ;
  rdfs:label "CONTROL CENTRE"
  ; rdfs:comment "An ORGANISATION PART for an operational team who are responsible for issuing commands to control the services."
  ; skos:definition "An ORGANISATION PART for an operational team who are responsible for issuing commands to control the services."
  ; rdfs:subClassOf tm:ORGANISATION_PART
