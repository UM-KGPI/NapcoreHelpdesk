  ; ea:attribute [ ea:name "ForProduction" ; ea:position 3 ; ea:typeName "normalizedString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "TRAIN NUMBER to use for production purposes, if different from Id." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 4 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of TRAIN NUMBER." ]
  .

tm:DEAD_RUN a owl:Class ;
  rdfs:label "DEAD RUN"
  ; rdfs:comment "A non-service VEHICLE JOURNEY."
  ; skos:definition "A non-service VEHICLE JOURNEY."
