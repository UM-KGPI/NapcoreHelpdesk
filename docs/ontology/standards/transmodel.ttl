  .

tm:AVAILABILITY_CONDITION a owl:Class ;
  rdfs:label "AVAILABILITY CONDITION"
  ; rdfs:comment "A VALIDITY CONDITION expressed in terms of temporal parameters and referring to DAY TYPEs."
  ; skos:definition "A VALIDITY CONDITION expressed in terms of temporal parameters and referring to DAY TYPEs."
  ; rdfs:subClassOf tm:VALIDITY_CONDITION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AvailabilityConditionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of AVAILABILITY CONDITION." ]
