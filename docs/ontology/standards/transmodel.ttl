  ; ea:attribute [ ea:name "Discrete" ; ea:position 4 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether series can only be used by itself, or whether it can be used in a chain of series." ]
  ; ea:attribute [ ea:name "FirstClassDistance" ; ea:position 5 ; ea:typeName "DistanceType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Notional distance along SERIES CONSTRAINT for computation of First Class fares." ]
  ; ea:attribute [ ea:name "SecondClassDistance" ; ea:position 6 ; ea:typeName "DistanceType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Notional distance along SERIES CONSTRAINT for computation of Second Class fares." ]
  .

