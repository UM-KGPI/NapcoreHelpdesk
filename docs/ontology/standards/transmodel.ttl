  .

tm:VERSION a owl:Class ;
  rdfs:label "VERSION"
  ; rdfs:comment "A group of operational data instances which share the same VALIDITY CONDITIONs.  NOTE: A version belongs to a unique VERSION FRAME and is characterised by a unique TYPE OF VERSION."
  ; skos:definition "A group of operational data instances which share the same VALIDITY CONDITIONs.  NOTE: A version belongs to a unique VERSION FRAME and is characterised by a unique TYPE OF VERSION."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VersionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VERSION." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of VERSION." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of VERSION." ]
  ; ea:attribute [ ea:name "StartDate" ; ea:position 4 ; ea:typeName "dateTime" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Start date of validity of VERSION." ]
