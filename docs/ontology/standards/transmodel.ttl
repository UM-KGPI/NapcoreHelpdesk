  ; ea:attribute [ ea:name "Id" ; ea:position 5 ; ea:typeName "ImpededTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of IMPEDED TIME." ]
  .

tm:TYPE_OF_VEHICLE_MONITORING a owl:Class ;
