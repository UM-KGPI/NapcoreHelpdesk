  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "InsufficentAccessRightsEntryIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of INSUFFICIENT ACCESS RIGHTS ENTRY." ]
  .

tm:FARE_FRAME a owl:Class ;
  rdfs:label "FARE FRAME"
  ; rdfs:comment "A set of FARE data elements to which the same VALIDITY CONDITIONs have been assigned."
  ; skos:definition "A set of FARE data elements to which the same VALIDITY CONDITIONs have been assigned."
