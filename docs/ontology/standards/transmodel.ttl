tm:AGGREGATED_ONBOARD_DEVICE_BASED_PASSENGER_COUNT a owl:Class ;
  rdfs:label "AGGREGATED ONBOARD DEVICE BASED PASSENGER COUNT"
  ; rdfs:comment "The class AGGREGATED VEHICLE PASSENGER DETECTION ENTRY represents a consolidated record of passenger detection data collected from a vehicle over a defined period or operational segment. Instead of storing individual detection events, this class aggregates multiple VEHICLE PASSENGER DETECTION ENTRY instances into a single summary, providing total passenger counts or occupancy levels for the entire MONITORED VEHICLE JOURNEY, OPERATING DAY, or a specific LEG."
  ; skos:definition "The class AGGREGATED VEHICLE PASSENGER DETECTION ENTRY represents a consolidated record of passenger detection data collected from a vehicle over a defined period or operational segment. Instead of storing individual detection events, this class aggregates multiple VEHICLE PASSENGER DETECTION ENTRY instances into a single summary, providing total passenger counts or occupancy levels for the entire MONITORED VEHICLE JOURNEY, OPERATING DAY, or a specific LEG."
  ; rdfs:subClassOf tm:INDICATOR_LOG_ENTRY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "id" ; ea:position 1 ; ea:typeName "AggregatedOnboardDeviceBasedPassengerCountIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "<font color=\"#0f0f0f\">Identifier of</font> AGGREGATED VEHICLE PASSENGER DETECTION ENTRY." ]
  .

