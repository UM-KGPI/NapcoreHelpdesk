  .

tm:TYPE_OF_ABSENCE a owl:Class ;
  rdfs:label "TYPE OF ABSENCE"
  ; rdfs:comment "A classification that indicates the reason why an EMPLOYEE is absent from work and if it is a planned or un-planned absence."
  ; skos:definition "A classification that indicates the reason why an EMPLOYEE is absent from work and if it is a planned or un-planned absence."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfAbsenceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF ABSENCE." ]
  ; ea:attribute [ ea:name "Category" ; ea:position 2 ; ea:typeName "normalizedString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Broad type categorization for TYPE OF ABSENCE." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of TYPE OF ABSENCE." ]
  .

tm:ABSENCE a owl:Class ;
  rdfs:label "ABSENCE"
  ; rdfs:comment "An actual absence of an EMPLOYEE from work on a particular OPERATING DAY for a specified time."
  ; skos:definition "An actual absence of an EMPLOYEE from work on a particular OPERATING DAY for a specified time."
