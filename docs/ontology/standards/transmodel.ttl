  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of EQUIPMENT." ]
  ; ea:attribute [ ea:name "Note" ; ea:position 4 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Note about EQUIPMENT." ]
