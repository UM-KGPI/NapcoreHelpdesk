  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfServiceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF SERVICE." ]
  .

tm:JOURNEY a owl:Class ;
  rdfs:label "JOURNEY"
  ; rdfs:comment "Common properties of VEHICLE JOURNEYs and SPECIAL SERVICEs, e.g., their link to accounting characteristics."
  ; skos:definition "Common properties of VEHICLE JOURNEYs and SPECIAL SERVICEs, e.g., their link to accounting characteristics."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY." ]
