  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "LinkProjectionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of LINK PROJECTION." ]
  .

tm:COMPLEX_FEATURE_PROJECTION a owl:Class ;
  rdfs:label "COMPLEX FEATURE PROJECTION"
  ; rdfs:comment "An oriented correspondence: from one COMPLEX FEATURE in the source layer, onto an entity in a target layer: e.g., POINT, COMPLEX FEATURE, within a defined TYPE OF PROJECTION."
  ; skos:definition "An oriented correspondence: from one COMPLEX FEATURE in the source layer, onto an entity in a target layer: e.g., POINT, COMPLEX FEATURE, within a defined TYPE OF PROJECTION."
  ; rdfs:subClassOf tm:PROJECTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ComplexFeatureProjectionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of COMPLEX FEATURE PROJECTION." ]
  .

tm:TYPE_OF_PROJECTION a owl:Class ;
  rdfs:label "TYPE OF PROJECTION"
  ; rdfs:comment "A classification of the projections according to their functional purpose, the source and target layers."
  ; skos:definition "A classification of the projections according to their functional purpose, the source and target layers."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfProjectionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF PROJECTION." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of TYPE OF PROJECTION (e.g. Point Projection, Link Projection, etc)." ]
  .

tm:ZONE_PROJECTION a owl:Class ;
  rdfs:label "ZONE PROJECTION"
  ; rdfs:comment "An oriented correspondence: from one ZONE in a source layer, onto a target entity: e.g., POINT, COMPLEX FEATURE, within a defined TYPE OF PROJECTION."
  ; skos:definition "An oriented correspondence: from one ZONE in a source layer, onto a target entity: e.g., POINT, COMPLEX FEATURE, within a defined TYPE OF PROJECTION."
  ; rdfs:subClassOf tm:PROJECTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ZoneProjectionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ZONE PROJECTION." ]
  .

tm:MEDICAL_NEED a owl:Class ;
  rdfs:label "MEDICAL NEED"
  ; rdfs:comment "A specific USER NEED, i.e., a requirement of a passenger as regards medical constraint (e.g., allergy) to access public transport."
  ; skos:definition "A specific USER NEED, i.e., a requirement of a passenger as regards medical constraint (e.g., allergy) to access public transport."
  ; rdfs:subClassOf tm:TYPE_OF_USER_NEED
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Need" ; ea:position 1 ; ea:typeName "MedicalNeedEnum" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Type of Medical need." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "MedicalNeedIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of MEDICAL NEED." ]
  .

tm:USER_NEED a owl:Class ;
  rdfs:label "USER NEED"
  ; rdfs:comment "A user's need for a particular SUITABILITY."
  ; skos:definition "A user's need for a particular SUITABILITY."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Excluded" ; ea:position 1 ; ea:typeName "boolean" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Whether USER NEED is to be include or excluded." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "UserNeedIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of USER NEED." ]
  ; ea:attribute [ ea:name "NeedRanking" ; ea:position 3 ; ea:typeName "integer." ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A relative ranking of the need that can be specified in some applications." ]
  .

tm:ACCESSIBILITY_ASSESSMENT a owl:Class ;
  rdfs:label "ACCESSIBILITY ASSESSMENT"
  ; rdfs:comment "The accessibility characteristics of an entity used by passengers such as a LINE, STOP PLACE, STOP PLACE COMPONENT or DECK COMPONENT.  NOTE: Described by ACCESSIBILITY LIMITATIONs, and/or a set of SUITABILITies."
  ; skos:definition "The accessibility characteristics of an entity used by passengers such as a LINE, STOP PLACE, STOP PLACE COMPONENT or DECK COMPONENT.  NOTE: Described by ACCESSIBILITY LIMITATIONs, and/or a set of SUITABILITies."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AssessmentIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACCESSIBILITY ASSESSMENT." ]
  ; ea:attribute [ ea:name "MobilityImpairedAccess" ; ea:position 2 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether the overall assessment is that there is Access for Mobility Impaired users." ]
  .

tm:MOBILITY_NEED a owl:Class ;
  rdfs:label "MOBILITY NEED"
  ; rdfs:comment "A specific USER NEED, i.e., a constraint of a passenger as regards his mobility, e.g., wheelchair, assisted wheelchair, etc."
  ; skos:definition "A specific USER NEED, i.e., a constraint of a passenger as regards his mobility, e.g., wheelchair, assisted wheelchair, etc."
  ; rdfs:subClassOf tm:TYPE_OF_USER_NEED
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Need" ; ea:position 1 ; ea:typeName "MobilityNeedEnum" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Type of Mobility need." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "MobilityNeedIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of MOBILITY NEED." ]
  .

tm:PASSENGER_ACCESSIBILITY_NEED a owl:Class ;
  rdfs:label "PASSENGER ACCESSIBILITY NEED"
  ; rdfs:comment "A passenger's requirement for accessibility, comprising one or more USER NEEDs, e.g., that he is unable to navigate stairs, or lifts, or has visual or auditory impairments.  NOTE: PASSENGER ACCESSIBILITY NEEDS can be used to derive an accessibility constraint for the passenger, allowing the computation of paths for passengers with specifically constrained mobility such as in Wheelchair, No Lifts, No Stairs, etc."
  ; skos:definition "A passenger's requirement for accessibility, comprising one or more USER NEEDs, e.g., that he is unable to navigate stairs, or lifts, or has visual or auditory impairments.  NOTE: PASSENGER ACCESSIBILITY NEEDS can be used to derive an accessibility constraint for the passenger, allowing the computation of paths for passengers with specifically constrained mobility such as in Wheelchair, No Lifts, No Stairs, etc."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Carer" ; ea:position 1 ; ea:typeName "boolean" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Whether user has a carer." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "PassengerAccessibilityNeedIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PASSENGER ACCESSIBILITY NEED." ]
  .

tm:TYPE_OF_USER_NEED a owl:Class ;
  rdfs:label "TYPE OF USER NEED"
  ; rdfs:comment "A classification of USER NEEDS."
  ; skos:definition "A classification of USER NEEDS."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfUserNeedIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF USER NEED." ]
  .

tm:ACCESSIBILITY_LIMITATION a owl:Class ;
  rdfs:label "ACCESSIBILITY LIMITATION"
  ; rdfs:comment "A categorisation of the accessibility characteristics of a SITE, e.g., a STOP PLACE or a STOP PLACE COMPONENT, EQUIPMENT or DECK COMPONENT to indicate its usability by passengers with specific needs, for example, those needing wheelchair access, step-free access or wanting to avoid confined spaces such as lifts.  NOTE: A small number of well-defined categories are used that are chosen to allow the consistent capture of data and the efficient computation of routes for different classes of user."
  ; skos:definition "A categorisation of the accessibility characteristics of a SITE, e.g., a STOP PLACE or a STOP PLACE COMPONENT, EQUIPMENT or DECK COMPONENT to indicate its usability by passengers with specific needs, for example, those needing wheelchair access, step-free access or wanting to avoid confined spaces such as lifts.  NOTE: A small number of well-defined categories are used that are chosen to allow the consistent capture of data and the efficient computation of routes for different classes of user."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "LimitationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACCESSIBILITY LIMITATION." ]
  ; ea:attribute [ ea:name "WheelchairAccess" ; ea:position 2 ; ea:typeName "LimitationStatusEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether there is Access for Wheelchair users." ]
  ; ea:attribute [ ea:name "StepFreeAccess" ; ea:position 3 ; ea:typeName "LimitationStatusEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether there is Step Free Access." ]
  ; ea:attribute [ ea:name "EscalatorFreeAccess" ; ea:position 4 ; ea:typeName "LimitationStatusEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether there is Escalator Free Access." ]
  ; ea:attribute [ ea:name "LiftFreeAccess" ; ea:position 5 ; ea:typeName "LimitationStatusEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether there is Lift Free Access." ]
  ; ea:attribute [ ea:name "AudibleSignsAvailable" ; ea:position 6 ; ea:typeName "LimitationStatusEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether there are Audible Signs." ]
  ; ea:attribute [ ea:name "VisualSignsAvailable" ; ea:position 7 ; ea:typeName "LimitationStatusEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether there are Visual Signs." ]
  .

tm:SUITABILITY a owl:Class ;
  rdfs:label "SUITABILITY"
  ; rdfs:comment "A statement of whether a particular USER NEED can be met; It can be used to state whether a SITE can be accessed by a passenger with a particular USER NEED."
  ; skos:definition "A statement of whether a particular USER NEED can be met; It can be used to state whether a SITE can be accessed by a passenger with a particular USER NEED."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SuitabilityIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SUITABILITY." ]
  ; ea:attribute [ ea:name "Suitable" ; ea:position 2 ; ea:typeName "SuitableEnum" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Whether the USER NEED is met." ]
  .

tm:ENCUMBRANCE_NEED a owl:Class ;
  rdfs:label "ENCUMBRANCE NEED"
  ; rdfs:comment "A specific USER NEED, i.e., a requirement of a passenger travelling with luggage, animal or any other object requiring special arrangements to access public transport."
  ; skos:definition "A specific USER NEED, i.e., a requirement of a passenger travelling with luggage, animal or any other object requiring special arrangements to access public transport."
  ; rdfs:subClassOf tm:TYPE_OF_USER_NEED
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Need" ; ea:position 1 ; ea:typeName "EncumbranceNeedEnum" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Type of Encumbrance need." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "EncumbranceNeedIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ENCUMBRANCE NEED." ]
  .

tm:TYPE_OF_ACCESSIBILITY_LIMITATION a owl:Class ;
  rdfs:label "TYPE OF ACCESSIBILITY LIMITATION"
  ; rdfs:comment "A classification for an ACCESSIBILITY LIMITATION, e.g., as audio, visual, step free, etc."
  ; skos:definition "A classification for an ACCESSIBILITY LIMITATION, e.g., as audio, visual, step free, etc."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfAccessibilityLimitationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF ACCESSIBILITY LIMITATION." ]
  .

tm:TYPE_OF_SUITABILITY a owl:Class ;
  rdfs:label "TYPE OF SUITABILITY"
  ; rdfs:comment "A classification for SUITABILITY, i.e., assessments as regards a possible SUITABILITY of access according to USER NEEDS."
  ; skos:definition "A classification for SUITABILITY, i.e., assessments as regards a possible SUITABILITY of access according to USER NEEDS."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfSuitabilityIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF SUITABILITY." ]
  .

tm:PSYCHOSENSORY_NEED a owl:Class ;
  rdfs:label "PSYCHOSENSORY NEED"
  ; rdfs:comment "A specific USER NEED, i.e., a constraint of a passenger as regards his psycho-sensory impairments, such as visual impairment, auditory impairment, averse to confined spaces, etc."
  ; skos:definition "A specific USER NEED, i.e., a constraint of a passenger as regards his psycho-sensory impairments, such as visual impairment, auditory impairment, averse to confined spaces, etc."
  ; rdfs:subClassOf tm:TYPE_OF_USER_NEED
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Need" ; ea:position 1 ; ea:typeName "PsychosensoryNeedEnum" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Type of Psychosensory need." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "TypeOfPsychoSensoryNeedIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PSYCHOSENSORY NEED." ]
  .

tm:TRANSFER a owl:Class ;
  rdfs:label "TRANSFER"
  ; rdfs:comment "A pair of POINTs located sufficiently close that they offer a passenger the possibility to reach one of the POINTs when starting at the other one in a timescale which is realistic when carrying out a trip, e.g., as a CONNECTION or ACCESS."
  ; skos:definition "A pair of POINTs located sufficiently close that they offer a passenger the possibility to reach one of the POINTs when starting at the other one in a timescale which is realistic when carrying out a trip, e.g., as a CONNECTION or ACCESS."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TransferIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TRANSFER." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of TRANSFER." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of TRANSFER." ]
  ; ea:attribute [ ea:name "Distance" ; ea:position 4 ; ea:typeName "LengthType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Distance of TRANSFER link." ]
  ; ea:attribute [ ea:name "BothWays" ; ea:position 5 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether TRANSFER can be traversed in both directions." ]
  ; ea:attribute [ ea:name "DefaultDuration" ; ea:position 6 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Default interval to make transfer." ]
  ; ea:attribute [ ea:name "FrequentTravellerDuration" ; ea:position 7 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time for a traveller familiar with journey to make transfer." ]
  ; ea:attribute [ ea:name "OccasionalTravellerDuration" ; ea:position 8 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time for a traveller unfamiliar with journey to make transfer." ]
  ; ea:attribute [ ea:name "MobilityRestrictedTravellerDuration" ; ea:position 9 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time for a mobility impaired traveller to make transfer." ]
  .

tm:TYPE_OF_TRANSFER a owl:Class ;
  rdfs:label "TYPE OF TRANSFER"
  ; rdfs:comment "A classification for TRANSFER."
  ; skos:definition "A classification for TRANSFER."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfTransferIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF TRANSFER." ]
  .

tm:ACCESS a owl:Class ;
  rdfs:label "ACCESS"
  ; rdfs:comment "The physical (spatial) possibility for a passenger to access or leave the public transport system.  NOTE: This link may be used during a trip for the walking movement of a passenger from a PLACE (origin of the trip) to a SCHEDULED STOP POINT (origin of the PT TRIP), or for the walking movement from a SCHEDULED STOP POINT (destination of the PT TRIP) to a PLACE (destination of the trip)."
  ; skos:definition "The physical (spatial) possibility for a passenger to access or leave the public transport system.  NOTE: This link may be used during a trip for the walking movement of a passenger from a PLACE (origin of the trip) to a SCHEDULED STOP POINT (origin of the PT TRIP), or for the walking movement from a SCHEDULED STOP POINT (destination of the PT TRIP) to a PLACE (destination of the trip)."
  ; rdfs:subClassOf tm:TRANSFER
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AccessIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACCESS Linkk.." ]
  .

tm:ACCESS_END a owl:Class ;
  rdfs:label "ACCESS END"
  ; rdfs:comment "Origin or destination end of an ACCESS link; may indicate a POINT and/or PLACE."
  ; skos:definition "Origin or destination end of an ACCESS link; may indicate a POINT and/or PLACE."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AccessEndIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACCESS END.." ]
  .

tm:PLACE a owl:Class ;
  rdfs:label "PLACE"
  ; rdfs:comment "A geographic place of any type which may be specified as the origin or destination of a trip.  NOTE: A PLACE may be represented as a POINT (dimension 0), a road section (dimension 1), or a ZONE (dimension 2)."
  ; skos:definition "A geographic place of any type which may be specified as the origin or destination of a trip.  NOTE: A PLACE may be represented as a POINT (dimension 0), a road section (dimension 1), or a ZONE (dimension 2)."
  ; rdfs:subClassOf tm:ZONE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PlaceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PLACE." ]
  .

tm:TRANSFER_END a owl:Class ;
  rdfs:label "TRANSFER END"
  ; rdfs:comment "End point of a TRANSFER."
  ; skos:definition "End point of a TRANSFER."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TransferEndIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TRANSFER END.." ]
  .

tm:TYPE_OF_PLACE a owl:Class ;
  rdfs:label "TYPE OF PLACE"
  ; rdfs:comment "A classification for PLACEs."
  ; skos:definition "A classification for PLACEs."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfPlaceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF PLACE." ]
  .

tm:ACCESS_MODE a owl:Class ;
  rdfs:label "ACCESS MODE"
  ; rdfs:comment "A PERSONAL MODE used to access or leave the public transport system (e.g., by foot, by private bicycle, by private car)."
  ; skos:definition "A PERSONAL MODE used to access or leave the public transport system (e.g., by foot, by private bicycle, by private car)."
  ; rdfs:subClassOf tm:PERSONAL_MODE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AccessModeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACCESS MODE." ]
  .

tm:MODE a owl:Class ;
  rdfs:label "MODE"
  ; rdfs:comment "A broad characterisation of the means of movement and / or operational aspect in consideration (e.g., by bus, by train, by metro, by ferry, by foot, by private car, etc.)."
  ; skos:definition "A broad characterisation of the means of movement and / or operational aspect in consideration (e.g., by bus, by train, by metro, by ferry, by foot, by private car, etc.)."
  ; rdfs:subClassOf tm:TYPE_OF_VALUE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ModeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of MODE." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of MODE." ]
  .

tm:PUBLIC_TRANSPORT_MODE a owl:Class ;
  rdfs:label "PUBLIC TRANSPORT MODE"
  ; rdfs:comment "A MODE used for public transport services (e.g., by bus, by tram, by metro, by train, by ferry, by ship, by shared taxi car, by shared car) under either a CONVENTIONAL MODE OF OPERATION or an ALTERNATIVE MODE OF OPERATION (i.e., excluding a PERSONAL MODE OF OPERATION).  Note: Prior to TM 6.2 this was named VEHICLE MODE"
  ; skos:definition "A MODE used for public transport services (e.g., by bus, by tram, by metro, by train, by ferry, by ship, by shared taxi car, by shared car) under either a CONVENTIONAL MODE OF OPERATION or an ALTERNATIVE MODE OF OPERATION (i.e., excluding a PERSONAL MODE OF OPERATION).  Note: Prior to TM 6.2 this was named VEHICLE MODE"
  ; rdfs:subClassOf tm:MODE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PublicTransportModeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PUBLIC TRANSPORT MODE." ]
  .

tm:SUBMODE a owl:Class ;
  rdfs:label "SUBMODE"
  ; rdfs:comment "A variant of a MODE, as for instance international or domestic rail (rail being the MODE)."
  ; skos:definition "A variant of a MODE, as for instance international or domestic rail (rail being the MODE)."
  ; rdfs:subClassOf tm:TYPE_OF_VALUE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SubmodeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SUBMODE." ]
  .

tm:OPERATING_DAY a owl:Class ;
  rdfs:label "OPERATING DAY"
  ; rdfs:comment "A day of public transport operation of which the characteristics are defined within in a specific SERVICE CALENDAR.  NOTE: An OPERATING DAY may last more than 24 hours."
  ; skos:definition "A day of public transport operation of which the characteristics are defined within in a specific SERVICE CALENDAR.  NOTE: An OPERATING DAY may last more than 24 hours."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "OperatingDayIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of OPERATING DAY." ]
  ; ea:attribute [ ea:name "CalendarDate" ; ea:position 2 ; ea:typeName "date" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Calendar date of OPERATING DAY." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of OPERATING DAY." ]
  ; ea:attribute [ ea:name "ShortName" ; ea:position 4 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Short name of OPERATING DAY." ]
  ; ea:attribute [ ea:name "EarliestTime" ; ea:position 5 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Start time of OPERATING DAY." ]
  ; ea:attribute [ ea:name "DayLength" ; ea:position 6 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Length of OPERATING DAY." ]
  .

tm:SERVICE_CALENDAR a owl:Class ;
  rdfs:label "SERVICE CALENDAR"
  ; rdfs:comment "A collection of DAY TYPE ASSIGNMENTs."
  ; skos:definition "A collection of DAY TYPE ASSIGNMENTs."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ServiceCalendarIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SERVICE CALENDAR." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of SERVICE CALENDAR." ]
  ; ea:attribute [ ea:name "ShortName" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Short name of SERVICE CALENDAR." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 4 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of SERVICE CALENDAR." ]
  ; ea:attribute [ ea:name "From" ; ea:position 5 ; ea:typeName "date" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Inclusive start date for validity of SERVICE CALENDAR." ]
  ; ea:attribute [ ea:name "To" ; ea:position 6 ; ea:typeName "date" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Inclusive end date for validity of SERVICE CALENDAR." ]
  ; ea:attribute [ ea:name "EarliestTime" ; ea:position 7 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Earliest time that days start SERVICE CALENDAR. Default to use if not specified on individual OPERATING DAY." ]
  ; ea:attribute [ ea:name "DayLength" ; ea:position 8 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Day Length used with Earliest time to work out end of day. Default to use if not specified on individual OPERATING DAY." ]
  .

tm:DAY_TYPE a owl:Class ;
  rdfs:label "DAY TYPE"
  ; rdfs:comment "A type of day characterised by one or more properties which affect public transport operation (for example: working day, sunday, weekday in school holidays, etc.)."
  ; skos:definition "A type of day characterised by one or more properties which affect public transport operation (for example: working day, sunday, weekday in school holidays, etc.)."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DayTypeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DAY TYPE." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of DAY TYPE." ]
  ; ea:attribute [ ea:name "ShortName" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Short Name of DAY TYPE." ]
  ; ea:attribute [ ea:name "EarliestTime" ; ea:position 4 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Earliest start time of DAY TYPE." ]
  ; ea:attribute [ ea:name "DayLength" ; ea:position 5 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Length of DAY TYPE." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 6 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of DAY TYPE." ]
  .

tm:PROPERTY_OF_DAY a owl:Class ;
  rdfs:label "PROPERTY OF DAY"
  ; rdfs:comment "A property which a day may possess, such as school holiday, weekday, summer, winter, etc."
  ; skos:definition "A property which a day may possess, such as school holiday, weekday, summer, winter, etc."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Name" ; ea:position 1 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of PROPERTY OF DAY." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of PROPERTY OF DAY." ]
  ; ea:attribute [ ea:name "WeekOfMonth" ; ea:position 3 ; ea:typeName "PositiveInteger" ; ea:lowerBound "0" ; ea:upperBound "5" ; ea:definition "Weeks of month (1-5) assigned to PROPERTY OF DAY." ]
  ; ea:attribute [ ea:name "DayOfYear" ; ea:position 4 ; ea:typeName "monthDay" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "For those day types that occur on the same day every year, month and day, assigned to PROPERTY OF DAY." ]
  ; ea:attribute [ ea:name "Month" ; ea:position 5 ; ea:typeName "month" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Month of year assigned to PROPERTY OF DAY." ]
  ; ea:attribute [ ea:name "Season" ; ea:position 6 ; ea:typeName "SeasonEnum" ; ea:lowerBound "0" ; ea:upperBound "4" ; ea:definition "Season of year assigned to PROPERTY OF DAY. E.g. Spring, Summer, AUtumn, WInter." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 7 ; ea:typeName "PropertyOfDayIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PROPERTY OF DAY." ]
  ; ea:attribute [ ea:name "Tide" ; ea:position 8 ; ea:typeName "TideEnum" ; ea:lowerBound "0" ; ea:upperBound "4" ; ea:definition "State of tide assigned to PROPERTY OF DAY. <font color=\"#0f0f0f\">E.g. High, Low, In between, Neap, Spring</font>" ]
  .

tm:DAY_TYPE_ASSIGNMENT a owl:Class ;
  rdfs:label "DAY TYPE ASSIGNMENT"
  ; rdfs:comment "The assignment of operational characteristics, expressed by DAY TYPEs, to particular OPERATING DAYs within a SERVICE CALENDAR."
  ; skos:definition "The assignment of operational characteristics, expressed by DAY TYPEs, to particular OPERATING DAYs within a SERVICE CALENDAR."
  ; rdfs:subClassOf tm:ASSIGNMENT
  ; ea:kind "class"
