tm:AGGREGATED_BOARDING_AND_ALIGHTING_ENTRY a owl:Class ;
  rdfs:label "AGGREGATED BOARDING AND ALIGHTING ENTRY"
  ; rdfs:comment "The class AGGREGATED BOARDING AND ALIGHTING ENTRY represents a summarized record of passenger movements at a higher level of aggregation, typically for a group of stops, a leg, or an entire journey. It consolidates multiple BOARDING AND ALIGHTING ENTRY instances into a single entry, providing total counts of passengers boarding and alighting rather than individual observations."
  ; skos:definition "The class AGGREGATED BOARDING AND ALIGHTING ENTRY represents a summarized record of passenger movements at a higher level of aggregation, typically for a group of stops, a leg, or an entire journey. It consolidates multiple BOARDING AND ALIGHTING ENTRY instances into a single entry, providing total counts of passengers boarding and alighting rather than individual observations."
  ; rdfs:subClassOf tm:INDICATOR_LOG_ENTRY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "id" ; ea:position 1 ; ea:typeName "AggretedBoardingAndAlightingEntryIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "<font color=\"#0f0f0f\">Identifier of</font> AGGREGATED BOARDING AND ALIGHTING  ENTRY." ]
  .

tm:EXPECTED_PASSENGER_COUNT a owl:Class ;
  rdfs:label "EXPECTED PASSENGER COUNT"
  ; rdfs:comment "Implementation of LOGGABLE OBJECT designed for recording planned number of passengers for a PT SCOPE (i.e. LINE) based on PASSENGER CARRYING REQUIREMENT of a VEHICLE TYPE."
  ; skos:definition "Implementation of LOGGABLE OBJECT designed for recording planned number of passengers for a PT SCOPE (i.e. LINE) based on PASSENGER CARRYING REQUIREMENT of a VEHICLE TYPE."
