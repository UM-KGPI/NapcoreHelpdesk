  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AccountDetectNoCheckInEventIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACCOUNT DETECT NO CHECK IN EVENT." ]
  .

tm:NO_ACCESS_RIGHTS_ENTRY a owl:Class ;
  rdfs:label "NO ACCESS RIGHTS ENTRY"
  ; rdfs:comment "A REVENUE PROTECTION ENTRY recording the detection of a TRANSPORT CUSTOMER travelling without having purchased access rights"
  ; skos:definition "A REVENUE PROTECTION ENTRY recording the detection of a TRANSPORT CUSTOMER travelling without having purchased access rights"
