  .

tm:PT_TRIP a owl:Class ;
  rdfs:label "PT TRIP"
  ; rdfs:comment "A<font color=\"#0f0f0f\"> part of a TRIP PATTERN consisting of a continuous sequence of PT RIDE LEGs and CONNECTION LEGs.</font>  <font color=\"#0f0f0f\">Note: IT must not contain any ACCESS LEGs or PERSONAL LEGs</font>"
  ; skos:definition "A<font color=\"#0f0f0f\"> part of a TRIP PATTERN consisting of a continuous sequence of PT RIDE LEGs and CONNECTION LEGs.</font>  <font color=\"#0f0f0f\">Note: IT must not contain any ACCESS LEGs or PERSONAL LEGs</font>"
  ; rdfs:subClassOf tm:TRIP
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PtTripIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PT TRIP." ]
  .

tm:PT_RIDE_LEG a owl:Class ;
  rdfs:label "PT RIDE LEG"
  ; rdfs:comment "A part of a TRIP PATTERN corresponding to the movement of a user (passenger, driver) on one and only one public transport vehicle (such as a train bus, ferry) from one SCHEDULED STOP POINT to another, on one JOURNEY PATTERN operating in a conventional MODE OF OPERATION."
  ; skos:definition "A part of a TRIP PATTERN corresponding to the movement of a user (passenger, driver) on one and only one public transport vehicle (such as a train bus, ferry) from one SCHEDULED STOP POINT to another, on one JOURNEY PATTERN operating in a conventional MODE OF OPERATION."
  ; rdfs:subClassOf tm:RIDE_LEG
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PtRideLegIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PT RIDE LEG." ]
  .

tm:LEG_TRACK a owl:Class ;
  rdfs:label "LEG TRACK"
  ; rdfs:comment "The spatial projection of the leg as a set of coordinate points for a specific purpose., such as displaying it on a map."
  ; skos:definition "The spatial projection of the leg as a set of coordinate points for a specific purpose., such as displaying it on a map."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "LegTrackIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of LEG TRACK" ]
  ; ea:attribute [ ea:name "Duration" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time needed to make interchange." ]
  .

tm:PATH_GUIDANCE a owl:Class ;
  rdfs:label "PATH GUIDANCE"
  ; rdfs:comment "An instruction to a passenger for an individual step when following a path between the start and the end of a TRANSFER LEG."
  ; skos:definition "An instruction to a passenger for an individual step when following a path between the start and the end of a TRANSFER LEG."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PathGuidanceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PATH GUIDANCE." ]
  ; ea:attribute [ ea:name "Order" ; ea:position 2 ; ea:typeName "integer" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Order of PATH GUIDANCE instruction within TRANSFER LEG." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of PATH STEP INSTRUCTION, e.g. Turn left at fork." ]
  .

tm:TRIP_REASON a owl:Class ;
  rdfs:label "TRIP REASON"
  ; rdfs:comment "A classification of a passenger's reason for undertaking a TRIP PATTERN, e.g., work commute, school pick up, shopping, etc."
