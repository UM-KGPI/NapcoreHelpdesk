tm:BLOCK a owl:Class ;
  rdfs:label "BLOCK"
  ; rdfs:comment "The work required to be done by a vehicle from the time it leaves a PARKING POINT after parking until its next return to park at a PARKING POINT.   NOTE1: A TRAIN COMPOSITION is a VEHICLE.  NOTE2: Any subsequent departure from a PARKING POINT after parking marks the start of a new BLOCK."
  ; skos:definition "The work required to be done by a vehicle from the time it leaves a PARKING POINT after parking until its next return to park at a PARKING POINT.   NOTE1: A TRAIN COMPOSITION is a VEHICLE.  NOTE2: Any subsequent departure from a PARKING POINT after parking marks the start of a new BLOCK."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "BlockIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a BLOCK." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of BLOCK." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of BLOCK." ]
  ; ea:attribute [ ea:name "PreparationDuration" ; ea:position 4 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time allotted for activities required to get ready to start the activity." ]
  ; ea:attribute [ ea:name "FinishingDuration" ; ea:position 5 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time allotted for activities required to bring the BLOCK to an end." ]
  ; ea:attribute [ ea:name "StartTime" ; ea:position 6 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Start time of BLOCK in principle this can be derived from the Start time of the first journey and the preparation duration." ]
  ; ea:attribute [ ea:name "StartTimeDayOffset" ; ea:position 7 ; ea:typeName "DayOffsetType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Day offset of start time from OPERATING DAY." ]
  ; ea:attribute [ ea:name "EndTime" ; ea:position 8 ; ea:typeName "time" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "End time of BLOCK in principle this can be derived from the Start time of the last journey and the finishing duration." ]
  ; ea:attribute [ ea:name "EndTimeDayOffset" ; ea:position 9 ; ea:typeName "DayOffsetType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Day offset of end time from start time." ]
  .

tm:NORMAL_DATED_BLOCK a owl:Class ;
  rdfs:label "NORMAL DATED BLOCK"
  ; rdfs:comment "A DATED BLOCK identical to a long-term planned BLOCK, possibly updated according to short-term modifications decided by the control staff."
  ; skos:definition "A DATED BLOCK identical to a long-term planned BLOCK, possibly updated according to short-term modifications decided by the control staff."
