tm:SERVICE_DIMENSIONS a owl:Class ;
  rdfs:label "SERVICE DIMENSIONS"
  ; rdfs:comment "Implementation of LOGGABLE OBJECT designed for recording dimensions of planned service (lines, journeys, seats, etc.)  for a PT SCOPE (i.e. LINE).  Following calculations can be derived per PT Scope:  - numberOfSeats = capacityPerJourney x totalJourneys  - meanNumberOfSeats = Σ(capacityPerJourney) / Σ(plannedJourneyDistance),     where:  capacityPerJourney = capacityPerVehicle &#215; vehiclesAssignedToJourney,  capacityPerVehicle = seatingCapacity + standingCapacity + wheelchairPlaceCapacity  Seat capacities are obtained from the PASSENGER CARRYING REQUIREMENT of the associated VEHICLE TYPE."
  ; skos:definition "Implementation of LOGGABLE OBJECT designed for recording dimensions of planned service (lines, journeys, seats, etc.)  for a PT SCOPE (i.e. LINE).  Following calculations can be derived per PT Scope:  - numberOfSeats = capacityPerJourney x totalJourneys  - meanNumberOfSeats = Σ(capacityPerJourney) / Σ(plannedJourneyDistance),     where:  capacityPerJourney = capacityPerVehicle &#215; vehiclesAssignedToJourney,  capacityPerVehicle = seatingCapacity + standingCapacity + wheelchairPlaceCapacity  Seat capacities are obtained from the PASSENGER CARRYING REQUIREMENT of the associated VEHICLE TYPE."
  ; rdfs:subClassOf tm:INDICATOR
  ; ea:kind "class"
  ; ea:attribute [ ea:name "NumberOfStopPoints" ; ea:position 1 ; ea:typeName "nonNegativeInteger" ; ea:lowerBound "0" ; ea:upperBound "1" ]
  ; ea:attribute [ ea:name "NumberOfLines" ; ea:position 2 ; ea:typeName "nonNegativeInteger" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Expected number of passengers." ]
  ; ea:attribute [ ea:name "NumberOfRoutes" ; ea:position 3 ; ea:typeName "nonNegativeInteger" ; ea:lowerBound "0" ; ea:upperBound "1" ]
  ; ea:attribute [ ea:name "NumberOfJourneys" ; ea:position 4 ; ea:typeName "nonNegativeInteger" ; ea:lowerBound "0" ; ea:upperBound "1" ]
  ; ea:attribute [ ea:name "TotalLengthOfRoutes" ; ea:position 5 ; ea:typeName "LengthType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Total length of ROUTEs within the scope." ]
  ; ea:attribute [ ea:name "TotalLengthOfNetwork" ; ea:position 6 ; ea:typeName "LengthType" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Total length of ROUTE LINKs comprising the network within the scope." ]
  ; ea:attribute [ ea:name "TotalVehicleJourneyDistance" ; ea:position 7 ; ea:typeName "DistanceType" ; ea:lowerBound "0" ; ea:upperBound "1" ]
  ; ea:attribute [ ea:name "TotalServiceJourneyDistance" ; ea:position 8 ; ea:typeName "DistanceType" ; ea:lowerBound "0" ; ea:upperBound "1" ]
  ; ea:attribute [ ea:name "TotalTrainVehicleJourneyDistance" ; ea:position 9 ; ea:typeName "DistanceType" ; ea:lowerBound "0" ; ea:upperBound "1" ]
  ; ea:attribute [ ea:name "TotalTrainServiceJourneyDistance" ; ea:position 10 ; ea:typeName "DistanceType" ; ea:lowerBound "0" ; ea:upperBound "1" ]
  .

