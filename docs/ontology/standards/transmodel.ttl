  .

tm:SPLIT_DUTY a owl:Class ;
  rdfs:label "SPLIT DUTY"
  ; rdfs:comment "A classification of a DUTY, in terms of working hours comprising several time bands separated in different DUTY PARTs by periods of unpaid time."
  ; skos:definition "A classification of a DUTY, in terms of working hours comprising several time bands separated in different DUTY PARTs by periods of unpaid time."
  ; rdfs:subClassOf tm:DUTY_TYPE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SplitDutyIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SPLIT DUTY." ]
  .

tm:DRIVER_SCHEDULE_FRAME a owl:Class ;
  rdfs:label "DRIVER SCHEDULE FRAME"
  ; rdfs:comment "A coherent set of DUTies to which the same set of VALIDITY CONDITIONs have been assigned."
  ; skos:definition "A coherent set of DUTies to which the same set of VALIDITY CONDITIONs have been assigned."
