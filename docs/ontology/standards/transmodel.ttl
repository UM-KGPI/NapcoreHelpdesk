  ; rdfs:subClassOf tm:FARE_CONTRACT_ENTRY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FulfilmentEntryIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a FULFILMENT ENTRY." ]
  .

tm:MEDIA_RESTORE_ENTRY a owl:Class ;
  rdfs:label "MEDIA RESTORE ENTRY"
  ; rdfs:comment "A FULFILMENT ENTRY recording the replacement of the MEDIUM ACCESS DEVICE."
  ; skos:definition "A FULFILMENT ENTRY recording the replacement of the MEDIUM ACCESS DEVICE."
  ; rdfs:subClassOf tm:FULFILMENT_ENTRY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "MediaRestoreEntryIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of MEDIA RESTORE ENTRY." ]
  .

tm:FARE_SECURITY_MANAGER_ROLE a owl:Class ;
  rdfs:label "FARE SECURITY MANAGER ROLE"
  ; rdfs:comment "<font color=\"#0f0f0f\">The ADMINISTRATIVE ORGANISATION ROLE of establishing and coordinating a security policy for fare data across the provider organisations, and of the certifying and auditing of organisations, applications, etc., for their conformance to the security policy.</font>"
  ; skos:definition "<font color=\"#0f0f0f\">The ADMINISTRATIVE ORGANISATION ROLE of establishing and coordinating a security policy for fare data across the provider organisations, and of the certifying and auditing of organisations, applications, etc., for their conformance to the security policy.</font>"
  ; rdfs:subClassOf tm:SECURITY_MANAGER_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FareSecurityManagerRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FARE SECURITY MANAGER ROLE." ]
  .

tm:FARE_DATA_COLLECTOR_ROLE a owl:Class ;
  rdfs:label "FARE DATA COLLECTOR ROLE"
  ; rdfs:comment "The role of collecting and forwarding fare data between the various parties concerned with product delivery, such as PRODUCT RETAILER, PRODUCT OWNER, etc.  NOTE: May be undertaken by a separate intermediary."
  ; skos:definition "The role of collecting and forwarding fare data between the various parties concerned with product delivery, such as PRODUCT RETAILER, PRODUCT OWNER, etc.  NOTE: May be undertaken by a separate intermediary."
  ; rdfs:subClassOf tm:DATA_COLLECTOR_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DataCollectorRoleIdTypeFare" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FARE DATA COLLECTOR ROLE." ]
  .

tm:FARE_PRODUCT_RETAILER_ROLE a owl:Class ;
  rdfs:label "FARE PRODUCT RETAILER ROLE"
  ; rdfs:comment "The role of an organisation to sell products to TRANSPORT CUSTOMERs, as authorised by the holder of a FARE PRODUCT OWNER ROLE.  NOTE: The FARE PRODUCT RETAILER ROLE may be undertaken by the same party as the FARE PRODUCT OWNER ROLE, the ACCOUNT PROVIDER ROLE, or a secondary outlet such as a TRAVEL AGENT, newsagent, or other third party, etc."
  ; skos:definition "The role of an organisation to sell products to TRANSPORT CUSTOMERs, as authorised by the holder of a FARE PRODUCT OWNER ROLE.  NOTE: The FARE PRODUCT RETAILER ROLE may be undertaken by the same party as the FARE PRODUCT OWNER ROLE, the ACCOUNT PROVIDER ROLE, or a secondary outlet such as a TRAVEL AGENT, newsagent, or other third party, etc."
  ; rdfs:subClassOf tm:FARE_ORGANISATION_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FareProductRetailerRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FARE PRODUCT RETAILER ROLE." ]
  .

tm:FARE_REGISTRAR_ROLE a owl:Class ;
  rdfs:label "FARE REGISTRAR ROLE"
  ; rdfs:comment "The ADMINISTRATIVE ORGANISATION ROLE of coordinating the issue of unique registration codes (for example, by determining rules for generating unique codes) for data linked to fare management such as FARE CONTRACTs, TRAVEL DOCUMENTs, etc."
  ; skos:definition "The ADMINISTRATIVE ORGANISATION ROLE of coordinating the issue of unique registration codes (for example, by determining rules for generating unique codes) for data linked to fare management such as FARE CONTRACTs, TRAVEL DOCUMENTs, etc."
  ; rdfs:subClassOf tm:REGISTRAR_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FareRegistrarRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FARE REGISTRAR ROLE." ]
  .

tm:FARE_ORGANISATION_ROLE a owl:Class ;
  rdfs:label "FARE ORGANISATION ROLE"
  ; rdfs:comment "Any corporate role in providing or managing transport services."
  ; skos:definition "Any corporate role in providing or managing transport services."
  ; rdfs:subClassOf tm:ORGANISATION_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FareOrganisationRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FARE ORGANISATION ROLE." ]
  .

tm:FARE_PRODUCT_ISSUER_ROLE a owl:Class ;
  rdfs:label "FARE PRODUCT ISSUER ROLE"
  ; rdfs:comment "A role of an organisation introduced when there are a large number of fare product owners and a large number of distributors.  NOTE: The FARE PRODUCT ISSUER ROLE makes a portfolio of products available to a product distributor to be sold via product retailers to TRANSPORT CUSTOMERs."
  ; skos:definition "A role of an organisation introduced when there are a large number of fare product owners and a large number of distributors.  NOTE: The FARE PRODUCT ISSUER ROLE makes a portfolio of products available to a product distributor to be sold via product retailers to TRANSPORT CUSTOMERs."
  ; rdfs:subClassOf tm:FARE_ORGANISATION_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FareProductIssuerRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FARE PRODUCT ISSUER ROLE." ]
  .

tm:FARE_PRODUCT_ATTRIBUTOR_ROLE a owl:Class ;
  rdfs:label "FARE PRODUCT ATTRIBUTOR ROLE"
  ; rdfs:comment "The role of being an agent of a FARE PRODUCT OWNER, i.e., the role of an intermediary organisation to whom certain responsibilities have been delegated by the FARE PRODUCT OWNER, for instance to provide the technical implementation of the products defined by the FARE PRODUCT OWNER."
  ; skos:definition "The role of being an agent of a FARE PRODUCT OWNER, i.e., the role of an intermediary organisation to whom certain responsibilities have been delegated by the FARE PRODUCT OWNER, for instance to provide the technical implementation of the products defined by the FARE PRODUCT OWNER."
  ; rdfs:subClassOf tm:FARE_ORGANISATION_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FareProductAttributorRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FARE PRODUCT ATTRIBUTOR ROLE." ]
  .

tm:FARE_PRODUCT_DISTRIBUTOR_ROLE a owl:Class ;
  rdfs:label "FARE PRODUCT DISTRIBUTOR ROLE"
  ; rdfs:comment "<font color=\"#0f0f0f\">The role, in large networks, of organising and accounting for the wholesale distribution of FARE PRODUCTs, as delegated by the FARE PRODUCT OWNER ROLE and to supply products to the FARE PRODUCT RETAILER ROLE.</font>"
  ; skos:definition "<font color=\"#0f0f0f\">The role, in large networks, of organising and accounting for the wholesale distribution of FARE PRODUCTs, as delegated by the FARE PRODUCT OWNER ROLE and to supply products to the FARE PRODUCT RETAILER ROLE.</font>"
  ; rdfs:subClassOf tm:FARE_ORGANISATION_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FareProductDIstributorRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FARE PRODUCT DISTRIBUTOR ROLE." ]
  .

tm:FARE_PRODUCT_OWNER_ROLE a owl:Class ;
  rdfs:label "FARE PRODUCT OWNER ROLE"
  ; rdfs:comment "The role of the organisation which has commercial ownership of a FARE PRODUCT and is responsible for specifying pricing, usage conditions and commercial rules for the product, for ensuring there are processes for marketing and retailing the product, customer payment, control and validation, back office accounting and settlement and for customer service."
  ; skos:definition "The role of the organisation which has commercial ownership of a FARE PRODUCT and is responsible for specifying pricing, usage conditions and commercial rules for the product, for ensuring there are processes for marketing and retailing the product, customer payment, control and validation, back office accounting and settlement and for customer service."
  ; rdfs:subClassOf tm:FARE_ORGANISATION_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FareProductOwnerRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FARE PRODUCT OWNER ROLE." ]
  .

tm:PAYMENT_PROVIDER_ROLE a owl:Class ;
  rdfs:label "PAYMENT PROVIDER ROLE"
  ; rdfs:comment "The role of channelling funds from the CUSTOMER to the FARE PRODUCT RETAILER for travel services, and particularly for usage-based travel products (e.g., EMV provider, ApplePay, PayPal, Android Pay, etc.)."
  ; skos:definition "The role of channelling funds from the CUSTOMER to the FARE PRODUCT RETAILER for travel services, and particularly for usage-based travel products (e.g., EMV provider, ApplePay, PayPal, Android Pay, etc.)."
  ; rdfs:subClassOf tm:TECHNOLOGY_ORGANISATION_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PaymentProviderRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PAYMENT PROVIDER ROLE." ]
  .

tm:IDENTITY_PROVIDER_ROLE a owl:Class ;
  rdfs:label "IDENTITY PROVIDER ROLE"
  ; rdfs:comment "The role of supplying a trusted identity token that can be associated with a CUSTOMER ACCOUNT, TRAVEL DOCUMENT, etc.  NOTE: The IDENTITY PROVIDER ROLE may be undertaken by transport AUTHORITies and OPERATORs, but also non-transport organisations, such as governments central and local, mobile network operators, or online service providers (e.g., Google, Facebook) and banks."
  ; skos:definition "The role of supplying a trusted identity token that can be associated with a CUSTOMER ACCOUNT, TRAVEL DOCUMENT, etc.  NOTE: The IDENTITY PROVIDER ROLE may be undertaken by transport AUTHORITies and OPERATORs, but also non-transport organisations, such as governments central and local, mobile network operators, or online service providers (e.g., Google, Facebook) and banks."
  ; rdfs:subClassOf tm:TECHNOLOGY_ORGANISATION_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "IdentityProviderRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of IDENTITY PROVIDER ROLE." ]
  .

tm:MEDIUM_APPLICATION_OWNER_ROLE a owl:Class ;
  rdfs:label "MEDIUM APPLICATION OWNER ROLE"
  ; rdfs:comment "For media-centric products, the APPLICATION OWNER ROLE has commercial ownership of the software MEDIA APPLICATION hosting a product and is contracted by the PRODUCT OWNER for the use of the application with the customer."
  ; skos:definition "For media-centric products, the APPLICATION OWNER ROLE has commercial ownership of the software MEDIA APPLICATION hosting a product and is contracted by the PRODUCT OWNER for the use of the application with the customer."
  ; rdfs:subClassOf tm:TECHNOLOGY_ORGANISATION_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "MediumApplicationOwnerRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of MEDIUM APPLICATION OWNER ROLE." ]
  .

tm:MEDIA_PROVIDER_ROLE a owl:Class ;
  rdfs:label "MEDIA PROVIDER ROLE"
  ; rdfs:comment "The role of supplying the media used for the TRAVEL DOCUMENT, that is a physical support containing a machine readable/writable data/processor application.  NOTE: This can include transport industry smartcards, payment industry contactless cards, public sector issued cards, mobile phones or paper (for barcodes), new formats such as watches and key fobs, and NFC enabled devices."
  ; skos:definition "The role of supplying the media used for the TRAVEL DOCUMENT, that is a physical support containing a machine readable/writable data/processor application.  NOTE: This can include transport industry smartcards, payment industry contactless cards, public sector issued cards, mobile phones or paper (for barcodes), new formats such as watches and key fobs, and NFC enabled devices."
  ; rdfs:subClassOf tm:TECHNOLOGY_ORGANISATION_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "MediaProviderRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of MEDIA PROVIDER ROLE." ]
  .

tm:MEDIUM_APPLICATION_PROVIDER_ROLE a owl:Class ;
  rdfs:label "MEDIUM APPLICATION PROVIDER ROLE"
  ; rdfs:comment "For media-centric products, the APPLICATION PROVIDER supplies the software application that hosts a TRAVEL DOCUMENT and presents it to CONTROL DEVICEs for automatic control and validation."
  ; skos:definition "For media-centric products, the APPLICATION PROVIDER supplies the software application that hosts a TRAVEL DOCUMENT and presents it to CONTROL DEVICEs for automatic control and validation."
  ; rdfs:subClassOf tm:TECHNOLOGY_ORGANISATION_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "MediumApplicationProviderRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of MEDIUM APPLICATION PROVIDER ROLE." ]
  .

tm:ACCOUNT_PROVIDER_ROLE a owl:Class ;
  rdfs:label "ACCOUNT PROVIDER ROLE"
  ; rdfs:comment "In Account Based Ticketing, the ACCOUNT PROVIDER provides the online account by means of which the product is delivered. Normally this involves a direct relationship with the CUSTOMER, though it may also be done as a white-labelled service for another party."
  ; skos:definition "In Account Based Ticketing, the ACCOUNT PROVIDER provides the online account by means of which the product is delivered. Normally this involves a direct relationship with the CUSTOMER, though it may also be done as a white-labelled service for another party."
  ; rdfs:subClassOf tm:TECHNOLOGY_ORGANISATION_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AccountProviderRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACCOUNT PROVIDER ROLE." ]
  .

tm:GROUP_MEMBER_ROLE a owl:Class ;
  rdfs:label "GROUP MEMBER ROLE"
  ; rdfs:comment "The role of a passenger travelling under the access rights granted by a GROUP TICKET."
  ; skos:definition "The role of a passenger travelling under the access rights granted by a GROUP TICKET."
  ; rdfs:subClassOf tm:PASSENGER_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "GroupMemberRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of GROUP MEMBER ROLE." ]
  .

tm:PASSENGER_ROLE a owl:Class ;
  rdfs:label "PASSENGER ROLE"
  ; rdfs:comment "The general role of consuming a travel service."
  ; skos:definition "The general role of consuming a travel service."
  ; rdfs:subClassOf tm:TRANSPORT_USER_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PassengerRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PASSENGER ROLE." ]
  .

tm:OFFENDER_ROLE a owl:Class ;
  rdfs:label "OFFENDER ROLE"
  ; rdfs:comment "The role enacted by someone attempting to travel with no or insufficient access rights."
  ; skos:definition "The role enacted by someone attempting to travel with no or insufficient access rights."
  ; rdfs:subClassOf tm:PASSENGER_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "OffenderRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of OFFENDER ROLE." ]
  .

tm:INDIVIDUAL_PASSENGER_ROLE a owl:Class ;
  rdfs:label "INDIVIDUAL PASSENGER ROLE"
  ; rdfs:comment "The role of a passenger consuming a travel service as a single individual."
  ; skos:definition "The role of a passenger consuming a travel service as a single individual."
  ; rdfs:subClassOf tm:PASSENGER_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "IndividualPassengerRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of INDIVIDUAL PASSENGER ROLE." ]
  .

tm:INDIVIDUAL_PURCHASER_ROLE a owl:Class ;
  rdfs:label "INDIVIDUAL PURCHASER ROLE"
  ; rdfs:comment "The role of a person in purchasing a FARE PRODUCT as a private individual; often, but not necessarily, the same as the PASSENGER ROLE."
  ; skos:definition "The role of a person in purchasing a FARE PRODUCT as a private individual; often, but not necessarily, the same as the PASSENGER ROLE."
  ; rdfs:subClassOf tm:PURCHASER_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "IndividualPurchaserRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of INDIVIDUAL PURCHASER ROLE." ]
  .

tm:COMPANION_ROLE a owl:Class ;
  rdfs:label "COMPANION ROLE"
  ; rdfs:comment "The role of accompanying another passenger under the access rights granted by the other passenger's ticket."
  ; skos:definition "The role of accompanying another passenger under the access rights granted by the other passenger's ticket."
  ; rdfs:subClassOf tm:PASSENGER_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "CompanionRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of COMPANION ROLE." ]
  .

tm:CORPORATE_PURCHASER_ROLE a owl:Class ;
  rdfs:label "CORPORATE PURCHASER ROLE"
  ; rdfs:comment "The role of purchasing FARE PRODUCTs on behalf of a corporate body such as a company, school, government department, etc."
  ; skos:definition "The role of purchasing FARE PRODUCTs on behalf of a corporate body such as a company, school, government department, etc."
  ; rdfs:subClassOf tm:PURCHASER_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "CorporatePurchaserRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CORPORATE PURCHASER ROLE." ]
  .

tm:PURCHASER_ROLE a owl:Class ;
  rdfs:label "PURCHASER ROLE"
  ; rdfs:comment "The role of the party who pays for a travel service for one or more TRANSPORT CUSTOMERs."
  ; skos:definition "The role of the party who pays for a travel service for one or more TRANSPORT CUSTOMERs."
  ; rdfs:subClassOf tm:TRANSPORT_USER_ROLE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PurchaserRoleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PURCHASER ROLE." ]
  .

tm:TYPE_OF_OFFENCE a owl:Class ;
  rdfs:label "TYPE OF OFFENCE"
  ; rdfs:comment "A classification of OFFENCE, for example wrong CLASS OF SEAT, not valid for PRODUCT CATEGORY, etc."
  ; skos:definition "A classification of OFFENCE, for example wrong CLASS OF SEAT, not valid for PRODUCT CATEGORY, etc."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfOffenceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF OFFENCE." ]
  .

tm:OTHER_CONTROL_MEANS a owl:Class ;
  rdfs:label "OTHER CONTROL MEANS"
  ; rdfs:comment "A particular means other than a control device, for example a manual procedure, used to control apply control processes."
  ; skos:definition "A particular means other than a control device, for example a manual procedure, used to control apply control processes."
  ; rdfs:subClassOf tm:CONTROL_MEANS
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "OtherControlMeansIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of OTHER CONTROL MEANS." ]
  .

tm:CONTROL_TYPE a owl:Class ;
  rdfs:label "CONTROL TYPE"
  ; rdfs:comment "A classification of passenger controls, e.g., entry, exit, en route or occasional controls."
  ; skos:definition "A classification of passenger controls, e.g., entry, exit, en route or occasional controls."
  ; rdfs:subClassOf tm:TYPE_OF_VALUE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ControlTypeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CONTROL TYPE." ]
  .

tm:DEVICE_PARAMETER_ASSIGNMENT a owl:Class ;
  rdfs:label "DEVICE PARAMETER ASSIGNMENT"
  ; rdfs:comment "An ACCESS RIGHT PARAMETER ASSIGNMENT expressing the location (or other fixed parameters) of a CONTROL MEANS."
  ; skos:definition "An ACCESS RIGHT PARAMETER ASSIGNMENT expressing the location (or other fixed parameters) of a CONTROL MEANS."
  ; rdfs:subClassOf tm:ACCESS_RIGHT_PARAMETER_ASSIGNMENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DeviceParameterAssignmentIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DEVICE PARAMETER ASSIGNMENT." ]
  .

tm:DEVICE_RELATED_CONTROL_MEANS a owl:Class ;
  rdfs:label "DEVICE RELATED CONTROL MEANS"
  ; rdfs:comment "A specific device constituting the CONTROL MEANS to control TRAVEL DOCUMENTs."
  ; skos:definition "A specific device constituting the CONTROL MEANS to control TRAVEL DOCUMENTs."
  ; rdfs:subClassOf tm:CONTROL_MEANS
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DeviceRelatedControlMeansIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a DEVICE RELATED CONTROL MEANS." ]
  .

tm:CONTROL_MEANS a owl:Class ;
  rdfs:label "CONTROL MEANS"
  ; rdfs:comment "A particular means (control device or manual control procedure) used to control TRAVEL DOCUMENTs."
  ; skos:definition "A particular means (control device or manual control procedure) used to control TRAVEL DOCUMENTs."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ControlMeansIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CONTROL MEANS." ]
  .

tm:CONTROLLED_ACCESS a owl:Class ;
  rdfs:label "CONTROLLED ACCESS"
  ; rdfs:comment "A validated use of a CONTROLLABLE ELEMENT."
  ; skos:definition "A validated use of a CONTROLLABLE ELEMENT."
  ; rdfs:subClassOf tm:CONTROL_RECORD
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ControlledAccessIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CONTROLLED ACCESS." ]
  .

tm:CONTROL_PARAMETER_ASSIGNMENT a owl:Class ;
  rdfs:label "CONTROL PARAMETER ASSIGNMENT"
  ; rdfs:comment "An ACCESS RIGHT PARAMETER ASSIGNMENT relating a fare collection parameter to a CONTROL ENTRY."
  ; skos:definition "An ACCESS RIGHT PARAMETER ASSIGNMENT relating a fare collection parameter to a CONTROL ENTRY."
  ; rdfs:subClassOf tm:ACCESS_RIGHT_PARAMETER_ASSIGNMENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ControlParameterAssignmentIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CONTROL PARAMETER ASSIGNMENT." ]
  .

tm:CONTROL_ENTRY a owl:Class ;
  rdfs:label "CONTROL ENTRY"
  ; rdfs:comment "The description of a control action, i.e., the comparison of actual and current parameters (time, location, etc.) to the access rights to which the holder of a TRAVEL DOCUMENT is entitled."
  ; skos:definition "The description of a control action, i.e., the comparison of actual and current parameters (time, location, etc.) to the access rights to which the holder of a TRAVEL DOCUMENT is entitled."
  ; rdfs:subClassOf tm:CONTROL_RECORD
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ControlEntryIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CONTROL ENTRY." ]
  .

tm:FARE_TRIP_ACTIVATION_ENTRY a owl:Class ;
  rdfs:label "FARE TRIP ACTIVATION ENTRY"
