  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PointInJourneyPatternIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of POINT IN JOURNEY PATTERN." ]
  .

tm:JOURNEY_PATTERN a owl:Class ;
  rdfs:label "JOURNEY PATTERN"
  ; rdfs:comment "An ordered list of SCHEDULED STOP POINTs and TIMING POINTs on a single ROUTE, describing the pattern of working for public transport vehicles.  NOTE1: A JOURNEY PATTERN may pass through the same POINT more than once.  NOTE2: The first point of a JOURNEY PATTERN is the origin; the last point is the destination."
  ; skos:definition "An ordered list of SCHEDULED STOP POINTs and TIMING POINTs on a single ROUTE, describing the pattern of working for public transport vehicles.  NOTE1: A JOURNEY PATTERN may pass through the same POINT more than once.  NOTE2: The first point of a JOURNEY PATTERN is the origin; the last point is the destination."
  ; rdfs:subClassOf tm:LINK_SEQUENCE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyPatternIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY PATTERN." ]
  .

tm:DEAD_RUN_PATTERN a owl:Class ;
  rdfs:label "DEAD RUN PATTERN"
  ; rdfs:comment "A JOURNEY PATTERN to be used for DEAD RUNs."
  ; skos:definition "A JOURNEY PATTERN to be used for DEAD RUNs."
  ; rdfs:subClassOf tm:JOURNEY_PATTERN
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DeadRunPatternIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DEAD RUN PATTERN." ]
  .

tm:TIMING_POINT_IN_JOURNEY_PATTERN a owl:Class ;
  rdfs:label "TIMING POINT IN JOURNEY PATTERN"
  ; rdfs:comment "A POINT in a JOURNEY PATTERN which is a TIMING POINT."
  ; skos:definition "A POINT in a JOURNEY PATTERN which is a TIMING POINT."
  ; rdfs:subClassOf tm:POINT_IN_LINK_SEQUENCE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TimingPointInJourneyPatternId" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TIMING POINT IN JOURNEY PATTERN." ]
  ; ea:attribute [ ea:name "IsWaitPoint" ; ea:position 2 ; ea:typeName "boolean" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Whether TIMING POINT is a wait point." ]
  .

tm:TIMING_LINK_IN_JOURNEY_PATTERN a owl:Class ;
  rdfs:label "TIMING LINK IN JOURNEY PATTERN"
  ; rdfs:comment "The position of a TIMING LINK in a JOURNEY PATTERN.  NOTE: This entity is needed if a TIMING LINK is repeated in the same JOURNEY PATTERN, and separate information is to be stored about each iteration of the TIMING LINK."
  ; skos:definition "The position of a TIMING LINK in a JOURNEY PATTERN.  NOTE: This entity is needed if a TIMING LINK is repeated in the same JOURNEY PATTERN, and separate information is to be stored about each iteration of the TIMING LINK."
  ; rdfs:subClassOf tm:LINK_IN_LINK_SEQUENCE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TimingLinkInJourneyPatternIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TIMING LINK IN JOURNEY PATTERN." ]
  .

tm:TIMING_POINT a owl:Class ;
  rdfs:label "TIMING POINT"
  ; rdfs:comment "A POINT against which the timing information necessary to build schedules may be recorded."
  ; skos:definition "A POINT against which the timing information necessary to build schedules may be recorded."
  ; rdfs:subClassOf tm:POINT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TimingPointIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a TIMING POINT." ]
  ; ea:attribute [ ea:name "Category" ; ea:position 2 ; ea:typeName "string" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Category of a TIMING POINT." ]
  ; ea:attribute [ ea:name "AllowedForWaitTime" ; ea:position 3 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Default Wait time to use for TIMING PATTERNs that use TIMING POINT. TIME DEMAND TYPE specific values may be specified using a TIME DEMAND TYPE TIMING." ]
  ; ea:attribute [ ea:name "Flexible" ; ea:position 4 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether TIMING POINT is usable in a FLEXIBLE JOURNEY." ]
  ; ea:attribute [ ea:name "TimingPointType" ; ea:position 5 ; ea:typeName "TimingStatusEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Timing status of POINT; principle, secondary, other." ]
  .

tm:GROUP_OF_TIMING_LINKS a owl:Class ;
  rdfs:label "GROUP OF TIMING LINKS"
  ; rdfs:comment "A set of TIMING LINKs grouped together according to the similarity of TIME BANDs which are relevant to them.  NOTE: There may be a GROUP OF TIMING LINKS which covers all TIMING LINKs, for use when different GROUPs OF TIMING LINKS are not needed."
  ; skos:definition "A set of TIMING LINKs grouped together according to the similarity of TIME BANDs which are relevant to them.  NOTE: There may be a GROUP OF TIMING LINKS which covers all TIMING LINKs, for use when different GROUPs OF TIMING LINKS are not needed."
  ; rdfs:subClassOf tm:GROUP_OF_LINKS
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "GroupOfTimingLinksIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of GROUP OF TIMING LINKS." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Description of GROUP OF TIMING LINKS." ]
  .

tm:TIMING_LINK a owl:Class ;
  rdfs:label "TIMING LINK"
  ; rdfs:comment "An ordered pair of TIMING POINTs for which run times may be recorded."
  ; skos:definition "An ordered pair of TIMING POINTs for which run times may be recorded."
  ; rdfs:subClassOf tm:LINK
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TimingLinkIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a TIMING LINK." ]
  .

tm:TIMING_PATTERN a owl:Class ;
  rdfs:label "TIMING PATTERN"
  ; rdfs:comment "The subset of a JOURNEY PATTERN made up only of TIMING POINTs IN JOURNEY PATTERN."
  ; skos:definition "The subset of a JOURNEY PATTERN made up only of TIMING POINTs IN JOURNEY PATTERN."
  ; rdfs:subClassOf tm:LINK_SEQUENCE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TimingPatternIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TIMING PATTERN." ]
  .

tm:DEFAULT_CONNECTION a owl:Class ;
  rdfs:label "DEFAULT CONNECTION"
  ; rdfs:comment "The physical (spatial) possibility for a passenger to change from one public transport vehicle to another to continue the trip.   NOTE1: It specifies default times to be used to change from one mode of transport to another at an area or national level as specified by a TOPOGRAPHIC PLACE, STOP AREA or SITE ELEMENT.   NOTE2: It may be further restricted to a specific MODE or OPERATOR or only apply in a particular direction of transfer, e.g., bus to rail may have a different time for rail to bus."
  ; skos:definition "The physical (spatial) possibility for a passenger to change from one public transport vehicle to another to continue the trip.   NOTE1: It specifies default times to be used to change from one mode of transport to another at an area or national level as specified by a TOPOGRAPHIC PLACE, STOP AREA or SITE ELEMENT.   NOTE2: It may be further restricted to a specific MODE or OPERATOR or only apply in a particular direction of transfer, e.g., bus to rail may have a different time for rail to bus."
  ; rdfs:subClassOf tm:TRANSFER
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DefaultConnectionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DEFAULT CONNECTION." ]
  .

tm:DEFAULT_CONNECTION_END a owl:Class ;
  rdfs:label "DEFAULT CONNECTION END"
  ; rdfs:comment "One end of a DEFAULT CONNECTION."
  ; skos:definition "One end of a DEFAULT CONNECTION."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "DefaultConnectionEndIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DEFAULT CONNECTION END." ]
  .

tm:SITE_CONNECTION_END a owl:Class ;
  rdfs:label "SITE CONNECTION END"
  ; rdfs:comment "One end of a SITE CONNECTION."
  ; skos:definition "One end of a SITE CONNECTION."
  ; rdfs:subClassOf tm:CONNECTION_END
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SiteConnectionEndIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SITE CONNECTION END." ]
  .

tm:SITE_CONNECTION a owl:Class ;
  rdfs:label "SITE CONNECTION"
  ; rdfs:comment "The physical (spatial) possibility for a passenger to change from one public transport vehicle to another to continue the trip, determined by physical locations, such as SITEs and/or its components and/or ENTRANCEs, in particular STOP PLACEs and/or its components.  NOTE: Different times may be necessary to cover the resulting distance, depending on the kind of passenger."
  ; skos:definition "The physical (spatial) possibility for a passenger to change from one public transport vehicle to another to continue the trip, determined by physical locations, such as SITEs and/or its components and/or ENTRANCEs, in particular STOP PLACEs and/or its components.  NOTE: Different times may be necessary to cover the resulting distance, depending on the kind of passenger."
  ; rdfs:subClassOf tm:TRANSFER
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SiteConnectionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SITE CONNECTION link." ]
  .

tm:CONNECTION_END a owl:Class ;
  rdfs:label "CONNECTION END"
  ; rdfs:comment "One end of a CONNECTION."
  ; skos:definition "One end of a CONNECTION."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ConnectionEndIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CONNECTION END;" ]
  .

tm:SERVICE_LINK a owl:Class ;
  rdfs:label "SERVICE LINK"
  ; rdfs:comment "A LINK between an ordered pair of SCHEDULED STOP POINTs."
  ; skos:definition "A LINK between an ordered pair of SCHEDULED STOP POINTs."
  ; rdfs:subClassOf tm:LINK
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ServiceLinkIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a SERVICE LINK." ]
  .

tm:SERVICE_PATTERN a owl:Class ;
  rdfs:label "SERVICE PATTERN"
  ; rdfs:comment "The subset of a JOURNEY PATTERN made up only of STOP POINTs IN JOURNEY PATTERN."
  ; skos:definition "The subset of a JOURNEY PATTERN made up only of STOP POINTs IN JOURNEY PATTERN."
  ; rdfs:subClassOf tm:LINK_SEQUENCE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ServicePatternIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a SERVICE PATTERN." ]
  .

tm:SERVICE_JOURNEY_PATTERN a owl:Class ;
  rdfs:label "SERVICE JOURNEY PATTERN"
  ; rdfs:comment "The JOURNEY PATTERN for a (passenger carrying) SERVICE JOURNEY."
  ; skos:definition "The JOURNEY PATTERN for a (passenger carrying) SERVICE JOURNEY."
  ; rdfs:subClassOf tm:JOURNEY_PATTERN
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ServiceJourneyPatternIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SERVICE JOURNEY PATTERN." ]
  .

tm:SCHEDULED_STOP_POINT a owl:Class ;
  rdfs:label "SCHEDULED STOP POINT"
  ; rdfs:comment "A POINT where passengers can board or alight from vehicles."
  ; skos:definition "A POINT where passengers can board or alight from vehicles."
  ; rdfs:subClassOf tm:POINT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ScheduledStopPointIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a SCHEDULED STOP POINT." ]
  ; ea:attribute [ ea:name "ShortName" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Short name of SCHEDULED STOP POINT." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of SCHEDULED STOP POINT." ]
  ; ea:attribute [ ea:name "Label" ; ea:position 4 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Label of SCHEDULED STOP POINT." ]
  ; ea:attribute [ ea:name "Url" ; ea:position 5 ; ea:typeName "anyURI" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "URL associated with SCHEDULED STOP POINT." ]
  ; ea:attribute [ ea:name "CompassBearing" ; ea:position 6 ; ea:typeName "degrees" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Heading of stop relative to street. Degrees from North. This should be considered as a derived value that can be used for presentation purposes when information about the physical stop is not available. The definitive value is the compass bearing found on the QUAY (i.e. physical stop) to which a SCHEDULED STOP POINT is assigned." ]
  ; ea:attribute [ ea:name "ForAlighting" ; ea:position 7 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Default for whether stop may be used for alighting. May be overridden on specific services." ]
  ; ea:attribute [ ea:name "ForBoarding" ; ea:position 8 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Default for whether stop may be used for boarding. May be overridden on specific services." ]
  ; ea:attribute [ ea:name "RequestStop" ; ea:position 9 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Default for whether stop is a request stop. May be overridden in JOURNEY PATTERNs." ]
  ; ea:attribute [ ea:name "AtCentre" ; ea:position 10 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether STOP POINT can be considered as being at the centre of a TOPOGRAPHIC PLACE. Default is false." ]
  .

tm:CONNECTION a owl:Class ;
  rdfs:label "CONNECTION"
  ; rdfs:comment "The physical (spatial) possibility for a passenger to change from one public transport vehicle to another to continue the trip, determined by a pair of points which may be either SCHEDULED STOP POINTs or VEHICLE MEETING POINTs.  NOTE: Different times may be necessary to cover the link between these points, depending on the kind of passenger."
  ; skos:definition "The physical (spatial) possibility for a passenger to change from one public transport vehicle to another to continue the trip, determined by a pair of points which may be either SCHEDULED STOP POINTs or VEHICLE MEETING POINTs.  NOTE: Different times may be necessary to cover the link between these points, depending on the kind of passenger."
  ; rdfs:subClassOf tm:TRANSFER
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ConnectionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a CONNECTION." ]
  ; ea:attribute [ ea:name "TransferOnly" ; ea:position 2 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether connecting at this stop passengers may only transfer. If true, then they may not enter or exit at the station." ]
  .

tm:STOP_AREA a owl:Class ;
  rdfs:label "STOP AREA"
  ; rdfs:comment "A group of SCHEDULED STOP POINTs close to each other."
  ; skos:definition "A group of SCHEDULED STOP POINTs close to each other."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "StopAreaIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a STOP AREA." ]
  ; ea:attribute [ ea:name "PublicCode" ; ea:position 2 ; ea:typeName "normalizedString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "PUBLIC CODE for a STOP AREA." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Name of STOP AREA." ]
  .

tm:TYPE_OF_STOP_POINT a owl:Class ;
  rdfs:label "TYPE OF STOP POINT"
  ; rdfs:comment "A classification of SCHEDULED STOP POINTs, used for instance to characterise the equipment to be installed at stops (post, shelter, seats, etc.)."
  ; skos:definition "A classification of SCHEDULED STOP POINTs, used for instance to characterise the equipment to be installed at stops (post, shelter, seats, etc.)."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfStopPointIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF STOP POINT." ]
  .

tm:STOP_POINT_IN_JOURNEY_PATTERN a owl:Class ;
  rdfs:label "STOP POINT IN JOURNEY PATTERN"
  ; rdfs:comment "A POINT in a JOURNEY PATTERN which is a SCHEDULED STOP POINT."
  ; skos:definition "A POINT in a JOURNEY PATTERN which is a SCHEDULED STOP POINT."
  ; rdfs:subClassOf tm:POINT_IN_LINK_SEQUENCE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "StopPointInJourneyPatternIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of a STOP POINT IN JOURNEY PATTERN." ]
  ; ea:attribute [ ea:name "ForAlighting" ; ea:position 2 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether stop may be used for alighting." ]
  ; ea:attribute [ ea:name "ForBoarding" ; ea:position 3 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether stop may be used for boarding." ]
  ; ea:attribute [ ea:name "RequestStop" ; ea:position 4 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether the stop is a Request Stop." ]
  ; ea:attribute [ ea:name "ChangeOfDestinationDisplay" ; ea:position 5 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether DESTINATION DISPLAY changes at this point in the JOURNEY PATTERN." ]
  ; ea:attribute [ ea:name "ChangeOfServiceRequirements" ; ea:position 6 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether service requirements change at this point in the JOURNEY PATTERN." ]
  ; ea:attribute [ ea:name "StopUse" ; ea:position 7 ; ea:typeName "StopUseEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Nature of use of stop, e.g. access, interchange only, or pass through. Default is Access." ]
  .

tm:COMMON_SECTION a owl:Class ;
  rdfs:label "COMMON SECTION"
  ; rdfs:comment "A part of a public transport network where the ROUTEs of several JOURNEY PATTERNs are going in parallel and where the synchronisation of SERVICE JOURNEYs may be planned and controlled with respect to commonly used LINKs and SCHEDULED STOP POINTs.  NOTE: COMMON SECTIONs are defined arbitrarily and need not cover the total lengths of topologically bundled sections."
  ; skos:definition "A part of a public transport network where the ROUTEs of several JOURNEY PATTERNs are going in parallel and where the synchronisation of SERVICE JOURNEYs may be planned and controlled with respect to commonly used LINKs and SCHEDULED STOP POINTs.  NOTE: COMMON SECTIONs are defined arbitrarily and need not cover the total lengths of topologically bundled sections."
  ; rdfs:subClassOf tm:SECTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "CommonSectionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of COMMON SECTION." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of COMMON SECTION." ]
  .

tm:ROUTING_CONSTRAINT_ZONE a owl:Class ;
  rdfs:label "ROUTING CONSTRAINT ZONE"
  ; rdfs:comment "A ZONE specifying constraints on activity when a journey is routed through it.  NOTE: Examples of routing constraints are \"If you board in this ZONE, you can't alight in the same ZONE\"; \"If you board in this ZONE, you can alight only if the journey has passed through at least one STOP outside of the ZONE\"; \"Journey will go on only if there are passenger on board\", etc."
  ; skos:definition "A ZONE specifying constraints on activity when a journey is routed through it.  NOTE: Examples of routing constraints are \"If you board in this ZONE, you can't alight in the same ZONE\"; \"If you board in this ZONE, you can alight only if the journey has passed through at least one STOP outside of the ZONE\"; \"Journey will go on only if there are passenger on board\", etc."
  ; rdfs:subClassOf tm:ZONE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "RoutingConstraintZoneIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ROUTING CONSTRAINT ZONE" ]
  .

tm:TRANSFER_RESTRICTION a owl:Class ;
  rdfs:label "TRANSFER RESTRICTION"
  ; rdfs:comment "A constraint that can be applied on a CONNECTION or INTERCHANGE between two SCHEDULED STOP POINT, preventing or forbidding the passenger to use it."
  ; skos:definition "A constraint that can be applied on a CONNECTION or INTERCHANGE between two SCHEDULED STOP POINT, preventing or forbidding the passenger to use it."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TransferRestrictionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TRANSFER RESTRICTION." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of TRANSFER RESTRICTION." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of TRANSFER RESTRICTION." ]
  ; ea:attribute [ ea:name "BothWays" ; ea:position 4 ; ea:typeName "boolean" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether TRANSFER can be traversed in both directions" ]
  .

tm:SERVICE_EXCLUSION a owl:Class ;
  rdfs:label "SERVICE EXCLUSION"
  ; rdfs:comment "A constraint on the use of a service; the service, on this specific JOURNEY PATTERN (usually a FTS JOURNEY PATTERN) cannot operate when another (regular) service operates.  NOTE: This may occur only on subpart of the JOURNEY PATTERN, or only on one or some specific SCHEDULED STOP POINTS within the pattern."
  ; skos:definition "A constraint on the use of a service; the service, on this specific JOURNEY PATTERN (usually a FTS JOURNEY PATTERN) cannot operate when another (regular) service operates.  NOTE: This may occur only on subpart of the JOURNEY PATTERN, or only on one or some specific SCHEDULED STOP POINTS within the pattern."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ServiceExclusionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SERVICE EXCLUSION." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of SERVICE EXCLUSION." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of SERVICE EXCLUSION." ]
  .

tm:TIME_DEMAND_TYPE a owl:Class ;
  rdfs:label "TIME DEMAND TYPE"
  ; rdfs:comment "An indicator of traffic conditions or other factors which may affect vehicle run or wait times.  NOTE: It may be entered directly by the scheduler or defined by the use of TIME BANDs."
  ; skos:definition "An indicator of traffic conditions or other factors which may affect vehicle run or wait times.  NOTE: It may be entered directly by the scheduler or defined by the use of TIME BANDs."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TimeDemandTypeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TIME DEMAND TYPE." ]
  ; ea:attribute [ ea:name "Name" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of TIME DEMAND TYPE." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 3 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of TIME DEMAND TYPE." ]
  .

tm:TIME_DEMAND_TYPE_ASSIGNMENT a owl:Class ;
  rdfs:label "TIME DEMAND TYPE ASSIGNMENT"
  ; rdfs:comment "The assignment of a TIME DEMAND TYPE to a TIME BAND depending on the DAY TYPE and GROUP OF TIMING LINKS."
  ; skos:definition "The assignment of a TIME DEMAND TYPE to a TIME BAND depending on the DAY TYPE and GROUP OF TIMING LINKS."
  ; rdfs:subClassOf tm:ASSIGNMENT
  ; ea:kind "class"
