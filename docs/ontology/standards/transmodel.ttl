  ; ea:attribute [ ea:name "Back" ; ea:position 6 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Direction heading to show for PATH LINK when travelling in its TO / FROM sense." ]
