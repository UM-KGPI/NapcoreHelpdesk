  rdfs:label "OBSERVED PASSING TIME"
  ; rdfs:comment "The actual passing of a public transport vehicle at a pre-defined POINT during a MONITORED VEHICLE JOURNEY."
  ; skos:definition "The actual passing of a public transport vehicle at a pre-defined POINT during a MONITORED VEHICLE JOURNEY."
  ; rdfs:subClassOf tm:DATED_PASSING_TIME
  ; ea:kind "class"
  ; ea:attribute [ ea:name "ActualDepartureTime" ; ea:position 1 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Actual departure time." ]
  ; ea:attribute [ ea:name "ActualArrivalTime" ; ea:position 2 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Actual arrival time." ]
  ; ea:attribute [ ea:name "ActualNonStopPassingTime" ; ea:position 3 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Actual passing time (if not stopping)." ]
  ; ea:attribute [ ea:name "ActualWaitingTime" ; ea:position 4 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Actual time spent at the stop between the arrival and the departure." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 5 ; ea:typeName "ObservedPassingTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of OBSERVED PASSING TIME." ]
  .

tm:ESTIMATED_PASSING_TIME a owl:Class ;
  rdfs:label "ESTIMATED PASSING TIME"
  ; rdfs:comment "A time data, calculated from the latest available input, about when a public transport vehicle will pass a particular POINT IN JOURNEY PATTERN on a specified DATED VEHICLE JOURNEY.  NOTE: Mainly used to inform passengers about expected times of arrival and/or departure, but may also be used for monitoring and re-planning."
  ; skos:definition "A time data, calculated from the latest available input, about when a public transport vehicle will pass a particular POINT IN JOURNEY PATTERN on a specified DATED VEHICLE JOURNEY.  NOTE: Mainly used to inform passengers about expected times of arrival and/or departure, but may also be used for monitoring and re-planning."
  ; rdfs:subClassOf tm:DATED_PASSING_TIME
  ; ea:kind "class"
  ; ea:attribute [ ea:name "ExpectedArrivalTime" ; ea:position 1 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Expected arrival time." ]
  ; ea:attribute [ ea:name "ExpectedDepartureTime" ; ea:position 2 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Expected departure time." ]
  ; ea:attribute [ ea:name "ExpectedNonStopPassingTime" ; ea:position 3 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Expected time of passing if not stopping." ]
  ; ea:attribute [ ea:name "ExpectedWaitingTime" ; ea:position 4 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Expected time to be spent at the stop between arrival and departure." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 5 ; ea:typeName "EstimatedPassingTimeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ESTIMATED PASSING TIME." ]
  .

tm:CONTROL_ACTION a owl:Class ;
  rdfs:label "CONTROL ACTION"
  ; rdfs:comment "An action resulting from a decision taken by the controller causing an amendment of the operation planned in the PRODUCTION PLAN."
  ; skos:definition "An action resulting from a decision taken by the controller causing an amendment of the operation planned in the PRODUCTION PLAN."
  ; rdfs:subClassOf tm:LOGGABLE_OBJECT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ControlActionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CONTROL ACTION." ]
  ; ea:attribute [ ea:name "ValidationTime" ; ea:position 2 ; ea:typeName "dateTime" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Validation time of CONTROL ACTION." ]
  .

tm:LOGICAL_VEHICLE_CANCELLATION a owl:Class ;
  rdfs:label "LOGICAL VEHICLE CANCELLATION"
  ; rdfs:comment "A CONTROL ACTION consisting in removing a LOGICAL VEHICLE from the production plan."
  ; skos:definition "A CONTROL ACTION consisting in removing a LOGICAL VEHICLE from the production plan."
  ; rdfs:subClassOf tm:VEHICLE_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "LogicalVehicleCancellationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of LOGICAL VEHICLE CANCELLATION." ]
  .

tm:VEHICLE_ASSIGNMENT a owl:Class ;
  rdfs:label "VEHICLE ASSIGNMENT"
  ; rdfs:comment "The assignment, or the cancellation of an assignment, of a physical VEHICLE to a LOGICAL VEHICLE.  NOTE: This assignment may be overridden by a further assignment."
  ; skos:definition "The assignment, or the cancellation of an assignment, of a physical VEHICLE to a LOGICAL VEHICLE.  NOTE: This assignment may be overridden by a further assignment."
  ; rdfs:subClassOf tm:ASSIGNMENT
  ; rdfs:subClassOf tm:VEHICLE_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "AssignOrCancel" ; ea:position 1 ; ea:typeName "normallizedString" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indication if the action is to assign or cancel a VEHICLE ASSIGNMENT." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "VehicleAssignmentIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE ASSIGNMENT." ]
  .

tm:CHANGE_OF_VEHICLE a owl:Class ;
  rdfs:label "CHANGE OF VEHICLE"
  ; rdfs:comment "A CONTROL ACTION consisting in removing, at a certain point in time and space, all work assigned to a LOGICAL VEHICLE and of assigning it to another LOGICAL VEHICLE."
  ; skos:definition "A CONTROL ACTION consisting in removing, at a certain point in time and space, all work assigned to a LOGICAL VEHICLE and of assigning it to another LOGICAL VEHICLE."
  ; rdfs:subClassOf tm:VEHICLE_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Time" ; ea:position 1 ; ea:typeName "dateTime" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time of CHANGE OF VEHICLE." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "ChangeOfVehicleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CHANGE OF VEHICLE." ]
  .

tm:VEHICLE_CONTROL_ACTION a owl:Class ;
  rdfs:label "VEHICLE CONTROL ACTION"
  ; rdfs:comment "A CONTROL ACTION affecting the LOGICAL VEHICLE."
  ; skos:definition "A CONTROL ACTION affecting the LOGICAL VEHICLE."
  ; rdfs:subClassOf tm:CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VehicleControlActionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE CONTROL ACTION." ]
  .

tm:VEHICLE_WORK_ASSIGNMENT a owl:Class ;
  rdfs:label "VEHICLE WORK ASSIGNMENT"
  ; rdfs:comment "The assignment, or the cancellation of an assignment, of a physical VEHICLE to a LOGICAL VEHICLE to some planned work, represented as DATED BLOCKs or as DATED VEHICLE JOURNEYs.  NOTE: This assignment may be overridden by a further assignment."
  ; skos:definition "The assignment, or the cancellation of an assignment, of a physical VEHICLE to a LOGICAL VEHICLE to some planned work, represented as DATED BLOCKs or as DATED VEHICLE JOURNEYs.  NOTE: This assignment may be overridden by a further assignment."
  ; rdfs:subClassOf tm:ASSIGNMENT
  ; rdfs:subClassOf tm:VEHICLE_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "AssignOrCancel" ; ea:position 1 ; ea:typeName "boolean" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indication if the action is to assign or cancel a VEHICLE WORK ASSIGNMENT." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "VehicleWorkAssignmentIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE WORK ASSIGNMENT." ]
  .

tm:LOGICAL_VEHICLE_CREATION a owl:Class ;
  rdfs:label "LOGICAL VEHICLE CREATION"
  ; rdfs:comment "A CONTROL ACTION consisting in creating a completely new LOGICAL VEHICLE and assigning DATED VEHICLE JOURNEYs to the new LOGICAL VEHICLE."
  ; skos:definition "A CONTROL ACTION consisting in creating a completely new LOGICAL VEHICLE and assigning DATED VEHICLE JOURNEYs to the new LOGICAL VEHICLE."
  ; rdfs:subClassOf tm:VEHICLE_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "LogicalVehicleCreationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of LOGICAL VEHICLE CREATION." ]
  .

tm:CHANGE_OF_JOURNEY_PATTERN a owl:Class ;
  rdfs:label "CHANGE OF JOURNEY PATTERN"
  ; rdfs:comment "A CONTROL ACTION consisting in assigning a new JOURNEY PATTERN (and the ROUTE supporting it) to a DATED VEHICLE JOURNEY."
  ; skos:definition "A CONTROL ACTION consisting in assigning a new JOURNEY PATTERN (and the ROUTE supporting it) to a DATED VEHICLE JOURNEY."
  ; rdfs:subClassOf tm:ELEMENTARY_JOURNEY_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ChangeOfJourneyPatternIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CHANGE OF JOURNEY PATTERN." ]
  .

tm:CHANGE_OF_JOURNEY_TIMING a owl:Class ;
  rdfs:label "CHANGE OF JOURNEY TIMING"
  ; rdfs:comment "A CONTROL ACTION consisting in changing one or several characteristics of a DATED VEHICLE JOURNEY, in particular the departure time of the journey."
  ; skos:definition "A CONTROL ACTION consisting in changing one or several characteristics of a DATED VEHICLE JOURNEY, in particular the departure time of the journey."
  ; rdfs:subClassOf tm:ELEMENTARY_JOURNEY_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "NewDepartureTime" ; ea:position 1 ; ea:typeName "time" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "New intended departure time of journey." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "ChangeOfJourneyTimingIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CHANGE OF JOURNEY TIMING." ]
  .

tm:PARTIAL_JOURNEY_CANCELLATION a owl:Class ;
  rdfs:label "PARTIAL JOURNEY CANCELLATION"
  ; rdfs:comment "A CONTROL ACTION consisting in assigning a JOURNEY PATTERN that is a subset of the original JOURNEY PATTERN to a DATED VEHICLE JOURNEY; thus specifically expressing that a part of a DATED VEHICLE JOURNEY has been cancelled."
  ; skos:definition "A CONTROL ACTION consisting in assigning a JOURNEY PATTERN that is a subset of the original JOURNEY PATTERN to a DATED VEHICLE JOURNEY; thus specifically expressing that a part of a DATED VEHICLE JOURNEY has been cancelled."
  ; rdfs:subClassOf tm:ELEMENTARY_JOURNEY_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PartialJourneyCancellationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PARTIAL JOURNEY CANCELLATION." ]
  .

tm:JOURNEY_CANCELLATION a owl:Class ;
  rdfs:label "JOURNEY CANCELLATION"
  ; rdfs:comment "A CONTROL ACTION consisting in deleting a DATED VEHICLE JOURNEY from the latest valid plan."
  ; skos:definition "A CONTROL ACTION consisting in deleting a DATED VEHICLE JOURNEY from the latest valid plan."
  ; rdfs:subClassOf tm:ELEMENTARY_JOURNEY_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyCancellationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY CANCELLATION." ]
  .

tm:JOURNEY_CREATION a owl:Class ;
  rdfs:label "JOURNEY CREATION"
  ; rdfs:comment "A CONTROL ACTION consisting in adding a completely new DATED VEHICLE JOURNEY to the latest valid plan."
  ; skos:definition "A CONTROL ACTION consisting in adding a completely new DATED VEHICLE JOURNEY to the latest valid plan."
  ; rdfs:subClassOf tm:ELEMENTARY_JOURNEY_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "JourneyCreationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of JOURNEY CREATION." ]
  .

tm:ELEMENTARY_JOURNEY_CONTROL_ACTION a owl:Class ;
  rdfs:label "ELEMENTARY JOURNEY CONTROL ACTION"
  ; rdfs:comment "A non-composite CONTROL ACTION affecting DATED VEHICLE JOURNEYs."
  ; skos:definition "A non-composite CONTROL ACTION affecting DATED VEHICLE JOURNEYs."
  ; rdfs:subClassOf tm:CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ElementaryJourneyControlActionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ELEMENTARY JOURNEY CONTROL ACTION." ]
  .

tm:FLEXIBLE_JOURNEY_ACTIVATION a owl:Class ;
  rdfs:label "FLEXIBLE JOURNEY ACTIVATION"
  ; rdfs:comment "A CONTROL ACTION consisting in activating a DATED VEHICLE JOURNEY that has a booking pre-condition."
  ; skos:definition "A CONTROL ACTION consisting in activating a DATED VEHICLE JOURNEY that has a booking pre-condition."
  ; rdfs:subClassOf tm:ELEMENTARY_JOURNEY_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "FlexibleJourneyActivationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of FLEXIBLE JOURNEY ACTIVATION." ]
  .

tm:DEPARTURE_LAG a owl:Class ;
  rdfs:label "DEPARTURE LAG"
  ; rdfs:comment "A CONTROL ACTION consisting of gradually shifting a set of departures at one POINT.  NOTE: It allows a change of the timetable without abrupt variations in the intervals."
  ; skos:definition "A CONTROL ACTION consisting of gradually shifting a set of departures at one POINT.  NOTE: It allows a change of the timetable without abrupt variations in the intervals."
  ; rdfs:subClassOf tm:COMPOSITE_JOURNEY_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "ShiftingTimeValue" ; ea:position 1 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time value expressing the difference between planned time and intended time when DEPARTURE LAG is fully applied." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "DepartureLagIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DEPARTURE LAG." ]
  .

tm:RESPACING a owl:Class ;
  rdfs:label "RESPACING"
  ; rdfs:comment "A CONTROL ACTION to respace departure times at one POINT after a journey or a vehicle has been added or cancelled, in order to preserve the regularity of intervals."
  ; skos:definition "A CONTROL ACTION to respace departure times at one POINT after a journey or a vehicle has been added or cancelled, in order to preserve the regularity of intervals."
  ; rdfs:subClassOf tm:COMPOSITE_JOURNEY_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "RespacingIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of RESPACING." ]
  .

tm:COMPOSITE_JOURNEY_CONTROL_ACTION a owl:Class ;
  rdfs:label "COMPOSITE JOURNEY CONTROL ACTION"
  ; rdfs:comment "A CONTROL ACTION affecting a set of DATED VEHICLE JOURNEYs with a correlated set of adjustments."
  ; skos:definition "A CONTROL ACTION affecting a set of DATED VEHICLE JOURNEYs with a correlated set of adjustments."
  ; rdfs:subClassOf tm:CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "CompositeJourneyControlActionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of COMPOSITE JOURNEY CONTROL ACTION." ]
  .

tm:DEPARTURE_EXCHANGE a owl:Class ;
  rdfs:label "DEPARTURE EXCHANGE"
  ; rdfs:comment "A CONTROL ACTION consisting in permuting at one POINT the departure times of two or several DATED VEHICLE JOURNEYs."
  ; skos:definition "A CONTROL ACTION consisting in permuting at one POINT the departure times of two or several DATED VEHICLE JOURNEYs."
  ; rdfs:subClassOf tm:COMPOSITE_JOURNEY_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "PermutationDirection" ; ea:position 1 ; ea:typeName "boolean" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Permutation direction of DEPARTURE EXCHANGE, i.e. ascending or descending." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "DepartureExchangeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DEPARTURE EXCHANGE." ]
  .

tm:RESORPTION a owl:Class ;
  rdfs:label "RESORPTION"
  ; rdfs:comment "A CONTROL ACTION consisting of progressively resorbing a delay on one DATED VEHICLE JOURNEY by rescheduling the departure times at one POINT of the following journeys.  NOTE: It is a way of maintaining regular intervals after a disturbance on a particular journey."
  ; skos:definition "A CONTROL ACTION consisting of progressively resorbing a delay on one DATED VEHICLE JOURNEY by rescheduling the departure times at one POINT of the following journeys.  NOTE: It is a way of maintaining regular intervals after a disturbance on a particular journey."
  ; rdfs:subClassOf tm:COMPOSITE_JOURNEY_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "ResorptionTimeValue" ; ea:position 1 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time value expressing the intended reduction of delay for each subsequent journey." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "ResorptionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of RESORPTION." ]
  .

tm:INTERCHANGE_CANCELLATION a owl:Class ;
  rdfs:label "INTERCHANGE CANCELLATION"
  ; rdfs:comment "A CONTROL ACTION consisting in deleting a DATED VEHICLE JOURNEY INTERCHANGE from the latest valid plan so that a distributor DATED VEHICLE JOURNEY no longer needs to wait for a feeder DATED VEHICLE JOURNEY."
  ; skos:definition "A CONTROL ACTION consisting in deleting a DATED VEHICLE JOURNEY INTERCHANGE from the latest valid plan so that a distributor DATED VEHICLE JOURNEY no longer needs to wait for a feeder DATED VEHICLE JOURNEY."
  ; rdfs:subClassOf tm:INTERCHANGE_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "InterchangeCancellationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of INTERCHANGE CANCELLATION." ]
  .

tm:INTERCHANGE_MODIFICATION a owl:Class ;
  rdfs:label "INTERCHANGE MODIFICATION"
  ; rdfs:comment "A CONTROL ACTION expressing that the duration a distributor DATED VEHICLE JOURNEY needs to wait for a feeder DATED VEHICLE JOURNEY in a DATED VEHICLE JOURNEY INTERCHANGE is changed or that a different DATED VEHICLE JOURNEY is to wait for the feeder."
  ; skos:definition "A CONTROL ACTION expressing that the duration a distributor DATED VEHICLE JOURNEY needs to wait for a feeder DATED VEHICLE JOURNEY in a DATED VEHICLE JOURNEY INTERCHANGE is changed or that a different DATED VEHICLE JOURNEY is to wait for the feeder."
  ; rdfs:subClassOf tm:INTERCHANGE_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "DistributorMaximumWaitUntilDateTime" ; ea:position 1 ; ea:typeName "dateTime" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The latest time that the distributor vehicle can delay its departure to in the wait for passengers from a delayed feeder vehicle." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "InterchangeModificationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of INTERCHANGE MODIFICATION." ]
  .

tm:INTERCHANGE_CREATION a owl:Class ;
  rdfs:label "INTERCHANGE CREATION"
  ; rdfs:comment "A CONTROL ACTION consisting in adding a completely new DATED VEHICLE JOURNEY INTERCHANGE between a feeder DATED VEHICLE JOURNEY and a distributor DATED VEHICLE JOURNEY to the latest valid plan."
  ; skos:definition "A CONTROL ACTION consisting in adding a completely new DATED VEHICLE JOURNEY INTERCHANGE between a feeder DATED VEHICLE JOURNEY and a distributor DATED VEHICLE JOURNEY to the latest valid plan."
  ; rdfs:subClassOf tm:INTERCHANGE_CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "DistributorMaximumWaitUntilTime" ; ea:position 1 ; ea:typeName "dateTime" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The latest time that the distributor vehicle can delay its departure to in the wait for passengers from a delayed feeder vehicle." ]
  ; ea:attribute [ ea:name "MinimumChangeDuration" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The shortest interval needed for a passenger to traverse the distance from the arrival point of the feeder vehicle to the departure point of the distributor vehicle." ]
  ; ea:attribute [ ea:name "StaySeated" ; ea:position 3 ; ea:typeName "boolean" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An indicator as to whether the feeder and distributor vehicle journey are run by the same vehicle so the passenger may remain in place, or whether they must change vehicle." ]
  ; ea:attribute [ ea:name "Advertised" ; ea:position 4 ; ea:typeName "boolean" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Whether the interchange should be advertised to the public or not." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 5 ; ea:typeName "InterchangeCreationIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of INTERCHANGE CREATION." ]
  .

tm:INTERCHANGE_CONTROL_ACTION a owl:Class ;
  rdfs:label "INTERCHANGE CONTROL ACTION"
  ; rdfs:comment "A CONTROL ACTION affecting a DATED VEHICLE JOURNEY INTERCHANGE."
  ; skos:definition "A CONTROL ACTION affecting a DATED VEHICLE JOURNEY INTERCHANGE."
  ; rdfs:subClassOf tm:CONTROL_ACTION
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "InterchangeControlActionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of INTERCHANGE CONTROL ACTION." ]
  .

tm:OPERATIONAL_EVENT a owl:Class ;
  rdfs:label "OPERATIONAL EVENT"
  ; rdfs:comment "Any event affecting the public transport operation (production follow-up, management of information or the technical functioning), occurring at a certain time and that is recorded in the system.  NOTE: An OPERATIONAL EVENT is generally causing a CONTROL ACTION."
  ; skos:definition "Any event affecting the public transport operation (production follow-up, management of information or the technical functioning), occurring at a certain time and that is recorded in the system.  NOTE: An OPERATIONAL EVENT is generally causing a CONTROL ACTION."
  ; rdfs:subClassOf tm:EVENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "OperationalEventIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of OPERATIONAL EVENT." ]
  ; ea:attribute [ ea:name "Description" ; ea:position 2 ; ea:typeName "MultilingualString" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Description of OPERATIONAL EVENT." ]
  ; ea:attribute [ ea:name "Time" ; ea:position 3 ; ea:typeName "dateTime" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time of OPERATIONAL EVENT." ]
  .

tm:ALARM a owl:Class ;
  rdfs:label "ALARM"
  ; rdfs:comment "An EVENT alerting the staff in charge of operations control on a probable dysfunction: operational threshold exceeded (e.g., delay), emergency call, failure, etc."
  ; skos:definition "An EVENT alerting the staff in charge of operations control on a probable dysfunction: operational threshold exceeded (e.g., delay), emergency call, failure, etc."
  ; rdfs:subClassOf tm:OPERATIONAL_EVENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AlarmIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ALARM." ]
  .

tm:VEHICLE_INCIDENT a owl:Class ;
  rdfs:label "VEHICLE INCIDENT"
  ; rdfs:comment "An INCIDENT concerning LOGICAL VEHICLEs."
  ; skos:definition "An INCIDENT concerning LOGICAL VEHICLEs."
  ; rdfs:subClassOf tm:INCIDENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "VehicleIncidentIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of VEHICLE INCIDENT." ]
  .

tm:FACILITY_OPERATIONAL_EVENT a owl:Class ;
  rdfs:label "FACILITY OPERATIONAL EVENT"
  ; rdfs:comment "An OPERATIONAL EVENT concerning a FACILITY."
