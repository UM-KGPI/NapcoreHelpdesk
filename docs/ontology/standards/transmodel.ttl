  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "OperatingDepartmentIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of OPERATING DEPARTMENT." ]
  .

tm:AUTHORITY a owl:Class ;
  rdfs:label "AUTHORITY"
  ; rdfs:comment "The ORGANISATION on which the responsibility of organising the transport service in a certain area is placed."
  ; skos:definition "The ORGANISATION on which the responsibility of organising the transport service in a certain area is placed."
