  .

tm:ROSTER_CYCLE a owl:Class ;
  rdfs:label "ROSTER CYCLE"
  ; rdfs:comment "A ROSTER CYCLE is a sequence pattern of days of work and days of rest where the days of work may be further specified by a particular DUTY TYPE."
  ; skos:definition "A ROSTER CYCLE is a sequence pattern of days of work and days of rest where the days of work may be further specified by a particular DUTY TYPE."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Description" ; ea:position 1 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of ROSTER CYCLE." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "RosterCycleIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ROSTER CYCLE." ]
  .

tm:ROSTER_DESIGN a owl:Class ;
  rdfs:label "ROSTER DESIGN"
  ; rdfs:comment "An element for roster building made up of a particular number of DESIGN WEEKs, to each of which a different sequence pattern of DUTY TYPEs and days of rest will be assigned."
  ; skos:definition "An element for roster building made up of a particular number of DESIGN WEEKs, to each of which a different sequence pattern of DUTY TYPEs and days of rest will be assigned."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Description" ; ea:position 1 ; ea:typeName "MultilingualString" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of ROSTER DESIGN." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "RosterDesignIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ROSTER DESIGN." ]
  .

tm:DESIGN_WEEK a owl:Class ;
  rdfs:label "DESIGN WEEK"
  ; rdfs:comment "A DESIGN WEEK is a week viewed as a part of a ROSTER DESIGN with a specified order in that design."
  ; skos:definition "A DESIGN WEEK is a week viewed as a part of a ROSTER DESIGN with a specified order in that design."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Order" ; ea:position 1 ; ea:typeName "positiveInteger" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Position of DESIGN WEEK in ROSTER DESIGN." ]
  ; ea:attribute [ ea:name "Id" ; ea:position 2 ; ea:typeName "DesignWeekIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of DESIGN WEEK." ]
  .

tm:ROSTER_DESIGN_IN_MATRIX a owl:Class ;
  rdfs:label "ROSTER DESIGN IN MATRIX"
  ; rdfs:comment "A ROSTER DESIGN IN MATRIX describes the order in which different ROSTER DESIGNs are applied to construct a certain ROSTER MATRIX."
  ; skos:definition "A ROSTER DESIGN IN MATRIX describes the order in which different ROSTER DESIGNs are applied to construct a certain ROSTER MATRIX."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "RosterDesignInMatrixIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ROSTER DESIGN IN MATRIX." ]
  ; ea:attribute [ ea:name "Order" ; ea:position 2 ; ea:typeName "positiveInteger" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Position of ROSTER DESIGN in ROSTER MATRIX." ]
  .

tm:ROSTER_DESIGN_TYPE a owl:Class ;
  rdfs:label "ROSTER DESIGN TYPE"
  ; rdfs:comment "A ROSTER DESIGN TYPE is a classification of a ROSTER DESIGN which may describe the number of weeks that are covered, the proportion of work to free days or other characteristics."
  ; skos:definition "A ROSTER DESIGN TYPE is a classification of a ROSTER DESIGN which may describe the number of weeks that are covered, the proportion of work to free days or other characteristics."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "RosterDesignTypeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ROSTER DESIGN TYPE." ]
  .

tm:DESIGN_WEEK_ELEMENT a owl:Class ;
  rdfs:label "DESIGN WEEK ELEMENT"
  ; rdfs:comment "A DESIGN WEEK ELEMENT is an element of a DESIGN WEEK representing a particular DAY OF WEEK designating if it is a day of rest or work according to a specific DUTY TYPE for a theoretically available driver."
  ; skos:definition "A DESIGN WEEK ELEMENT is an element of a DESIGN WEEK representing a particular DAY OF WEEK designating if it is a day of rest or work according to a specific DUTY TYPE for a theoretically available driver."
