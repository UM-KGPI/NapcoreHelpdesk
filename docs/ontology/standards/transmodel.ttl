  .

tm:LOCAL_SERVICE a owl:Class ;
  rdfs:label "LOCAL SERVICE"
  ; rdfs:comment "A named service relating to the use of the SITE or transport services at a particular location, for example porterage, assistance for disabled users, booking offices, etc.  NOTE1: The service may have a VALIDITY CONDITION associated with it.  NOTE2: A LOCAL SERVICE is treated as a form of non-material EQUIPMENT."
  ; skos:definition "A named service relating to the use of the SITE or transport services at a particular location, for example porterage, assistance for disabled users, booking offices, etc.  NOTE1: The service may have a VALIDITY CONDITION associated with it.  NOTE2: A LOCAL SERVICE is treated as a form of non-material EQUIPMENT."
  ; rdfs:subClassOf tm:EQUIPMENT
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "LocalServiceIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of LOCAL SERVICE." ]
  .

tm:EQUIPMENT a owl:Class ;
  rdfs:label "EQUIPMENT"
  ; rdfs:comment "An item of equipment installed either in a fixed location (PLACE EQUIPMENT) or on-board vehicles (VEHICLE EQUIPMENT).  NOTE: A service (for example a LOCAL SERVICE such as LEFT LUGGAGE, or TICKETING SERVICE) available at such locations is considered as immaterial equipment as well."
  ; skos:definition "An item of equipment installed either in a fixed location (PLACE EQUIPMENT) or on-board vehicles (VEHICLE EQUIPMENT).  NOTE: A service (for example a LOCAL SERVICE such as LEFT LUGGAGE, or TICKETING SERVICE) available at such locations is considered as immaterial equipment as well."
