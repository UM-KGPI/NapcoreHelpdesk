  .

tm:NON_PT_TRIP a owl:Class ;
  rdfs:label "NON-PT TRIP"
  ; rdfs:comment "A<font color=\"#0f0f0f\"> part of a TRIP PATTERN consisting of a continuous sequence of PERSONAL LEGs and TRANSFER LEGs.</font>  <font color=\"#0f0f0f\">Note: IT must not contain any PT RIDE LEGs.</font>"
  ; skos:definition "A<font color=\"#0f0f0f\"> part of a TRIP PATTERN consisting of a continuous sequence of PERSONAL LEGs and TRANSFER LEGs.</font>  <font color=\"#0f0f0f\">Note: IT must not contain any PT RIDE LEGs.</font>"
  ; rdfs:subClassOf tm:TRIP
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "NonPtTripIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of NON PT TRIP." ]
  .

tm:MIXED_TRIP a owl:Class ;
  rdfs:label "MIXED TRIP"
  ; rdfs:comment "A<font color=\"#0f0f0f\"> part of a TRIP PATTERN that mixes both PT RIDE LEGs and PERSONAL LEGs.</font>"
  ; skos:definition "A<font color=\"#0f0f0f\"> part of a TRIP PATTERN that mixes both PT RIDE LEGs and PERSONAL LEGs.</font>"
  ; rdfs:subClassOf tm:TRIP
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "MixedripIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of MIXED TRIP." ]
  .

tm:TRIP_PATTERN a owl:Class ;
  rdfs:label "TRIP PATTERN"
  ; rdfs:comment "A movement of a passenger (or another person, e.g., driver) from an origin to a destination PLACE, done for a specific TRIP REASON.  A TRIP PATTERN may consist of one or more consecutive TRIPs<font color=\"#0f0f0f\">.</font>"
  ; skos:definition "A movement of a passenger (or another person, e.g., driver) from an origin to a destination PLACE, done for a specific TRIP REASON.  A TRIP PATTERN may consist of one or more consecutive TRIPs<font color=\"#0f0f0f\">.</font>"
  ; rdfs:subClassOf tm:LINK_SEQUENCE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TripPatternIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TRIP PATTERN." ]
  ; ea:attribute [ ea:name "StartTime" ; ea:position 2 ; ea:typeName "dateTime" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time at which trip starts" ]
  ; ea:attribute [ ea:name "EndTime" ; ea:position 3 ; ea:typeName "dateTime" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time at which trip ends" ]
  ; ea:attribute [ ea:name "Distance" ; ea:position 4 ; ea:typeName "DistanceType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Total distance for trip" ]
  ; ea:attribute [ ea:name "SingleOperator" ; ea:position 5 ; ea:typeName "boolean" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Whether trip is provided by a single or multiple operators." ]
  .

tm:SPOT_AFFINITY a owl:Class ;
  rdfs:label "SPOT AFFINITY"
  ; rdfs:comment "A group of proximate seats suitable for selection for use by a group of travellers, for example, as being side by side, face to face, around a table, near a wheelchair spot, etc."
  ; skos:definition "A group of proximate seats suitable for selection for use by a group of travellers, for example, as being side by side, face to face, around a table, near a wheelchair spot, etc."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "SpotAffinityIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of SPOT AFFINITY." ]
  ; ea:attribute [ ea:name "NumberOfSpots" ; ea:position 2 ; ea:typeName "integer" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Number of LOCATABLE SPOTs in affinity." ]
  .

tm:ACCESS_LEG a owl:Class ;
  rdfs:label "ACCESS LEG"
  ; rdfs:comment "A part of a TRIP PATTERN corresponding to the movement of a passenger when not on a public transport vehicle, from an origin PLACE to a SCHEDULED STOP POINT or VEHICLE MEETING POINT, or from a SCHEDULED STOP POINT or VEHICLE MEETING POINT to a destination PLACE.   NOTE: May reference an ACCESS."
  ; skos:definition "A part of a TRIP PATTERN corresponding to the movement of a passenger when not on a public transport vehicle, from an origin PLACE to a SCHEDULED STOP POINT or VEHICLE MEETING POINT, or from a SCHEDULED STOP POINT or VEHICLE MEETING POINT to a destination PLACE.   NOTE: May reference an ACCESS."
  ; rdfs:subClassOf tm:TRANSFER_LEG
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "AccessLegIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of ACCESS LEG." ]
  .

tm:TYPE_OF_GUARANTEE a owl:Class ;
  rdfs:label "TYPE OF GUARANTEE"
  ; rdfs:comment "A classification of the type of guarantee offered for a given leg."
  ; skos:definition "A classification of the type of guarantee offered for a given leg."
  ; rdfs:subClassOf tm:TYPE_OF_VALUE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfGuaranteeIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE of GUARANTEE." ]
  .

tm:LEG a owl:Class ;
  rdfs:label "LEG"
  ; rdfs:comment "<font color=\"#0f0f0f\">A part of a TRIP PATTERN corresponding to the movement of a user in a single vehicle, or a pedestrian mode such as walking.</font>"
  ; skos:definition "<font color=\"#0f0f0f\">A part of a TRIP PATTERN corresponding to the movement of a user in a single vehicle, or a pedestrian mode such as walking.</font>"
  ; rdfs:subClassOf tm:LINK
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "LegIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of LEG." ]
  ; ea:attribute [ ea:name "Duration" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Duration of LEG." ]
  ; ea:attribute [ ea:name "Distance" ; ea:position 3 ; ea:typeName "DistanceType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Total distance for LEG." ]
  .

tm:CONNECTION_LEG a owl:Class ;
  rdfs:label "CONNECTION LEG"
  ; rdfs:comment "A part of a TRIP PATTERN corresponding to the movement of a passenger transferring from one SERVICE JOURNEY to another, made over a CONNECTION from one SCHEDULED STOP POINT (or VEHICLE MEETING POINT) to another, and possibly following a specific NAVIGATION PATH<font color=\"#0f0f0f\">.</font>"
  ; skos:definition "A part of a TRIP PATTERN corresponding to the movement of a passenger transferring from one SERVICE JOURNEY to another, made over a CONNECTION from one SCHEDULED STOP POINT (or VEHICLE MEETING POINT) to another, and possibly following a specific NAVIGATION PATH<font color=\"#0f0f0f\">.</font>"
  ; rdfs:subClassOf tm:TRANSFER_LEG
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "ConnectionLegIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of CONNECTION LEG." ]
  ; ea:attribute [ ea:name "Duration" ; ea:position 2 ; ea:typeName "duration" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time needed to make interchange." ]
  .

tm:PERSONAL_LEG a owl:Class ;
  rdfs:label "PERSONAL LEG"
  ; rdfs:comment "A part of a TRIP PATTERN corresponding to the movement of a user from one PLACE to another, where the TRIP is made entirely by personal means, and neither of the endpoints is a SCHEDULED STOP POINT or VEHICLE MEETING POINT."
  ; skos:definition "A part of a TRIP PATTERN corresponding to the movement of a user from one PLACE to another, where the TRIP is made entirely by personal means, and neither of the endpoints is a SCHEDULED STOP POINT or VEHICLE MEETING POINT."
  ; rdfs:subClassOf tm:LEG
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "PersonalLegIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PERSONAL LEG" ]
  .

tm:TRIP a owl:Class ;
  rdfs:label "TRIP"
  ; rdfs:comment "A part of a TRIP PATTERN describing the movement of a passenger from one PLACE of any sort to another.  NOTE: A TRIP may consist of one or more consecutive LEGs having some common characteristics."
  ; skos:definition "A part of a TRIP PATTERN describing the movement of a passenger from one PLACE of any sort to another.  NOTE: A TRIP may consist of one or more consecutive LEGs having some common characteristics."
  ; rdfs:subClassOf tm:LINK_SEQUENCE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TripIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of PT TRIP." ]
  .

tm:TRAVEL a owl:Class ;
  rdfs:label "TRAVEL"
  ; rdfs:comment "A sequence of TRIP PATTERNs made by a passenger."
  ; skos:definition "A sequence of TRIP PATTERNs made by a passenger."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TravelIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TRAVEL." ]
  .

tm:TRAVELLING_ENTITY a owl:Class ;
  rdfs:label "TRAVELLING ENTITY"
  ; rdfs:comment "A moving person or object following a TRIP PATTERN."
  ; skos:definition "A moving person or object following a TRIP PATTERN."
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TravellingEntityIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TRAVELLING ENTITY." ]
  .

tm:TRAVEL_FLOW a owl:Class ;
  rdfs:label "TRAVEL FLOW"
  ; rdfs:comment "A summary of the TRAVELs made by many passengers"
  ; skos:definition "A summary of the TRAVELs made by many passengers"
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TravelFlowIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TRAVEL FLOW" ]
  .

tm:TYPE_OF_TRAVELLING_ENTITY a owl:Class ;
  rdfs:label "TYPE OF TRAVELLING ENTITY"
  ; rdfs:comment "A classification of a TRAVELLING ENTITY, e.g., as person, family, cyclist, driver in car, tracked mobile phone, etc."
  ; skos:definition "A classification of a TRAVELLING ENTITY, e.g., as person, family, cyclist, driver in car, tracked mobile phone, etc."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TravellingEntityIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE of PASSENGER." ]
  .

tm:TYPE_OF_PASSENGER a owl:Class ;
  rdfs:label "TYPE OF PASSENGER"
  ; rdfs:comment "A classification of passenger."
  ; skos:definition "A classification of passenger."
  ; rdfs:subClassOf tm:TYPE_OF_VALUE
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfPassengerIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE of PASSENGER." ]
  .

tm:MONITORED_LEG_CALL_PART a owl:Class ;
  rdfs:label "MONITORED LEG CALL PART"
  ; rdfs:comment "A view that brings together data to present to a passenger making a specific MONITORED TRIP relating to the arrival to or the departure from a POINT IN JOURNEY PATTERN in a DATED VEHICLE JOURNEY."
