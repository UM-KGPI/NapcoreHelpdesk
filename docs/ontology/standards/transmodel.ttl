  ; ea:attribute [ ea:name "Status" ; ea:position 6 ; ea:typeName "VersionStatusEnum" ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Status of VERSION. Enumerated value." ]
  .

tm:TYPE_OF_VERSION a owl:Class ;
  rdfs:label "TYPE OF VERSION"
  ; rdfs:comment "A classification of VERSIONs; e.g., whether there is shareability of ENTITies between several versions."
  ; skos:definition "A classification of VERSIONs; e.g., whether there is shareability of ENTITies between several versions."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
  ; ea:kind "class"
  ; ea:attribute [ ea:name "Id" ; ea:position 1 ; ea:typeName "TypeOfVersionIdType" ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier of TYPE OF VERSION." ]
  .

tm:TYPE_OF_FRAME a owl:Class ;
  rdfs:label "TYPE OF FRAME"
  ; rdfs:comment "A classification of VERSION FRAMEs according to a common purpose, e.g., line descriptions for line versions, vehicle schedules, operating costs.  NOTE: A TYPE OF FRAME is ruled by a unique TYPE OF VALIDITY."
  ; skos:definition "A classification of VERSION FRAMEs according to a common purpose, e.g., line descriptions for line versions, vehicle schedules, operating costs.  NOTE: A TYPE OF FRAME is ruled by a unique TYPE OF VALIDITY."
  ; rdfs:subClassOf tm:TYPE_OF_ENTITY
