    ea:value [ ea:name "motorShow"@en ; ea:position 38 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motor show which could disrupt traffic."@en ] ;
    ea:value [ ea:name "motorSportRaceMeeting"@en ; ea:position 39 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motor sport race meeting that could disrupt traffic."@en ] ;
    ea:value [ ea:name "openAirConcert"@en ; ea:position 40 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Open air concert"@en ] ;
    ea:value [ ea:name "parade"@en ; ea:position 41 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Formal display or organised procession which could disrupt traffic."@en ] ;
    ea:value [ ea:name "procession"@en ; ea:position 42 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An organised procession which could disrupt traffic."@en ] ;
    ea:value [ ea:name "raceMeeting"@en ; ea:position 43 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Race meeting (other than horse or motor sport) that could disrupt traffic."@en ] ;
    ea:value [ ea:name "rugbyMatch"@en ; ea:position 44 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rugby match that could disrupt traffic."@en ] ;
    ea:value [ ea:name "severalMajorEvents"@en ; ea:position 45 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A series of significant organised events either on or near the roadway which could disrupt traffic."@en ] ;
    ea:value [ ea:name "show"@en ; ea:position 46 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Entertainment event that could disrupt traffic."@en ] ;
    ea:value [ ea:name "showJumping"@en ; ea:position 47 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Horse showing jumping and tournament event that could disrupt traffic."@en ] ;
    ea:value [ ea:name "soundAndLightShow"@en ; ea:position 48 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Sound and light show."@en ] ;
    ea:value [ ea:name "sportsMeeting"@en ; ea:position 49 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Sports event of unspecified type that could disrupt traffic."@en ] ;
    ea:value [ ea:name "stateOccasion"@en ; ea:position 50 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Public ceremony or visit of national or international significance which could disrupt traffic."@en ] ;
    ea:value [ ea:name "streetFestival"@en ; ea:position 51 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Street festival"@en ] ;
    ea:value [ ea:name "tennisTournament"@en ; ea:position 52 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Tennis tournament that could disrupt traffic."@en ] ;
    ea:value [ ea:name "theatricalEvent"@en ; ea:position 53 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Theatrical event"@en ] ;
    ea:value [ ea:name "tournament"@en ; ea:position 54 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Sporting event or series of events of unspecified type lasting more than one day which could disrupt traffic."@en ] ;
    ea:value [ ea:name "tradeFair"@en ; ea:position 55 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A periodic (e.g. annual), often traditional, gathering for trade promotion, which could disrupt traffic."@en ] ;
    ea:value [ ea:name "waterSportsMeeting"@en ; ea:position 56 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Water sports meeting that could disrupt traffic."@en ] ;
    ea:value [ ea:name "wineFestival"@en ; ea:position 57 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Wine festival"@en ] ;
    ea:value [ ea:name "winterSportsMeeting"@en ; ea:position 58 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Winter sports meeting or event (e.g. skiing, ski jumping, skating) that could disrupt traffic."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 59 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Service provider does not know at time of message generation."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 60 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Common.PublicHoliday
    a owl:Class ;
    rdfs:label "PublicHoliday"@en ;
    skos:definition "Specification of a specific public holiday in case specialDayType is set to 'publicHoliday'."@en ;
    skos:prefLabel "public holiday"@en ;
    skos:altLabel "publicholiday"@en ;
    rdfs:subClassOf datex:Common.SpecialDay ;
    rdfs:comment "DATEX II class in namespace Common / Classes/Validity"@en ;
