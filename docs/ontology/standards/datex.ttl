datex:Vms.VmsController
    a owl:Class ;
    rdfs:label "VmsController"@en ;
    skos:definition "A roadside unit which can control one or more variable message signs on a single gantry or mounting or on closely associated gantries or mountings."@en ;
    skos:prefLabel "vms controller"@en ;
    skos:altLabel "vmscontroller"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "numberOfVms"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Number of variable message signs controlled by the unit."@en ] ;
    ea:attribute [ ea:name "externalIdentifier"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identification of a VMS controller unit used by the supplier or consumer systems."@en ] ;
    ea:attribute [ ea:name "ipAddress"@en ; ea:position 3 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "IP network address of the VMS controller unit."@en ] ;
    ea:attribute [ ea:name "electronicAddress"@en ; ea:position 4 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Electronic address of the VMS controller unit (if not IP addressable)."@en ] .

