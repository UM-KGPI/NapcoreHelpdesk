    ea:value [ ea:name "unladen"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Weight of vehicle when it’s not carrying any passengers, goods or other items."@en ] .

datex:ControlledZone.ActivationStatus
    a owl:Class ;
    rdfs:label "ActivationStatus"@en ;
    skos:definition "An activation status of a controlled zone, traffic regulation, predefined condition or non-predefined condition."@en ;
    skos:prefLabel "activation status"@en ;
    skos:altLabel "activationstatus"@en ;
    rdfs:comment "DATEX II class in namespace ControlledZone / ControlledZonePublication"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "activationTime"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The date/time the creation of the Activation."@en ] ;
    ea:attribute [ ea:name "activationVersionTime"@en ; ea:position 2 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The date/time of the current version of the Activation."@en ] .

datex:ControlledZone.ActivationStatus.Validity
    a owl:ObjectProperty ;
    rdfs:domain datex:ControlledZone.ActivationStatus ;
    rdfs:range datex:Common.Validity ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:ControlledZone.ActivationTypeEnum
    a owl:Class ;
    rdfs:label "ActivationTypeEnum"@en ;
    skos:definition "Activation types of controlled zones."@en ;
    skos:prefLabel "activation type enum"@en ;
    skos:altLabel "activationtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace ControlledZone / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "dynamicallyActivated"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The assignment is dynamically activated within in the validity period. The real time status is published elsewhere."@en ] ;
    ea:value [ ea:name "permanent"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The assignment is permanent within in the validity period."@en ] .

datex:ControlledZone.AlternativeMobilityOptions
    a owl:Class ;
    rdfs:label "AlternativeMobilityOptions"@en ;
    skos:definition "Information about alternative mobility options."@en ;
    skos:prefLabel "alternative mobility options"@en ;
    skos:altLabel "alternativemobilityoptions"@en ;
    rdfs:comment "DATEX II class in namespace ControlledZone / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "description"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of the alternative mobility option."@en ] ;
    ea:attribute [ ea:name "url"@en ; ea:position 2 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "URL to a resource on the internet with further information from the transportation service provider."@en ] .

datex:ControlledZone.ConditionTypeEnum
    a owl:Class ;
    rdfs:label "ConditionTypeEnum"@en ;
    skos:definition "Types of specialisations of the Condition class."@en ;
    skos:prefLabel "condition type enum"@en ;
    skos:altLabel "conditiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace ControlledZone / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "accessCondition"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Conditions for the access of a road or carriageway or lane that cannot be coded by the AccessCondition class."@en ] ;
    ea:value [ ea:name "driverCondition"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Conditions for the driver, e.g. holding a disabled permit that cannot be coded by the DriverCondition class."@en ] ;
    ea:value [ ea:name "locationCondition"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Conditions for the location of a traffic regulation that cannot be coded via the LocationCondition class."@en ] ;
    ea:value [ ea:name "nonVehicularRoadUserCondition"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Conditions for non-vehicular road users that cannot be coded by the NonVehicularRoadUserCondition class."@en ] ;
    ea:value [ ea:name "occupantConditions"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Conditions for the occupants of a vehicle that cannot be coded by the OccupantCondition class."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other non-codable condition."@en ] ;
    ea:value [ ea:name "permitCondition"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Condition for which a permit is required for vehicles with certain characteristics (sometimes restricted to specific locations) that cannot be coded by the PermitCondition class."@en ] ;
    ea:value [ ea:name "registrationCondition"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Conditions for registration before entering a UVAR that cannot be coded by the RegistrationCondition class."@en ] ;
    ea:value [ ea:name "retrofittingCondition"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Class for defining information on retrofitting details that cannot be coded by the RetrofittingCondition class."@en ] ;
    ea:value [ ea:name "roadCondition"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specification of road types (e.g. motorway, express way, etc.) that cannot be coded by the RoadCondition class."@en ] ;
    ea:value [ ea:name "stickerCondition"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Conditions relating to a sticker that the vehicle must be equipped with that cannot be coded by the StickerCondition class."@en ] ;
    ea:value [ ea:name "validityCondition"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Conditions for time validity of a traffic regulation that cannot be coded by the ValidityCondition class."@en ] ;
    ea:value [ ea:name "vehicleCondition"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Conditions for a vehicle that cannot be coded by the VehicleCondition class."@en ] .

datex:ControlledZone.ControlledZone
    a owl:Class ;
    rdfs:label "ControlledZone"@en ;
    skos:definition "Defines a geographic zone together with an applicable set of regulations, e.g. usable for UVAR (Urban Vehicle Access Regulation) zones."@en ;
    skos:prefLabel "controlled zone"@en ;
    skos:altLabel "controlledzone"@en ;
    rdfs:comment "DATEX II class in namespace ControlledZone / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "activationType"@en ; ea:position 1 ; ea:type datex:ControlledZone.ActivationTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The activation type of the controlled zone."@en ] ;
    ea:attribute [ ea:name "controlledZoneType"@en ; ea:position 2 ; ea:type datex:ControlledZone.ControlledZoneTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Broad category of the controlled zone."@en ] ;
    ea:attribute [ ea:name "name"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The formal name of the controlled zone."@en ] ;
    ea:attribute [ ea:name "status"@en ; ea:position 4 ; ea:type datex:TrafficRegulation.ActivationStatusEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The activation status of the controlled zone."@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 5 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Additional description of the restrictions of the zone and its areas."@en ] ;
    ea:attribute [ ea:name "dynamicActivationPublicationSource"@en ; ea:position 6 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Reference to the publication where the dynamic activation status of the controlled zone is published."@en ] ;
    ea:attribute [ ea:name "recordVersionTime"@en ; ea:position 7 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Date/time that this version of the zone was last updated."@en ] .

datex:ControlledZone.ControlledZone.AlternativeMobilityOptions
    a owl:ObjectProperty ;
    rdfs:domain datex:ControlledZone.ControlledZone ;
    rdfs:range datex:ControlledZone.AlternativeMobilityOptions ;
    ea:lowerBound "0" ;
