datex:Vms.VmsPublication
    a owl:Class ;
    rdfs:label "VmsPublication"@en ;
    skos:definition "A publication containing the current status and settings of one or more VMS controller units, each unit controlling one or more individual variable message signs."@en ;
    skos:prefLabel "vms publication"@en ;
    skos:altLabel "vmspublication"@en ;
    rdfs:subClassOf datex:Common.PayloadPublication ;
    rdfs:comment "DATEX II class in namespace Vms / VmsPublication"@en ;
    ea:kind "class" .

