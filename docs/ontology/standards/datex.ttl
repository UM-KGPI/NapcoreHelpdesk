datex:Facilities.SquareMetres
    a owl:Class ;
    rdfs:label "SquareMetres"@en ;
    skos:definition "A value of area expressed in units of square metres."@en ;
    skos:prefLabel "square metres"@en ;
    skos:altLabel "squaremetres"@en ;
    rdfs:subClassOf datex:Common.NonNegativeInteger ;
    rdfs:comment "DATEX II data type in namespace Facilities / DataTypes"@en ;
    ea:kind "data type" .

datex:Facilities.SupplementalEquipment
    a owl:Class ;
    rdfs:label "SupplementalEquipment"@en ;
    skos:definition "One type of supplemental equipment, which is available on some site, for example on a rest area."@en ;
    skos:prefLabel "supplemental equipment"@en ;
    skos:altLabel "supplementalequipment"@en ;
    rdfs:subClassOf datex:Facilities.SupplementalFacility ;
    rdfs:comment "DATEX II class in namespace Facilities / SupplementalFacility"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "equipmentType"@en ; ea:position 1 ; ea:type datex:Facilities.EquipmentTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "One type of equipment."@en ] .

datex:Facilities.SupplementalFacility
    a owl:Class ;
    rdfs:label "SupplementalFacility"@en ;
    skos:definition "One type of supplemental facility which can be supplemental equipment or a supplemental service facility."@en ;
    skos:prefLabel "supplemental facility"@en ;
    skos:altLabel "supplementalfacility"@en ;
    rdfs:subClassOf datex:Facilities.FacilityObject ;
    rdfs:comment "DATEX II class in namespace Facilities / SupplementalFacility"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "availability"@en ; ea:position 1 ; ea:type datex:Facilities.AvailabilityEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specifies whether the supplemental facility is available or not. Note that this is no dynamic information!"@en ] ;
    ea:attribute [ ea:name "quantity"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Number of the supplemental facility (e.g. number of toilets, restaurants, park & ride places, etc.) with respect to given restrictions. Dynamic overridable."@en ] ;
    ea:attribute [ ea:name "regularlyCleaned"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates whether the supplemental facility is cleaned on a regular basis."@en ] ;
    ea:attribute [ ea:name "applicableForUser"@en ; ea:position 4 ; ea:type datex:Facilities.UserTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Limitation to a set of special users."@en ] .

datex:Facilities.SupplementalFacilityStatus
    a owl:Class ;
    rdfs:label "SupplementalFacilityStatus"@en ;
    skos:definition "Information on current status and availability of supplemental facilities (for example number of free electric charging stations)."@en ;
    skos:prefLabel "supplemental facility status"@en ;
    skos:altLabel "supplementalfacilitystatus"@en ;
    rdfs:subClassOf datex:Facilities.FacilityObjectStatus ;
    rdfs:comment "DATEX II class in namespace Facilities / SupplementalFacility"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "numberOfSubitemsOverride"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Overrides the static value 'numberOfSubitems' (for example because of long- or midterm closures, such as renovation)."@en ] ;
    ea:attribute [ ea:name "quantityOverride"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Overrides the static quantity information (for example because of long- or midterm closures, such as renovation)."@en ] ;
    ea:attribute [ ea:name "vacantSubitems"@en ; ea:position 3 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Sets the number of currently vacant elements of either equipment (e.g. free toilets) or service facility subitems (e.g. free restaurant places)."@en ] ;
    ea:attribute [ ea:name "equipmentOperationStatus"@en ; ea:position 4 ; ea:type datex:Facilities.OperationStatusEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specifies whether this supplemental equipment is available / is in operation or not."@en ] .

datex:Facilities.SupplementalServiceFacility
    a owl:Class ;
    rdfs:label "SupplementalServiceFacility"@en ;
    skos:definition "One type of supplemental service facility. You can specify the number of this service facility type (e.g. 5 restaurants) as well as the number of subitems (e.g. 200 restaurant places)."@en ;
    skos:prefLabel "supplemental service facility"@en ;
    skos:altLabel "supplementalservicefacility"@en ;
    rdfs:subClassOf datex:Facilities.SupplementalFacility ;
    rdfs:comment "DATEX II class in namespace Facilities / SupplementalFacility"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "serviceFacilityType"@en ; ea:position 1 ; ea:type datex:Facilities.ServiceFacilityTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "One type of service."@en ] ;
    ea:attribute [ ea:name "numberOfSubitems"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The quantity of subitems to this service facility type, e.g. the total number of restaurant places or fuel dispensers etc."@en ] ;
    ea:attribute [ ea:name "distanceFromOriginFacility"@en ; ea:position 3 ; ea:type datex:Common.MetresAsNonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Approximate distance (given in metres) between this supplemental facility and some origin facility to which it is clearly related (typically a larger facility, e.g. a parking site)."@en ] .

datex:Facilities.Surcharge
    a owl:Class ;
    rdfs:label "Surcharge"@en ;
    skos:definition "Free-text description of the condition that leads to a surcharge being applied"@en ;
    skos:prefLabel "surcharge"@en ;
    rdfs:comment "DATEX II class in namespace Facilities / RatesPublication/Rates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "surchargeType"@en ; ea:position 1 ; ea:type datex:Facilities.SurchargeTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the nature of the surcharge to be applied"@en ] ;
    ea:attribute [ ea:name "value"@en ; ea:position 2 ; ea:type datex:Facilities.AmountOfMoney ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The monetary amount of the surcharge"@en ] ;
    ea:attribute [ ea:name "rate"@en ; ea:position 3 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The percentage rate surcharge to be applied"@en ] ;
    ea:attribute [ ea:name "trigger"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text definition of boundary condition setting applicability of the surcharge value."@en ] ;
    ea:attribute [ ea:name "labelForDisplay"@en ; ea:position 5 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text for display on a receipt and/or in a user interface"@en ] ;
    ea:attribute [ ea:name "refund"@en ; ea:position 6 ; ea:type datex:Facilities.RefundTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates the nature of the refund of the surcharge that is available"@en ] .

