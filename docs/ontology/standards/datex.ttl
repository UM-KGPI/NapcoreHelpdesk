    ea:attribute [ ea:name "currencyType"@en ; ea:position 2 ; ea:type datex:AfirFacilities.CurrencyCode ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Code for the specified currency as defined in ISO 4217."@en ] .

