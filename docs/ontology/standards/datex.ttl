datex:FaultAndStatus.DeviceHealthEnum
    a owl:Class ;
    rdfs:label "DeviceHealthEnum"@en ;
    skos:definition "This enumeration provides information on the health status of a device, in terms of its ability to provide its functional service."@en ;
    skos:prefLabel "device health enum"@en ;
    skos:altLabel "devicehealthenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace FaultAndStatus / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "ok"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device is working properly according to its specified requirements."@en ] ;
    ea:value [ ea:name "notOk"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device is not working properly according to its specified requirements. A reference to a fault may be provided."@en ] ;
    ea:value [ ea:name "functionalityPartlyOk"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some specific functionality of the device is working properly according to its specified requirements, but some other is not."@en ] ;
    ea:value [ ea:name "intermittentlyOk"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device is sometimes working properly according to its specified requirements, but on occasions is not. A reference to a fault may be provided."@en ] ;
    ea:value [ ea:name "alarm"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is an indication of a fault danger or some other undesirable effects. An example might be an environmental alarm, for instance the device-temperature being above a certain threshold."@en ] ;
    ea:value [ ea:name "notResponding"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device does not respond on calling. Nevertheless, it can be possible that the device still sends data. Normally this information is gathered from a system trigger or log trace, which is acknowledged and recorded by an operator."@en ] ;
    ea:value [ ea:name "offline"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device is not connected or cannot be contacted. A reference to a fault may be provided. Usually, this information is generated by an operator."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The status of the device is unknown."@en ] .

datex:FaultAndStatus.DevicePower
    a owl:Class ;
    rdfs:label "DevicePower"@en ;
    skos:definition "Power source for a device"@en ;
    skos:prefLabel "device power"@en ;
    skos:altLabel "devicepower"@en ;
    rdfs:comment "DATEX II class in namespace FaultAndStatus / StatusPublication"@en ;
