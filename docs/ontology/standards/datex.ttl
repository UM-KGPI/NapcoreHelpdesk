datex:Situation.PoorEnvironmentTypeEnum
    a owl:Class ;
    rdfs:label "PoorEnvironmentTypeEnum"@en ;
    skos:definition "Types of poor environmental conditions."@en ;
    skos:prefLabel "poor environment type enum"@en ;
    skos:altLabel "poorenvironmenttypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "badWeather"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Adverse weather conditions are affecting driving conditions."@en ] ;
    ea:value [ ea:name "blizzard"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Heavy snowfall in combination with strong winds, limiting visibility to 50m or less."@en ] ;
    ea:value [ ea:name "blowingDust"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dust blowing across the roadway causing significantly reduced visibility."@en ] ;
    ea:value [ ea:name "blowingSnow"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fallen snow moving due to the forces of wind."@en ] ;
    ea:value [ ea:name "crosswinds"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Strong cross winds across the direction of the roadway (e.g. on a ridge or bridge)."@en ] ;
    ea:value [ ea:name "damagingHail"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Large falling ice pellets or frozen rain capable of causing injury or damage to property."@en ] ;
    ea:value [ ea:name "denseFog"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dense fog, limiting visibility to 50m or less."@en ] ;
    ea:value [ ea:name "eclipse"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Eclipse, either partial or full, of the sun causing low light levels during normal daylight period."@en ] ;
    ea:value [ ea:name "extremeCold"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Abnormally low temperatures."@en ] ;
    ea:value [ ea:name "extremeHeat"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Abnormally high expected maximum temperature."@en ] ;
    ea:value [ ea:name "fog"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fog, visibility more than 50m."@en ] ;
    ea:value [ ea:name "freezingFog"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fog, in conjunction with sub-zero air temperatures causing possible freezing of road surface."@en ] ;
    ea:value [ ea:name "frost"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Frost can be expected."@en ] ;
    ea:value [ ea:name "gales"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Winds between 60 km/h and 90 km/h."@en ] ;
    ea:value [ ea:name "gustyWinds"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Constantly varying winds, significant at times."@en ] ;
    ea:value [ ea:name "hail"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Falling ice pellets or frozen rain."@en ] ;
    ea:value [ ea:name "heavyFrost"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A thick coating of frost can be expected."@en ] ;
    ea:value [ ea:name "heavyRain"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Heavy rainfall, limiting visibility to 50m or less."@en ] ;
    ea:value [ ea:name "heavySnowfall"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dense falling snow, limiting visibility to 50m or less."@en ] ;
    ea:value [ ea:name "hurricaneForceWinds"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Winds over 120 km/h."@en ] ;
    ea:value [ ea:name "lowSunGlare"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Difficult visibility conditions created by low elevation sunlight."@en ] ;
    ea:value [ ea:name "moderateFog"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Misty conditions impairing vision over 100m."@en ] ;
    ea:value [ ea:name "nearbyFire"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fire near the road affecting driving conditions and/or significantly reduced visibility"@en ] ;
    ea:value [ ea:name "nearbyFlooding"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Flooding near the road risking to affect driving conditions"@en ] ;
    ea:value [ ea:name "ozonePollution"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "High concentrations of ozone are present."@en ] ;
    ea:value [ ea:name "pollution"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pollution of an unspecified nature."@en ] ;
    ea:value [ ea:name "patchyFog"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fog, in which intermittent areas of dense fog may be encountered."@en ] ;
    ea:value [ ea:name "precipitationInTheArea"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unspecified precipitation is falling on the area."@en ] ;
    ea:value [ ea:name "rain"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rain, visibility more than 50m."@en ] ;
    ea:value [ ea:name "rainChangingToSnow"@en ; ea:position 30 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Falling rain is changing to snow."@en ] ;
    ea:value [ ea:name "sandStorms"@en ; ea:position 31 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Sand blowing across the roadway causing significantly reduced visibility."@en ] ;
    ea:value [ ea:name "severeExhaustPollution"@en ; ea:position 32 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pollution from exhaust fumes has reached a level sufficient to cause concern."@en ] ;
    ea:value [ ea:name "severeSmog"@en ; ea:position 33 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Environmental warning of very poor air quality resulting from smog."@en ] ;
    ea:value [ ea:name "showers"@en ; ea:position 34 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Light rain or intermittent rain."@en ] ;
    ea:value [ ea:name "sleet"@en ; ea:position 35 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rain mingled with snow or hail."@en ] ;
    ea:value [ ea:name "smogAlert"@en ; ea:position 36 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Environmental warning of poor air quality resulting from smog."@en ] ;
    ea:value [ ea:name "smokeHazard"@en ; ea:position 37 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Smoke drifting across the roadway causing significantly reduced visibility."@en ] ;
    ea:value [ ea:name "snowChangingToRain"@en ; ea:position 38 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Falling snow is changing to rain."@en ] ;
    ea:value [ ea:name "snowfall"@en ; ea:position 39 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Falling snow, visibility more than 50m."@en ] ;
    ea:value [ ea:name "sprayHazard"@en ; ea:position 40 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Reduced visibility resulting from spray created by moving vehicles on a wet roadway."@en ] ;
    ea:value [ ea:name "stormForceWinds"@en ; ea:position 41 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Winds between 90 km/h and 120 km/h."@en ] ;
    ea:value [ ea:name "strongGustsOfWind"@en ; ea:position 42 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Constantly varying winds, strong at times."@en ] ;
    ea:value [ ea:name "strongWinds"@en ; ea:position 43 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Winds between 40 km/h and 60 km/h."@en ] ;
    ea:value [ ea:name "swarmsOfInsects"@en ; ea:position 44 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Large numbers of insects which create a hazard for road users through reduced visibility."@en ] ;
    ea:value [ ea:name "temperatureFalling"@en ; ea:position 45 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The temperature is falling significantly."@en ] ;
    ea:value [ ea:name "thunderstorms"@en ; ea:position 46 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Electrical storms, generally with heavy rain."@en ] ;
    ea:value [ ea:name "tornadoes"@en ; ea:position 47 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Very violent, whirling windstorms affecting narrow strips of country."@en ] ;
    ea:value [ ea:name "veryStrongGustsOfWind"@en ; ea:position 48 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Constantly varying winds, very strong at times."@en ] ;
    ea:value [ ea:name "visibilityReduced"@en ; ea:position 49 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Environmental conditions causing reduced visibility."@en ] ;
    ea:value [ ea:name "whiteOut"@en ; ea:position 50 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Falling snow in blizzard conditions resulting in very reduced visibility."@en ] ;
    ea:value [ ea:name "winterStorm"@en ; ea:position 51 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Heavy rain, sleet, hail and/or snow in combination with strong winds, limiting visibility to 50m or less."@en ] .

datex:Situation.ProbabilityOfOccurrenceEnum
    a owl:Class ;
    rdfs:label "ProbabilityOfOccurrenceEnum"@en ;
