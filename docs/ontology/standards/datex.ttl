datex:Parking.RateUsageDurationStartTypeEnum
    a owl:Class ;
    rdfs:label "RateUsageDurationStartTypeEnum"@en ;
    skos:prefLabel "rate usage duration start type enum"@en ;
    skos:altLabel "rateusagedurationstarttypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "atPurchase"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rate usage applies from the time of purchase"@en ] ;
