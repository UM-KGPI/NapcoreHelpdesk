datex:LocationReferencing.PredefinedLocation
    a owl:Class ;
    rdfs:label "PredefinedLocation"@en ;
    skos:definition "An identifiable versioned instance of a single predefined location."@en ;
    skos:prefLabel "predefined location"@en ;
    skos:altLabel "predefinedlocation"@en ;
    rdfs:subClassOf datex:LocationReferencing.PredefinedLocationReference ;
