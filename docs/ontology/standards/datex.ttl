datex:Common.ApplicationRateValue
    a owl:Class ;
    rdfs:label "ApplicationRateValue"@en ;
    skos:definition "A measured or calculated value of the application rate of a substance."@en ;
    skos:prefLabel "application rate value"@en ;
    skos:altLabel "applicationratevalue"@en ;
    rdfs:subClassOf datex:Common.DataValue ;
    rdfs:comment "DATEX II class in namespace Common / Classes/DataValue"@en ;
    ea:kind "class" ;
