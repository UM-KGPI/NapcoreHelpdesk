    ea:value [ ea:name "staff"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Staff."@en ] ;
    ea:value [ ea:name "subscribers"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Subscribers."@en ] ;
