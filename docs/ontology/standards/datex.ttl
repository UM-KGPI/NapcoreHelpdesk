datex:Situation.Delays
    a owl:Class ;
    rdfs:label "Delays"@en ;
    skos:definition "The details of the delays being caused by the situation element defined in the situation record. It is recommended to only use one of the optional attributes to avoid confusion."@en ;
    skos:prefLabel "delays"@en ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/Impact"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "delayBand"@en ; ea:position 1 ; ea:type datex:Situation.DelayBandEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The time band within which the additional travel time due to adverse travel conditions of any kind falls, when compared to \"normal conditions\"."@en ] ;
    ea:attribute [ ea:name "delaysType"@en ; ea:position 2 ; ea:type datex:Situation.DelaysTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Coarse classification of the delay."@en ] ;
    ea:attribute [ ea:name "delayTimeValue"@en ; ea:position 3 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The value of the additional travel time due to adverse travel conditions of any kind, when compared to \"normal conditions\", given in seconds."@en ] .

datex:Situation.DelaysTypeEnum
    a owl:Class ;
    rdfs:label "DelaysTypeEnum"@en ;
    skos:definition "Course classifications of a delay."@en ;
    skos:prefLabel "delays type enum"@en ;
    skos:altLabel "delaystypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "delays"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Delays on the road network as a result of any situation which causes hold-ups."@en ] ;
    ea:value [ ea:name "delaysOfUncertainDuration"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Delays on the road network whose predicted duration cannot be estimated."@en ] ;
    ea:value [ ea:name "longDelays"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Delays on the road network of unusual severity."@en ] ;
    ea:value [ ea:name "veryLongDelays"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Delays on the road network of abnormally unusual severity."@en ] .

datex:Situation.DetailedCauseType
    a owl:Class ;
    rdfs:label "DetailedCauseType"@en ;
    skos:definition "The type of influence that may be the cause of components of a situation. At least one attribute must be populated."@en ;
    skos:prefLabel "detailed cause type"@en ;
    skos:altLabel "detailedcausetype"@en ;
    rdfs:comment "DATEX II class in namespace Situation / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "abnormalTrafficType"@en ; ea:position 1 ; ea:type datex:Situation.AbnormalTrafficTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A characterization of the nature of abnormal traffic flow, i.e. specifically relating to the nature of the traffic movement."@en ] ;
    ea:attribute [ ea:name "accidentType"@en ; ea:position 2 ; ea:type datex:Situation.AccidentTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "A characterization of the nature of the accident."@en ] ;
    ea:attribute [ ea:name "animalPresenceType"@en ; ea:position 3 ; ea:type datex:Situation.AnimalPresenceTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates the nature of animals present on or near the roadway."@en ] ;
    ea:attribute [ ea:name "authorityOperationType"@en ; ea:position 4 ; ea:type datex:Situation.AuthorityOperationTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of authority initiated operation or activity that could disrupt traffic."@en ] ;
    ea:attribute [ ea:name "constructionWorkType"@en ; ea:position 5 ; ea:type datex:Situation.ConstructionWorkTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The type of construction work being performed."@en ] ;
    ea:attribute [ ea:name "disturbanceActivityType"@en ; ea:position 6 ; ea:type datex:Situation.DisturbanceActivityTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Includes all situations of a public disorder type or of an alert type, with potential to disrupt traffic."@en ] ;
    ea:attribute [ ea:name "drivingConditionType"@en ; ea:position 7 ; ea:type datex:Situation.DrivingConditionTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of the driving conditions at the specified location."@en ] ;
    ea:attribute [ ea:name "environmentalObstructionType"@en ; ea:position 8 ; ea:type datex:Situation.EnvironmentalObstructionTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Characterization of an obstruction on the road resulting from an environmental cause."@en ] ;
    ea:attribute [ ea:name "equipmentOrSystemFaultType"@en ; ea:position 9 ; ea:type datex:Situation.EquipmentOrSystemFaultTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Failure, malfunction or non operational condition of equipment or system."@en ] ;
    ea:attribute [ ea:name "generalInstructionToRoadUsersType"@en ; ea:position 10 ; ea:type datex:Situation.GeneralInstructionToRoadUsersTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "General instruction that is issued by the network/road operator which is applicable to drivers and sometimes passengers."@en ] ;
    ea:attribute [ ea:name "generalNetworkManagementType"@en ; ea:position 11 ; ea:type datex:Situation.GeneralNetworkManagementTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The type of traffic management action instigated by the network/road operator."@en ] ;
    ea:attribute [ ea:name "infrastructureDamageType"@en ; ea:position 12 ; ea:type datex:Situation.InfrastructureDamageTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Characterization of an obstruction on the road resulting from the failure or damage of infrastructure on, under, above or close to the road."@en ] ;
    ea:attribute [ ea:name "nonWeatherRelatedRoadConditionType"@en ; ea:position 13 ; ea:type datex:Situation.NonWeatherRelatedRoadConditionTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The type of road conditions which are not related to the weather."@en ] ;
    ea:attribute [ ea:name "obstructionType"@en ; ea:position 14 ; ea:type datex:Situation.ObstructionTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Characterization of the type of general obstruction."@en ] ;
    ea:attribute [ ea:name "poorEnvironmentType"@en ; ea:position 15 ; ea:type datex:Situation.PoorEnvironmentTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The type of environment condition which is affecting driving conditions."@en ] ;
    ea:attribute [ ea:name "publicEventType"@en ; ea:position 16 ; ea:type datex:Common.PublicEventTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of public event which could disrupt traffic."@en ] ;
    ea:attribute [ ea:name "reroutingManagementType"@en ; ea:position 17 ; ea:type datex:Situation.ReroutingManagementTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Type of rerouting management action instigated by operator."@en ] ;
    ea:attribute [ ea:name "roadMaintenanceType"@en ; ea:position 18 ; ea:type datex:Situation.RoadMaintenanceTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The type of road maintenance or installation work at the specified location."@en ] ;
    ea:attribute [ ea:name "roadOperatorServiceDisruptionType"@en ; ea:position 19 ; ea:type datex:Situation.RoadOperatorServiceDisruptionTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The type of road operator service which is disrupted."@en ] ;
    ea:attribute [ ea:name "roadOrCarriagewayOrLaneManagementType"@en ; ea:position 20 ; ea:type datex:Situation.RoadOrCarriagewayOrLaneManagementTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of road, carriageway or lane management action instigated by operator."@en ] ;
    ea:attribute [ ea:name "roadsideAssistanceType"@en ; ea:position 21 ; ea:type datex:Situation.RoadsideAssistanceTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates the nature of the road side assistance that will be, is or has been provided."@en ] ;
    ea:attribute [ ea:name "roadsideServiceDisruptionType"@en ; ea:position 22 ; ea:type datex:Situation.ServiceDisruptionTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The type of roadside service which is disrupted."@en ] ;
    ea:attribute [ ea:name "speedManagementType"@en ; ea:position 23 ; ea:type datex:Situation.SpeedManagementTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of speed management action instigated by operator."@en ] ;
    ea:attribute [ ea:name "transitServiceInformation"@en ; ea:position 24 ; ea:type datex:Situation.TransitServiceInformationEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Information about transit services."@en ] ;
    ea:attribute [ ea:name "vehicleObstructionType"@en ; ea:position 25 ; ea:type datex:Situation.VehicleObstructionTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Characterization of an obstruction on the road caused by one or more vehicles."@en ] ;
    ea:attribute [ ea:name "weatherRelatedRoadConditionType"@en ; ea:position 26 ; ea:type datex:Common.WeatherRelatedRoadConditionTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The type of road surface condition that is related to the weather which is affecting the driving conditions."@en ] ;
    ea:attribute [ ea:name "winterEquipmentManagementType"@en ; ea:position 27 ; ea:type datex:Common.WinterEquipmentManagementTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of winter equipment management action instigated by operator."@en ] .

datex:Situation.DisturbanceActivity
    a owl:Class ;
    rdfs:label "DisturbanceActivity"@en ;
    skos:definition "Deliberate human action of either a public disorder nature or of a situation alert type which could disrupt traffic."@en ;
    skos:prefLabel "disturbance activity"@en ;
    skos:altLabel "disturbanceactivity"@en ;
    rdfs:subClassOf datex:Situation.Activity ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement/Activity"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "disturbanceActivityType"@en ; ea:position 1 ; ea:type datex:Situation.DisturbanceActivityTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes all situations of a public disorder type or of an alert type, with potential to disrupt traffic."@en ] .

datex:Situation.DisturbanceActivityTypeEnum
    a owl:Class ;
    rdfs:label "DisturbanceActivityTypeEnum"@en ;
    skos:definition "Types of disturbance activities."@en ;
    skos:prefLabel "disturbance activity type enum"@en ;
    skos:altLabel "disturbanceactivitytypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "airRaid"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation relating to any threat from foreign air power."@en ] ;
    ea:value [ ea:name "altercationOfVehicleOccupants"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An altercation (argument, dispute or fight) between two or more vehicle occupants."@en ] ;
    ea:value [ ea:name "assault"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation where an assault has taken place on one or more persons."@en ] ;
    ea:value [ ea:name "assetDestruction"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation where assets of one or more persons or authorities have been destroyed."@en ] ;
    ea:value [ ea:name "attack"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation where an attack on a group of people or properties has taken place."@en ] ;
    ea:value [ ea:name "attackOnVehicle"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation where an attack on a vehicle or its occupants has taken place."@en ] ;
    ea:value [ ea:name "blockadeOrBarrier"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A manned blockade or barrier across a road stopping vehicles passing."@en ] ;
    ea:value [ ea:name "bombAlert"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An alert to a situation where suspected or actual explosive or incendiary devices may cause disruption to traffic."@en ] ;
    ea:value [ ea:name "crowd"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A major gathering of people that could disrupt traffic."@en ] ;
    ea:value [ ea:name "demonstration"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A public protest with the potential to disrupt traffic."@en ] ;
    ea:value [ ea:name "evacuation"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation where a definite area is being cleared due to dangerous conditions or for security reasons."@en ] ;
    ea:value [ ea:name "filterBlockade"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A manned blockade of a road where only certain vehicles are allowed through."@en ] ;
    ea:value [ ea:name "goSlowOperation"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "As a form of protest, several vehicles are driving in a convoy at a low speed which is affecting the normal traffic flow."@en ] ;
    ea:value [ ea:name "gunfireOnRoadway"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation involving gunfire, perceived or actual, on or near the roadway through an act of terrorism or crime, which could disrupt traffic."@en ] ;
    ea:value [ ea:name "illVehicleOccupants"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "One or more occupants of a vehicle are seriously ill, possibly requiring specialist services or assistance. This may disrupt normal traffic flow."@en ] ;
    ea:value [ ea:name "march"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation where people are walking together in large groups for a common purpose, with potential to disrupt traffic."@en ] ;
    ea:value [ ea:name "peopleThrowingObjectsOnTheRoad"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "People throwing objects on the road"@en ] ;
    ea:value [ ea:name "publicDisturbance"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation of public disorder, with potential to disrupt traffic."@en ] ;
    ea:value [ ea:name "radioactiveLeakAlert"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An alert to a radioactive leak which may endanger the public and hence may cause traffic disruption."@en ] ;
    ea:value [ ea:name "riot"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation of public disorder involving violent behaviour and/or destruction of property with the potential to disrupt traffic."@en ] ;
    ea:value [ ea:name "sabotage"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation resulting from any act of sabotage."@en ] ;
    ea:value [ ea:name "securityAlert"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An official alert to a perceived or actual threat of crime or terrorism, which could disrupt traffic."@en ] ;
    ea:value [ ea:name "securityIncident"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation related to a perceived or actual threat of crime or terrorism, which could disrupt traffic."@en ] ;
    ea:value [ ea:name "sightseersObstructingAccess"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Attendees or sightseers to reported event(s) causing obstruction to access."@en ] ;
    ea:value [ ea:name "strike"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation resulting from industrial action that could disrupt traffic."@en ] ;
    ea:value [ ea:name "terroristIncident"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation related to a perceived or actual threat of terrorism, which could disrupt traffic."@en ] ;
    ea:value [ ea:name "theft"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation where assets of one or more persons or authorities have been stolen."@en ] ;
    ea:value [ ea:name "toxicCloudAlert"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An alert to a toxic release of gases and/or particulates into the environment which may endanger the public and hence may cause traffic disruption."@en ] ;
    ea:value [ ea:name "unspecifiedAlert"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An alert to a perceived or actual threat of an unspecified nature, which could disrupt traffic."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 30 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.DrivingConditionTypeEnum
    a owl:Class ;
    rdfs:label "DrivingConditionTypeEnum"@en ;
    skos:definition "Types of the perceived driving conditions."@en ;
    skos:prefLabel "driving condition type enum"@en ;
    skos:altLabel "drivingconditiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "impossible"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Current conditions are making driving impossible."@en ] ;
    ea:value [ ea:name "hazardous"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Driving conditions are hazardous due to environmental conditions."@en ] ;
    ea:value [ ea:name "normal"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Driving conditions are normal."@en ] ;
    ea:value [ ea:name "passableWithCare"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The roadway is passable to vehicles with driver care."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Driving conditions are unknown."@en ] ;
    ea:value [ ea:name "veryHazardous"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Driving conditions are very hazardous due to environmental conditions."@en ] ;
    ea:value [ ea:name "winterConditions"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Driving conditions are consistent with those expected in winter."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.EnvironmentalObstruction
    a owl:Class ;
    rdfs:label "EnvironmentalObstruction"@en ;
    skos:definition "An obstruction on the road resulting from an environmental cause."@en ;
    skos:prefLabel "environmental obstruction"@en ;
    skos:altLabel "environmentalobstruction"@en ;
    rdfs:subClassOf datex:Situation.Obstruction ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement/Obstruction"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "depth"@en ; ea:position 1 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The depth of flooding or of snow on the road."@en ] ;
    ea:attribute [ ea:name "environmentalObstructionType"@en ; ea:position 2 ; ea:type datex:Situation.EnvironmentalObstructionTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Characterization of an obstruction on the road resulting from an environmental cause."@en ] .

datex:Situation.EnvironmentalObstructionTypeEnum
    a owl:Class ;
    rdfs:label "EnvironmentalObstructionTypeEnum"@en ;
    skos:definition "Types of environmental obstructions."@en ;
    skos:prefLabel "environmental obstruction type enum"@en ;
    skos:altLabel "environmentalobstructiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "avalanches"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road may be obstructed or partially obstructed due to snow slides."@en ] ;
    ea:value [ ea:name "earthquakeDamage"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road may be obstructed or partially obstructed because of damage caused by an earthquake."@en ] ;
    ea:value [ ea:name "fallenTrees"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road is obstructed or partially obstructed by one or more fallen trees."@en ] ;
    ea:value [ ea:name "fallingIce"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Falling ice off trees, power lines or structures which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "fallingLightIceOrSnow"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Falling light ice or snow off trees, power lines or structures which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "flashFloods"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road may become quickly inundated by powerful floodwaters due to heavy rain nearby."@en ] ;
    ea:value [ ea:name "flooding"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road is obstructed or partially obstructed by flood water."@en ] ;
    ea:value [ ea:name "forestFire"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic may be disrupted due to a forest fire adjacent to the roadway."@en ] ;
    ea:value [ ea:name "grassFire"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic may be disrupted due to a grass fire adjacent to the roadway."@en ] ;
    ea:value [ ea:name "landslips"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road may be obstructed or partially obstructed due to landslides."@en ] ;
    ea:value [ ea:name "mudSlide"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road may be obstructed or partially obstructed due to mudslides."@en ] ;
    ea:value [ ea:name "sewerOverflow"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road is obstructed or partially obstructed by overflows from one or more sewers."@en ] ;
    ea:value [ ea:name "rockfalls"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road may be obstructed or partially obstructed due to fallen rocks."@en ] ;
    ea:value [ ea:name "seriousFire"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic may be disrupted due to a fire (other than a vehicle fire) adjacent to the roadway."@en ] ;
    ea:value [ ea:name "smokeOrFumes"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Smoke or fumes which may hinder driving conditions or distract drivers."@en ] ;
    ea:value [ ea:name "stormDamage"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road may be obstructed or partially obstructed by debris caused by strong winds."@en ] ;
    ea:value [ ea:name "subsidence"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road surface has sunken or collapsed in places."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.EquipmentOrSystemFault
    a owl:Class ;
    rdfs:label "EquipmentOrSystemFault"@en ;
    skos:definition "Equipment or system which is faulty, malfunctioning or not in a fully operational state that may be of interest or concern to road operators and road users."@en ;
    skos:prefLabel "equipment or system fault"@en ;
    skos:altLabel "equipmentorsystemfault"@en ;
    rdfs:subClassOf datex:Situation.TrafficElement ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "equipmentOrSystemFaultType"@en ; ea:position 1 ; ea:type datex:Situation.EquipmentOrSystemFaultTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Failure, malfunction or non operational condition of equipment or system."@en ] ;
