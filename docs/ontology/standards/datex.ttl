    ea:attribute [ ea:name "roadsideAssistanceType"@en ; ea:position 1 ; ea:type datex:Situation.RoadsideAssistanceTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the nature of the road side assistance that will be, is or has been provided."@en ] .

datex:TrafficManagementPlan.Scenario
    a owl:Class ;
    rdfs:label "Scenario"@en ;
    skos:definition "Predefined kind of road network situation with potential impact that would lead road operators to initiate traffic management. Identifies a subset of possible traffic situations. May be arbitrarily specific yet not fixed to a specific instance in time."@en ;
    skos:prefLabel "scenario"@en ;
    rdfs:comment "DATEX II class in namespace TrafficManagementPlan / Classes/TmplanTable/Scenario"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "emergencyServicesAccessibility"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of whether and how the emergency services can still use the road network in this scenario"@en ] ;
    ea:attribute [ ea:name "externalIdentification"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An external identifier for a Traffic Management Plan scenario, defined during the Traffic Management Plan design phase."@en ] ;
    ea:attribute [ ea:name "name"@en ; ea:position 3 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Human-readable name for the Scenario"@en ] ;
    ea:attribute [ ea:name "scenarioDirector"@en ; ea:position 4 ; ea:type datex:Common.Reference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Organisation responsible for directing the scenario"@en ] ;
    ea:attribute [ ea:name "situationFilter"@en ; ea:position 5 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Filter expressions for traffic related situations to trigger this scenario. The filter language/expressions have to be defined individually."@en ] ;
    ea:attribute [ ea:name "situationType"@en ; ea:position 6 ; ea:type datex:Situation.CauseTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The type(s) of situation that this scenario represents"@en ] ;
    ea:attribute [ ea:name "versionTime"@en ; ea:position 7 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time stamp indicating when this version of the scenario was created or updated."@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 8 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of Traffic Management Plan scenario in natural language."@en ] .

