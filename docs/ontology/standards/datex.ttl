datex:Common.LoadTypeEnum
    a owl:Class ;
    rdfs:label "LoadTypeEnum"@en ;
    skos:definition "Types of load carried by a vehicle."@en ;
    skos:prefLabel "load type enum"@en ;
    skos:altLabel "loadtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "abnormalLoad"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A load that exceeds normal vehicle dimensions in terms of height, length, width, gross vehicle weight or axle weight or any combination of these. Generally termed an \"abnormal load\"."@en ] ;
    ea:value [ ea:name "ammunition"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Ammunition."@en ] ;
    ea:value [ ea:name "chemicals"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Chemicals of unspecified type."@en ] ;
    ea:value [ ea:name "combustibleMaterials"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Combustible materials of unspecified type."@en ] ;
    ea:value [ ea:name "corrosiveMaterials"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Corrosive materials of unspecified type."@en ] ;
    ea:value [ ea:name "debris"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Debris of unspecified type."@en ] ;
    ea:value [ ea:name "empty"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No load."@en ] ;
    ea:value [ ea:name "explosiveMaterials"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Explosive materials of unspecified type."@en ] ;
    ea:value [ ea:name "extraHighLoad"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A load of exceptional height."@en ] ;
    ea:value [ ea:name "extraLongLoad"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A load of exceptional length."@en ] ;
    ea:value [ ea:name "extraWideLoad"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A load of exceptional width."@en ] ;
    ea:value [ ea:name "fuel"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fuel of unspecified type."@en ] ;
    ea:value [ ea:name "glass"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Glass."@en ] ;
    ea:value [ ea:name "goods"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Any goods of a commercial nature."@en ] ;
    ea:value [ ea:name "hazardousMaterials"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Materials classed as being of a hazardous nature."@en ] ;
    ea:value [ ea:name "liquid"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Liquid of an unspecified nature."@en ] ;
    ea:value [ ea:name "livestock"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Livestock."@en ] ;
    ea:value [ ea:name "materials"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "General materials of unspecified type."@en ] ;
    ea:value [ ea:name "materialsDangerousForPeople"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Materials classed as being of a danger to people or animals."@en ] ;
    ea:value [ ea:name "materialsDangerousForTheEnvironment"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Materials classed as being potentially dangerous to the environment."@en ] ;
    ea:value [ ea:name "materialsDangerousForWater"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Materials classed as being dangerous when exposed to water (e.g. materials which may react exothermically with water)."@en ] ;
    ea:value [ ea:name "oil"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Oil."@en ] ;
    ea:value [ ea:name "ordinary"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Materials that present limited environmental or health risk. Non-combustible, non-toxic, non-corrosive."@en ] ;
    ea:value [ ea:name "perishableProducts"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Products or produce that will significantly degrade in quality or freshness over a short period of time."@en ] ;
    ea:value [ ea:name "petrol"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Petrol or petroleum."@en ] ;
    ea:value [ ea:name "pharmaceuticalMaterials"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pharmaceutical materials."@en ] ;
    ea:value [ ea:name "radioactiveMaterials"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Materials that emit significant quantities of electro-magnetic radiation that may present a risk to people, animals or the environment."@en ] ;
    ea:value [ ea:name "refrigeratedGoods"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Refrigerated goods."@en ] ;
    ea:value [ ea:name "refuse"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Refuse."@en ] ;
    ea:value [ ea:name "toxicMaterials"@en ; ea:position 30 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Materials of a toxic nature which may damage the environment or endanger public health."@en ] ;
    ea:value [ ea:name "vehicles"@en ; ea:position 31 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles of any type which are being transported."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 32 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

