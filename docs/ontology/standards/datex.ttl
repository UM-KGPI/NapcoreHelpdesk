    ea:value [ ea:name "january"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The month of January."@en ] ;
    ea:value [ ea:name "february"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The month of February."@en ] ;
    ea:value [ ea:name "march"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The month of March."@en ] ;
    ea:value [ ea:name "april"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The month of April."@en ] ;
    ea:value [ ea:name "may"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The month of May."@en ] ;
    ea:value [ ea:name "june"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The month of June."@en ] ;
    ea:value [ ea:name "july"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The month of July."@en ] ;
    ea:value [ ea:name "august"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The month of August."@en ] ;
    ea:value [ ea:name "september"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The month of September."@en ] ;
    ea:value [ ea:name "october"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The month of October."@en ] ;
    ea:value [ ea:name "november"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The month of November."@en ] ;
    ea:value [ ea:name "december"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The month of December."@en ] .

