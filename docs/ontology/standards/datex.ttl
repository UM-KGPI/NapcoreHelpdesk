    ea:kind "enumeration" ;
    ea:value [ ea:name "accessOnlyTraffic"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic destined for local access only."@en ] ;
    ea:value [ ea:name "destinedForAirport"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic destined for the airport."@en ] ;
    ea:value [ ea:name "destinedForAirportArrivals"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic destined for airport arrivals."@en ] ;
    ea:value [ ea:name "destinedForAirportDepartures"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic destined for airport departures."@en ] ;
    ea:value [ ea:name "destinedForFerryService"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic destined for the ferry service."@en ] ;
    ea:value [ ea:name "destinedForRailService"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic destined for the rail service."@en ] ;
    ea:value [ ea:name "holidayTraffic"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic heading towards holiday destinations."@en ] ;
    ea:value [ ea:name "localTraffic"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic heading towards local destinations."@en ] ;
    ea:value [ ea:name "longDistanceTraffic"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic heading towards destinations which are a long distance away."@en ] ;
    ea:value [ ea:name "regionalTraffic"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic heading towards local regional destinations."@en ] ;
    ea:value [ ea:name "residentsOnlyTraffic"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Local residents only traffic."@en ] ;
    ea:value [ ea:name "throughTraffic"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic which is not for local access, i.e. traffic not destined for local town, city or built up area but for transit though the area."@en ] ;
    ea:value [ ea:name "visitorTraffic"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic heading towards local visitor attraction."@en ] .

datex:Situation.TransitInformation
    a owl:Class ;
    rdfs:label "TransitInformation"@en ;
    skos:definition "The availability of transit services and information relating to their departures. This is limited to those transit services which are of direct relevance to road users, e.g. connecting rail or ferry services."@en ;
    skos:prefLabel "transit information"@en ;
    skos:altLabel "transitinformation"@en ;
    rdfs:subClassOf datex:Situation.ServiceInformation ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/ServiceInformation"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "journeyDestination"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates the stated termination point of the transit journey."@en ] ;
    ea:attribute [ ea:name "journeyOrigin"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates the stated starting point of the transit journey."@en ] ;
    ea:attribute [ ea:name "journeyReference"@en ; ea:position 3 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates a transit service journey number."@en ] ;
    ea:attribute [ ea:name "transitServiceInformation"@en ; ea:position 4 ; ea:type datex:Situation.TransitServiceInformationEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Information about transit services."@en ] ;
    ea:attribute [ ea:name "transitServiceType"@en ; ea:position 5 ; ea:type datex:Situation.TransitServiceTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of transit service to which the information relates."@en ] ;
    ea:attribute [ ea:name "scheduledDepartureTime"@en ; ea:position 6 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates the timetabled departure time of a transit service for a specified location."@en ] .

datex:Situation.TransitServiceInformationEnum
    a owl:Class ;
    rdfs:label "TransitServiceInformationEnum"@en ;
    skos:definition "Types of public transport information."@en ;
    skos:prefLabel "transit service information enum"@en ;
    skos:altLabel "transitserviceinformationenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "cancellations"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Public transport, park-and-ride, rail or bus services are cancelled."@en ] ;
    ea:value [ ea:name "delayDueToBadWeather"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified service is delayed due to bad weather."@en ] ;
    ea:value [ ea:name "delayDueToRepairs"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified service is delayed due to the need for repairs."@en ] ;
    ea:value [ ea:name "delayedUntilFurtherNotice"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified public transport service will be delayed until further notice."@en ] ;
    ea:value [ ea:name "delaysDueToFlotsam"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The departure of the specified ferry service is delayed due to flotsam."@en ] ;
    ea:value [ ea:name "departureOnSchedule"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The departure of the specified service is on schedule."@en ] ;
    ea:value [ ea:name "ferryReplacedByIceRoad"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The ferry service has been replaced by an ice road."@en ] ;
    ea:value [ ea:name "freeShuttleServiceOperating"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A shuttle service is operating at no charge between specified locations."@en ] ;
    ea:value [ ea:name "informationServiceNotAvailable"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The information service relating to the specified transport system is not currently available."@en ] ;
    ea:value [ ea:name "irregularServiceDelays"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified service is subject to irregular delays."@en ] ;
    ea:value [ ea:name "loadCapacityChanged"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The load capacity for the specified service has been changed."@en ] ;
    ea:value [ ea:name "restrictionsForLongerVehicles"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Long vehicles are subject to restrictions on the specified service."@en ] ;
    ea:value [ ea:name "serviceDelays"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified service is subject to delays."@en ] ;
    ea:value [ ea:name "serviceDelaysOfUncertainDuration"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified service is subject to delays whose predicted duration cannot be estimated accurately."@en ] ;
    ea:value [ ea:name "serviceFullyBooked"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The departure of the specified service is fully booked."@en ] ;
    ea:value [ ea:name "serviceNotOperating"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified service is not operating."@en ] ;
    ea:value [ ea:name "serviceNotOperatingSubstituteServiceAvailable"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified service is not operating but an alternative service is available."@en ] ;
    ea:value [ ea:name "serviceSuspended"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified service has been suspended."@en ] ;
    ea:value [ ea:name "serviceWithdrawn"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified service has been cancelled."@en ] ;
    ea:value [ ea:name "shuttleServiceOperating"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A shuttle service is operating between the specified locations."@en ] ;
    ea:value [ ea:name "temporaryChangesToTimetables"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The timetable for the specified service is subject to temporary changes."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

