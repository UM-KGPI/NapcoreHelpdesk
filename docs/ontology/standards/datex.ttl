datex:AfirFacilities.RateMatrixByReference
    a owl:Class ;
    rdfs:label "RateMatrixByReference"@en ;
    skos:definition "Reference to a rate matrix previously specified."@en ;
    skos:prefLabel "rate matrix by reference"@en ;
    skos:altLabel "ratematrixbyreference"@en ;
