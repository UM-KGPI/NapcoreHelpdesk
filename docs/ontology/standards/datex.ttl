    rdfs:range datex:LocationReferencing.DistanceAlongLinearElement ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:LocationReferencing.PointAlongLinearElement.LinearElement
    a owl:ObjectProperty ;
