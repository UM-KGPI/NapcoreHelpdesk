    skos:altLabel "servicefacilitytypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Facilities / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "bikeGarage"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A place where bikes are repaired."@en ] ;
    ea:value [ ea:name "bikeSharing"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Bike Sharing."@en ] ;
