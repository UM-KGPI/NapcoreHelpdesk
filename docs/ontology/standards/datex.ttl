    ea:attribute [ ea:name "automaticallyDeactivated"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether the traffic management response elements that have been implemented are automatically deactivated."@en ] ;
    ea:attribute [ ea:name "automaticallyImplemented"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether the associated traffic management response element is automatically implemented (after acceptance). If false, further triggering will be needed to fully implement the response."@en ] .

