    ea:value [ ea:name "doNotUseExit"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is not to use the specified exit from the identified road to commence the alternative route."@en ] ;
