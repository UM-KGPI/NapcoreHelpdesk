datex:CommonExtension.VehicleEquipmentEnumExtended
    a owl:Class ;
    rdfs:label "VehicleEquipmentEnumExtended"@en ;
    skos:definition "Extension of types of vehicle equipment in use or on board."@en ;
    skos:prefLabel "vehicle equipment enum extended"@en ;
    skos:altLabel "vehicleequipmentenumextended"@en ;
    rdfs:subClassOf datex:Common.VehicleEquipmentEnum ;
    rdfs:comment "DATEX II enumeration in namespace CommonExtension / Final"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "dippedHeadlightsInUse"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles with dipped headlights in use."@en ] ;
    ea:value [ ea:name "electronicTollEquipment"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle is provided with electronic toll equipment."@en ] ;
    ea:value [ ea:name "filterInUse"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A device composed of fibrous, or porous materials which removes solid particulates such as dust, pollen, mold, and bacteria from the air."@en ] ;
    ea:value [ ea:name "speedLimiterInUse"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle with a speed limiter in use."@en ] ;
    ea:value [ ea:name "studdedTyresInUse"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle using studded tyres."@en ] ;
    ea:value [ ea:name "weelchairSystem"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle is fitted with a wheelchair system."@en ] .

datex:CommonExtension.VehicleRegistrationCharacteristics
    a owl:Class ;
    rdfs:label "VehicleRegistrationCharacteristics"@en ;
    skos:definition "Characteristics of the registration of a vehicle."@en ;
    skos:prefLabel "vehicle registration characteristics"@en ;
    skos:altLabel "vehicleregistrationcharacteristics"@en ;
    rdfs:comment "DATEX II class in namespace CommonExtension / Final"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "registeredHistoricVehicle"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The vehicle is registered as a historic vehicle."@en ] .

datex:CommonExtension.VehicleTypeEnumExtended
    a owl:Class ;
    rdfs:label "VehicleTypeEnumExtended"@en ;
    skos:definition "Extension for type of vehicles."@en ;
    skos:prefLabel "vehicle type enum extended"@en ;
    skos:altLabel "vehicletypeenumextended"@en ;
    rdfs:subClassOf datex:Common.VehicleTypeEnum ;
    rdfs:comment "DATEX II enumeration in namespace CommonExtension / Final"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "agriculturalAndForestryVehicle"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle normally used for agricultural, horticultural, cattle breeding, forestry or fishing purposes, e.g. tractor with a max construction speed of 40 km/h."@en ] ;
    ea:value [ ea:name "animalDrawnVehicles"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Animal drawn vehicles."@en ] ;
    ea:value [ ea:name "coach"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A single-decker bus used for longer journeys."@en ] ;
    ea:value [ ea:name "electricVehicles"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Electrically powered vehicles."@en ] ;
    ea:value [ ea:name "extendedCabDualPurposePickup"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Extended-cab dual purpose pickup."@en ] ;
    ea:value [ ea:name "fireEngine"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A large vehicle that carries firefighters and their equipment to a fire."@en ] ;
    ea:value [ ea:name "forestryVehicle"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle normally used for forestry purposes, e.g. tractor with max contruction speed of 40 km/h."@en ] ;
    ea:value [ ea:name "fourStrokeEngineVehicle"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle with four-stroke engine."@en ] ;
    ea:value [ ea:name "fourWheeledVehicle"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Four wheeled vehicle of unspecified type."@en ] ;
    ea:value [ ea:name "goodsVehicles"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Goods vehicles."@en ] ;
    ea:value [ ea:name "gritter"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vehicle for spreading grit or salt on roads in icy or potentially icy weather."@en ] ;
    ea:value [ ea:name "handcarts"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Handcarts."@en ] ;
    ea:value [ ea:name "lowspeedDisabledVehicle"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motorised vehicle designed for the transport of people with a disability. Vehicle usually has limited sizes and speed restrictions apply depending on the road/sidewalk in or outside. The vehicle has a maximum construction speed of 45 km/h."@en ] ;
    ea:value [ ea:name "lowSpeedMotorisedVehicle"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle designed to execute specific tasks with a maximum construction speed of 25 or 45 km/h and do not require a license plate."@en ] ;
    ea:value [ ea:name "microcar"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Moped with more than 2 wheels (usually with a maximum construction speed of 45 km/h)."@en ] ;
    ea:value [ ea:name "mobileMachines"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motorised vehicle designed to execute specific tasks and not constructed for the transport of people and good via road."@en ] ;
    ea:value [ ea:name "motorisedHorseBox"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motorised horse box."@en ] ;
    ea:value [ ea:name "motorisedPersonalTransportDevices"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motorised personal transport devices like kick scooter, e-scooter, gyropod, etc."@en ] ;
    ea:value [ ea:name "motorizedVehicles"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motorized vehicles."@en ] ;
    ea:value [ ea:name "motorizedVehiclesWithoutNumberPlate"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motorized vehicles without number plate."@en ] ;
    ea:value [ ea:name "motorQuadricycles"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motor quadricycles."@en ] ;
    ea:value [ ea:name "nonMotorizedVehicles"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Non motorized vehicles."@en ] ;
    ea:value [ ea:name "passengerCarWithTrailer"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Passenger car towing a trailer."@en ] ;
    ea:value [ ea:name "pickup"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A light-duty truck having an enclosed cab and an open cargo area with low sides and tailgate."@en ] ;
    ea:value [ ea:name "quadricycle"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Quadricycle."@en ] ;
    ea:value [ ea:name "snowPlough"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Snow plough."@en ] ;
    ea:value [ ea:name "soloMotorcycle"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Two-wheeled motorcycles, excluding motorcycles with side cars."@en ] ;
    ea:value [ ea:name "tipper"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A truck having a rear platform which can be raised at its front end, thus enabling a load to be discharged."@en ] ;
    ea:value [ ea:name "tractor"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Tractor."@en ] ;
    ea:value [ ea:name "twoStrokeEngineVehicle"@en ; ea:position 30 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle with two-stroke engine."@en ] ;
    ea:value [ ea:name "withEvenFirstNumberRegistrationPlate"@en ; ea:position 31 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Registration plate starting with an even number."@en ] ;
    ea:value [ ea:name "withOddFirstNumberRegistrationPlate"@en ; ea:position 32 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Registration plate starting with an odd number."@en ] .

datex:CommonExtension.VehicleUsageExtended
    a owl:Class ;
    rdfs:label "VehicleUsageExtended"@en ;
    skos:definition "Extension of the vehicleUsageEnum"@en ;
    skos:prefLabel "vehicle usage extended"@en ;
    skos:altLabel "vehicleusageextended"@en ;
    rdfs:subClassOf datex:Common.VehicleUsageEnum ;
    rdfs:comment "DATEX II enumeration in namespace CommonExtension / Final"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "deliveryServices"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle used for delivering goods or other items."@en ] ;
    ea:value [ ea:name "funeralProcession"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle used in a funeral procession."@en ] ;
    ea:value [ ea:name "government"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle used by government authority."@en ] ;
    ea:value [ ea:name "marketVehicle"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle used as market vehicle."@en ] ;
    ea:value [ ea:name "nightlySurveillance"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Careful watching of a person or place at night, because of a crime that has happened or is expected."@en ] ;
    ea:value [ ea:name "publicTransportation"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle which are available to the public, charge set fares and run on fixed routes."@en ] ;
    ea:value [ ea:name "removals"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle equipped for removals."@en ] ;
    ea:value [ ea:name "schoolBus"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dedicated bus service for schools."@en ] ;
    ea:value [ ea:name "transportOfPeopleWithDisabilities"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle that has a permit for transporting people with disabilities."@en ] ;
    ea:value [ ea:name "entertainment"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle used for entertainment purposes."@en ] .

datex:CommonExtension.WeightTypeEnumExtended
    a owl:Class ;
    rdfs:label "WeightTypeEnumExtended"@en ;
    skos:definition "Extension of weight type enum."@en ;
    skos:prefLabel "weight type enum extended"@en ;
    skos:altLabel "weighttypeenumextended"@en ;
