datex:AfirFacilities.AccessibilityEnum
    a owl:Class ;
    rdfs:label "AccessibilityEnum"@en ;
    skos:definition "Information on accessibility and facilities for persons with disabilities."@en ;
    skos:prefLabel "accessibility enum"@en ;
    skos:altLabel "accessibilityenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirFacilities / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "barrierFreeAccessible"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Accessible without any steps or other barriers."@en ] ;
    ea:value [ ea:name "disabilityAccessible"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Accessible for persons with disabilities. Wheelchair accessible is a special form of it."@en ] ;
    ea:value [ ea:name "wheelChairAccessible"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Accessible by people in a wheelchair."@en ] ;
    ea:value [ ea:name "disabilityFacilities"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There are special facilities for persons with disabilities, like handrails or special furniture."@en ] ;
    ea:value [ ea:name "orientationSystemForBlindPeople"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is some orientation system, which helps blind or visually impaired people. Examples might be some acoustic system or tactile paving."@en ] ;
    ea:value [ ea:name "marking"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is a visible mark for the privilege of persons with disabilities (e.g. a wheelchair symbol)."@en ] ;
    ea:value [ ea:name "none"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No form of special accessibility, i.e. usually not convenient for persons with disabilities, e.g. because of steps or barriers."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "It is unknown whether there is a special form of accessibility."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

