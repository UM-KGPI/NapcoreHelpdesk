    ea:upperBound "1" .

datex:Common.InformationDeliveryServicesEnum
    a owl:Class ;
    rdfs:label "InformationDeliveryServicesEnum"@en ;
    skos:definition "List of service channels or devices on which information or data exchanged can be delivered."@en ;
    skos:prefLabel "information delivery services enum"@en ;
    skos:altLabel "informationdeliveryservicesenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "anyGeneralDeliveryService"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes any general delivery channel such as broadcast channels (e.g. radio, tv, RDS-TMC, TPEG services, etc.) or web publishing available to public or to specific users, depending on Service Provider policies."@en ] ;
    ea:value [ ea:name "safetyServices"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specific services which deliver warning alerts to end users to enhance safety via any specific application available to drivers, including C-ITS services."@en ] ;
    ea:value [ ea:name "vms"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Variable Message Signs or any other visual roadside devices which information are accessible to drivers which aim to affect driving style improving safety and road network LoS."@en ] .

datex:Common.InformationStatusEnum
    a owl:Class ;
    rdfs:label "InformationStatusEnum"@en ;
    skos:definition "Status of the related information (i.e. real, test or exercise)."@en ;
    skos:prefLabel "information status enum"@en ;
    skos:altLabel "informationstatusenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "real"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The information is real. It is not a test or exercise."@en ] ;
    ea:value [ ea:name "securityExercise"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The information is part of an exercise which is for testing security."@en ] ;
    ea:value [ ea:name "technicalExercise"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The information is part of an exercise which includes tests of associated technical subsystems."@en ] ;
    ea:value [ ea:name "test"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The information is part of a test for checking the exchange of this type of information."@en ] .

datex:Common.InstanceOfDayEnum
    a owl:Class ;
