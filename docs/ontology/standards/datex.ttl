datex:TrafficRegulation.AccessRestrictionTypeEnum
    a owl:Class ;
    rdfs:label "AccessRestrictionTypeEnum"@en ;
    skos:definition "Types of access restrictions."@en ;
    skos:prefLabel "access restriction type enum"@en ;
    skos:altLabel "accessrestrictiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace TrafficRegulation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "laneUsageProhibited"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Usage of lane prohibited."@en ] ;
    ea:value [ ea:name "noEntry"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No entry."@en ] ;
    ea:value [ ea:name "noPassingWithoutStopping"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The driver must stop at the line to be able to respect the order by the customs officer or authority representatives."@en ] ;
    ea:value [ ea:name "restrictedAccess"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The access is restricted."@en ] ;
    ea:value [ ea:name "useOfAudibleWarningDevicesProhibited"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicating a zone which is subject to a prohibition on the use of audible warning devices."@en ] .

datex:TrafficRegulation.ActivatedRegulation
    a owl:Class ;
    rdfs:label "ActivatedRegulation"@en ;
    skos:definition "Traffic regulation currently active according to a traffic regulation by authorised actor."@en ;
    skos:prefLabel "activated regulation"@en ;
    skos:altLabel "activatedregulation"@en ;
    rdfs:comment "DATEX II class in namespace TrafficRegulation / TrafficRegulationPublication"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "actor"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Actor entitled by the regulation order to install traffic regulations."@en ] ;
    ea:attribute [ ea:name "issuingAuthority"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The competent authority that issued a traffic regulation order that permits the actor to install traffic regulations."@en ] ;
    ea:attribute [ ea:name "regulationId"@en ; ea:position 3 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A (external) unique identification of the traffic regulation order where the traffic regulation is defined."@en ] .

datex:TrafficRegulation.ActivatedRegulation.TrafficRegulation
    a owl:ObjectProperty ;
    rdfs:domain datex:TrafficRegulation.ActivatedRegulation ;
