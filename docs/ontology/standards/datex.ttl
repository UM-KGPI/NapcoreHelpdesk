    ea:value [ ea:name "surchargePartiallyRefundable"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The surcharge amount is partially but not fully refundable, when termination conditions are met"@en ] ;
