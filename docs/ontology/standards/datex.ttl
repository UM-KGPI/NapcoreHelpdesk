datex:Situation.SituationRecord
    a owl:Class ;
    rdfs:label "SituationRecord"@en ;
    skos:definition "An identifiable versioned instance of a single record/element within a situation."@en ;
    skos:prefLabel "situation record"@en ;
    skos:altLabel "situationrecord"@en ;
    rdfs:comment "DATEX II class in namespace Situation / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "situationRecordCreationReference"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A unique alphanumeric reference (e.g. an external reference or a UUID) of the SituationRecord object (the first version of the record) that was created by the original supplier."@en ] ;
    ea:attribute [ ea:name "situationRecordCreationTime"@en ; ea:position 2 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The date/time that the SituationRecord object (the first version of the record) was created by the original supplier."@en ] ;
    ea:attribute [ ea:name "situationRecordObservationTime"@en ; ea:position 3 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The date/time that the information represented by the current version of the SituationRecord was observed by the original (potentially external) source of the information."@en ] ;
    ea:attribute [ ea:name "situationRecordVersionTime"@en ; ea:position 4 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The date/time that this current version of the SituationRecord within the situation was written into the database of the supplier which is involved in the data exchange. Identity and version of record are defined by the class stereotype implementation."@en ] ;
    ea:attribute [ ea:name "situationRecordFirstSupplierVersionTime"@en ; ea:position 5 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The date/time that the current version of the Situation Record was written into the database of the original supplier in the supply chain."@en ] ;
    ea:attribute [ ea:name "confidentialityOverride"@en ; ea:position 6 ; ea:type datex:Common.ConfidentialityValueEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The extent to which the related information may be circulated, according to the recipient type. Recipients must comply with this confidentiality statement. This overrides any confidentiality defined for the situation as a whole in the header information."@en ] ;
    ea:attribute [ ea:name "probabilityOfOccurrence"@en ; ea:position 7 ; ea:type datex:Situation.ProbabilityOfOccurrenceEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An assessment of the degree of likelihood that the reported event will occur."@en ] ;
    ea:attribute [ ea:name "severity"@en ; ea:position 8 ; ea:type datex:Situation.SeverityEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The assessment of the impact (in terms of severity) that this element of the situation is having, or will have, on the traffic flow as perceived by the supplier."@en ] ;
    ea:attribute [ ea:name "safetyRelatedMessage"@en ; ea:position 9 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates whether this SituationRecord specifies a safety-related traffic situation. At least all traffic situations governed by Commission Delegated Regulation (EU) No 886/2013 shall be indicated."@en ] .

