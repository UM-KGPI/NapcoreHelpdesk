    ea:attribute [ ea:name "operationStatus"@en ; ea:position 2 ; ea:type datex:Facilities.OperationStatusEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The current status for this operating pattern."@en ] .

datex:Parking.OperatingPatternStatus.ptScheduleUpdate
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.OperatingPatternStatus ;
