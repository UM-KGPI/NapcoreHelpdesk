    ea:attribute [ ea:name "permananentlyClosed"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Permanently closed, i.e. it is not intended to open again."@en ] ;
    ea:attribute [ ea:name "temporarilyClosed"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Temporarily closed for an unspecified period."@en ] ;
    ea:attribute [ ea:name "closedFrom"@en ; ea:position 3 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Permanently or temporarily closed from the given date on. May lie in the future - in this case the scene is not closed now."@en ] ;
    ea:attribute [ ea:name "temporarilyClosedUntil"@en ; ea:position 4 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Temporarily closed until the given date (i.e. closure still includes this date)."@en ] .

datex:Facilities.ContactInformation
    a owl:Class ;
    rdfs:label "ContactInformation"@en ;
    skos:definition "Contact information"@en ;
    skos:prefLabel "contact information"@en ;
    skos:altLabel "contactinformation"@en ;
    rdfs:comment "DATEX II class in namespace Facilities / OrganisationPublication"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "language"@en ; ea:position 1 ; ea:type datex:Common.Language ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Language(s) that are supported via telephone or mail."@en ] ;
    ea:attribute [ ea:name "telephoneNumber"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Telephone number, which can be a general number or the number of a specific contact person."@en ] ;
    ea:attribute [ ea:name "faxNumber"@en ; ea:position 3 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Fax number, which can be a general number or the number of a specific contact person."@en ] ;
    ea:attribute [ ea:name "eMail"@en ; ea:position 4 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "E-Mail address, which can be a general mail address or the mail address of a specific contact person."@en ] .

datex:Facilities.ContactPerson
    a owl:Class ;
    rdfs:label "ContactPerson"@en ;
    skos:definition "A specific contact person"@en ;
    skos:prefLabel "contact person"@en ;
    skos:altLabel "contactperson"@en ;
    rdfs:subClassOf datex:Facilities.ContactInformation ;
    rdfs:comment "DATEX II class in namespace Facilities / OrganisationPublication"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "name"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The (last) name of the contact person"@en ] ;
    ea:attribute [ ea:name "firstName"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The first name of the contact person"@en ] ;
    ea:attribute [ ea:name "title"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Title information of the contact person."@en ] ;
    ea:attribute [ ea:name "position"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The position of the contact person"@en ] .

datex:Facilities.Credential
    a owl:Class ;
    rdfs:label "Credential"@en ;
    skos:definition "Class containing reference to a credential (identifiable persistent identity)"@en ;
    skos:prefLabel "credential"@en ;
    rdfs:comment "DATEX II class in namespace Facilities / RatesPublication/Right"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "type"@en ; ea:position 1 ; ea:type datex:Facilities.CredentialTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Type of credential"@en ] ;
    ea:attribute [ ea:name "otherType"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Some other type of credential"@en ] .

datex:Facilities.CredentialAssigned
    a owl:Class ;
    rdfs:label "CredentialAssigned"@en ;
    skos:definition "Information concerning a specific credential that is used for verification for one AssignedRight. Specialisation of a general credential."@en ;
    skos:prefLabel "credential assigned"@en ;
    skos:altLabel "credentialassigned"@en ;
    rdfs:subClassOf datex:Facilities.Credential ;
    rdfs:comment "DATEX II class in namespace Facilities / RatesPublication/Right"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "localIdentifier"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identifier issued by credential issuer."@en ] ;
    ea:attribute [ ea:name "issuer"@en ; ea:position 2 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identity of the credential issuer."@en ] .

datex:Facilities.CredentialTypeEnum
    a owl:Class ;
    rdfs:label "CredentialTypeEnum"@en ;
    skos:definition "A list of the supported credential types available for reference."@en ;
    skos:prefLabel "credential type enum"@en ;
    skos:altLabel "credentialtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Facilities / RatesPublication/Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "hangtag"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Visible, often removable, credential indicator, with visible markings"@en ] ;
    ea:value [ ea:name "permit"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Issued credential, often in the form of an adhesive label, often placed on the windscreen, credential indicator, with visible markings"@en ] ;
    ea:value [ ea:name "licensePlate"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fixed plate, in a defined format, used to identify a specific vehicle. Normally a permanent fixture."@en ] ;
    ea:value [ ea:name "ticket"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Typically issued paper with printed details, often with magnetic strips; typically single use disposable."@en ] ;
    ea:value [ ea:name "eticket"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Digital equivalent of a paper ticket, often presentable via smartphone or similar device for control."@en ] ;
    ea:value [ ea:name "barcode"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Barcode or QR digital print pattern held on any physical media."@en ] ;
    ea:value [ ea:name "bluetooth"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specific bluetooth or BLE identification chip used to associate a BLE receiver to a specific user. Used for both one time and permit uses."@en ] ;
    ea:value [ ea:name "rfid"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specific RF identification associated to an RFID-related account. Used for permit uses."@en ] ;
    ea:value [ ea:name "qrCode"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Quick Reference (QR) code"@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some other credential"@en ] .

datex:Facilities.CurrencyCode
    a owl:Class ;
    rdfs:label "CurrencyCode"@en ;
    skos:definition "Three letter code defining the currency according to ISO 4217:2015 (e.g. EUR for Euro)."@en ;
    skos:prefLabel "currency code"@en ;
    skos:altLabel "currencycode"@en ;
    rdfs:subClassOf datex:Common.String ;
    rdfs:comment "DATEX II data type in namespace Facilities / DataTypes"@en ;
    ea:kind "data type" .

datex:Facilities.Dimension
    a owl:Class ;
    rdfs:label "Dimension"@en ;
    skos:definition "A component that provides dimension information. Especially for multi-storey buildings, the usable area might be larger than the product from its length and width."@en ;
    skos:prefLabel "dimension"@en ;
    rdfs:comment "DATEX II class in namespace Facilities / Dimension"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "length"@en ; ea:position 1 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Length."@en ] ;
    ea:attribute [ ea:name "width"@en ; ea:position 2 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Width."@en ] ;
    ea:attribute [ ea:name "height"@en ; ea:position 3 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Height."@en ] ;
    ea:attribute [ ea:name "usableArea"@en ; ea:position 4 ; ea:type datex:Facilities.SquareMetres ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The area measured in square metres, that is available for some specific purpose."@en ] .

datex:Facilities.Duration
    a owl:Class ;
    rdfs:label "Duration"@en ;
    skos:definition "A duration of time, which may consist of years, months, days, hours, minutes, and seconds components, as defined in ISO 8601."@en ;
    skos:prefLabel "duration"@en ;
    rdfs:comment "DATEX II data type in namespace Facilities / DataTypes"@en ;
    ea:kind "data type" .

datex:Facilities.DurationValue
    a owl:Class ;
    rdfs:label "DurationValue"@en ;
    skos:definition "A measured or calculated value of a period of time."@en ;
    skos:prefLabel "duration value"@en ;
    skos:altLabel "durationvalue"@en ;
    rdfs:subClassOf datex:Common.DataValue ;
    rdfs:comment "DATEX II class in namespace Facilities / DataValue"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "duration"@en ; ea:position 1 ; ea:type datex:Common.Seconds ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A period of time expressed in seconds."@en ] .

datex:Facilities.Eligibility
    a owl:Class ;
    rdfs:label "Eligibility"@en ;
    skos:definition "Class support concepts for defining eligibility criteria."@en ;
    skos:prefLabel "eligibility"@en ;
    rdfs:comment "DATEX II class in namespace Facilities / RatesPublication/Eligibility"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "eligibilityName"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text name for the eligibility definition"@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text description for the eligibility definition"@en ] .

datex:Facilities.Eligibility.Qualification
    a owl:ObjectProperty ;
    rdfs:domain datex:Facilities.Eligibility ;
    rdfs:range datex:Facilities.Qualification ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Facilities.EnergySourceEnum
    a owl:Class ;
    rdfs:label "EnergySourceEnum"@en ;
