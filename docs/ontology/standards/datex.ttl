    ea:attribute [ ea:name "alertCLocationCountryCode"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "ALERT-C country code as defined IEC 62106."@en ] ;
    ea:attribute [ ea:name "alertCLocationTableNumber"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Number allocated to an ALERT-C table in a country. Ref. EN ISO 14819-3 for the allocation of a location table number."@en ] ;
    ea:attribute [ ea:name "alertCLocationTableVersion"@en ; ea:position 3 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Version number associated with an ALERT-C table reference."@en ] .

datex:LocationReferencing.AltitudeAccuracyEnum
    a owl:Class ;
    rdfs:label "AltitudeAccuracyEnum"@en ;
    skos:definition "Coded level of vertical accuracy"@en ;
    skos:prefLabel "altitude accuracy enum"@en ;
    skos:altLabel "altitudeaccuracyenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "equalToOrLessThan1Centimetre"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 1 centimetre"@en ] ;
    ea:value [ ea:name "equalToOrLessThan2Centimetres"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 2 centimetres"@en ] ;
    ea:value [ ea:name "equalToOrLessThan5Centimetres"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 5 centimetres"@en ] ;
    ea:value [ ea:name "equalToOrLessThan10Centimetres"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 10 centimetres"@en ] ;
    ea:value [ ea:name "equalToOrLessThan20Centimetres"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 20 centimetres"@en ] ;
    ea:value [ ea:name "equalToOrLessThan50Centimetres"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 50 centimetres"@en ] ;
    ea:value [ ea:name "equalToOrLessThan1Metre"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 1 metre"@en ] ;
    ea:value [ ea:name "equalToOrLessThan2Metres"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 2 metres"@en ] ;
    ea:value [ ea:name "equalToOrLessThan5Metres"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 5 metres"@en ] ;
    ea:value [ ea:name "equalToOrLessThan10Metres"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 10 metres"@en ] ;
    ea:value [ ea:name "equalToOrLessThan20Metres"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 20 metres"@en ] ;
    ea:value [ ea:name "equalToOrLessThan50Metres"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 50 metres"@en ] ;
    ea:value [ ea:name "equalToOrLessThan100Metres"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 100 metres"@en ] ;
    ea:value [ ea:name "equalToOrLessThan200Metres"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates if the altitude accuracy is equal to or less than 200 metres"@en ] .

datex:LocationReferencing.AltitudeConfidence
    a owl:Class ;
    rdfs:label "AltitudeConfidence"@en ;
    skos:definition "Evaluation of the altitude confidence assessed according to ETSI ISO 102894-2"@en ;
    skos:prefLabel "altitude confidence"@en ;
    skos:altLabel "altitudeconfidence"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/PointCoordinates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "altitudeAccuracyCodedValue"@en ; ea:position 1 ; ea:type datex:LocationReferencing.AltitudeAccuracyEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Absolute accuracy of reported value of a geographical point for a confidence level expressed by a coded scale."@en ] ;
    ea:attribute [ ea:name "altitudeAccuracyCodedError"@en ; ea:position 2 ; ea:type datex:LocationReferencing.PositionConfidenceCodedErrorEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Error code in case the altitude confidence is out of range or cannot be determined"@en ] .

datex:LocationReferencing.AreaDestination
    a owl:Class ;
