datex:AfirEnergyInfrastructure.RefillPointStatus
    a owl:Class ;
    rdfs:label "RefillPointStatus"@en ;
    skos:definition "Dynamic information on the status of the refill point."@en ;
    skos:prefLabel "refill point status"@en ;
    skos:altLabel "refillpointstatus"@en ;
    rdfs:subClassOf datex:AfirFacilities.FacilityStatus ;
    rdfs:comment "DATEX II class in namespace AfirEnergyInfrastructure / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "status"@en ; ea:position 1 ; ea:type datex:AfirEnergyInfrastructure.RefillPointStatusEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Status of the refill point."@en ] ;
    ea:attribute [ ea:name "unitsInStock"@en ; ea:position 2 ; ea:type datex:AfirEnergyInfrastructure.Units ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Amount of delivery units still in stock (with delivery units as defined in the static information model)."@en ] .

datex:AfirEnergyInfrastructure.RefillPointStatus.EnergyRateUpdate
    a owl:ObjectProperty ;
