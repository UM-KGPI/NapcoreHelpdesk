    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:ControlledZone.ControlledZone.TrafficRegulationOrder
    a owl:ObjectProperty ;
    rdfs:domain datex:ControlledZone.ControlledZone ;
    rdfs:range datex:TrafficRegulation.TrafficRegulationOrder ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:ControlledZone.ControlledZone.tariffInformation
    a owl:ObjectProperty ;
    rdfs:domain datex:ControlledZone.ControlledZone ;
    rdfs:range datex:Facilities.Rates ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:ControlledZone.ControlledZoneActivation
    a owl:Class ;
    rdfs:label "ControlledZoneActivation"@en ;
    skos:definition "Class to identify the activation of a dynamic controlled zone as a whole."@en ;
    skos:prefLabel "controlled zone activation"@en ;
    skos:altLabel "controlledzoneactivation"@en ;
