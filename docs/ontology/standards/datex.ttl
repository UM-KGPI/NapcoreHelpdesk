datex:AfirFacilities.RateTable
    a owl:Class ;
    rdfs:label "RateTable"@en ;
    skos:definition "A specific set of rate charges relating to one or more locations and optionally one set of eligibility criteria."@en ;
    skos:prefLabel "rate table"@en ;
    skos:altLabel "ratetable"@en ;
    rdfs:subClassOf datex:AfirFacilities.Rates ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / RatesPublication/Rates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "lastUpdated"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The date/time at which this information was last updated."@en ] ;
    ea:attribute [ ea:name "rateTableName"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of the Rate Table."@en ] ;
    ea:attribute [ ea:name "activeTimes"@en ; ea:position 3 ; ea:type datex:AfirFacilities.Duration ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Periods when the rate table is to be applied."@en ] ;
    ea:attribute [ ea:name "availability"@en ; ea:position 4 ; ea:type datex:AfirFacilities.RateAvailabilityTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Availability of Rate to the public."@en ] ;
    ea:attribute [ ea:name "rateResponsibleParty"@en ; ea:position 5 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Entity responsible for fee collection. Identifies the entity that actually collects payment (e.g. mobile payment provider, online reservation firm, on-site operations)."@en ] ;
    ea:attribute [ ea:name "rateSupersedeLink"@en ; ea:position 6 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identify the rate table that this rate table supersedes. Temporarily supersedes the identified rate table. Use the Rate expiration times to define duration."@en ] ;
    ea:attribute [ ea:name "validation"@en ; ea:position 7 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Are validations accepted when using this rate table? [TRUE] = validations can be applied to transactions using this rate table; [FALSE] validations cannot be applicated to transactions using this rate table."@en ] ;
    ea:attribute [ ea:name "rateType"@en ; ea:position 8 ; ea:type datex:AfirFacilities.RateTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Defines the type of rate in use."@en ] ;
    ea:attribute [ ea:name "validityEnd"@en ; ea:position 9 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Expiration of rate table in date/time. This is when the rate table and pricing expires and is no longer used."@en ] ;
    ea:attribute [ ea:name "validityStart"@en ; ea:position 10 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Valid start date/time of rate table. This is when the rate table and pricing become active."@en ] ;
    ea:attribute [ ea:name "additionalInformation"@en ; ea:position 11 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "URI locator for supplementary additional information concerning use of the rate table."@en ] .

