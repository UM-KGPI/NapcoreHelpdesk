datex:Common.Base64Binary
    a owl:Class ;
    rdfs:label "Base64Binary"@en ;
    skos:definition "Binary data in base 64 encoding, for example for image data."@en ;
    skos:prefLabel "base64 binary"@en ;
    skos:altLabel "base64binary"@en ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Generic"@en ;
    ea:kind "data type" .

datex:Common.Boolean
    a owl:Class ;
    rdfs:label "Boolean"@en ;
    skos:definition "Boolean has the value space required to support the mathematical concept of binary-valued logic: {true, false}."@en ;
    skos:prefLabel "boolean"@en ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Generic"@en ;
    ea:kind "data type" .

datex:Common.CalendarWeekWithinMonth
    a owl:Class ;
    rdfs:label "CalendarWeekWithinMonth"@en ;
    skos:definition "Specification of periods defined by relevant calendar weeks in a month, see ISO8601. Note: Calendar weeks start with Monday. First week is the week containing the first of the month."@en ;
    skos:prefLabel "calendar week within month"@en ;
    skos:altLabel "calendarweekwithinmonth"@en ;
    rdfs:subClassOf datex:Common.DayWeekMonth ;
    rdfs:comment "DATEX II class in namespace Common / Classes/Validity"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "applicableCalenderWeekWithinMonth"@en ; ea:position 1 ; ea:type datex:Common.CalendarWeekWithinMonthEnum ; ea:lowerBound "1" ; ea:upperBound "6" ; ea:definition "Calender week in month. See ISO8601. \"All weeks of the month\" is expressed by not using the CalendarWeekOfMonth class. Note: Calendar weeks start with Monday. First week is the week containing the first of the month."@en ] .

datex:Common.CalendarWeekWithinMonthEnum
    a owl:Class ;
    rdfs:label "CalendarWeekWithinMonthEnum"@en ;
    skos:definition "Calendar week within month (see ISO8601)."@en ;
    skos:prefLabel "calendar week within month enum"@en ;
    skos:altLabel "calendarweekwithinmonthenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "firstWeek"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Calendar week containing the first of the month. Several days of the first week of the month may occur in the previous calendar month. By construction, the last week of a preceding month can also be the first week of a subsequent month."@en ] ;
    ea:value [ ea:name "secondWeek"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Second week of the month."@en ] ;
    ea:value [ ea:name "thirdWeek"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Third week of the month."@en ] ;
    ea:value [ ea:name "fourthWeek"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fourth week of the month."@en ] ;
    ea:value [ ea:name "fifthWeek"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fifth week of the month."@en ] ;
    ea:value [ ea:name "sixthWeek"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Sixth week of the month."@en ] ;
    ea:value [ ea:name "lastWeek"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Last calendar week within month, regardless of its actual number. The last calendar week is the week beginning with Monday and containing the last of the month."@en ] .

datex:Common.ComparisonOperatorEnum
    a owl:Class ;
    rdfs:label "ComparisonOperatorEnum"@en ;
    skos:definition "Logical comparison operations."@en ;
    skos:prefLabel "comparison operator enum"@en ;
    skos:altLabel "comparisonoperatorenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "equalTo"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Logical comparison operator of \"equal to\"."@en ] ;
    ea:value [ ea:name "greaterThan"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Logical comparison operator of \"greater than\"."@en ] ;
    ea:value [ ea:name "greaterThanOrEqualTo"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Logical comparison operator of \"greater than or equal to\"."@en ] ;
    ea:value [ ea:name "lessThan"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Logical comparison operator of \"less than\"."@en ] ;
    ea:value [ ea:name "lessThanOrEqualTo"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Logical comparison operator of \"less than or equal to\"."@en ] .

datex:Common.ComputationMethodEnum
    a owl:Class ;
    rdfs:label "ComputationMethodEnum"@en ;
    skos:definition "Types of computational methods used in deriving data values for data sets."@en ;
    skos:prefLabel "computation method enum"@en ;
    skos:altLabel "computationmethodenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "arithmeticAverageOfSamplesBasedOnAFixedNumberOfSamples"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Arithmetic average of sample values based on a fixed number of samples."@en ] ;
    ea:value [ ea:name "arithmeticAverageOfSamplesInATimePeriod"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Arithmetic average of sample values in a time period."@en ] ;
    ea:value [ ea:name "harmonicAverageOfSamplesInATimePeriod"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Harmonic average of sample values in a time period."@en ] ;
    ea:value [ ea:name "medianOfSamplesInATimePeriod"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Median of sample values taken over a time period."@en ] ;
    ea:value [ ea:name "movingAverageOfSamples"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Moving average of sample values."@en ] .

datex:Common.ConcentrationKilogramsPerCubicMetre
    a owl:Class ;
    rdfs:label "ConcentrationKilogramsPerCubicMetre"@en ;
    skos:definition "Concentration defined in kilograms per cubic metre (equivalent to grams per litre under standard conditions)."@en ;
    skos:prefLabel "concentration kilograms per cubic metre"@en ;
    skos:altLabel "concentrationkilogramspercubicmetre"@en ;
    rdfs:subClassOf datex:Common.Float ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Specific"@en ;
    ea:kind "data type" .

datex:Common.ConcentrationMicrogramsPerCubicMetre
    a owl:Class ;
    rdfs:label "ConcentrationMicrogramsPerCubicMetre"@en ;
    skos:definition "A measure of concentration defined in µg/m3 (micrograms/cubic metre)."@en ;
    skos:prefLabel "concentration micrograms per cubic metre"@en ;
    skos:altLabel "concentrationmicrogramspercubicmetre"@en ;
    rdfs:subClassOf datex:Common.Float ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Specific"@en ;
    ea:kind "data type" .

datex:Common.ConfidentialityValueEnum
    a owl:Class ;
    rdfs:label "ConfidentialityValueEnum"@en ;
    skos:definition "Values of confidentiality."@en ;
    skos:prefLabel "confidentiality value enum"@en ;
    skos:altLabel "confidentialityvalueenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "internalUse"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "For internal use only of the recipient organisation."@en ] ;
    ea:value [ ea:name "noRestriction"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No restriction on usage."@en ] ;
    ea:value [ ea:name "restrictedToAuthorities"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Restricted for use only by authorities."@en ] ;
    ea:value [ ea:name "restrictedToAuthoritiesAndTrafficOperators"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Restricted for use only by authorities and traffic operators."@en ] .

datex:Common.CountryCode
    a owl:Class ;
    rdfs:label "CountryCode"@en ;
    skos:definition "EN ISO 3166-1 alpha-2 two-letter country code"@en ;
    skos:prefLabel "country code"@en ;
    skos:altLabel "countrycode"@en ;
    rdfs:subClassOf datex:Common.String ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Specific"@en ;
    ea:kind "data type" .

datex:Common.CubicMetres
    a owl:Class ;
    rdfs:label "CubicMetres"@en ;
    skos:definition "A volumetric measure defined in cubic metres."@en ;
    skos:prefLabel "cubic metres"@en ;
    skos:altLabel "cubicmetres"@en ;
    rdfs:subClassOf datex:Common.Float ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Specific"@en ;
    ea:kind "data type" .

datex:Common.DangerousGoodsRegulationsEnum
    a owl:Class ;
    rdfs:label "DangerousGoodsRegulationsEnum"@en ;
    skos:definition "Types of dangerous goods regulations."@en ;
    skos:prefLabel "dangerous goods regulations enum"@en ;
    skos:altLabel "dangerousgoodsregulationsenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "adr"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "European agreement on the international carriage of dangerous goods on road."@en ] ;
    ea:value [ ea:name "iataIcao"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Regulations covering the international transportation of dangerous goods issued by the International Air Transport Association and the International Civil Aviation Organisation."@en ] ;
    ea:value [ ea:name "imoImdg"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Regulations regarding the transportation of dangerous goods on ocean-going vessels issued by the International Maritime Organisation."@en ] ;
    ea:value [ ea:name "railroadDangerousGoodsBook"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "International regulations concerning the international carriage of dangerous goods by rail."@en ] .

datex:Common.DataValue
    a owl:Class ;
    rdfs:label "DataValue"@en ;
    skos:definition "A data value of something that can be measured or calculated. Any provided meta-data values specified in the attributes override any specified generic characteristics such as defined for a specific measurement in the MeasurementSiteTable."@en ;
    skos:prefLabel "data value"@en ;
    skos:altLabel "datavalue"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/DataValue"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "dataError"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication of whether the value is deemed to be erroneous by the supplier (true = erroneous). If not present, the data value is assumed to be ok. This may be used when automatic fault detection information relating to sensors is available."@en ] ;
    ea:attribute [ ea:name "reasonForDataError"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The reason why the value is deemed to be erroneous by the supplier."@en ] ;
    ea:attribute [ ea:name "accuracy"@en ; ea:position 3 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The extent to which the value is expected to be free from error, measured as a percentage of the data value. 100% means fully accurate."@en ] ;
    ea:attribute [ ea:name "computationalMethod"@en ; ea:position 4 ; ea:type datex:Common.ComputationMethodEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Method of computation which has been used to compute this data value."@en ] ;
    ea:attribute [ ea:name "numberOfIncompleteInputs"@en ; ea:position 5 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of inputs detected but not completed during the sampling or measurement period; e.g. vehicles detected entering but not exiting the detection zone."@en ] ;
    ea:attribute [ ea:name "numberOfInputValuesUsed"@en ; ea:position 6 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of input values used in the sampling or measurement period to determine the data value."@en ] ;
    ea:attribute [ ea:name "smoothingFactor"@en ; ea:position 7 ; ea:type datex:Common.Float ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Coefficient required when a moving average is computed to give specific weights to the former average and the new data. A typical formula is, F being the smoothing factor: New average = (old average) F + (new data) (1 - F)."@en ] ;
    ea:attribute [ ea:name "standardDeviation"@en ; ea:position 8 ; ea:type datex:Common.Float ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The standard deviation of the sample of input values from which this value was derived, measured in the units of the data value."@en ] ;
    ea:attribute [ ea:name "supplierCalculatedDataQuality"@en ; ea:position 9 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A measure of data quality assigned to the value by the supplier. 100% equates to ideal/perfect quality. The method of calculation is supplier specific and needs to be agreed between supplier and client."@en ] .

datex:Common.Date
    a owl:Class ;
    rdfs:label "Date"@en ;
    skos:definition "A combination of year, month and day integer-valued properties plus an optional timezone property. It represents an interval of exactly one day, beginning on the first moment of the day in the timezone, i.e. '00:00:00' up to but not including '24:00:00'."@en ;
    skos:prefLabel "date"@en ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Generic"@en ;
    ea:kind "data type" .

datex:Common.DateTime
    a owl:Class ;
    rdfs:label "DateTime"@en ;
    skos:definition "A combination of integer-valued year, month, day, hour, minute properties, a decimal-valued second property and a time zone property from which it is possible to determine the local time, the equivalent UTC time and the time zone offset from UTC."@en ;
    skos:prefLabel "date time"@en ;
    skos:altLabel "datetime"@en ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Generic"@en ;
    ea:kind "data type" .

datex:Common.DayEnum
    a owl:Class ;
    rdfs:label "DayEnum"@en ;
    skos:definition "Days of the week."@en ;
    skos:prefLabel "day enum"@en ;
    skos:altLabel "dayenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "monday"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Monday."@en ] ;
    ea:value [ ea:name "tuesday"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Tuesday."@en ] ;
    ea:value [ ea:name "wednesday"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Wednesday."@en ] ;
    ea:value [ ea:name "thursday"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Thursday."@en ] ;
    ea:value [ ea:name "friday"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Friday."@en ] ;
    ea:value [ ea:name "saturday"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Saturday."@en ] ;
    ea:value [ ea:name "sunday"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Sunday."@en ] .

datex:Common.DayWeekMonth
    a owl:Class ;
    rdfs:label "DayWeekMonth"@en ;
    skos:definition "Specification of periods defined by the intersection of days or instances of them, calendar weeks and months."@en ;
    skos:prefLabel "day week month"@en ;
    skos:altLabel "dayweekmonth"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/Validity"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "applicableDay"@en ; ea:position 1 ; ea:type datex:Common.DayEnum ; ea:lowerBound "0" ; ea:upperBound "7" ; ea:definition "Applicable day of the week. \"All days of the week\" is expressed by non-inclusion of this attribute."@en ] ;
    ea:attribute [ ea:name "applicableMonth"@en ; ea:position 2 ; ea:type datex:Common.MonthOfYearEnum ; ea:lowerBound "0" ; ea:upperBound "12" ; ea:definition "Applicable month of the year. \"All months of the year\" is expressed by non-inclusion of this attribute."@en ] .

datex:Common.Decimal
    a owl:Class ;
    rdfs:label "Decimal"@en ;
    skos:definition "A decimal number whose value space is the set of numbers that can be obtained by multiplying an integer by a non-positive power of ten, i.e., expressible as i × 10^-n where i and n are integers and n >= 0."@en ;
    skos:prefLabel "decimal"@en ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Generic"@en ;
    ea:kind "data type" .

datex:Common.DirectionBearingValue
    a owl:Class ;
    rdfs:label "DirectionBearingValue"@en ;
    skos:definition "A measured or calculated value of direction as a bearing."@en ;
    skos:prefLabel "direction bearing value"@en ;
    skos:altLabel "directionbearingvalue"@en ;
    rdfs:subClassOf datex:Common.DataValue ;
    rdfs:comment "DATEX II class in namespace Common / Classes/DataValue"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "directionBearing"@en ; ea:position 1 ; ea:type datex:Common.AngleInDegrees ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A value of direction expressed in terms of a bearing measured in whole degrees. Unless otherwise specified the reference direction corresponding to 0 degrees is North. Values increase in the clockwise direction."@en ] .

datex:Common.DirectionCompassEnum
    a owl:Class ;
    rdfs:label "DirectionCompassEnum"@en ;
    skos:definition "Cardinal direction points of the compass."@en ;
    skos:prefLabel "direction compass enum"@en ;
    skos:altLabel "directioncompassenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "east"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "East."@en ] ;
    ea:value [ ea:name "eastNorthEast"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "East north east."@en ] ;
    ea:value [ ea:name "eastSouthEast"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "East south east."@en ] ;
    ea:value [ ea:name "north"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "North."@en ] ;
    ea:value [ ea:name "northEast"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "North east."@en ] ;
    ea:value [ ea:name "northNorthEast"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "North north east."@en ] ;
    ea:value [ ea:name "northNorthWest"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "North north west."@en ] ;
    ea:value [ ea:name "northWest"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "North west."@en ] ;
    ea:value [ ea:name "south"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "South."@en ] ;
    ea:value [ ea:name "southEast"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "South east."@en ] ;
    ea:value [ ea:name "southSouthEast"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "South south east."@en ] ;
    ea:value [ ea:name "southSouthWest"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "South south west."@en ] ;
    ea:value [ ea:name "southWest"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "South west."@en ] ;
    ea:value [ ea:name "west"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "West."@en ] ;
    ea:value [ ea:name "westNorthWest"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "West north west."@en ] ;
    ea:value [ ea:name "westSouthWest"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "West south west."@en ] .

datex:Common.DirectionCompassValue
    a owl:Class ;
    rdfs:label "DirectionCompassValue"@en ;
    skos:definition "A measured or calculated value of direction as a point of the compass."@en ;
    skos:prefLabel "direction compass value"@en ;
    skos:altLabel "directioncompassvalue"@en ;
    rdfs:subClassOf datex:Common.DataValue ;
    rdfs:comment "DATEX II class in namespace Common / Classes/DataValue"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "directionCompass"@en ; ea:position 1 ; ea:type datex:Common.DirectionCompassEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A value of direction expressed in terms of points of the compass."@en ] .

datex:Common.Double
    a owl:Class ;
    rdfs:label "Double"@en ;
    skos:definition "A double precision number whose value space consists of the values m × 2^e, where m is an integer whose absolute value is less than 2^53, and e is an integer between -1024 and 1023, inclusive."@en ;
    skos:prefLabel "double"@en ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Generic"@en ;
    ea:kind "data type" .

datex:Common.EmissionClassificationEuroEnum
    a owl:Class ;
    rdfs:label "EmissionClassificationEuroEnum"@en ;
    skos:definition "Classification of emission according to the Euro emission classification (based on serveral amendments on 1970 Directive 70/220/EEC). Note htat vehicleType as well as fuelType are mandatory to provide to make this classification explicit."@en ;
    skos:prefLabel "emission classification euro enum"@en ;
    skos:altLabel "emissionclassificationeuroenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "euro5"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Euro 5."@en ] ;
    ea:value [ ea:name "euro5a"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Euro 5a."@en ] ;
    ea:value [ ea:name "euro5b"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Euro 5b."@en ] ;
    ea:value [ ea:name "euro6"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Euro 6."@en ] ;
    ea:value [ ea:name "euro6a"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Euro 6a."@en ] ;
    ea:value [ ea:name "euro6b"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Euro 6b."@en ] ;
    ea:value [ ea:name "euro6c"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Euro 6c."@en ] ;
    ea:value [ ea:name "euroV"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Euro V."@en ] ;
    ea:value [ ea:name "euroVI"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Euro VI."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Any other level."@en ] .

datex:Common.Emissions
    a owl:Class ;
    rdfs:label "Emissions"@en ;
    skos:definition "Emission characteristics of vehicles."@en ;
    skos:prefLabel "emissions"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/VehicleCharacteristics"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "emissionClassificationEuro"@en ; ea:position 1 ; ea:type datex:Common.EmissionClassificationEuroEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The minimum Euro emission classification the vehicle(s) have to comply with according to the 1970 Directive 70/220/EEC and its several amendments. Note that vehicleType and fuelType need to be provided in order to make this classification explicit."@en ] ;
    ea:attribute [ ea:name "emissionClassificationOther"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Some other (probably locally defined) value(s) for emission classification."@en ] ;
    ea:attribute [ ea:name "emissionLevel"@en ; ea:position 3 ; ea:type datex:Common.LowEmissionLevelEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The low emission level of a vehicle."@en ] .

datex:Common.Fault
    a owl:Class ;
    rdfs:label "Fault"@en ;
    skos:definition "Information about a fault relating to a specific piece of equipment or process."@en ;
    skos:prefLabel "fault"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/Fault"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "faultIdentifier"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Unique identifier of the fault."@en ] ;
    ea:attribute [ ea:name "faultDescription"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Textual description of the fault."@en ] ;
    ea:attribute [ ea:name "faultCreationTime"@en ; ea:position 3 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The date and time at which the fault was originally recorded/reported."@en ] ;
    ea:attribute [ ea:name "faultLastUpdateTime"@en ; ea:position 4 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The date and time at which the fault information as specified in this instance was last updated."@en ] ;
    ea:attribute [ ea:name "faultImpactSeverity"@en ; ea:position 5 ; ea:type datex:Common.FaultSeverityEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The severity of the fault in terms of how it affects the usability of the equipment or the reliability of the data generated by the equipment."@en ] ;
    ea:attribute [ ea:name "faultUrgencyToRectify"@en ; ea:position 6 ; ea:type datex:Common.FaultUrgencyEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The urgency to rectify the fault."@en ] ;
    ea:attribute [ ea:name "manufacturerFaultCode"@en ; ea:position 7 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A manufacturer specific code for the fault."@en ] .

datex:Common.FaultSeverityEnum
    a owl:Class ;
    rdfs:label "FaultSeverityEnum"@en ;
    skos:definition "Classification of the severity of faults."@en ;
    skos:prefLabel "fault severity enum"@en ;
    skos:altLabel "faultseverityenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "low"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The fault is of low severity and has only limited impact on the usability of the equipment or the value of the data generated by the equipment."@en ] ;
    ea:value [ ea:name "medium"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The fault is of medium severity which will significantly limit the usability of the equipment or devalue the usefulness of the data generated by the equipment."@en ] ;
    ea:value [ ea:name "high"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The fault is of high severity which will render the equipment unusable or any data generated by the equipment to be of no value."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The fault is of unknown severity and hence its effect on the usability of the equipment or the usefulness of the data generated by the equipment can not be assessed."@en ] .

datex:Common.FaultUrgencyEnum
    a owl:Class ;
    rdfs:label "FaultUrgencyEnum"@en ;
    skos:definition "Classification of the urgency to rectify a fault."@en ;
    skos:prefLabel "fault urgency enum"@en ;
    skos:altLabel "faulturgencyenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "normal"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The urgency to rectify this fault is normal."@en ] ;
    ea:value [ ea:name "urgent"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "It is urgent to rectify this fault."@en ] ;
    ea:value [ ea:name "extremelyUrgent"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "It is extremely urgent to rectify this fault."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The urgency to rectify this fault is not known."@en ] .

datex:Common.Float
    a owl:Class ;
    rdfs:label "Float"@en ;
    skos:definition "A floating point number whose value space consists of the values m × 2^e, where m is an integer whose absolute value is less than 2^24, and e is an integer between -149 and 104, inclusive."@en ;
    skos:prefLabel "float"@en ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Generic"@en ;
    ea:kind "data type" .

datex:Common.FloatingPointMetreDistanceValue
    a owl:Class ;
    rdfs:label "FloatingPointMetreDistanceValue"@en ;
    skos:definition "A measured or calculated value of distance in metres in a floating point format."@en ;
    skos:prefLabel "floating point metre distance value"@en ;
    skos:altLabel "floatingpointmetredistancevalue"@en ;
    rdfs:subClassOf datex:Common.DataValue ;
    rdfs:comment "DATEX II class in namespace Common / Classes/DataValue"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "distance"@en ; ea:position 1 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A value of distance expressed in metres in a floating point format."@en ] .

datex:Common.FrictionValue
    a owl:Class ;
    rdfs:label "FrictionValue"@en ;
    skos:definition "A measured or calculated value of road surface friction."@en ;
    skos:prefLabel "friction value"@en ;
    skos:altLabel "frictionvalue"@en ;
    rdfs:subClassOf datex:Common.DataValue ;
    rdfs:comment "DATEX II class in namespace Common / Classes/DataValue"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "friction"@en ; ea:position 1 ; ea:type datex:Common.Float ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Friction, usually a value between 0 and 1."@en ] .

datex:Common.FuelTypeEnum
    a owl:Class ;
    rdfs:label "FuelTypeEnum"@en ;
    skos:definition "Type of fuel used by a vehicle."@en ;
    skos:prefLabel "fuel type enum"@en ;
    skos:altLabel "fueltypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "all"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "All sort of fuel is accepted."@en ] ;
    ea:value [ ea:name "battery"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Battery."@en ] ;
    ea:value [ ea:name "biodiesel"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Biodiesel."@en ] ;
    ea:value [ ea:name "diesel"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fuel used for compression-ignition (CI) engines."@en ] ;
    ea:value [ ea:name "dieselBatteryHybrid"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Diesel and battery hybrid."@en ] ;
    ea:value [ ea:name "ethanol"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Ethanol."@en ] ;
    ea:value [ ea:name "hydrogen"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Hydrogen."@en ] ;
    ea:value [ ea:name "liquidGas"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Liquid gas of any type including LPG."@en ] ;
    ea:value [ ea:name "lpg"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Liquid petroleum gas."@en ] ;
    ea:value [ ea:name "methane"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Methane gas."@en ] ;
    ea:value [ ea:name "petrol"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fuel used for positive-ignition (PI) engines."@en ] ;
    ea:value [ ea:name "petrol95Octane"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Petrol with 95 octane."@en ] ;
    ea:value [ ea:name "petrol98Octane"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Petrol with 98 octane."@en ] ;
    ea:value [ ea:name "petrolBatteryHybrid"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Petrol and battery hybrid."@en ] ;
    ea:value [ ea:name "petrolLeaded"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Leaded petrol."@en ] ;
    ea:value [ ea:name "petrolUnleaded"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unleaded petrol."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The sort of fuel is not known."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

datex:Common.GenericPublication
    a owl:Class ;
    rdfs:label "GenericPublication"@en ;
