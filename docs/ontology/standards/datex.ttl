datex:Parking.Place
    a owl:Class ;
    rdfs:label "Place"@en ;
    skos:definition "A place or location used for parking, loading, unloading, standing, or some other mobility or transport related activity."@en ;
    skos:prefLabel "place"@en ;
    rdfs:subClassOf datex:Parking.HierarchyElementGeneral ;
