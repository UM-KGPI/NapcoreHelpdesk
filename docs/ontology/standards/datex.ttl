datex:Parking.RegulationEnum
    a owl:Class ;
    rdfs:label "RegulationEnum"@en ;
    skos:definition "Regulation parameters for actions."@en ;
    skos:prefLabel "regulation enum"@en ;
    skos:altLabel "regulationenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "permitted"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Permitted."@en ] ;
    ea:value [ ea:name "prohibited"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Prohibited."@en ] ;
    ea:value [ ea:name "punishable"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The action is prohibited and can be punished."@en ] ;
    ea:value [ ea:name "seasonalHeterogeneous"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "It depends on the season, whether the action is allowed or not."@en ] ;
    ea:value [ ea:name "permittedOnlyAtParticularTimes"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Permitted only at particular times."@en ] ;
    ea:value [ ea:name "permittedOnlyOnParticularAreas"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Permitted only on particular areas (but inside the parking site ground)."@en ] ;
    ea:value [ ea:name "prohibitedAtParticularTimes"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Prohibited at particular times."@en ] ;
    ea:value [ ea:name "prohibitedOnParticularAreas"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Prohibited on particular areas."@en ] ;
    ea:value [ ea:name "onlyOnRequest"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only on request (i.e. permission needed)."@en ] ;
    ea:value [ ea:name "heterogeneous"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The regulation rule is quite complex and cannot be noted here."@en ] ;
    ea:value [ ea:name "onlyOutsideBuildings"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only outside buildings."@en ] ;
    ea:value [ ea:name "onlyInsideBuildings"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only inside buildings."@en ] ;
    ea:value [ ea:name "unspecified"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is no regulation for this action."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The regulation is unknown."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

