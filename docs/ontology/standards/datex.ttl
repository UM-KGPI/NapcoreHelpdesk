    ea:attribute [ ea:name "manufactureDate"@en ; ea:position 3 ; ea:type datex:Common.Date ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "date that this device was manufactured"@en ] ;
    ea:attribute [ ea:name "manufacturer"@en ; ea:position 4 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "the identity of the manufacturer of this device"@en ] ;
    ea:attribute [ ea:name "model"@en ; ea:position 5 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "model of device"@en ] ;
    ea:attribute [ ea:name "name"@en ; ea:position 6 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "name of the individual device"@en ] ;
