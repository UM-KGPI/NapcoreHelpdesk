datex:EnergyInfrastructure.PricingPolicyEnum
    a owl:Class ;
    rdfs:label "PricingPolicyEnum"@en ;
    skos:definition "A list of possible pricing policies at refill points"@en ;
    skos:prefLabel "pricing policy enum"@en ;
    skos:altLabel "pricingpolicyenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace EnergyInfrastructure / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "pricePerChargingTime"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The charging time defines the price."@en ] ;
    ea:value [ ea:name "pricePerDeliveryUnit"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The amount of delivery units (see DeliveryUnitEnum) defines the price."@en ] ;
    ea:value [ ea:name "contract"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A contract defines the pricing."@en ] ;
    ea:value [ ea:name "flatRate"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Customers can or must have (depends on other available options) a flatrate to use the RefillPoint."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The pricing details are unknown."@en ] ;
    ea:value [ ea:name "free"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Charging is free."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other method of pricing."@en ] .

datex:EnergyInfrastructure.RefillPoint
    a owl:Class ;
    rdfs:label "RefillPoint"@en ;
    skos:definition "Technical infrastructure at a specific location that facilitates an energy refilling process being connected to max. one vehicle at a time"@en ;
    skos:prefLabel "refill point"@en ;
    skos:altLabel "refillpoint"@en ;
    rdfs:subClassOf datex:Facilities.Facility ;
    rdfs:comment "DATEX II class in namespace EnergyInfrastructure / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "deliveryUnit"@en ; ea:position 1 ; ea:type datex:EnergyInfrastructure.DeliveryUnitEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Measurement unit that is used for delivery and accounting the energy provided at this refill point"@en ] ;
    ea:attribute [ ea:name "maximumDeliveryAmount"@en ; ea:position 2 ; ea:type datex:EnergyInfrastructure.Units ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum delivery amount"@en ] ;
    ea:attribute [ ea:name "minimumDeliveryAmount"@en ; ea:position 3 ; ea:type datex:EnergyInfrastructure.Units ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Minimum delivery amount"@en ] ;
    ea:attribute [ ea:name "modelType"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A description of the refill point model type."@en ] ;
    ea:attribute [ ea:name "reservation"@en ; ea:position 5 ; ea:type datex:Facilities.ReservationTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Information regarding options for reservation of a time frame."@en ] .

datex:EnergyInfrastructure.RefillPoint.ServiceType
    a owl:ObjectProperty ;
    rdfs:domain datex:EnergyInfrastructure.RefillPoint ;
    rdfs:range datex:EnergyInfrastructure.ServiceType ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:EnergyInfrastructure.RefillPointStatus
    a owl:Class ;
    rdfs:label "RefillPointStatus"@en ;
    skos:definition "Dynamic information on the status of the refill point."@en ;
    skos:prefLabel "refill point status"@en ;
    skos:altLabel "refillpointstatus"@en ;
    rdfs:subClassOf datex:Facilities.FacilityStatus ;
    rdfs:comment "DATEX II class in namespace EnergyInfrastructure / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "status"@en ; ea:position 1 ; ea:type datex:EnergyInfrastructure.RefillPointStatusEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Status of the refill point"@en ] ;
    ea:attribute [ ea:name "unitsInStock"@en ; ea:position 2 ; ea:type datex:EnergyInfrastructure.Units ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Amount of delivery units still in stock (with delivery units as defined in the static information model)"@en ] .

datex:EnergyInfrastructure.RefillPointStatus.waitingTime
    a owl:ObjectProperty ;
    rdfs:domain datex:EnergyInfrastructure.RefillPointStatus ;
    rdfs:range datex:Facilities.DurationValue ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:EnergyInfrastructure.RefillPointStatusEnum
    a owl:Class ;
    rdfs:label "RefillPointStatusEnum"@en ;
    skos:definition "The status of a refill point."@en ;
    skos:prefLabel "refill point status enum"@en ;
    skos:altLabel "refillpointstatusenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace EnergyInfrastructure / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "available"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The refill point is not occupied, has got enough energy resources and can be used."@en ] ;
    ea:value [ ea:name "blocked"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The refill point is not accessible because of a physical barrier, e.g. a car."@en ] ;
    ea:value [ ea:name "charging"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The refill point is currently in use for charging."@en ] ;
    ea:value [ ea:name "faulted"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The refill point has got a fault."@en ] ;
    ea:value [ ea:name "inoperative"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The refill point is not yet active or it is no longer available (deleted)."@en ] ;
    ea:value [ ea:name "occupied"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The refill point is in use, this might include vehicle charging activity."@en ] ;
    ea:value [ ea:name "outOfOrder"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The refill point is currently out of order."@en ] ;
    ea:value [ ea:name "outOfStock"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The refill point is out of stock, i.e. energy resources are empty."@en ] ;
    ea:value [ ea:name "planned"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The refill point is planned, will be operating soon."@en ] ;
    ea:value [ ea:name "removed"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The refill point was discontinued/removed."@en ] ;
    ea:value [ ea:name "reserved"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The refill point is reserved by a customer, i.e. it is not available for other users right now."@en ] ;
    ea:value [ ea:name "unavailable"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is no energy available at this refill point. This could be because of a failure or damage or a longer lasting delivery failure (note that there is a literal 'outOfStock' for a short-term shortage)."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The status of the refill point is unknown (can also be offline)."@en ] .

