datex:Parking.SpaceStatus
    a owl:Class ;
    rdfs:label "SpaceStatus"@en ;
    skos:definition "Status for a single parking space which was defined in the static part of the model."@en ;
    skos:prefLabel "space status"@en ;
    skos:altLabel "spacestatus"@en ;
    rdfs:subClassOf datex:Parking.ParkingStatusInformation ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/ParkingStatus"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "occupied"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "True: Parking space is occupied; False: Parking space is free."@en ] ;
    ea:attribute [ ea:name "declarationValidNow"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Override validity of 'ParkingSpace': True = Parking space declaration is valid now; False = Parking space declaration is invalid now; Omitted = Static validity information is significant (if static validity is omitted too, declaration is valid)."@en ] ;
    ea:attribute [ ea:name "measurementOrCalculationTime"@en ; ea:position 3 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Point in time at which this specific value or set of values has been measured or calculated. It may also be a future time at which a data value is predicted."@en ] ;
    ea:attribute [ ea:name "lastCalibration"@en ; ea:position 4 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Date of last calibration of the detection system in question."@en ] .

datex:Parking.SpecialLocationEnum
    a owl:Class ;
    rdfs:label "SpecialLocationEnum"@en ;
    skos:definition "Types of locations, often associated with some building."@en ;
    skos:prefLabel "special location enum"@en ;
    skos:altLabel "speciallocationenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "airportTerminal"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with an airport terminal."@en ] ;
    ea:value [ ea:name "exhibitonCentre"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with an exhibition centre."@en ] ;
    ea:value [ ea:name "shoppingCentre"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a shopping centre."@en ] ;
    ea:value [ ea:name "specificFacility"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a specific facility (e.g. a hospital, a tourist site, a garden centre, a park etc.). RelatedLocation - specificLocation may be used to give more details."@en ] ;
    ea:value [ ea:name "trainStation"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a train station."@en ] ;
    ea:value [ ea:name "campGround"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a campground."@en ] ;
    ea:value [ ea:name "themePark"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a theme park."@en ] ;
    ea:value [ ea:name "ferryTerminal"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a ferry terminal."@en ] ;
    ea:value [ ea:name "vehicleOnRailTerminal"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a vehicle-to-rail terminal."@en ] ;
    ea:value [ ea:name "coachStation"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a coach station."@en ] ;
    ea:value [ ea:name "cableCarStation"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a cable car station."@en ] ;
    ea:value [ ea:name "publicTransportStation"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a public transport station."@en ] ;
    ea:value [ ea:name "market"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a market."@en ] ;
    ea:value [ ea:name "religiousCentre"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a religious centre."@en ] ;
    ea:value [ ea:name "conventionCentre"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a convention centre."@en ] ;
    ea:value [ ea:name "cinema"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a cinema."@en ] ;
    ea:value [ ea:name "skiLift"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a ski lift."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with some other location. Use \"parkingOtherSpecialLocation\" to specify details."@en ] .

