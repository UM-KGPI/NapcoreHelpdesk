    ea:attribute [ ea:name "nationalIdentifier"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifier or name unique within the specified country."@en ] .

datex:Common.KilogramsConcentrationValue
    a owl:Class ;
    rdfs:label "KilogramsConcentrationValue"@en ;
    skos:definition "A measured or calculated value of concentration of a substance in kilograms per unit volume."@en ;
