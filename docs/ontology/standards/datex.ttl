datex:Parking.VehicleCountAndRate
    a owl:Class ;
    rdfs:label "VehicleCountAndRate"@en ;
    skos:definition "Vehicle rates can be assigned to a parking site or to assigned parking spaces. Furthermore, they can reference to a measurement site or to an entrance/exit."@en ;
    skos:prefLabel "vehicle count and rate"@en ;
    skos:altLabel "vehiclecountandrate"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/VehicleCountAndRate"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "measurementSiteReference"@en ; ea:position 1 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A reference to a versioned measurement site record defined in a Measurement Site table."@en ] ;
    ea:attribute [ ea:name "measuredValueIndex"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "If a measurement site is specified, the index of the measured value can be specified here."@en ] ;
    ea:attribute [ ea:name "dedicatedAccess"@en ; ea:position 3 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specifies a reference to an access, object (i.e. an entrance, an exit or both). A Point location and further characteristics can be specified for those objects."@en ] ;
    ea:attribute [ ea:name "lastCalibration"@en ; ea:position 4 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Date of last calibration of the detection system in question."@en ] ;
    ea:attribute [ ea:name "coveringPetrolStationArea"@en ; ea:position 5 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication, if this detector also covers the area of a petrol station."@en ] .

