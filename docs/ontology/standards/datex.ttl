    ea:value [ ea:name "employees"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Employees."@en ] ;
    ea:value [ ea:name "families"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Families."@en ] ;
