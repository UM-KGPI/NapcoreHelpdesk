    ea:attribute [ ea:name "versionTime"@en ; ea:position 2 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The date/time that this version of the parking table was defined by the supplier. The identity and version of the table are defined by the class stereotype implementation."@en ] .

