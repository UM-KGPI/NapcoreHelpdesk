datex:Parking.ParkingRouteByReference
    a owl:Class ;
    rdfs:label "ParkingRouteByReference"@en ;
    skos:definition "A route defined by a reference to an earlier specified route."@en ;
    skos:prefLabel "parking route by reference"@en ;
    skos:altLabel "parkingroutebyreference"@en ;
    rdfs:subClassOf datex:Parking.ParkingRoute ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/ParkingRoute"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "parkingRouteReference"@en ; ea:position 1 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A reference to a parking route."@en ] .

datex:Parking.ParkingRouteDetails
    a owl:Class ;
    rdfs:label "ParkingRouteDetails"@en ;
    skos:definition "Urban context: Defining parking routes leading to the parking site. Truck parking context: Can be used to define a dynamic route management."@en ;
    skos:prefLabel "parking route details"@en ;
    skos:altLabel "parkingroutedetails"@en ;
    rdfs:subClassOf datex:Parking.ParkingRoute ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/ParkingRoute"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "name"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of the parking route."@en ] ;
    ea:attribute [ ea:name "type"@en ; ea:position 2 ; ea:type datex:Parking.ParkingRouteTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The type of parking route. If not specified, the route is designed for any type of vehicles."@en ] ;
    ea:attribute [ ea:name "dynamicRouteManagement"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates that there is dynamic route management for truck parking, i.e. a management system concerning several truck parking sites (including this one) along a route."@en ] ;
    ea:attribute [ ea:name "iconIndex"@en ; ea:position 4 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An index, which can identify some icon for visualisation of the route. Note that form and usage of this index as well as the icons itself are not further determined here."@en ] ;
    ea:attribute [ ea:name "direction"@en ; ea:position 5 ; ea:type datex:LocationReferencing.DirectionEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The direction of traffic, for which the parking route can be used. If not specified, the route can be used in the order of the given locations."@en ] ;
    ea:attribute [ ea:name "orientation"@en ; ea:position 6 ; ea:type datex:Parking.ParkingRouteOrientationEnum ; ea:lowerBound "0" ; ea:upperBound "2" ; ea:definition "Orientation of traffic, for which the parking route is specified."@en ] .

datex:Parking.ParkingRouteDetails.LocationReference
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.ParkingRouteDetails ;
    rdfs:range datex:LocationReferencing.LocationReference ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Parking.ParkingRouteDetails.ParkingVms
