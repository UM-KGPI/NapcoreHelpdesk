    ea:attribute [ ea:name "securityLevel"@en ; ea:position 2 ; ea:type datex:Parking.EsporgStandardLevelEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Security level identified for this place in a defined scheme"@en ] ;
    ea:attribute [ ea:name "additionalSecurity"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Security equipment of the parking that is not covered by the corresponding enumeration."@en ] ;
    ea:attribute [ ea:name "safety"@en ; ea:position 4 ; ea:type datex:Parking.ParkingSafetyEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Safety measures on the parking according to European Secure Parking Organisation."@en ] ;
    ea:attribute [ ea:name "additionalSafety"@en ; ea:position 5 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Safety measures on the parking that is not covered by the corresponding enumeration."@en ] ;
    ea:attribute [ ea:name "supervision"@en ; ea:position 6 ; ea:type datex:Parking.ParkingSupervisionEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Defines the kind of supervision of the parking site."@en ] ;
