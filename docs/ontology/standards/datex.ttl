    ea:attribute [ ea:name "description"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Supplier-defined free-text description for the rate matrix."@en ] ;
    ea:attribute [ ea:name "versionTime"@en ; ea:position 3 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Timestamp indicating the issuance of this rate matrix."@en ] .

datex:AfirFacilities.RateMatrix.RateTable
    a owl:ObjectProperty ;
    rdfs:domain datex:AfirFacilities.RateMatrix ;
    rdfs:range datex:AfirFacilities.RateTable ;
    ea:lowerBound "1" ;
