datex:TrafficRegulation.GddPictogramCategoryCode
    a owl:Class ;
    rdfs:label "GddPictogramCategoryCode"@en ;
    skos:definition "A 3-digit code to identify a pictogram, as defined in EN ISO 14823-1 Graphic Data Dictionary. That standard is inconsistent in its definition of the value range; this model uses the more permissive definition where the bounds are 100 and 999."@en ;
    skos:prefLabel "gdd pictogram category code"@en ;
    skos:altLabel "gddpictogramcategorycode"@en ;
    rdfs:subClassOf datex:Common.NonNegativeInteger ;
    rdfs:comment "DATEX II data type in namespace TrafficRegulation / DataTypes"@en ;
    ea:kind "data type" .

datex:TrafficRegulation.GddPictogramIdentification
    a owl:Class ;
    rdfs:label "GddPictogramIdentification"@en ;
    skos:definition "Group of codes that uniquely identifies a kind of pictogram, according to the EN ISO 14823-1 Graphic Data Dictionary."@en ;
    skos:prefLabel "gdd pictogram identification"@en ;
    skos:altLabel "gddpictogramidentification"@en ;
    rdfs:comment "DATEX II class in namespace TrafficRegulation / Classes/TrafficRegulation"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "country"@en ; ea:position 1 ; ea:type datex:Common.CountryCode ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Country code used to either allow associating a country-specific rendering with the coded pictogram or distinguish nationally-defined pictogram codes."@en ] ;
    ea:attribute [ ea:name "pictogramCategoryCode"@en ; ea:position 2 ; ea:type datex:TrafficRegulation.GddPictogramCategoryCode ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Code that identifies a pictogram for a given country and service category."@en ] ;
    ea:attribute [ ea:name "serviceCategory"@en ; ea:position 3 ; ea:type datex:TrafficRegulation.GddServiceCategoryEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Category used to group pictograms for a given usage."@en ] .

datex:TrafficRegulation.GddServiceCategoryEnum
    a owl:Class ;
    rdfs:label "GddServiceCategoryEnum"@en ;
    skos:definition "Type of service offered by the pictogram, as defined in EN ISO 14823-1."@en ;
    skos:prefLabel "gdd service category enum"@en ;
    skos:altLabel "gddservicecategoryenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace TrafficRegulation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "ambientConditions"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Notifying of road-related ambient conditions and events on route (GDD service category 31)."@en ] ;
    ea:value [ ea:name "dangerWarning"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Danger warning sign information (GDD service category 11)."@en ] ;
    ea:value [ ea:name "informative"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Informative, advisory, or guiding (GDD service category 13)."@en ] ;
