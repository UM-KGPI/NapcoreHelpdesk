    ea:value [ ea:name "vehicle"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vehicle in its role as a connected communicating device"@en ] ;
    ea:value [ ea:name "vms"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A variable message sign"@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some other device"@en ] .

