    ea:attribute [ ea:name "countryCode"@en ; ea:position 3 ; ea:type datex:Common.CountryCode ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "EN ISO 3166-1 two-character country code."@en ] .

datex:LocationExtension.Address.AddressLine
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationExtension.Address ;
    rdfs:range datex:LocationExtension.AddressLine ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:LocationExtension.AddressLine
    a owl:Class ;
    rdfs:label "AddressLine"@en ;
    skos:definition "A class defining information concerning one line of a postal address."@en ;
    skos:prefLabel "address line"@en ;
    skos:altLabel "addressline"@en ;
    rdfs:comment "DATEX II class in namespace LocationExtension / Final"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "order"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The sequence order that the address line element should be displayed in"@en ] ;
    ea:attribute [ ea:name "type"@en ; ea:position 2 ; ea:type datex:LocationExtension.AddressLineTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type for the address line element"@en ] ;
    ea:attribute [ ea:name "text"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Free-text description for the address line element"@en ] .

datex:LocationExtension.AddressLineTypeEnum
    a owl:Class ;
    rdfs:label "AddressLineTypeEnum"@en ;
    skos:definition "A list of supported address line types."@en ;
    skos:prefLabel "address line type enum"@en ;
    skos:altLabel "addresslinetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationExtension / Final"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "apartment"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Element indicating a discrete element of a building forming the address"@en ] ;
    ea:value [ ea:name "building"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Element identifying the number or name and type of the edifice or construction relevant for the address [derived from ISO19160-4]"@en ] ;
    ea:value [ ea:name "poBox"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A postal delivery location identifier, not necessarily a physical location."@en ] ;
    ea:value [ ea:name "unit"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An element representing a section of a building or organisation."@en ] ;
    ea:value [ ea:name "region"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Element indicating the name of the area within or adjacent to the town in which delivery address is."@en ] ;
    ea:value [ ea:name "town"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Element indicating the name of the populated place in which a delivery point is located, or near to or via which the delivery point is accessed. [Source: ISO19160-4]"@en ] ;
    ea:value [ ea:name "districtTerritory"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Element specifying the geographic or administrative area of the country for the address [Source: 19160-4]"@en ] ;
    ea:value [ ea:name "floor"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Element indicating the floor or level on which a delivery point is located in a multi-storey building [Source:ISO19160-4]"@en ] ;
    ea:value [ ea:name "street"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Element indicating road or street identifier or name"@en ] ;
    ea:value [ ea:name "houseNumber"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Element indicating a house number"@en ] ;
    ea:value [ ea:name "generalTextLine"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A non-predefined text line for general purpose."@en ] .

