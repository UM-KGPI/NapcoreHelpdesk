    ea:value [ ea:name "electricScooter"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A two-wheeled device with handlebars and a floorboard that is powered by a motor."@en ] ;
    ea:value [ ea:name "personalLightElectricVehicle"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Small electronic vehicle where the rider stands on a base between the wheels and holds onto a bar at waist height. It also includes other personal light electric vehicles like kick scooters, self-balancing unicycles, self-balancing scooters."@en ] .

