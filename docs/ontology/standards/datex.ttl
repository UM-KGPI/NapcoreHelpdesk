datex:RoadTrafficData.IndividualVehicleDataValues
    a owl:Class ;
    rdfs:label "IndividualVehicleDataValues"@en ;
    skos:definition "Measured or calculated data values relating to individual vehicles derived from detectors at the specified measurement site."@en ;
    skos:prefLabel "individual vehicle data values"@en ;
    skos:altLabel "individualvehicledatavalues"@en ;
    rdfs:subClassOf datex:RoadTrafficData.TrafficData ;
    rdfs:comment "DATEX II class in namespace RoadTrafficData / Classes/TrafficData/IndividualVehicleData"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "arrivalTime"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The time of the arrival of an individual vehicle in a detection zone."@en ] ;
    ea:attribute [ ea:name "distanceGap"@en ; ea:position 2 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The measured distance between the front of this vehicle and the rear of the preceding one, in metres at the specified measurement site."@en ] ;
    ea:attribute [ ea:name "distanceHeadway"@en ; ea:position 3 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The measured distance between one end (normally the front) of this vehicle and the same end of the preceding vehicle at the specified measurement site."@en ] ;
    ea:attribute [ ea:name "exitTime"@en ; ea:position 4 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The time when an individual vehicle leaves a detection zone."@en ] ;
    ea:attribute [ ea:name "passageDuration"@en ; ea:position 5 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The time elapsed between an individual vehicle entering a detection zone and exiting the same detection zone as detected by entry and exit sensors."@en ] ;
    ea:attribute [ ea:name "presenceDuration"@en ; ea:position 6 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The period of time during which a vehicle activates a presence sensor."@en ] ;
    ea:attribute [ ea:name "speed"@en ; ea:position 7 ; ea:type datex:Common.KilometresPerHour ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The measured speed of the individual vehicle at the specified measurement site."@en ] ;
    ea:attribute [ ea:name "timeGap"@en ; ea:position 8 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The time interval between the arrival of this vehicle's front at a point on the roadway, and that of the departure of the rear of the preceding one."@en ] ;
    ea:attribute [ ea:name "timeHeadway"@en ; ea:position 9 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The measured time interval between this vehicle's arrival at (or departure from) a point on the roadway, and the equivalent event for the preceding vehicle."@en ] .

