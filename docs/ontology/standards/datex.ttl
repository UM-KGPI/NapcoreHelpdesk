datex:CommonExtension.EuSpecialPurposeVehicleEnum
    a owl:Class ;
    rdfs:label "EuSpecialPurposeVehicleEnum"@en ;
    skos:definition "Vehicle purpose according to EU legislation."@en ;
    skos:prefLabel "eu special purpose vehicle enum"@en ;
    skos:altLabel "euspecialpurposevehicleenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace CommonExtension / Final"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "motorCaravan"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Special purpose M category vehicle constructed to include living accommodation which contains at least the following equipment: seats and table, sleeping accommodation, cooking facilities and storage facilities."@en ] ;
    ea:value [ ea:name "armouredVehicle"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle intended for the protection of conveyed passengers and/or goods and complying with armour plating anti-bullet requirements."@en ] ;
    ea:value [ ea:name "ambulance"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A motor vehicle of category M intended for the transport of sick or injured people and having special equipment for such purpose."@en ] ;
    ea:value [ ea:name "hearse"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A motor vehicle of category M intended for the transport of deceased people and having special equipment for such purpose."@en ] ;
    ea:value [ ea:name "trailerCaravan"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Trailer caravan ee ISO Standard 3833-77, term No 3.2.1.3."@en ] ;
    ea:value [ ea:name "mobileCrane"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Special purpose vehicle of category N3, not fitted for the carriage of goods, provided with a crane whose lifting moment is equal to or higher than 400 kNm."@en ] ;
    ea:value [ ea:name "otherSpecialPurposeVehicle"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other special purpose vehicle."@en ] ;
    ea:value [ ea:name "wheelChairAccessibleVehicle"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Wheel chair accessible vehicle."@en ] .

datex:CommonExtension.EuVehicleCategoryEnum
    a owl:Class ;
    rdfs:label "EuVehicleCategoryEnum"@en ;
    skos:definition "Vehicle categories according to EU legislation."@en ;
    skos:prefLabel "eu vehicle category enum"@en ;
    skos:altLabel "euvehiclecategoryenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace CommonExtension / Final"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "l1"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Light two-wheel powered vehicle."@en ] ;
    ea:value [ ea:name "l2"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Three-wheel moped."@en ] ;
    ea:value [ ea:name "l3"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Two-wheel motorcycle."@en ] ;
    ea:value [ ea:name "l4"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Two-wheel motorcycle with side-car."@en ] ;
    ea:value [ ea:name "l5"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Powered tricycle."@en ] ;
    ea:value [ ea:name "l6"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Light quadricycle."@en ] ;
    ea:value [ ea:name "l7"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Heavy quadricycle."@en ] ;
    ea:value [ ea:name "m"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motor vehicles with at least four wheels designed and constructed for the carriage of passengers."@en ] ;
    ea:value [ ea:name "r"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Agricultural trailer: any agricultural or forestry vehicle intended mainly to be towed by a tractor and intended mainly to carry loads or process materials. The ratio of the techn. permissible max. laden to unladen mass is equal to or greater than 3.0."@en ] ;
    ea:value [ ea:name "r1"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Trailers, the sum of the technically permissible masses per axle of which does not exceed 1,500 kg."@en ] ;
    ea:value [ ea:name "r2"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Trailers, the sum of the technically permissible masses per axle of which exceeds 1,500 kg but does not exceed 3,500 kg."@en ] ;
    ea:value [ ea:name "r3"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Trailers, the sum of the technically permissible masses per axle of which exceeds 3,500 kg but does not exceed 21,000 kg."@en ] ;
    ea:value [ ea:name "r4"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Trailers, the sum of the technically permissible masses per axle of which exceeds 21,000 kg."@en ] ;
    ea:value [ ea:name "t1"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Wheeled tractors with the closest axle to the driver having a minimum track width of not less than 1,500 mm; with an unladen mass in running order of more than 600 kg and with a ground clearance of not more than 1,000 mm."@en ] ;
    ea:value [ ea:name "t2"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle category t2 according to Regulation (EU) No 167/2013."@en ] ;
    ea:value [ ea:name "t3"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Wheeled tractors with unladen mass in running order of not more than 600 kg."@en ] ;
    ea:value [ ea:name "t4"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Special purpose wheeled tractors with a maximum design speed of not more than 40 km/h."@en ] ;
    ea:value [ ea:name "t41"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Category T4.1: High clearance tractors."@en ] ;
    ea:value [ ea:name "t42"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Category T4.2: Extra-wide tractors."@en ] ;
    ea:value [ ea:name "t43"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Category T4.3: Low clearance tractors."@en ] ;
    ea:value [ ea:name "m1"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles designed and constructed for the carriage of passengers and comprising no more than eight seats in addition to the driver’s seat."@en ] ;
    ea:value [ ea:name "m2"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles designed and constructed for the carriage of passengers, comprising more than eight seats in addition to the driver’s seat, and having a maximum mass not exceeding 5 tonnes."@en ] ;
    ea:value [ ea:name "m3"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles designed and constructed for the carriage of passengers, comprising more than eight seats in addition to the driver’s seat, and having a maximum mass exceeding 5 tonnes."@en ] ;
    ea:value [ ea:name "n"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motor vehicles with at least four wheels designed and constructed for the carriage of goods."@en ] ;
    ea:value [ ea:name "n1"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles designed and constructed for the carriage of goods and having a maximum mass not exceeding 3,5 tonnes"@en ] ;
    ea:value [ ea:name "n2"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles designed and constructed for the carriage of goods and having a maximum mass exceeding 3,5 tonnes but not exceeding 12 tonnes."@en ] ;
    ea:value [ ea:name "n3"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles designed and constructed for the carriage of goods and having a maximum mass exceeding 12 tonnes."@en ] ;
    ea:value [ ea:name "o"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Trailers (including semi-trailers)."@en ] ;
    ea:value [ ea:name "o1"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Trailers with a maximum mass not exceeding 0,75 tonnes"@en ] ;
    ea:value [ ea:name "o2"@en ; ea:position 30 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Trailers with a maximum mass exceeding 0,75 tonnes but not exceeding 3,5 tonnes."@en ] ;
    ea:value [ ea:name "o3"@en ; ea:position 31 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Trailers with a maximum mass exceeding 3,5 tonnes but not exceeding 10 tonnes."@en ] ;
    ea:value [ ea:name "o4"@en ; ea:position 32 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Trailers with a maximum mass exceeding 10 tonnes."@en ] .

