    ea:kind "enumeration" ;
    ea:value [ ea:name "allParkingsFull"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "All parking places within the specified area are full."@en ] ;
    ea:value [ ea:name "multiStoreyParkingsFull"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "All multi storey parking sites within the specified area are full."@en ] ;
    ea:value [ ea:name "noMoreParkingSpacesAvailable"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There are no more parking spaces available within the specified area."@en ] ;
    ea:value [ ea:name "enoughSpacesAvailable"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There are enough spaces available within the specified area."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The status of the group of parking sites is unknown."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

