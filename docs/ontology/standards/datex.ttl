    ea:value [ ea:name "lostWheel"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle has lost a wheel"@en ] ;
    ea:value [ ea:name "motorMechanics"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Problem with the motor mechanics of a vehicle"@en ] ;
    ea:value [ ea:name "oilLeakage"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle has an oil leak"@en ] ;
    ea:value [ ea:name "suspension"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Problem with the suspension of a vehicle"@en ] ;
