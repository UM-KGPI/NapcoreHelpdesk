    skos:prefLabel "places enum"@en ;
    skos:altLabel "placesenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "aroundBendsInTheRoad"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Around bends in the road."@en ] ;
