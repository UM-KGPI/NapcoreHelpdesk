    ea:value [ ea:name "docstop"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The site is part of the Docstop project, http://www.docstoponline.eu, which means medical assistance for professional drivers."@en ] ;
    ea:value [ ea:name "foodShopping"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Food shopping."@en ] ;
