    ea:attribute [ ea:name "bioethanolPercentage"@en ; ea:position 3 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Percentage of bioethanol in petrol (typically 5% or 10%)"@en ] ;
    ea:attribute [ ea:name "bioethanolType"@en ; ea:position 4 ; ea:type datex:EnergyInfrastructure.BioethanolTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Listing of common types of petrol with bioethanol"@en ] .

datex:EnergyInfrastructure.PetrolTypeEnum
    a owl:Class ;
