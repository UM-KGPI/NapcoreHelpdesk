datex:Vms.VmsStatus
    a owl:Class ;
    rdfs:label "VmsStatus"@en ;
    skos:definition "Provides the current status and settings of the VMS and the currently displayed information."@en ;
    skos:prefLabel "vms status"@en ;
    skos:altLabel "vmsstatus"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsStatus"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "flashingLightsOn"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates if lights outside display areas (called lanterns in some countries) are turned on."@en ] ;
    ea:attribute [ ea:name "remainingPowerCapacity"@en ; ea:position 2 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The estimated length of time for which the VMS will have power to continue operating"@en ] ;
    ea:attribute [ ea:name "statusUpdateTime"@en ; ea:position 3 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time at which this VMS status was updated"@en ] ;
    ea:attribute [ ea:name "workingStatus"@en ; ea:position 4 ; ea:type datex:Vms.WorkingStatusEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates whether the VMS is usable. Note it can still be usable with minor faults."@en ] ;
    ea:attribute [ ea:name "sequencingInterval"@en ; ea:position 5 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The time duration that each message is displayed for before the VMS displays the next message in the sequence."@en ] .

