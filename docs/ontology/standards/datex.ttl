datex:LocationReferencing.PointByCoordinates
    a owl:Class ;
    rdfs:label "PointByCoordinates"@en ;
    skos:definition "A single point defined only by a coordinate set with an optional bearing direction."@en ;
    skos:prefLabel "point by coordinates"@en ;
    skos:altLabel "pointbycoordinates"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/PointCoordinates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "bearing"@en ; ea:position 1 ; ea:type datex:Common.AngleInDegrees ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A bearing at the point measured in degrees (0 - 359). Unless otherwise specified the reference direction corresponding to 0 degrees is North. Values increase in the clockwise direction."@en ] .

