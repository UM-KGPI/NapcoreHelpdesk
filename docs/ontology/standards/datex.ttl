    ea:value [ ea:name "temperatureInformation"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Measured or derived temperature information."@en ] ;
    ea:value [ ea:name "trafficConcentration"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Measured or derived traffic concentration information."@en ] ;
    ea:value [ ea:name "trafficFlow"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Measured or derived traffic flow information."@en ] ;
    ea:value [ ea:name "trafficGap"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Measured or derived traffic gap information."@en ] ;
    ea:value [ ea:name "trafficHeadway"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Measured or derived traffic headway information."@en ] ;
    ea:value [ ea:name "trafficSpeed"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Measured or derived traffic speed information."@en ] ;
    ea:value [ ea:name "trafficStatusInformation"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Measured or derived traffic status information."@en ] ;
