datex:AfirEnergyInfrastructure.VehicleToGridCommunicationTypeEnum
    a owl:Class ;
    rdfs:label "VehicleToGridCommunicationTypeEnum"@en ;
    skos:definition "A list of communication types for communication between vehicles and the grid."@en ;
    skos:prefLabel "vehicle to grid communication type enum"@en ;
    skos:altLabel "vehicletogridcommunicationtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirEnergyInfrastructure / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "none"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No communication between vehicle and the grid."@en ] ;
    ea:value [ ea:name "iso15118"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Communication according to ISO15118-20."@en ] ;
    ea:value [ ea:name "iec619802"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Communication according to IEC/TS 61980-2."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Communication according to other guidelines/specifications."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of communication is unknown."@en ] .

datex:AfirEnergyInfrastructure.Volt
    a owl:Class ;
    rdfs:label "Volt"@en ;
    skos:definition "Volt."@en ;
    skos:prefLabel "volt"@en ;
    rdfs:subClassOf datex:Common.Float ;
