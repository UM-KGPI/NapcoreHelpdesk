    ea:value [ ea:name "secondInstance"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Second instance of specified day of week in month."@en ] ;
    ea:value [ ea:name "thirdInstance"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Third instance of specified day of week in month."@en ] ;
    ea:value [ ea:name "fourthInstance"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fourth instance of specified day of week in month."@en ] ;
    ea:value [ ea:name "fifthInstance"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fifth instance of specified day of week in month."@en ] ;
    ea:value [ ea:name "lastInstance"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Last instance of specified day of week in month (regardless its actual instance number)."@en ] .

datex:Common.InstanceOfDayWithinMonth
    a owl:Class ;
    rdfs:label "InstanceOfDayWithinMonth"@en ;
