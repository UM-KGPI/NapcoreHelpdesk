datex:TrafficRegulation.AccessConditionTypeEnum
    a owl:Class ;
    rdfs:label "AccessConditionTypeEnum"@en ;
    skos:definition "Access is only permitted under certain conditions."@en ;
    skos:prefLabel "access condition type enum"@en ;
    skos:altLabel "accessconditiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace TrafficRegulation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "accessOnly"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Access only."@en ] ;
    ea:value [ ea:name "destinationTraffic"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Access restricted if the destination of traffic lies in a specific region."@en ] ;
    ea:value [ ea:name "loadingAndUnloading"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Loading or unloading of vehicle."@en ] ;
    ea:value [ ea:name "necessaryHospitalAndDoctorConsultations"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Trips for necessary hospital and doctor consultations."@en ] ;
    ea:value [ ea:name "passengerLoadingAndUnloading"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pick up or set down passengers."@en ] ;
    ea:value [ ea:name "snowChainsCompulsory"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicating a zone where the use of snow chains or equivalent winter equipment is mandatory."@en ] ;
    ea:value [ ea:name "socialAndCareSupportServices"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Trips for social and care support services."@en ] ;
    ea:value [ ea:name "sourceAndDestinationTraffic"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Access is restricted if the source and destination of traffic lies in a specific region."@en ] ;
    ea:value [ ea:name "sourceTraffic"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Access is restricted if the source of traffic lies in a specific region."@en ] ;
    ea:value [ ea:name "throughTraffic"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Access is restricted if the traffic goes through a specific region."@en ] .

datex:TrafficRegulation.AccessRestriction
    a owl:Class ;
