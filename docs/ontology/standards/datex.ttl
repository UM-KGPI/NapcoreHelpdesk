    ea:value [ ea:name "onNonMotorways"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On non motorways."@en ] ;
    ea:value [ ea:name "onPasses"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On mountain passes."@en ] ;
    ea:value [ ea:name "onRoundabouts"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On roundabouts."@en ] ;
    ea:value [ ea:name "onSingleCarriagewaySections"@en ; ea:position 30 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On single carriageway sections of the road."@en ] ;
    ea:value [ ea:name "onSlipRoads"@en ; ea:position 31 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On slip roads."@en ] ;
    ea:value [ ea:name "onUndergroundSections"@en ; ea:position 32 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On underground sections of the road."@en ] ;
    ea:value [ ea:name "onUnderpasses"@en ; ea:position 33 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On underpasses, i.e. sections of the road which pass under another road."@en ] ;
    ea:value [ ea:name "onUpHillSections"@en ; ea:position 34 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On hill sections of the road."@en ] ;
