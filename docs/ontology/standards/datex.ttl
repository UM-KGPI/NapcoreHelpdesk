    ea:attribute [ ea:name "telephoneNumber"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Telephone number, which can be a general number or the number of a specific contact person."@en ] ;
    ea:attribute [ ea:name "faxNumber"@en ; ea:position 3 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Fax number, which can be a general number or the number of a specific contact person."@en ] ;
    ea:attribute [ ea:name "eMail"@en ; ea:position 4 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "E-Mail address, which can be a general mail address or the mail address of a specific contact person."@en ] .

datex:AfirFacilities.ContactPerson
    a owl:Class ;
    rdfs:label "ContactPerson"@en ;
    skos:definition "A specific contact person."@en ;
    skos:prefLabel "contact person"@en ;
    skos:altLabel "contactperson"@en ;
    rdfs:subClassOf datex:AfirFacilities.ContactInformation ;
