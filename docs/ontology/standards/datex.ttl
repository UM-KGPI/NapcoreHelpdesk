datex:LocationReferencing.Referent
    a owl:Class ;
    rdfs:label "Referent"@en ;
    skos:definition "A referent on a linear object that has a known location such as a node, a reference marker (e.g. a marker-post), an intersection etc."@en ;
    skos:prefLabel "referent"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/LinearReferencing/PointAlongLinearElement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "referentIdentifier"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The identifier of the referent, unique on the specified linear element (i.e. road or part of)."@en ] ;
    ea:attribute [ ea:name "referentName"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The name of the referent, e.g. a junction or intersection name."@en ] ;
    ea:attribute [ ea:name "referentType"@en ; ea:position 3 ; ea:type datex:LocationReferencing.ReferentTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of the referent."@en ] ;
    ea:attribute [ ea:name "referentDescription"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of the referent."@en ] .

datex:LocationReferencing.Referent.PointCoordinates
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.Referent ;
    rdfs:range datex:LocationReferencing.PointCoordinates ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:LocationReferencing.ReferentTypeEnum
    a owl:Class ;
    rdfs:label "ReferentTypeEnum"@en ;
    skos:definition "A set of types of known points along a linear object such as a road."@en ;
    skos:prefLabel "referent type enum"@en ;
    skos:altLabel "referenttypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "boundary"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A boundary between two jurisdictional or administrative areas. These may be legal boundaries such as between counties or countries, maintenance responsibility boundaries or control boundaries."@en ] ;
    ea:value [ ea:name "intersection"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A crossing of two or more roads where the precise point of intersection is defined according to specific business rules."@en ] ;
    ea:value [ ea:name "referenceMarker"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A marker which is usually but not necessarily physical that is one of a sequence which are spaced out along the linear object (road) to provide a location reference. The spacing of markers is not necessarily even."@en ] ;
    ea:value [ ea:name "landmark"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A visible identifiable physical landmark either alongside or close to the linear object."@en ] ;
    ea:value [ ea:name "roadNode"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A topological node defined on a road network. Such nodes may delineate the segmentation of the road network according to defined business rules or may constitute a purely topological representation of a road network."@en ] .

datex:LocationReferencing.RelativePositionOnCarriagewayEnum
    a owl:Class ;
    rdfs:label "RelativePositionOnCarriagewayEnum"@en ;
    skos:definition "Identifies a relative position across a carriageway"@en ;
    skos:prefLabel "relative position on carriageway enum"@en ;
    skos:altLabel "relativepositiononcarriagewayenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "inTheCentre"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the centre of the roadway."@en ] ;
    ea:value [ ea:name "onTheLeft"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the left of the roadway."@en ] ;
    ea:value [ ea:name "onTheRight"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the right of the roadway."@en ] .

datex:LocationReferencing.RoadInformation
    a owl:Class ;
    rdfs:label "RoadInformation"@en ;
    skos:definition "Information on a road"@en ;
    skos:prefLabel "road information"@en ;
    skos:altLabel "roadinformation"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/SupplementaryPositionalDescription"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "roadDestination"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A destination associated with this road."@en ] ;
    ea:attribute [ ea:name "roadName"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The name of the road"@en ] ;
    ea:attribute [ ea:name "roadNumber"@en ; ea:position 3 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The road number designated by the road authority"@en ] .

datex:LocationReferencing.SingleRoadLinearLocation
    a owl:Class ;
    rdfs:label "SingleRoadLinearLocation"@en ;
    skos:definition "Location representing a linear section along a single road with optional directionality defined between two points on the same road. No matter the kind of linear reference it uses, the constraint of using only a single road must be preserved."@en ;
    skos:prefLabel "single road linear location"@en ;
    skos:altLabel "singleroadlinearlocation"@en ;
    rdfs:subClassOf datex:LocationReferencing.LinearLocation ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" .

datex:LocationReferencing.SingleRoadLinearLocation.AlertCLinear
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.SingleRoadLinearLocation ;
    rdfs:range datex:LocationReferencing.AlertCLinear ;
