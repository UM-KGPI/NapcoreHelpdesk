datex:Common.AxleSpacing
    a owl:Class ;
    rdfs:label "AxleSpacing"@en ;
    skos:definition "The spacing details between the axle sets of an individual vehicle numbered from the front to the back of the vehicle."@en ;
    skos:prefLabel "axle spacing"@en ;
    skos:altLabel "axlespacing"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/Vehicle"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "axleSpacing"@en ; ea:position 1 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The spacing interval, indicated by the axleSpacingSequenceIdentifier, between the axles of an individual vehicle from front to back of the vehicle."@en ] ;
    ea:attribute [ ea:name "axleSpacingSequenceIdentifier"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the sequence number of the interval between the axles of the individual vehicle from front to back (e.g. 1, 2, 3...). This cannot exceed (numberOfAxles -1) if the numberOfAxles is also given as part of the VehicleCharacteristics."@en ] .

datex:Common.AxleWeight
