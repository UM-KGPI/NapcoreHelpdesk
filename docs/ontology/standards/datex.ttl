    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:Situation.AbnormalTraffic
    a owl:Class ;
    rdfs:label "AbnormalTraffic"@en ;
    skos:definition "A traffic condition which is not normal."@en ;
    skos:prefLabel "abnormal traffic"@en ;
    skos:altLabel "abnormaltraffic"@en ;
    rdfs:subClassOf datex:Situation.TrafficElement ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "abnormalTrafficType"@en ; ea:position 1 ; ea:type datex:Situation.AbnormalTrafficTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A characterization of the nature of abnormal traffic flow, i.e. specifically relating to the nature of the traffic movement, implying a level of service."@en ] ;
    ea:attribute [ ea:name "numberOfVehiclesWaiting"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of vehicles waiting in a queue."@en ] ;
    ea:attribute [ ea:name "queueLength"@en ; ea:position 3 ; ea:type datex:Common.MetresAsNonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The length of a queue or the average length of queues in separate lanes due to a situation."@en ] ;
    ea:attribute [ ea:name "relativeTrafficFlow"@en ; ea:position 4 ; ea:type datex:Situation.RelativeTrafficFlowEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Assessment of the traffic flow conditions relative to normally expected conditions at this date/time."@en ] ;
    ea:attribute [ ea:name "trafficFlowCharacteristics"@en ; ea:position 5 ; ea:type datex:Situation.TrafficFlowCharacteristicsEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The consistency (steadiness) of the traffic flow."@en ] ;
    ea:attribute [ ea:name "trafficTrendType"@en ; ea:position 6 ; ea:type datex:Common.TrafficTrendTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A characterization of the trend in the traffic conditions at the specified location and direction."@en ] .

datex:Situation.AbnormalTrafficTypeEnum
    a owl:Class ;
    rdfs:label "AbnormalTrafficTypeEnum"@en ;
    skos:definition "Descriptive terms for abnormal traffic conditions specifically relating to the nature of the traffic movement, implying levels of service."@en ;
    skos:prefLabel "abnormal traffic type enum"@en ;
    skos:altLabel "abnormaltraffictypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "stationaryTraffic"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic is stationary, or very near stationary, at the specified location (i.e. average speed is less than 10% of its free-flow level)."@en ] ;
    ea:value [ ea:name "queuingTraffic"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic is queuing at the specified location, although there is still some traffic movement (i.e. average speed is between 10% and 25% of its free-flow level)."@en ] ;
    ea:value [ ea:name "slowTraffic"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic is slow moving at the specified location, but not yet forming queues (i.e. average speed is between 25% and 75% of its free-flow level)."@en ] ;
    ea:value [ ea:name "heavyTraffic"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic is heavy at the specified location (i.e. average speed is between 75% and 90% of its free-flow level)."@en ] ;
    ea:value [ ea:name "unspecifiedAbnormalTraffic"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There are abnormal traffic conditions of an unspecified nature at the specified location."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.Accident
    a owl:Class ;
    rdfs:label "Accident"@en ;
    skos:definition "Accidents are events where one or more vehicles are involved in collisions or in leaving the roadway. These include collisions between vehicles or with other road users or obstacles."@en ;
    skos:prefLabel "accident"@en ;
    rdfs:subClassOf datex:Situation.TrafficElement ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement/Accident"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "accidentCause"@en ; ea:position 1 ; ea:type datex:Situation.AccidentCauseEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A descriptor indicating the most significant factor causing an accident."@en ] ;
    ea:attribute [ ea:name "accidentType"@en ; ea:position 2 ; ea:type datex:Situation.AccidentTypeEnum ; ea:lowerBound "1" ; ea:upperBound "*" ; ea:definition "A characterization of the nature of the accident."@en ] ;
    ea:attribute [ ea:name "collisionType"@en ; ea:position 3 ; ea:type datex:Situation.CollisionTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identifies a type of collision"@en ] ;
    ea:attribute [ ea:name "totalNumberOfPeopleInvolved"@en ; ea:position 4 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The total number of people that are involved."@en ] ;
    ea:attribute [ ea:name "totalNumberOfVehiclesInvolved"@en ; ea:position 5 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The total number of vehicles that are involved."@en ] .

datex:Situation.Accident.GroupOfPeopleInvolved
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.Accident ;
    rdfs:range datex:Situation.GroupOfPeopleInvolved ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Situation.Accident.GroupOfVehiclesInvolved
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.Accident ;
    rdfs:range datex:Common.GroupOfVehiclesInvolved ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Situation.Accident.vehicleInvolved
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.Accident ;
    rdfs:range datex:Common.Vehicle ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Situation.AccidentCauseEnum
    a owl:Class ;
    rdfs:label "AccidentCauseEnum"@en ;
    skos:definition "Collection of the type of accident causes."@en ;
    skos:prefLabel "accident cause enum"@en ;
    skos:altLabel "accidentcauseenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "avoidanceOfObstacles"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Avoidance of obstacles on the roadway."@en ] ;
    ea:value [ ea:name "driverDistraction"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Driver distraction."@en ] ;
    ea:value [ ea:name "driverDrugAbuse"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Driver under the influence of drugs."@en ] ;
    ea:value [ ea:name "driverIllness"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Driver illness."@en ] ;
    ea:value [ ea:name "exceedingSpeedsLimits"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Loss of vehicle control due to excessive vehicle speed."@en ] ;
    ea:value [ ea:name "excessAlcohol"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Driver abilities reduced due to driving under the influence of alcohol. Alcohol levels above nationally accepted limit."@en ] ;
    ea:value [ ea:name "excessiveDriverTiredness"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Excessive tiredness of the driver."@en ] ;
    ea:value [ ea:name "impermissibleManoeuvre"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A driving manoeuvre which was not permitted."@en ] ;
    ea:value [ ea:name "limitedVisibility"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Limited or impaired visibility."@en ] ;
    ea:value [ ea:name "notKeepingASafeDistance"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Not keeping a safe distance from the vehicle in front."@en ] ;
    ea:value [ ea:name "onTheWrongSideOfTheRoad"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Driving on the wrong side of the road."@en ] ;
    ea:value [ ea:name "pedestrianInRoad"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pedestrian in the roadway."@en ] ;
    ea:value [ ea:name "poorLaneAdherence"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Not keeping to lane."@en ] ;
    ea:value [ ea:name "poorMergeEntryOrExitJudgement"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Poor judgement when merging at an entry or exit point of a carriageway or junction."@en ] ;
    ea:value [ ea:name "poorRoadSurfaceCondition"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Poor road surface condition."@en ] ;
    ea:value [ ea:name "poorSurfaceAdherence"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Poor road surface adherence."@en ] ;
    ea:value [ ea:name "undisclosed"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Undisclosed cause."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unknown cause."@en ] ;
    ea:value [ ea:name "vehicleFailure"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Malfunction or failure of vehicle function."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.AccidentTypeEnum
    a owl:Class ;
    rdfs:label "AccidentTypeEnum"@en ;
    skos:definition "Collection of descriptive terms for types of accidents."@en ;
    skos:prefLabel "accident type enum"@en ;
    skos:altLabel "accidenttypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "accident"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Accidents are situations in which one or more vehicles lose control and do not recover. They include collisions between vehicle(s) or other road user(s), between vehicle(s) and fixed obstacle(s), or they result from a vehicle running off the road."@en ] ;
    ea:value [ ea:name "accidentInvolvingHazardousMaterials"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes all accidents involving at least one vehicle believed to be carrying materials, which could present an additional hazard to road users."@en ] ;
    ea:value [ ea:name "accidentInvolvingHeavyLorries"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes all accidents involving at least one heavy goods vehicle."@en ] ;
    ea:value [ ea:name "accidentInvolvingMassTransitVehicle"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes all accidents involving at least one mass transit vehicle."@en ] ;
    ea:value [ ea:name "accidentInvolvingPublicTransport"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes all accidents involving public transport"@en ] ;
    ea:value [ ea:name "accidentInvolvingRadioactiveMaterial"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Accident involving radioactive material."@en ] ;
    ea:value [ ea:name "accidentInvolvingTrain"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes all accidents involving collision with a train."@en ] ;
    ea:value [ ea:name "collision"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Collision of vehicle with another object of unspecified type."@en ] ;
    ea:value [ ea:name "multipleVehicleAccident"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes all accidents involving three or more vehicles."@en ] ;
    ea:value [ ea:name "secondaryAccident"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes all situations resulting from vehicles avoiding or being distracted by earlier accidents."@en ] ;
    ea:value [ ea:name "seriousInjuryOrFatalAccident"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes all accidents believed to involve fatality or injury expected to require overnight hospitalisation."@en ] ;
    ea:value [ ea:name "vehicleStuckUnderBridge"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vehicle is stuck under a bridge."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.Activity
    a owl:Class ;
    rdfs:label "Activity"@en ;
    skos:definition "Deliberate human action external to the traffic stream or roadway which could disrupt traffic."@en ;
    skos:prefLabel "activity"@en ;
    rdfs:subClassOf datex:Situation.TrafficElement ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement/Activity"@en ;
    ea:kind "class" .

datex:Situation.Activity.mobilityOfActivity
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.Activity ;
    rdfs:range datex:Situation.Mobility ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Situation.AnimalPresenceObstruction
    a owl:Class ;
    rdfs:label "AnimalPresenceObstruction"@en ;
    skos:definition "An obstruction on the road resulting from the presence of animals."@en ;
    skos:prefLabel "animal presence obstruction"@en ;
    skos:altLabel "animalpresenceobstruction"@en ;
    rdfs:subClassOf datex:Situation.Obstruction ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement/Obstruction"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "alive"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates whether the identified animals are dead (immobile) or alive (potentially mobile)."@en ] ;
    ea:attribute [ ea:name "animalPresenceType"@en ; ea:position 2 ; ea:type datex:Situation.AnimalPresenceTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the nature of animals present on or near the roadway."@en ] .

datex:Situation.AnimalPresenceTypeEnum
    a owl:Class ;
    rdfs:label "AnimalPresenceTypeEnum"@en ;
    skos:definition "Types of animal presence."@en ;
    skos:prefLabel "animal presence type enum"@en ;
    skos:altLabel "animalpresencetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "animalsOnTheRoad"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic may be disrupted due to animals on the roadway."@en ] ;
    ea:value [ ea:name "herdOfAnimalsOnTheRoad"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic may be disrupted due to a herd of animals on the roadway."@en ] ;
    ea:value [ ea:name "largeAnimalsOnTheRoad"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic may be disrupted due to large animals on the roadway."@en ] ;
    ea:value [ ea:name "smallAnimalsOnTheRoad"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Small animals (that may fit underneath vehicle frames) are on the road"@en ] ;
    ea:value [ ea:name "wildAnimalsOnTheRoad"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Wild animals (not controlled by humans) are on the road"@en ] .

datex:Situation.AuthorityOperation
    a owl:Class ;
    rdfs:label "AuthorityOperation"@en ;
    skos:definition "Authority initiated operation or activity that could disrupt traffic."@en ;
    skos:prefLabel "authority operation"@en ;
    skos:altLabel "authorityoperation"@en ;
    rdfs:subClassOf datex:Situation.Activity ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement/Activity"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "authorityOperationType"@en ; ea:position 1 ; ea:type datex:Situation.AuthorityOperationTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Type of authority initiated operation or activity that could disrupt traffic."@en ] .

datex:Situation.AuthorityOperationTypeEnum
    a owl:Class ;
    rdfs:label "AuthorityOperationTypeEnum"@en ;
    skos:definition "Types of authority operations."@en ;
    skos:prefLabel "authority operation type enum"@en ;
    skos:altLabel "authorityoperationtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "accidentInvestigationWork"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An operation involving authorised investigation work connected to an earlier reported accident."@en ] ;
    ea:value [ ea:name "bombSquadInAction"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An operation where a bomb squad is in action to deal with suspected or actual explosive or incendiary devices which may cause disruption to traffic."@en ] ;
    ea:value [ ea:name "civilEmergency"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation, perceived or actual, relating to a civil emergency which could disrupt traffic. This includes large scale destruction, through events such as earthquakes, insurrection, and civil disobedience."@en ] ;
    ea:value [ ea:name "customsOperation"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A permanent or temporary operation established by customs and excise authorities on or adjacent to the carriageway."@en ] ;
    ea:value [ ea:name "juridicalReconstruction"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An operation involving the juridical reconstruction of events for the purposes of judicial or legal proceedings."@en ] ;
    ea:value [ ea:name "policeCheckPoint"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A permanent or temporary operation established on or adjacent to the carriageway for use by police or other authorities."@en ] ;
    ea:value [ ea:name "policeInvestigation"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A temporary operation established on or adjacent to the carriageway by the police associated with an ongoing investigation."@en ] ;
    ea:value [ ea:name "roadOperatorCheckPoint"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A permanent or temporary operation established on or adjacent to the carriageway for use by the road operator, such as for survey or inspection purposes, but not for traffic management purposes."@en ] ;
    ea:value [ ea:name "snowChainOnBoardOrSnowTyresMountedCheck"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "the police are checking if snow chains are on board vehicles or vehicles have snow tyres mounted"@en ] ;
    ea:value [ ea:name "snowChainOrSnowTyresMountedCheck"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "the police are checking if snow chains or snow tyres are mounted on vehicles"@en ] ;
    ea:value [ ea:name "survey"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A permanent or temporary operation established by authorities on or adjacent to the carriageway for the purpose of gathering statistics or other traffic related information."@en ] ;
    ea:value [ ea:name "undefinedAuthorityActivity"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An authority activity of undefined type."@en ] ;
    ea:value [ ea:name "transportOfVip"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An operation to transport one or more VIPs."@en ] ;
    ea:value [ ea:name "vehicleInspectionCheckPoint"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A permanent or temporary operation established on or adjacent to the carriageway for inspection of vehicles by authorities (e.g. vehicle safety checks and tachograph checks)."@en ] ;
    ea:value [ ea:name "vehicleWeighing"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A permanent or temporary operation established on or adjacent to the carriageway for weighing of vehicles by authorities."@en ] ;
    ea:value [ ea:name "weighInMotion"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A permanent or temporary facility established by authorities on the carriageway for weighing vehicles while in motion."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.Cause
    a owl:Class ;
    rdfs:label "Cause"@en ;
    skos:definition "Contains details of the cause of a record within a situation"@en ;
    skos:prefLabel "cause"@en ;
    rdfs:comment "DATEX II class in namespace Situation / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "causeDescription"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of a cause which is not managed by the publication creator (e.g. an off network cause)."@en ] ;
    ea:attribute [ ea:name "causeType"@en ; ea:position 2 ; ea:type datex:Situation.CauseTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates an external influence that may be the causation of components of a situation."@en ] .

datex:Situation.Cause.detailedCauseType
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.Cause ;
    rdfs:range datex:Situation.DetailedCauseType ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Situation.Cause.managedCause
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.Cause ;
    rdfs:range datex:Situation.SituationRecordReference ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Situation.CauseTypeEnum
    a owl:Class ;
    rdfs:label "CauseTypeEnum"@en ;
    skos:definition "Types of causes of situations which are not managed or are off network."@en ;
    skos:prefLabel "cause type enum"@en ;
    skos:altLabel "causetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "abnormalTraffic"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A traffic condition that is not normal."@en ] ;
    ea:value [ ea:name "accident"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Accident."@en ] ;
    ea:value [ ea:name "animalPresence"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An obstruction on the road resulting from the presence of animals"@en ] ;
    ea:value [ ea:name "authorityOperation"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Authority initiated operation or activity"@en ] ;
    ea:value [ ea:name "constructionWork"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Roadworks involving the construction of new infrastructure."@en ] ;
    ea:value [ ea:name "disturbance"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Deliberate human action of either a public disorder nature or of a situation alert type which could disrupt traffic."@en ] ;
    ea:value [ ea:name "drivingConditions"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Degraded driving conditions."@en ] ;
    ea:value [ ea:name "environmentalObstruction"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An obstruction on the road resulting from an environmental cause"@en ] ;
    ea:value [ ea:name "equipmentOrSystemFault"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Equipment or system which is faulty, malfunctioning or not in a fully operational state"@en ] ;
    ea:value [ ea:name "infrastructureDamageObstruction"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An obstruction on the road resulting from the failure or damage of infrastructure on, under, above or close to the road"@en ] ;
    ea:value [ ea:name "instructionToRoadUsers"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Instruction and/or message issued by the network/road operator"@en ] ;
    ea:value [ ea:name "networkManagement"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Network management action which is applicable to the road network and its users."@en ] ;
    ea:value [ ea:name "nonWeatherRelatedRoadConditions"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Road surface conditions that are not related to the weather"@en ] ;
    ea:value [ ea:name "obstruction"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Obstruction on the roadway."@en ] ;
    ea:value [ ea:name "poorEnvironment"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Poor environmental conditions"@en ] ;
    ea:value [ ea:name "publicEvent"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Organised public event"@en ] ;
    ea:value [ ea:name "rerouting"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouting management action issued by the network/road operator"@en ] ;
    ea:value [ ea:name "roadMaintenance"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Roadworks involving the maintenance or installation of infrastructure"@en ] ;
    ea:value [ ea:name "roadOperatorServiceDisruption"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Disruption to normal road operator services"@en ] ;
    ea:value [ ea:name "roadOrCarriagewayOrLaneManagement"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Road, carriageway or lane management action instigated by the network/road operator"@en ] ;
    ea:value [ ea:name "roadsideAssistance"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Road side assistance"@en ] ;
    ea:value [ ea:name "roadsideServiceDisruption"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Disruption to normal roadside services"@en ] ;
    ea:value [ ea:name "speedManagement"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Speed management action instigated by the network/road operator"@en ] ;
    ea:value [ ea:name "transitServiceDisruption"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Disruption to transit services of direct relevance to road users, e.g. connecting rail or ferry services"@en ] ;
    ea:value [ ea:name "vehicleObstruction"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An obstruction on the road caused by one or more vehicles."@en ] ;
    ea:value [ ea:name "weatherRelatedRoadConditions"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Road surface conditions related to the weather"@en ] ;
    ea:value [ ea:name "winterEquipmentManagement"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Winter driving management action instigated by the network/road operator"@en ] ;
    ea:value [ ea:name "earlierEvent"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An earlier event."@en ] ;
    ea:value [ ea:name "earlierIncident"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An earlier incident."@en ] ;
    ea:value [ ea:name "holidayTraffic"@en ; ea:position 30 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Holiday traffic."@en ] ;
    ea:value [ ea:name "problemsAtBorderPost"@en ; ea:position 31 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Problems at the border crossing."@en ] ;
    ea:value [ ea:name "problemsAtCustomPost"@en ; ea:position 32 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Problems at the customs post on the border."@en ] ;
    ea:value [ ea:name "problemsOnLocalRoads"@en ; ea:position 33 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Problems (of an unspecified nature) on the local roads."@en ] ;
    ea:value [ ea:name "roadsideEvent"@en ; ea:position 34 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A roadside event (of unspecified nature) whether planned or not."@en ] ;
    ea:value [ ea:name "rubberNecking"@en ; ea:position 35 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Drivers being distracted and turning to look at an accident or other roadside event."@en ] ;
    ea:value [ ea:name "technicalProblems"@en ; ea:position 36 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Technical problems."@en ] ;
    ea:value [ ea:name "vandalism"@en ; ea:position 37 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vandalism incident."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 38 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.CollisionTypeEnum
    a owl:Class ;
    rdfs:label "CollisionTypeEnum"@en ;
    skos:definition "Identifies a type of collision"@en ;
    skos:prefLabel "collision type enum"@en ;
    skos:altLabel "collisiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "collisionWithAnimal"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Collision of vehicle with one or more animals."@en ] ;
    ea:value [ ea:name "collisionWithObstacle"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Collision of vehicle with an object of a stationary nature."@en ] ;
    ea:value [ ea:name "collisionWithPerson"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Collision of vehicle with one or more pedestrians."@en ] ;
    ea:value [ ea:name "headOnCollision"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Collision of vehicle with another vehicle head on."@en ] ;
    ea:value [ ea:name "headOnOrSideCollision"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Collision of vehicle with another vehicle either head on or sideways."@en ] ;
    ea:value [ ea:name "multipleVehicleCollision"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Collision involving multiple vehicles"@en ] ;
    ea:value [ ea:name "rearCollision"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes all accidents where one or more vehicles have collided with the rear of one or more other vehicles."@en ] ;
    ea:value [ ea:name "sideCollision"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes all accidents where one or more vehicles have collided with the side of one or more other vehicles."@en ] .

datex:Situation.Comment
    a owl:Class ;
    rdfs:label "Comment"@en ;
    skos:definition "A free text comment with an optional date/time stamp that can be used by the operator to convey additional observations/information that are not possible to code otherwise."@en ;
    skos:prefLabel "comment"@en ;
    rdfs:comment "DATEX II class in namespace Situation / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "comment"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A free text comment that can be used by the operator to convey un-coded observations/information."@en ] ;
    ea:attribute [ ea:name "commentDateTime"@en ; ea:position 2 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The date/time at which the comment was made."@en ] ;
    ea:attribute [ ea:name "commentType"@en ; ea:position 3 ; ea:type datex:Situation.CommentTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A classification of the the type of comment."@en ] .

datex:Situation.CommentTypeEnum
    a owl:Class ;
    rdfs:label "CommentTypeEnum"@en ;
    skos:definition "Classification of comment types."@en ;
    skos:prefLabel "comment type enum"@en ;
    skos:altLabel "commenttypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "abnormalLoadMovementNote"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A free text human oriented note describing details of abnormal load movements associated with the SituationRecord."@en ] ;
    ea:value [ ea:name "dataProcessingNote"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A free text human oriented note describing the way the information in the SituationRecord has been or should be processed."@en ] ;
    ea:value [ ea:name "description"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A free text human oriented description of the situation element defined by the SituationRecord."@en ] ;
    ea:value [ ea:name "internalNote"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A free text human oriented note that supports internal traffic control operations relating to the situation element defined by the SituationRecord."@en ] ;
    ea:value [ ea:name "roadworksName"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Human-readable name by which the associated roadworks is known"@en ] ;
    ea:value [ ea:name "warning"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A free text human oriented warning relating to the SituationRecord, such as advising the recipient that an advanced warning on VMS should be activated."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.ComplianceOptionEnum
    a owl:Class ;
