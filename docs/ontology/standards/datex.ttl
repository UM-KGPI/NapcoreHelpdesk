datex:Common.Seconds
    a owl:Class ;
    rdfs:label "Seconds"@en ;
    skos:definition "Seconds."@en ;
    skos:prefLabel "seconds"@en ;
    rdfs:subClassOf datex:Common.Float ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Specific"@en ;
    ea:kind "data type" .

datex:Common.Source
    a owl:Class ;
    rdfs:label "Source"@en ;
    skos:definition "Details of the source from which the information was obtained."@en ;
    skos:prefLabel "source"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "sourceCountry"@en ; ea:position 1 ; ea:type datex:Common.CountryCode ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "EN ISO 3166-1 two-character country code of the source of the information."@en ] ;
    ea:attribute [ ea:name "sourceIdentification"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Language independent textual code or identifier for the organisation or the equipment that has produced the information."@en ] ;
    ea:attribute [ ea:name "sourceName"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The name of the organisation which has produced the information relating to this version of the information."@en ] ;
    ea:attribute [ ea:name "sourceType"@en ; ea:position 4 ; ea:type datex:Common.SourceTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Information about the technology used for measuring the data or the method used for obtaining qualitative descriptions relating to this version of the information."@en ] ;
    ea:attribute [ ea:name "reliable"@en ; ea:position 5 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An indication as to whether the source deems the associated information to be reliable/correct. \"True\" indicates it is deemed reliable."@en ] .

datex:Common.SourceTypeEnum
    a owl:Class ;
    rdfs:label "SourceTypeEnum"@en ;
    skos:definition "Type of sources from which situation information may be derived."@en ;
    skos:prefLabel "source type enum"@en ;
    skos:altLabel "sourcetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "automobileClubPatrol"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A patrol of an automobile club."@en ] ;
    ea:value [ ea:name "cameraObservation"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A camera observation (either still or video camera)."@en ] ;
    ea:value [ ea:name "freightVehicleOperator"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An operator of freight vehicles."@en ] ;
    ea:value [ ea:name "inductionLoopMonitoringStation"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A station dedicated to the monitoring of the road network by processing inductive loop information."@en ] ;
    ea:value [ ea:name "infraredMonitoringStation"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A station dedicated to the monitoring of the road network by processing infrared image information."@en ] ;
    ea:value [ ea:name "microwaveMonitoringStation"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A station dedicated to the monitoring of the road network by processing microwave information."@en ] ;
    ea:value [ ea:name "mobileTelephoneCaller"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A caller using a mobile telephone (who may be or not on the road network)."@en ] ;
    ea:value [ ea:name "nonPoliceEmergencyServicePatrol"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Emergency service patrols other than police."@en ] ;
    ea:value [ ea:name "otherInformation"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other sources of information."@en ] ;
    ea:value [ ea:name "otherOfficialVehicle"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Personnel from a vehicle belonging to the road operator or authority or any emergency service, including authorised breakdown service organisations."@en ] ;
    ea:value [ ea:name "policePatrol"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A police patrol."@en ] ;
    ea:value [ ea:name "privateBreakdownService"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A private breakdown service."@en ] ;
    ea:value [ ea:name "publicAndPrivateUtilities"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A utility organisation, either public or private."@en ] ;
    ea:value [ ea:name "registeredMotoristObserver"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A motorist who is an officially registered observer."@en ] ;
    ea:value [ ea:name "roadAuthorities"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A road authority."@en ] ;
    ea:value [ ea:name "roadOperatorPatrol"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A patrol of the road operator or authority."@en ] ;
    ea:value [ ea:name "roadsideTelephoneCaller"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A caller who is using an emergency roadside telephone."@en ] ;
    ea:value [ ea:name "spotterAircraft"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A spotter aircraft of an organisation specifically assigned to the monitoring of the traffic network."@en ] ;
    ea:value [ ea:name "trafficMonitoringStation"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A station, usually automatic, dedicated to the monitoring of the road network."@en ] ;
    ea:value [ ea:name "transitOperator"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An operator of a transit service, e.g. bus link operator."@en ] ;
    ea:value [ ea:name "vehicleProbeMeasurement"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A specially equipped vehicle used to provide measurements."@en ] ;
    ea:value [ ea:name "videoProcessingMonitoringStation"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A station dedicated to the monitoring of the road network by processing video image information."@en ] .

datex:Common.SpecialDay
    a owl:Class ;
    rdfs:label "SpecialDay"@en ;
    skos:definition "Specification of a special type of day, possibly also a public holiday. Can be country or region specific."@en ;
    skos:prefLabel "special day"@en ;
    skos:altLabel "specialday"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/Validity"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "intersectWithApplicableDays"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "When true, the period is the intersection of applicable days and this special day. When false, the period is the union of applicable days and this special day."@en ] ;
    ea:attribute [ ea:name "specialDayType"@en ; ea:position 2 ; ea:type datex:Common.SpecialDayTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specification of a special day, for example schoolDay, publicHoliday, ..."@en ] ;
    ea:attribute [ ea:name "publicEvent"@en ; ea:position 3 ; ea:type datex:Common.PublicEventTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of public event on this special day."@en ] .

datex:Common.SpecialDay.NamedArea
    a owl:ObjectProperty ;
    rdfs:domain datex:Common.SpecialDay ;
    rdfs:range datex:Common.NamedArea ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Common.SpecialDayTypeEnum
    a owl:Class ;
    rdfs:label "SpecialDayTypeEnum"@en ;
    skos:definition "Collection of special types of days."@en ;
    skos:prefLabel "special day type enum"@en ;
    skos:altLabel "specialdaytypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "dayBeforePublicHoliday"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The day preceding a public holiday."@en ] ;
    ea:value [ ea:name "publicHoliday"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A public holiday in general. You may use the PublicHoliday class to refer on a specific public holiday."@en ] ;
    ea:value [ ea:name "dayFollowingPublicHoliday"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A day following a public holiday."@en ] ;
    ea:value [ ea:name "longWeekendDay"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A day between a public holiday and the weekend."@en ] ;
    ea:value [ ea:name "inLieuOfPublicHoliday"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A holiday in lieu of a public holiday that falls on a weekend."@en ] ;
    ea:value [ ea:name "schoolDay"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A school day."@en ] ;
    ea:value [ ea:name "schoolHolidays"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A day within the school holidays."@en ] ;
    ea:value [ ea:name "publicEventDay"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A day of a public event. You may use the publicEvent attribute to specify the corresponding event."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some other special day."@en ] .

datex:Common.SpeedValue
    a owl:Class ;
    rdfs:label "SpeedValue"@en ;
    skos:definition "A measured or calculated value of speed."@en ;
    skos:prefLabel "speed value"@en ;
    skos:altLabel "speedvalue"@en ;
    rdfs:subClassOf datex:Common.DataValue ;
    rdfs:comment "DATEX II class in namespace Common / Classes/DataValue"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "speed"@en ; ea:position 1 ; ea:type datex:Common.KilometresPerHour ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A value of speed expressed in kilometres per hour."@en ] .

datex:Common.String
    a owl:Class ;
    rdfs:label "String"@en ;
    skos:definition "A character string whose value space is the set of finite-length sequences of characters. Every character has a corresponding Universal Character Set code point (as defined in ISO/IEC 10646), which is an integer."@en ;
    skos:prefLabel "string"@en ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Generic"@en ;
    ea:kind "data type" .

