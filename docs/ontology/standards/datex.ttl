datex:Parking.ParkingConditionsEnum
    a owl:Class ;
    rdfs:label "ParkingConditionsEnum"@en ;
    skos:definition "Defines if normal parking conditions are suspended or special parking conditions are in force."@en ;
    skos:prefLabel "parking conditions enum"@en ;
    skos:altLabel "parkingconditionsenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "normalParkingConditionsSuspended"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking conditions (possibly including tariffs) that normally apply are temporarily suspended."@en ] ;
    ea:value [ ea:name "specialParkingConditionsInForce"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking conditions, other than those that normally apply, are currently in force for the parking site."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

datex:Parking.ParkingFaultEnum
    a owl:Class ;
    rdfs:label "ParkingFaultEnum"@en ;
    skos:definition "Types of parking site or access faults."@en ;
    skos:prefLabel "parking fault enum"@en ;
    skos:altLabel "parkingfaultenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "communicationsFailure"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Communications failure affecting parking site."@en ] ;
    ea:value [ ea:name "barrierMalfunction"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The entrance or exit barrier(s) are malfunctioning causing access problems to vehicles."@en ] ;
    ea:value [ ea:name "entranceExitObstructed"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "One or more entrances or exits are obstructed to some degree causing access problems to vehicles."@en ] ;
    ea:value [ ea:name "erroneousOccupancyInformation"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Occupancy information is subject to errors due to malfunctioning equipment."@en ] ;
    ea:value [ ea:name "erroneousOccupancyDisplayed"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Occupancy information displayed on signs associated with parking site (e.g. at entrance) are erroneous."@en ] ;
    ea:value [ ea:name "paymentMachinesInoperative"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Payment machines are not functioning normally."@en ] ;
    ea:value [ ea:name "reservationServiceOutOfOrder"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Reservation service out of order."@en ] ;
    ea:value [ ea:name "noParkingInformationAvailable"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No parking information available."@en ] ;
    ea:value [ ea:name "unspecified"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "General fault of unspecified type."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unknown parking facility fault."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Parking.ParkingModeEnum
    a owl:Class ;
    rdfs:label "ParkingModeEnum"@en ;
    skos:definition "The arrangement of the parking space or the group of parking spaces in relation to the road."@en ;
    skos:prefLabel "parking mode enum"@en ;
    skos:altLabel "parkingmodeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "perpendicularParking"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking spaces are located in an angle of nearly 90 degrees to the road."@en ] ;
    ea:value [ ea:name "parallelParking"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking spaces are located parallel to the road."@en ] ;
    ea:value [ ea:name "echelonParking"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking spaces are located in a diagonal relation to the road."@en ] ;
    ea:value [ ea:name "parkingOnOppositeSideOfRoad"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking is possible on the other side of the road."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

datex:Parking.ParkingOccupancyEnum
    a owl:Class ;
    rdfs:label "ParkingOccupancyEnum"@en ;
    skos:definition "Parking Occupancy enum."@en ;
    skos:prefLabel "parking occupancy enum"@en ;
    skos:altLabel "parkingoccupancyenum"@en ;
