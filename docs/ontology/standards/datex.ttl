datex:AfirFacilities.Dimension
    a owl:Class ;
    rdfs:label "Dimension"@en ;
    skos:definition "A component that provides dimension information. Especially for multi-storey buildings,the usable area might be larger than the product from its length and width."@en ;
    skos:prefLabel "dimension"@en ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / Dimension"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "length"@en ; ea:position 1 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Length."@en ] ;
    ea:attribute [ ea:name "width"@en ; ea:position 2 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Width."@en ] ;
    ea:attribute [ ea:name "height"@en ; ea:position 3 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Height."@en ] ;
    ea:attribute [ ea:name "usableArea"@en ; ea:position 4 ; ea:type datex:AfirFacilities.SquareMetres ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The area measured in square metres, that is available for some specific purpose."@en ] .

datex:AfirFacilities.Duration
    a owl:Class ;
    rdfs:label "Duration"@en ;
    skos:definition "A duration of time,which may consist of years,months,days,hours,minutes,and seconds components,as defined in ISO 8601."@en ;
    skos:prefLabel "duration"@en ;
    rdfs:comment "DATEX II data type in namespace AfirFacilities / DataTypes"@en ;
    ea:kind "data type" .

datex:AfirFacilities.DurationValue
    a owl:Class ;
    rdfs:label "DurationValue"@en ;
    skos:definition "A measured or calculated value of a period of time."@en ;
    skos:prefLabel "duration value"@en ;
    skos:altLabel "durationvalue"@en ;
    rdfs:subClassOf datex:Common.DataValue ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / DataValues"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "duration"@en ; ea:position 1 ; ea:type datex:Common.Seconds ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A period of time expressed in seconds."@en ] .

datex:AfirFacilities.Eligibility
    a owl:Class ;
    rdfs:label "Eligibility"@en ;
    skos:definition "Defines the combination of Eligibility requirements with RateTables and associates this combination to a RightSpecification."@en ;
    skos:prefLabel "eligibility"@en ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / RatesPublication/Eligibility"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "name"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text name for the eligibility name to assist data users to readily find the eligibility characteristics for a specific eligibility data set."@en ] ;
    ea:attribute [ ea:name "noFeeToUse"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "If TRUE indicates that the related RightSpecification may be used without charge or cost. If FALSE or not specified, costs and charges apply."@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text description for the eligibility definition."@en ] ;
    ea:attribute [ ea:name "priority"@en ; ea:position 4 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An integer value, starting at 1, indicating the order in which multiple relevant RateTables shall be considered, with 1 being the highest priority."@en ] ;
    ea:attribute [ ea:name "combinable"@en ; ea:position 5 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Boolean attribute that indicates (TRUE) if all RateTables associated to a RightSpecification with a common Eligibility can be combined to establish a lowest cost tariff or (FALSE) they cannot be combined."@en ] .

