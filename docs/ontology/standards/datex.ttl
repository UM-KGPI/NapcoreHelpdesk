datex:TrafficRegulation.AmbientWarning
    a owl:Class ;
    rdfs:label "AmbientWarning"@en ;
    skos:definition "Warning about ambient factors i.e. conditions more likely to occur due to the location or surroundings of the road."@en ;
    skos:prefLabel "ambient warning"@en ;
    skos:altLabel "ambientwarning"@en ;
    rdfs:subClassOf datex:TrafficRegulation.Warning ;
    rdfs:comment "DATEX II class in namespace TrafficRegulation / Classes/Warning"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "ambientWarningType"@en ; ea:position 1 ; ea:type datex:TrafficRegulation.AmbientWarningTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Type of the ambient warning."@en ] .

datex:TrafficRegulation.AmbientWarningTypeEnum
    a owl:Class ;
    rdfs:label "AmbientWarningTypeEnum"@en ;
    skos:definition "Types of environmental dangers."@en ;
    skos:prefLabel "ambient warning type enum"@en ;
    skos:altLabel "ambientwarningtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace TrafficRegulation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "accompaniedHorsesCrossing"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Accompanied horses or ponies likely to be in or crossing the road."@en ] ;
    ea:value [ ea:name "airfield"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Low-flying aircraft or sudden aircraft noise."@en ] ;
    ea:value [ ea:name "cattle"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Cattle or other animals crossing."@en ] ;
    ea:value [ ea:name "fallingRocks"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Risk of falling or fallen rocks."@en ] ;
    ea:value [ ea:name "insufficientStructureGauge"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Insufficient structure gauge."@en ] ;
    ea:value [ ea:name "looseGravel"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Loose gravel."@en ] ;
    ea:value [ ea:name "migratoryToadCrossing"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Migratory toad crossing."@en ] ;
    ea:value [ ea:name "otherDanger"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other danger."@en ] ;
    ea:value [ ea:name "pedestrianCrossing"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A marked part of a road where pedestrians have right of way to cross."@en ] ;
    ea:value [ ea:name "poorVisibility"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Poor visibility through snow, rain and fog."@en ] ;
    ea:value [ ea:name "quaysideOrRiverBank"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Road leads on to quay or river."@en ] ;
    ea:value [ ea:name "riskOfIce"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Risk of ice."@en ] ;
    ea:value [ ea:name "sideWindsLeft"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Side winds from left."@en ] ;
    ea:value [ ea:name "sideWindsRight"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Side winds from right."@en ] ;
    ea:value [ ea:name "wildAnimalsCrossing"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Warning of the possibility of wild animals crossing the road."@en ] .

datex:TrafficRegulation.AmountOfMoney
    a owl:Class ;
    rdfs:label "AmountOfMoney"@en ;
    skos:definition "A monetary value expressed to two decimal places."@en ;
    skos:prefLabel "amount of money"@en ;
    skos:altLabel "amountofmoney"@en ;
    rdfs:subClassOf datex:Common.Decimal ;
    rdfs:comment "DATEX II data type in namespace TrafficRegulation / DataTypes"@en ;
    ea:kind "data type" .

datex:TrafficRegulation.CompulsoryMinSpeed
    a owl:Class ;
    rdfs:label "CompulsoryMinSpeed"@en ;
    skos:definition "Specifies the compulsory minimum speed, aligned with the concept of compulsory minimum speed of the Vienna Convention on Road Signs, 1968."@en ;
    skos:prefLabel "compulsory min speed"@en ;
    skos:altLabel "compulsoryminspeed"@en ;
    rdfs:subClassOf datex:TrafficRegulation.NumercialSpeedValue ;
    rdfs:comment "DATEX II class in namespace TrafficRegulation / Classes/TypeOfRegulation"@en ;
    ea:kind "class" .

datex:TrafficRegulation.Condition
    a owl:Class ;
    rdfs:label "Condition"@en ;
    skos:definition "Specifies a condition for applicabilities or exemptions of a traffic regulation."@en ;
    skos:prefLabel "condition"@en ;
    rdfs:comment "DATEX II class in namespace TrafficRegulation / Classes/Condition"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "active"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "If the condition is dynamic, this attribute shall be set to \"true\" if the condition is currently active and to \"false\" if the condition is currently inactive."@en ] ;
    ea:attribute [ ea:name "negate"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "If set to true means that the effect is the logical inverse of the specified condition."@en ] .

datex:TrafficRegulation.Condition.LegalBasis
    a owl:ObjectProperty ;
    rdfs:domain datex:TrafficRegulation.Condition ;
    rdfs:range datex:TrafficRegulation.LegalBasis ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:TrafficRegulation.ConditionOperator
    a owl:Class ;
    rdfs:label "ConditionOperator"@en ;
    skos:definition "The logical operator to be used in a test of conditions."@en ;
    skos:prefLabel "condition operator"@en ;
    skos:altLabel "conditionoperator"@en ;
    rdfs:comment "DATEX II enumeration in namespace TrafficRegulation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "and"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The AND logical operator – a logical operation to determine if all conditions in a test are TRUE."@en ] ;
    ea:value [ ea:name "or"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The OR logical operator – a logical operation to determine if any conditions in a test are TRUE."@en ] ;
    ea:value [ ea:name "xor"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The XOR logical operator - a logical operation that outputs true only when inputs differ (one is true, the other is false)."@en ] .

datex:TrafficRegulation.ConditionReference
    a owl:Class ;
    rdfs:label "ConditionReference"@en ;
    skos:definition "Reference to a predefined condition instance."@en ;
    skos:prefLabel "condition reference"@en ;
    skos:altLabel "conditionreference"@en ;
    rdfs:subClassOf datex:TrafficRegulation.Condition ;
    rdfs:comment "DATEX II class in namespace TrafficRegulation / Classes/Condition"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "reference"@en ; ea:position 1 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Reference to a predefined condition."@en ] .

datex:TrafficRegulation.ConditionSet
    a owl:Class ;
    rdfs:label "ConditionSet"@en ;
    skos:definition "Groups a number of conditions into a condition set."@en ;
    skos:prefLabel "condition set"@en ;
    skos:altLabel "conditionset"@en ;
    rdfs:subClassOf datex:TrafficRegulation.Condition ;
    rdfs:comment "DATEX II class in namespace TrafficRegulation / Classes/Condition"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "operator"@en ; ea:position 1 ; ea:type datex:TrafficRegulation.ConditionOperator ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specifies the operator to be applied between the conditions in the set."@en ] .

datex:TrafficRegulation.ConditionSet.conditions
    a owl:ObjectProperty ;
    rdfs:domain datex:TrafficRegulation.ConditionSet ;
    rdfs:range datex:TrafficRegulation.Condition ;
    ea:lowerBound "1" ;
    ea:upperBound "*" .

datex:TrafficRegulation.DirectionRestriction
    a owl:Class ;
