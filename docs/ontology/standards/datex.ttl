    a owl:Class ;
    rdfs:label "MicrogramsConcentrationValue"@en ;
    skos:definition "A measured or calculated value of concentration of a substance in micrograms per unit volume."@en ;
    skos:prefLabel "micrograms concentration value"@en ;
