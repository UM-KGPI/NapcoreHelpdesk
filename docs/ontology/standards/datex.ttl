    ea:attribute [ ea:name "roadOrigination"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Name of some city, area, compass direction or other identification this road comes from."@en ] .

datex:Parking.RoadTypeEnum
    a owl:Class ;
