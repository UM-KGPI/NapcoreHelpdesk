datex:Parking.OccupancyChangeValue
    a owl:Class ;
    rdfs:label "OccupancyChangeValue"@en ;
    skos:definition "A measured or calculated value of change of occupied parking spaces expressed as integer."@en ;
    skos:prefLabel "occupancy change value"@en ;
    skos:altLabel "occupancychangevalue"@en ;
    rdfs:subClassOf datex:Common.DataValue ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/VehicleCountAndRate"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "occupancyChange"@en ; ea:position 1 ; ea:type datex:Common.Integer ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A measured or calculated absolute change of occupied parking spaces within a specified time expressed as integer."@en ] .

datex:Parking.OccupancyLevel
    a owl:Class ;
    rdfs:label "OccupancyLevel"@en ;
    skos:definition "Defines an occupancy level as specified by the data supplier."@en ;
    skos:prefLabel "occupancy level"@en ;
    skos:altLabel "occupancylevel"@en ;
