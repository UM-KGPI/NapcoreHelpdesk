    skos:prefLabel "structure grade enum"@en ;
    skos:altLabel "structuregradeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "groundLevel"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking is at ground level."@en ] ;
    ea:value [ ea:name "aboveGround"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking is above ground level (this may include ground level parking)."@en ] ;
    ea:value [ ea:name "underground"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking is on one or more floors below ground level."@en ] .

datex:Parking.StructureTypeEnum
    a owl:Class ;
    rdfs:label "StructureTypeEnum"@en ;
    skos:definition "A list of types of parking structure."@en ;
    skos:prefLabel "structure type enum"@en ;
    skos:altLabel "structuretypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "onStreet"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On-street parking."@en ] ;
    ea:value [ ea:name "offStreetSurface"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Off-street ground-level at grade parking."@en ] ;
    ea:value [ ea:name "offStreetStructure"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Off-street multi-tier parking structure."@en ] .

datex:Parking.SubplaceElement
    a owl:Class ;
    rdfs:label "SubplaceElement"@en ;
    skos:definition "A sub-division of a place for the convenience of the operator to segment the place and identify varied uses for parking and mobility related operations or other purposes."@en ;
    skos:prefLabel "subplace element"@en ;
    skos:altLabel "subplaceelement"@en ;
    rdfs:subClassOf datex:Parking.HierarchyElementGeneral ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/SubplaceElement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "subplaceType"@en ; ea:position 1 ; ea:type datex:Parking.ElementDescriptorEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Hierarchy element type."@en ] .

datex:Parking.SubplaceElement.CommonComponents
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.SubplaceElement ;
    rdfs:range datex:Parking.CommonComponents ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Parking.SupplementalFacility
    a owl:Class ;
    rdfs:label "SupplementalFacility"@en ;
    skos:definition "A specialisation of an identifiedArea referencing an identifiable area with associated identified services or equipment."@en ;
    skos:prefLabel "supplemental facility"@en ;
    skos:altLabel "supplementalfacility"@en ;
    rdfs:subClassOf datex:Parking.IdentifiedArea ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/IdentifiedArea"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "reference"@en ; ea:position 1 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A reference on a previously defined SupplementalFacility (from namespace Facilities)."@en ] .

datex:Parking.Supply
    a owl:Class ;
    rdfs:label "Supply"@en ;
    skos:definition "A class defining concepts relating the parameters of the supply of parking or others uses in a Place. This is the total number of spaces usable for parking or other mobility operations. It can be defined as demarcated spaces or non-demarcated."@en ;
    skos:prefLabel "supply"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/SupplyAndDemand"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "quantity"@en ; ea:position 1 ; ea:type datex:Common.Integer ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the numeric value of available parking or other space uses."@en ] ;
    ea:attribute [ ea:name "viewType"@en ; ea:position 2 ; ea:type datex:Parking.SupplyViewTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the nature of the supply view that is being provided, as defined by the supply view type."@en ] ;
    ea:attribute [ ea:name "startValidUsagePeriod"@en ; ea:position 3 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Valid start date/time for the supply."@en ] ;
    ea:attribute [ ea:name "endValidUsagePeriod"@en ; ea:position 4 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Valid end date/time for the supply."@en ] ;
    ea:attribute [ ea:name "spacesReference"@en ; ea:position 5 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "A reference to one or more spaces for which the supply information is valid."@en ] .

datex:Parking.SupplyViewTypeEnum
    a owl:Class ;
    rdfs:label "SupplyViewTypeEnum"@en ;
    skos:definition "Define if space quantity is demarcated or estimated."@en ;
    skos:prefLabel "supply view type enum"@en ;
    skos:altLabel "supplyviewtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "spaceView"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Each space is physically marked and identifiable."@en ] ;
    ea:value [ ea:name "vehicleView"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The vehicle capacity in an area is estimated based on calculating a capacity (i.e. curb length divided by a length of vehicle). The distributing party decides on the appropriate length of vehicle to use."@en ] .

datex:Parking.ThresholdConfiguration
    a owl:Class ;
    rdfs:label "ThresholdConfiguration"@en ;
    skos:definition "Configuration of thresholds and colours for the status parameter. Only one status should be active at a time, so that the most recently activated status means that an existing active status should be considered no longer active."@en ;
    skos:prefLabel "threshold configuration"@en ;
    skos:altLabel "thresholdconfiguration"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/ThresholdConfiguration"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "lastMaximumOccupancy"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The last known occupancy (number of parked vehicles on the site) under safe conditions."@en ] .

datex:Parking.ThresholdConfiguration.StatusConfiguration
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.ThresholdConfiguration ;
    rdfs:range datex:Parking.StatusConfiguration ;
    ea:lowerBound "1" ;
    ea:upperBound "*" .

datex:Parking.Thresholds
    a owl:Class ;
    rdfs:label "Thresholds"@en ;
    skos:definition "Threshold values to configure the given parking site status."@en ;
    skos:prefLabel "thresholds"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/ThresholdConfiguration"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "lowerThreshold"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A lower threshold from which the specified parking site status should become active."@en ] ;
    ea:attribute [ ea:name "upperThreshold"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An upper threshold up to which the specified parking site status should become active."@en ] ;
    ea:attribute [ ea:name "lowerThresholdInPercent"@en ; ea:position 3 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A lower threshold in percent from which the specified parking site status should become active."@en ] ;
    ea:attribute [ ea:name "upperThresholdInPercent"@en ; ea:position 4 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An upper threshold in percent up to which the specified parking site status should become active."@en ] ;
    ea:attribute [ ea:name "boundaryValuesExcluded"@en ; ea:position 5 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Configures, if the given threshold values itself should be included (\"false\"; default) or excluded (\"true\") in the comparison, when evaluating the status."@en ] .

datex:Parking.TruckParkingDynamicManagementEnum
    a owl:Class ;
    rdfs:label "TruckParkingDynamicManagementEnum"@en ;
    skos:definition "Dynamic parking mode enum."@en ;
    skos:prefLabel "truck parking dynamic management enum"@en ;
    skos:altLabel "truckparkingdynamicmanagementenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "compactParking"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lorries are parking one after the other in different lanes; each lane has a dedicated time of departure (which might be displayed on a sign gantry)."@en ] ;
    ea:value [ ea:name "queueParking"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lorries are parking in queues, one after the other. Each lorry must have an earlier time of departure than all the lorries behind it."@en ] ;
    ea:value [ ea:name "noDynamicParkingManagement"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No dynamic parking management."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some other type of dynamic parking management."@en ] .

datex:Parking.UsageScenario
    a owl:Class ;
    rdfs:label "UsageScenario"@en ;
    skos:definition "A special type of usage available for this campus, (sub)place, space or identified area. In the 'ParkingStatusPublication', the operation type (in operation or not) can be defined."@en ;
    skos:prefLabel "usage scenario"@en ;
    skos:altLabel "usagescenario"@en ;
    rdfs:subClassOf datex:Parking.OperatingPattern ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/OperatingPattern"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "type"@en ; ea:position 1 ; ea:type datex:Parking.ParkingUsageScenarioEnum ; ea:lowerBound "1" ; ea:upperBound "*" ; ea:definition "A special type of usage available for this campus, (sub)place, space or identified area. In the 'ParkingStatusPublication', the operation type (in operation or not) can be defined."@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A description for the usage scenario."@en ] ;
    ea:attribute [ ea:name "truckParkingDynamicManagement"@en ; ea:position 3 ; ea:type datex:Parking.TruckParkingDynamicManagementEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Two modes for parking lorries in a efficient way according to their departure times. May only be used for parking scenario 'truckParking'."@en ] ;
    ea:attribute [ ea:name "eventParkingType"@en ; ea:position 4 ; ea:type datex:Common.PublicEventTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Parking associated with an event. May only be used for parking scenario 'eventParking'."@en ] .

datex:Parking.ValidityByOffset
    a owl:Class ;
