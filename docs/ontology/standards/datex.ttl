    ea:upperBound "*" .

datex:Parking.ParkingRouteOrientationEnum
    a owl:Class ;
    rdfs:label "ParkingRouteOrientationEnum"@en ;
    skos:definition "Orientation of traffic for a parking route."@en ;
    skos:prefLabel "parking route orientation enum"@en ;
    skos:altLabel "parkingrouteorientationenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "towardsParkingSite"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Towards parking site."@en ] ;
    ea:value [ ea:name "awayFromParkingSite"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Away from parking site."@en ] .

datex:Parking.ParkingRouteStatus
    a owl:Class ;
    rdfs:label "ParkingRouteStatus"@en ;
    skos:definition "The status as well as the travel times of a parking route (active/inactive) defined in the static part of the model."@en ;
    skos:prefLabel "parking route status"@en ;
    skos:altLabel "parkingroutestatus"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/ParkingStatus"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "parkingRouteReference"@en ; ea:position 1 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A reference to a parking route."@en ] ;
    ea:attribute [ ea:name "parkingRouteActive"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Defines if this parking route is currently active or not."@en ] .

