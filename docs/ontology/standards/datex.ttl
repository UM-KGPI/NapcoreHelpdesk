    ea:value [ ea:name "percentage30"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "30% full."@en ] ;
    ea:value [ ea:name "percentage40"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "40% full."@en ] ;
    ea:value [ ea:name "percentage50"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "50% full."@en ] ;
    ea:value [ ea:name "percentage60"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "60% full."@en ] ;
    ea:value [ ea:name "percentage70"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "70% full."@en ] ;
    ea:value [ ea:name "percentage80"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "80% full."@en ] ;
    ea:value [ ea:name "percentage90"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "90% full."@en ] ;
    ea:value [ ea:name "full"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Full."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unknown."@en ] .

datex:Parking.ParkingOccupancyTrendEnum
    a owl:Class ;
    rdfs:label "ParkingOccupancyTrendEnum"@en ;
    skos:definition "List of terms used to describe the trend in parking space occupancy."@en ;
    skos:prefLabel "parking occupancy trend enum"@en ;
    skos:altLabel "parkingoccupancytrendenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "decreasing"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking space occupancy is decreasing."@en ] ;
    ea:value [ ea:name "increasing"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking space occupancy is increasing."@en ] ;
    ea:value [ ea:name "stable"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking space occupancy is stable."@en ] ;
    ea:value [ ea:name "increasingQuickly"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking space occupancy is increasing quickly."@en ] ;
    ea:value [ ea:name "increasingSlowly"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking space occupancy is increasing slowly."@en ] ;
    ea:value [ ea:name "decreasingQuickly"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking space occupancy is decreasing quickly."@en ] ;
    ea:value [ ea:name "decreasingSlowly"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking space occupancy is decreasing slowly."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unknown."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

datex:Parking.ParkingPlaceStatusEnum
    a owl:Class ;
    rdfs:label "ParkingPlaceStatusEnum"@en ;
    skos:definition "The status of the parking place or sub-places (spaces available or not)."@en ;
    skos:prefLabel "parking place status enum"@en ;
    skos:altLabel "parkingplacestatusenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "full"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is full (as defined by its configuration parameters)."@en ] ;
    ea:value [ ea:name "fullAtEntrance"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is considered full at its entrance (e.g. full sign is displayed at entrance or on managing VMS)."@en ] ;
    ea:value [ ea:name "spacesAvailable"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking spaces are currently available."@en ] ;
    ea:value [ ea:name "almostFull"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is almost full (as defined by its configuration parameters)."@en ] ;
    ea:value [ ea:name "overcrowding"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is overcrowding (as defined by its configuration parameters)."@en ] ;
    ea:value [ ea:name "overcrowdingLevel1"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is overcrowding in level 1 (as defined by its configuration parameters)."@en ] ;
    ea:value [ ea:name "overcrowdingLevel2"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is overcrowding in level 2 (as defined by its configuration parameters)."@en ] ;
    ea:value [ ea:name "noOvercrowding"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is not overcrowded."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The status of the parking site is unknown."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

datex:Parking.ParkingRoute
    a owl:Class ;
