datex:Common.GlobalReference
    a owl:Class ;
    rdfs:label "GlobalReference"@en ;
    skos:definition "A versioned reference to an object that may be in another publication from another publisher."@en ;
    skos:prefLabel "global reference"@en ;
    skos:altLabel "globalreference"@en ;
