datex:FaultAndStatus.ObjectIdentifier
    a owl:Class ;
    rdfs:label "ObjectIdentifier"@en ;
    skos:definition "An OID according to ISO/IEC 9834-1:2012 and ISO/IEC 8824-1:2015 using the dot-notation. Example: (1.3.162) points to CEN. The presentation in ASN.1 would be: {iso(1) identified-organization(3) cen(162)}."@en ;
