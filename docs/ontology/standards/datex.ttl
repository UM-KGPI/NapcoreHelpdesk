    ea:value [ ea:name "regulatory"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Informing of special obligations, restrictions or prohibitions (GDD service category 12)."@en ] ;
    ea:value [ ea:name "roadConditions"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Notifying of road-related conditions and events on route (GDD service category 32)."@en ] .

