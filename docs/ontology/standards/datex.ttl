    ea:attribute [ ea:name "predefinedLocationGroupName"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A name assigned to the predefined group of non-ordered locations."@en ] .

datex:LocationReferencing.PredefinedLocationGroup.LocationGroup
    a owl:ObjectProperty ;
