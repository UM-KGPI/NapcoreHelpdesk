    skos:definition "Describes the time at which a measured or calculated value or set of values was measured or calculated. It may be a future time at which a data value is predicted to apply."@en ;
    skos:prefLabel "measurement or calculation time"@en ;
    skos:altLabel "measurementorcalculationtime"@en ;
    rdfs:comment "DATEX II class in namespace RoadTrafficData / Classes/BasicData"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "timeMeaning"@en ; ea:position 1 ; ea:type datex:RoadTrafficData.TimeMeaningEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Meaning of associated time value"@en ] ;
    ea:attribute [ ea:name "timeValue"@en ; ea:position 2 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Point in time at which this specific value or set of values has been measured or calculated. It may also be a future time at which a data value is predicted. It may be the time of the beginning, the end or the middle of a measurement period."@en ] ;
    ea:attribute [ ea:name "timePrecision"@en ; ea:position 3 ; ea:type datex:Common.TimePrecisionEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The precision to which the time of measurement or calculation is given."@en ] .

