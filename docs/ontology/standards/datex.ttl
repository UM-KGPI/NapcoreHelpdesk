datex:Parking.SessionActivationModeEnum
    a owl:Class ;
    rdfs:label "SessionActivationModeEnum"@en ;
    skos:definition "Modes or credentials that can be used to activate a parking session or other operation (delivery, loading, etc)."@en ;
    skos:prefLabel "session activation mode enum"@en ;
    skos:altLabel "sessionactivationmodeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "payByPlate"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The vehicle registration or license plate is used to activate a parking session or other operation (delivery, loading, etc.)."@en ] ;
    ea:value [ ea:name "payBySpace"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The activation of a parking session or other operation (delivery, loading, etc.) is based on identifying / recording the occupancy of a specific area denoted by a space or area number. Typically used in prepaid operations."@en ] ;
    ea:value [ ea:name "payAndDisplay"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The vehicle displays a credential, which is received on site when session is started, to show it is authorized to use Place. Typically used in prepaid operations."@en ] ;
    ea:value [ ea:name "ticket"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A ticket from an onsite device is issued to activate a parking session or other operation. The session is closed when the ticket is presented back to an onsite device for final fee calculation. Typically used in daily or short-term operations."@en ] ;
    ea:value [ ea:name "permit"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Similar to pay and display, but typically for long term usage and received prior to starting session. Permit may be presented as a hangtag, AVI tag, sticker, QR code, etc."@en ] ;
    ea:value [ ea:name "app"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A mobile application and/or an on-device credential is used to activate a parking session or other operation. The app may control the access to the facility. This is not related to payment! E.g. a Bluetooth communication to request access etc."@en ] .

