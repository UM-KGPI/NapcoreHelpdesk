    ea:attribute [ ea:name "style"@en ; ea:position 1 ; ea:type datex:Parking.PedestrianAccessStyleEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Provides information concerning the style of the pedestrian access."@en ] ;
    ea:attribute [ ea:name "numberOfPortals"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates the number of door portals present at the pedestrian access area."@en ] .

datex:Parking.PedestrianAccessStyleEnum
    a owl:Class ;
    rdfs:label "PedestrianAccessStyleEnum"@en ;
    skos:definition "A list of the supported pedestrian access characteristic types."@en ;
    skos:prefLabel "pedestrian access style enum"@en ;
    skos:altLabel "pedestrianaccessstyleenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "cargoShippingDoor"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Door/portal primarily intended for the handing and transfer of goods and cargo"@en ] ;
    ea:value [ ea:name "door"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Door/portal without special characteristics - general pedestrian access"@en ] ;
    ea:value [ ea:name "doorWithAccessCredential"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Door/portal with controlled access by use of defined credentials"@en ] ;
    ea:value [ ea:name "doorWithSecurityReview"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Door/portal with controlled access by security staff inspection"@en ] ;
    ea:value [ ea:name "emergencyExitDoor"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Door/portal primarily intended for use in emergency evacuations circumstances - may be internal within sub-areas of a place"@en ] .

