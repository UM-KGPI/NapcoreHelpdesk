    ea:attribute [ ea:name "measurementSiteIdentification"@en ; ea:position 6 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identification of a measurement site used by the supplier or consumer systems."@en ] .

