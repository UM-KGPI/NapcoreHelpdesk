    ea:attribute [ ea:name "predefinedItineraryName"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A name assigned to the predefined itinerary."@en ] .

