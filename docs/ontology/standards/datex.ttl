datex:Situation.GeneralNetworkManagement
    a owl:Class ;
    rdfs:label "GeneralNetworkManagement"@en ;
    skos:definition "Network management action that is instigated either manually or automatically by the network/road operator. Compliance with any resulting control may be advisory or mandatory."@en ;
    skos:prefLabel "general network management"@en ;
    skos:altLabel "generalnetworkmanagement"@en ;
    rdfs:subClassOf datex:Situation.NetworkManagement ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/OperatorAction/NetworkManagement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "generalNetworkManagementType"@en ; ea:position 1 ; ea:type datex:Situation.GeneralNetworkManagementTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of traffic management action instigated by the network/road operator."@en ] ;
    ea:attribute [ ea:name "trafficManuallyDirectedBy"@en ; ea:position 2 ; ea:type datex:Situation.PersonCategoryEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of person that is manually directing traffic (applicable if generalNetworkManagementType is set to \"trafficBeingManuallyDirected\")."@en ] .

datex:Situation.GeneralNetworkManagementTypeEnum
    a owl:Class ;
    rdfs:label "GeneralNetworkManagementTypeEnum"@en ;
    skos:definition "Types of network management actions."@en ;
    skos:prefLabel "general network management type enum"@en ;
    skos:altLabel "generalnetworkmanagementtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "bridgeSwingInOperation"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The bridge at the specified location has swung or lifted and is therefore temporarily closed to traffic."@en ] ;
    ea:value [ ea:name "convoyService"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vehicle convoy service is in operation, for example with a snowplough running ahead due to bad weather conditions."@en ] ;
    ea:value [ ea:name "obstacleSignalling"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Signs are being put out before or around an obstacle to protect drivers."@en ] ;
    ea:value [ ea:name "rampMeteringInOperation"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Ramp metering is now active at the specified location."@en ] ;
    ea:value [ ea:name "temporaryTrafficLights"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic is being controlled by temporary traffic lights (red-yellow-green or red-green)."@en ] ;
    ea:value [ ea:name "tollGatesOpen"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Toll gates are open with no fee collection at the specified location."@en ] ;
    ea:value [ ea:name "trafficBeingManuallyDirected"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic is being manually directed."@en ] ;
    ea:value [ ea:name "trafficHeld"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic in the specified direction is temporarily held up due to an unplanned event (e.g. for clearance of wreckage following an accident)."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

