    ea:attribute [ ea:name "triggerDefinition"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A formal or informal definition of a trigger condition, either human readable or machine-interpretable. If the definition is machine interpretable, the expression language should be specified in documention of the service publishing the conditions."@en ] .

datex:TrafficManagementPlan.WinterDrivingManagementDefinition
    a owl:Class ;
