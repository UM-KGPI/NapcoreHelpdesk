datex:Facilities.RateLineTax
    a owl:Class ;
    rdfs:label "RateLineTax"@en ;
    skos:definition "Class containing details of tax to be applied to a RateLine"@en ;
    skos:prefLabel "rate line tax"@en ;
    skos:altLabel "ratelinetax"@en ;
    rdfs:comment "DATEX II class in namespace Facilities / RatesPublication/Rates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "taxValue"@en ; ea:position 1 ; ea:type datex:Facilities.AmountOfMoney ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The monetary amount of tax to be applied."@en ] ;
    ea:attribute [ ea:name "taxRate"@en ; ea:position 2 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The percentage rate of tax to be applied."@en ] ;
    ea:attribute [ ea:name "taxIncluded"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "[TRUE] Indication that tax to be applied is included within the total rate associated with this rate line. [FALSE] indicates that the tax is added additionally to the total."@en ] ;
    ea:attribute [ ea:name "trigger"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text definition of boundary condition setting applicability of the tax"@en ] ;
    ea:attribute [ ea:name "labelForDisplay"@en ; ea:position 5 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text for display on a receipt and/or in a user interface"@en ] .

datex:Facilities.RateLineTypeEnum
    a owl:Class ;
    rdfs:label "RateLineTypeEnum"@en ;
    skos:definition "A list of rate line types."@en ;
    skos:prefLabel "rate line type enum"@en ;
    skos:altLabel "ratelinetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Facilities / RatesPublication/Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "flatRate"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A rate applied to the rate line which is not time/duration dependent. i.e. a single fixed payment."@en ] ;
    ea:value [ ea:name "incrementingRate"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A charge rate that increases by a defined amount in a defined time."@en ] ;
    ea:value [ ea:name "flatRateTier"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A flat rate charge rate associated with a specific time-based tier. This is a special case of an incrementing rate."@en ] ;
    ea:value [ ea:name "perUnit"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A charge rate that is calculated per unit (the unit should be specified, for example in RefillPoint)"@en ] .

datex:Facilities.RateMatrix
    a owl:Class ;
    rdfs:label "RateMatrix"@en ;
