datex:Parking.ParkingUsageScenarioEnum
    a owl:Class ;
    rdfs:label "ParkingUsageScenarioEnum"@en ;
    skos:definition "Types of parking usage (park & ride, kiss & ride, ...)"@en ;
    skos:prefLabel "parking usage scenario enum"@en ;
    skos:altLabel "parkingusagescenarioenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "automatedParkingGarage"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking is completely automated from the point of leaving the vehicle in an arrival bay to its delivery back to the driver in a pickup bay."@en ] ;
    ea:value [ ea:name "carSharing"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking site for people who are sharing cars organised by a car sharing company."@en ] ;
    ea:value [ ea:name "delivery"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking for delivery"@en ] ;
    ea:value [ ea:name "dropOff"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site or space(s) are designed for drop off only."@en ] ;
    ea:value [ ea:name "dropOffMechanical"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A mechanical drop off service."@en ] ;
    ea:value [ ea:name "dropOffWithValet"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A valet drop off service."@en ] ;
    ea:value [ ea:name "eventParking"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking is associated with an event. Use 'eventParkingType' to specify the event."@en ] ;
    ea:value [ ea:name "guidanceToAvailableSpaces"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specifies, if there is a (visual) guidance system within the parking site, which helps the drivers to find free spaces. Note: This is not a parking VMS or a parking route, which are usually located outside the parking site."@en ] ;
    ea:value [ ea:name "kissAndRide"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking site with possibility for very short parking to drop off (or drop on) passengers for public transport."@en ] ;
    ea:value [ ea:name "liftshare"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking site for people who are sharing their cars."@en ] ;
    ea:value [ ea:name "motorwayParking"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking is located directly on a motorway or a similar type of road."@en ] ;
    ea:value [ ea:name "nearbyMotorwayParking"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking is located with some distance to a motorway or a similar type of road but focussed on travellers from this motorway."@en ] ;
    ea:value [ ea:name "overnightParking"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site or space(s) are designed for overnight parking. Note that the absence of this scenario does not automatically mean a prohibition of overnight parking. See also PermitsAndProhibitions."@en ] ;
    ea:value [ ea:name "parkAndCycle"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking site for people who continue their journey by bike."@en ] ;
    ea:value [ ea:name "parkAndDrive"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking for users that share their cars."@en ] ;
    ea:value [ ea:name "parkAndRide"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking for public transport users."@en ] ;
    ea:value [ ea:name "parkAndWalk"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking site for people who continue to walk."@en ] ;
    ea:value [ ea:name "poiParking"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking in relation or in the near of a point of interest"@en ] ;
    ea:value [ ea:name "restArea"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a rest area, i.e. people can relax some time outside their car there. Note that the presence of some bench, picnic place or toilet is already sufficient; there is no need for a restaurant or a building."@en ] ;
    ea:value [ ea:name "serviceArea"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a service area."@en ] ;
    ea:value [ ea:name "specialLocation"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking is connected to or part of a special location which can be specified by an extra attribute."@en ] ;
    ea:value [ ea:name "staffGuidesToSpace"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Staff guides to space."@en ] ;
    ea:value [ ea:name "truckParking"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is designed for lorries (other vehicles are allowed as well)."@en ] ;
    ea:value [ ea:name "vehicleLift"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle lift"@en ] ;
    ea:value [ ea:name "zone"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking zone."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some other usage scenario."@en ] .

datex:Parking.ParkingVacantSpacesEnum
    a owl:Class ;
    rdfs:label "ParkingVacantSpacesEnum"@en ;
    skos:definition "Parking vacant spaces enum."@en ;
    skos:prefLabel "parking vacant spaces enum"@en ;
    skos:altLabel "parkingvacantspacesenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "noParkingSpacesAvailable"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No parking spaces available."@en ] ;
    ea:value [ ea:name "expectNoSpacesAvailable"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Expect no parking spaces available."@en ] ;
    ea:value [ ea:name "onlyAFewSpacesAvailable"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only a few parking spaces available."@en ] ;
    ea:value [ ea:name "lessThan10SpacesAvailable"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Less than 10 parking spaces available."@en ] ;
    ea:value [ ea:name "lessThan20SpacesAvailable"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Less than 20 parking spaces available."@en ] ;
    ea:value [ ea:name "lessThan30SpacesAvailable"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Less than 30 parking spaces available."@en ] ;
    ea:value [ ea:name "lessThan40SpacesAvailable"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Less than 40 parking spaces available."@en ] ;
    ea:value [ ea:name "lessThan50SpacesAvailable"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Less than 50 parking spaces available."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unknown."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

