datex:Parking.PublicTransportTypeEnum
    a owl:Class ;
    rdfs:label "PublicTransportTypeEnum"@en ;
    skos:definition "Special measures in the context of public transport."@en ;
    skos:prefLabel "public transport type enum"@en ;
    skos:altLabel "publictransporttypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
