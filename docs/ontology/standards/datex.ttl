datex:TrafficManagementPlan.ResponseEffectTypeEnum
    a owl:Class ;
    rdfs:label "ResponseEffectTypeEnum"@en ;
    skos:definition "Type of effect that a traffic management response is intended to have."@en ;
    skos:prefLabel "response effect type enum"@en ;
    skos:altLabel "responseeffecttypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace TrafficManagementPlan / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "capacityIncrease"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "the effect that is to increase flow capacity of a section of road"@en ] ;
    ea:value [ ea:name "inflowReduction"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "the effect that is to reduce inflow to a section of road"@en ] ;
    ea:value [ ea:name "outflowIncrease"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "the effect that is to increase the outflow from a section of road"@en ] ;
    ea:value [ ea:name "prewarning"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "the effect that is the provision of prior warning that traffic-affecting conditions or actions will occur"@en ] ;
    ea:value [ ea:name "rerouting"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "the effect that is rerouting"@en ] .

datex:TrafficManagementPlan.ResponseStageEnum
    a owl:Class ;
