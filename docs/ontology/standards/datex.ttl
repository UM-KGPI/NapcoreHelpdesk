datex:LocationReferencing.PredefinedLocationReference
    a owl:Class ;
    rdfs:label "PredefinedLocationReference"@en ;
    skos:definition "A location reference which is predefined and may be realised by a predefined itinerary, non-ordered group of locations or single location."@en ;
    skos:prefLabel "predefined location reference"@en ;
    skos:altLabel "predefinedlocationreference"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / PredefinedLocationsPublication"@en ;
    ea:kind "class" .

datex:LocationReferencing.PredefinedLocationsPublication
    a owl:Class ;
    rdfs:label "PredefinedLocationsPublication"@en ;
    skos:definition "A publication containing one or more groups of predefined locations organised either as itineraries, non-ordered groups or as individual locations."@en ;
    skos:prefLabel "predefined locations publication"@en ;
    skos:altLabel "predefinedlocationspublication"@en ;
    rdfs:subClassOf datex:Common.PayloadPublication ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / PredefinedLocationsPublication"@en ;
