    skos:altLabel "undefinedorganisation"@en ;
    rdfs:subClassOf datex:AfirFacilities.Organisation ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / OrganisationPublication"@en ;
    ea:kind "class" .

datex:AfirFacilities.UnitOfTimeEnum
    a owl:Class ;
    rdfs:label "UnitOfTimeEnum"@en ;
    skos:definition "A list of the supported units of measures of time.."@en ;
    skos:prefLabel "unit of time enum"@en ;
    skos:altLabel "unitoftimeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirFacilities / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "second"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Base unit of measurement of time in the International System of Units (SI) as defined by the International Committee of Weights and Measures (CIPM, i.e. Comité International des Poids et Mesures) [source ISO8601]."@en ] ;
    ea:value [ ea:name "minute"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unit of time, equal to 60 seconds [source ISO8601]."@en ] ;
    ea:value [ ea:name "hour"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unit of time, equal to 60 minutes [source ISO8601]."@en ] ;
    ea:value [ ea:name "day"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unit of time, equal to 24 hours [source ISO8601]."@en ] .

