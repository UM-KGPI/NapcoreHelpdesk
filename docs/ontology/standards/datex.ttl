    ea:upperBound "1" .

datex:Common.TemperatureCelsius
    a owl:Class ;
    rdfs:label "TemperatureCelsius"@en ;
    skos:definition "A measure of temperature defined in degrees Celsius."@en ;
    skos:prefLabel "temperature celsius"@en ;
    skos:altLabel "temperaturecelsius"@en ;
    rdfs:subClassOf datex:Common.Float ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Specific"@en ;
    ea:kind "data type" .

datex:Common.TemperatureValue
    a owl:Class ;
    rdfs:label "TemperatureValue"@en ;
    skos:definition "A measured or calculated value of temperature."@en ;
    skos:prefLabel "temperature value"@en ;
    skos:altLabel "temperaturevalue"@en ;
    rdfs:subClassOf datex:Common.DataValue ;
    rdfs:comment "DATEX II class in namespace Common / Classes/DataValue"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "temperature"@en ; ea:position 1 ; ea:type datex:Common.TemperatureCelsius ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A value of temperature expressed in degrees Celsius."@en ] .

datex:Common.Time
    a owl:Class ;
    rdfs:label "Time"@en ;
    skos:definition "An instant of time that recurs every day. The value space of time is the space of time of day values as defined in § 5.3 of [ISO 8601]. Specifically, it is a set of zero-duration daily time instances."@en ;
    skos:prefLabel "time"@en ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Generic"@en ;
    ea:kind "data type" .

datex:Common.TimePeriodOfDay
    a owl:Class ;
    rdfs:label "TimePeriodOfDay"@en ;
    skos:definition "Specification of a continuous period of time within a 24 hour period. If endTime is before startTime then endTime should be interpreted as being in the following day."@en ;
    skos:prefLabel "time period of day"@en ;
    skos:altLabel "timeperiodofday"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/Validity"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "startTimeOfPeriod"@en ; ea:position 1 ; ea:type datex:Common.Time ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Start of time period."@en ] ;
    ea:attribute [ ea:name "endTimeOfPeriod"@en ; ea:position 2 ; ea:type datex:Common.Time ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "End of time period."@en ] .

datex:Common.TimePrecisionEnum
    a owl:Class ;
    rdfs:label "TimePrecisionEnum"@en ;
    skos:definition "List of precisions to which times can be given."@en ;
    skos:prefLabel "time precision enum"@en ;
    skos:altLabel "timeprecisionenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "tenthsOfSecond"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time given to the nearest tenth of a second."@en ] ;
    ea:value [ ea:name "second"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time given to the nearest second."@en ] ;
    ea:value [ ea:name "minute"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time given to the nearest minute."@en ] ;
    ea:value [ ea:name "quarterHour"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time given to the nearest quarter hour."@en ] ;
    ea:value [ ea:name "halfHour"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time given to the nearest half hour."@en ] ;
    ea:value [ ea:name "hour"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time given to the nearest hour."@en ] .

datex:Common.Tonnes
    a owl:Class ;
    rdfs:label "Tonnes"@en ;
    skos:definition "A measure of weight defined in metric tonnes."@en ;
    skos:prefLabel "tonnes"@en ;
    rdfs:subClassOf datex:Common.Float ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Specific"@en ;
    ea:kind "data type" .

datex:Common.TrafficTrendTypeEnum
    a owl:Class ;
    rdfs:label "TrafficTrendTypeEnum"@en ;
    skos:definition "List of terms used to describe the trend in traffic conditions."@en ;
    skos:prefLabel "traffic trend type enum"@en ;
    skos:altLabel "traffictrendtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "trafficBuildingUp"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic conditions are changing from free-flow to heavy or slow service levels. Queues may also be expected."@en ] ;
    ea:value [ ea:name "trafficEasing"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic conditions are changing from heavy or slow service levels to free-flow."@en ] ;
    ea:value [ ea:name "trafficStable"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic conditions are currently stable."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The trend of traffic conditions is currently unknown."@en ] .

datex:Common.Url
    a owl:Class ;
    rdfs:label "Url"@en ;
    skos:definition "A Uniform Resource Locator (URL) address comprising a compact string of characters for a resource available on the Internet."@en ;
    skos:prefLabel "url"@en ;
    rdfs:subClassOf datex:Common.String ;
    rdfs:comment "DATEX II data type in namespace Common / DataTypes/Generic"@en ;
    ea:kind "data type" .

datex:Common.UrlLink
    a owl:Class ;
    rdfs:label "UrlLink"@en ;
    skos:definition "Details of a Uniform Resource Locator (URL) address pointing to a resource available on the Internet from where further relevant information may be obtained."@en ;
    skos:prefLabel "url link"@en ;
    skos:altLabel "urllink"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "urlLinkAddress"@en ; ea:position 1 ; ea:type datex:Common.Url ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A Uniform Resource Locator (URL) address pointing to a resource available on the Internet from where further relevant information may be obtained."@en ] ;
    ea:attribute [ ea:name "urlLinkDescription"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of the relevant information available on the Internet from the URL link."@en ] ;
    ea:attribute [ ea:name "urlLinkType"@en ; ea:position 3 ; ea:type datex:Common.UrlLinkTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Details of the type of relevant information available on the Internet from the URL link."@en ] .

datex:Common.UrlLinkTypeEnum
    a owl:Class ;
    rdfs:label "UrlLinkTypeEnum"@en ;
    skos:definition "Types of URL links."@en ;
    skos:prefLabel "url link type enum"@en ;
    skos:altLabel "urllinktypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "documentPdf"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "URL link to a pdf document."@en ] ;
    ea:value [ ea:name "html"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "URL link to an html page."@en ] ;
    ea:value [ ea:name "image"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "URL link to an image."@en ] ;
    ea:value [ ea:name "rss"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "URL link to an RSS feed."@en ] ;
    ea:value [ ea:name "videoStream"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "URL link to a video stream."@en ] ;
    ea:value [ ea:name "voiceStream"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "URL link to a voice stream."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Common.Validity
    a owl:Class ;
    rdfs:label "Validity"@en ;
    skos:definition "Specification of validity, either explicitly or by a validity time period specification which may be discontinuous."@en ;
    skos:prefLabel "validity"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/Validity"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "validityStatus"@en ; ea:position 1 ; ea:type datex:Common.ValidityStatusEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specification of validity, either explicitly overriding the validity time specification or confirming it."@en ] ;
    ea:attribute [ ea:name "overrunning"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The activity or action described by the SituationRecord is still in progress, overrunning its planned duration as indicated in a previous version of this record or even in current version."@en ] .

datex:Common.Validity.validityTimeSpecification
    a owl:ObjectProperty ;
    rdfs:domain datex:Common.Validity ;
    rdfs:range datex:Common.OverallPeriod ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:Common.ValidityStatusEnum
    a owl:Class ;
    rdfs:label "ValidityStatusEnum"@en ;
    skos:definition "Values of validity status that can be assigned to a described event, action or item."@en ;
    skos:prefLabel "validity status enum"@en ;
    skos:altLabel "validitystatusenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "active"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The described event, action or item is currently active regardless of the definition of the validity time specification."@en ] ;
    ea:value [ ea:name "planned"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The described event, action or item is currently planned regardless of the definition of the validity time specification."@en ] ;
    ea:value [ ea:name "suspended"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The described event, action or item is currently suspended, that is inactive, regardless of the definition of the validity time specification."@en ] ;
    ea:value [ ea:name "definedByValidityTimeSpec"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The validity status of the described event, action or item is in accordance with the definition of the validity time specification."@en ] .

datex:Common.Vehicle
    a owl:Class ;
    rdfs:label "Vehicle"@en ;
    skos:definition "Details of an individual vehicle."@en ;
    skos:prefLabel "vehicle"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/Vehicle"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "anonymizedVehicleReference"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A reference for a vehicle derived from vehicle properties such as registration number but encoded so that it does not allow a human to identify the vehicle directly from the encoded value"@en ] ;
    ea:attribute [ ea:name "vehicleColour"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The colour of the vehicle."@en ] ;
    ea:attribute [ ea:name "vehicleCountryOfOrigin"@en ; ea:position 3 ; ea:type datex:Common.CountryCode ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specification of the country in which the vehicle is registered. The code is the 2-alpha code as given in EN ISO 3166-1 which is updated by the ISO 3166 Maintenance Agency."@en ] ;
    ea:attribute [ ea:name "vehicleIdentifier"@en ; ea:position 4 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A vehicle identification number (VIN) comprising 17 characters that is based on either ISO 3779 or ISO 3780 and uniquely identifies the individual vehicle. This is normally securely attached to the vehicle chassis."@en ] ;
    ea:attribute [ ea:name "vehicleManufacturer"@en ; ea:position 5 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates the stated manufacturer of the vehicle, e.g. Ford."@en ] ;
    ea:attribute [ ea:name "vehicleModel"@en ; ea:position 6 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates the model (or range name) of the vehicle, e.g. Mondeo."@en ] ;
    ea:attribute [ ea:name "vehicleRegistrationPlateIdentifier"@en ; ea:position 7 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An identifier or code displayed on a vehicle registration plate attached to the vehicle used for official identification purposes. The registration identifier is numeric or alphanumeric and is unique within the issuing authority's region."@en ] ;
    ea:attribute [ ea:name "vehicleStatus"@en ; ea:position 8 ; ea:type datex:Common.VehicleStatusEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Vehicle status."@en ] .

