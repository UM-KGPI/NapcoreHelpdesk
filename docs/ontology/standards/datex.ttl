datex:ReroutingManagementEnhanced.ComplianceOptionEnumExtended
    a owl:Class ;
    rdfs:label "ComplianceOptionEnumExtended"@en ;
    skos:definition "Extension for ComplianceOptionEnum"@en ;
    skos:prefLabel "compliance option enum extended"@en ;
    skos:altLabel "complianceoptionenumextended"@en ;
    rdfs:subClassOf datex:Situation.ComplianceOptionEnum ;
    rdfs:comment "DATEX II enumeration in namespace ReroutingManagementEnhanced / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "information"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "This is only an information about some network management."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of compliance is unknown."@en ] .

datex:ReroutingManagementEnhanced.Condition
    a owl:Class ;
    rdfs:label "Condition"@en ;
    skos:definition "Abstract class that specifies a condition for applicabilities or exemptions of a traffic regulation."@en ;
    skos:prefLabel "condition"@en ;
    rdfs:comment "DATEX II class in namespace ReroutingManagementEnhanced / Classes/Allocation"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "negate"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "If set to true means that the entire condition shall be negated."@en ] .

datex:ReroutingManagementEnhanced.Condition.LegalBasis
    a owl:ObjectProperty ;
    rdfs:domain datex:ReroutingManagementEnhanced.Condition ;
    rdfs:range datex:TrafficRegulation.LegalBasis ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:ReroutingManagementEnhanced.ConditionOperator
    a owl:Class ;
    rdfs:label "ConditionOperator"@en ;
    skos:definition "The logical operator to be used in a test of conditions."@en ;
    skos:prefLabel "condition operator"@en ;
    skos:altLabel "conditionoperator"@en ;
    rdfs:comment "DATEX II enumeration in namespace ReroutingManagementEnhanced / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "and"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The AND logical operator – a logical operation to determine if all."@en ] ;
    ea:value [ ea:name "or"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The OR logical operator – a logical operation to determine if any."@en ] ;
    ea:value [ ea:name "xor"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The XOR logical operator - a logical operation that outputs true only."@en ] .

datex:ReroutingManagementEnhanced.ConditionSet
    a owl:Class ;
    rdfs:label "ConditionSet"@en ;
    skos:definition "Groups a number of conditions into a condition set."@en ;
    skos:prefLabel "condition set"@en ;
    skos:altLabel "conditionset"@en ;
    rdfs:subClassOf datex:ReroutingManagementEnhanced.Condition ;
    rdfs:comment "DATEX II class in namespace ReroutingManagementEnhanced / Classes/Allocation"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "operator"@en ; ea:position 1 ; ea:type datex:ReroutingManagementEnhanced.ConditionOperator ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specifies the operator to be applied between the conditions in the set."@en ] .

datex:ReroutingManagementEnhanced.ConditionSet.conditions
    a owl:ObjectProperty ;
    rdfs:domain datex:ReroutingManagementEnhanced.ConditionSet ;
