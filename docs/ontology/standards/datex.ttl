    ea:value [ ea:name "downloadFailed"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A download failed."@en ] ;
    ea:value [ ea:name "intermittentData"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Data is transmitted intermittently, i.e. not continuously."@en ] ;
    ea:value [ ea:name "noData"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is no data transmitted."@en ] ;
    ea:value [ ea:name "unreliableData"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The data is unreliable."@en ] ;
    ea:value [ ea:name "unspecified"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The impact on data of the fault is not specified."@en ] .

