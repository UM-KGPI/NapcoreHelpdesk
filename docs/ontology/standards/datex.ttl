datex:LocationReferencing.AreaPlacesEnum
    a owl:Class ;
    rdfs:label "AreaPlacesEnum"@en ;
    skos:definition "Type of area place(s)"@en ;
    skos:prefLabel "area places enum"@en ;
    skos:altLabel "areaplacesenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "atBorders"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At national borders"@en ] ;
    ea:value [ ea:name "atHighAltitudes"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At high altitudes"@en ] ;
    ea:value [ ea:name "inBuiltUpAreas"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In built up areas, i.e. villages, towns and cities"@en ] ;
    ea:value [ ea:name "inForestedAreas"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On sections of the road where it runs through or adjacent to forested areas"@en ] ;
    ea:value [ ea:name "inGalleries"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In galleries"@en ] ;
    ea:value [ ea:name "inLowLyingAreas"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In low-lying areas"@en ] ;
    ea:value [ ea:name "inRuralAreas"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In rural areas, i.e. outside villages, towns and cities"@en ] ;
    ea:value [ ea:name "inShadedAreas"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In shaded areas"@en ] ;
    ea:value [ ea:name "inTheInnerCityAreas"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the city centre areas"@en ] ;
    ea:value [ ea:name "inTunnels"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In tunnels"@en ] ;
    ea:value [ ea:name "onBridges"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On bridges"@en ] ;
    ea:value [ ea:name "onDownhillSections"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On downhill sections of the road"@en ] ;
    ea:value [ ea:name "onElevatedSections"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On elevated sections of the road"@en ] ;
    ea:value [ ea:name "onEnteringOrLeavingTunnels"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On entering or leaving tunnels"@en ] ;
    ea:value [ ea:name "onFlyovers"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On flyover sections of the road, i.e. sections of the road which pass over another road"@en ] ;
    ea:value [ ea:name "onPasses"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On mountain passes"@en ] ;
    ea:value [ ea:name "onUndergroundSections"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On underground sections of the road"@en ] ;
    ea:value [ ea:name "onUnderpasses"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On underpasses, i.e. sections of the road which pass under another road"@en ] .

datex:LocationReferencing.Carriageway
    a owl:Class ;
    rdfs:label "Carriageway"@en ;
    skos:definition "Supplementary positional information which details carriageway and lane locations. Several instances may exist where the element being described extends over more than one carriageway."@en ;
    skos:prefLabel "carriageway"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/SupplementaryPositionalDescription"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "carriageway"@en ; ea:position 1 ; ea:type datex:LocationReferencing.CarriagewayEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the section of carriageway to which the location relates."@en ] ;
    ea:attribute [ ea:name "originalNumberOfLanes"@en ; ea:position 2 ; ea:type datex:Common.Integer ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Normal number of lanes, potentially available for moving traffic, before reduction due to situations. Hard shoulder should not be counted unless it is sometimes used operationally for moving traffic."@en ] .

datex:LocationReferencing.Carriageway.Lane
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.Carriageway ;
    rdfs:range datex:LocationReferencing.Lane ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:LocationReferencing.CarriagewayEnum
    a owl:Class ;
    rdfs:label "CarriagewayEnum"@en ;
    skos:definition "List of descriptors identifying specific carriageway details."@en ;
    skos:prefLabel "carriageway enum"@en ;
    skos:altLabel "carriagewayenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "connectingCarriageway"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the connecting carriageway."@en ] ;
    ea:value [ ea:name "cycleTrack"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Independent road or part of a road designated for cycles, signposted as such. A cycle track is separated from other roads or other parts of the same road by structural means."@en ] ;
    ea:value [ ea:name "entrySlipRoad"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the entry slip road."@en ] ;
    ea:value [ ea:name "exitSlipRoad"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the exit slip road."@en ] ;
    ea:value [ ea:name "flyover"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the flyover, i.e. the section of road passing over another."@en ] ;
    ea:value [ ea:name "footpath"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the footpath"@en ] ;
    ea:value [ ea:name "leftHandParallelCarriageway"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the left hand parallel carriageway."@en ] ;
    ea:value [ ea:name "leftHandFeederRoad"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the left hand feeder road."@en ] ;
    ea:value [ ea:name "mainCarriageway"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the main carriageway."@en ] ;
    ea:value [ ea:name "oppositeCarriageway"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the opposite carriageway."@en ] ;
    ea:value [ ea:name "parallelCarriageway"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the adjacent external parallel carriageway."@en ] ;
    ea:value [ ea:name "rightHandFeederRoad"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the right hand feeder road."@en ] ;
    ea:value [ ea:name "rightHandParallelCarriageway"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the right hand parallel carriageway."@en ] ;
    ea:value [ ea:name "roundabout"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the roundabout."@en ] ;
    ea:value [ ea:name "serviceRoad"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the adjacent service road."@en ] ;
    ea:value [ ea:name "slipRoads"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the slip roads."@en ] ;
    ea:value [ ea:name "underpass"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the underpass, i.e. the section of road passing under another."@en ] ;
    ea:value [ ea:name "unspecifiedCarriageway"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On an unspecified carriageway"@en ] .

datex:LocationReferencing.Destination
    a owl:Class ;
    rdfs:label "Destination"@en ;
    skos:definition "The specification of a destination. This may be either a point location or an area location."@en ;
    skos:prefLabel "destination"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" .

datex:LocationReferencing.DirectionEnum
    a owl:Class ;
    rdfs:label "DirectionEnum"@en ;
    skos:definition "List of directions of travel."@en ;
    skos:prefLabel "direction enum"@en ;
    skos:altLabel "directionenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "aligned"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Same direction as the normal direction of flow at this point on the road network."@en ] ;
    ea:value [ ea:name "allDirections"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "All directions (where more than two are applicable) at this point on the road network."@en ] ;
    ea:value [ ea:name "anticlockwise"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Anti-clockwise."@en ] ;
    ea:value [ ea:name "bothWays"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Both directions that are applicable at this point on the road network."@en ] ;
    ea:value [ ea:name "clockwise"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Clockwise."@en ] ;
    ea:value [ ea:name "innerRing"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Inner ring direction."@en ] ;
    ea:value [ ea:name "outerRing"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Outer ring direction."@en ] ;
    ea:value [ ea:name "eastBound"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "East bound general direction."@en ] ;
    ea:value [ ea:name "northBound"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "North bound general direction."@en ] ;
    ea:value [ ea:name "northEastBound"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "North east bound general direction."@en ] ;
    ea:value [ ea:name "northWestBound"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "North west bound general direction."@en ] ;
    ea:value [ ea:name "southBound"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "South bound general direction."@en ] ;
    ea:value [ ea:name "southEastBound"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "South east bound general direction."@en ] ;
    ea:value [ ea:name "southWestBound"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "South west bound general direction."@en ] ;
    ea:value [ ea:name "westBound"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "West bound general direction."@en ] ;
    ea:value [ ea:name "inboundTowardsTown"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Heading towards town centre direction of travel."@en ] ;
    ea:value [ ea:name "outboundFromTown"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Heading out of or away from the town centre direction of travel."@en ] ;
    ea:value [ ea:name "opposite"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Opposite direction to the normal direction of flow at this point on the road network."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Direction is unknown."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:LocationReferencing.DirectionPurposeEnum
    a owl:Class ;
    rdfs:label "DirectionPurposeEnum"@en ;
    skos:definition "Main purpose of a direction of a road"@en ;
    skos:prefLabel "direction purpose enum"@en ;
    skos:altLabel "directionpurposeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "inbound"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the carriageway or lane which is inbound towards the centre of the town or city."@en ] ;
    ea:value [ ea:name "outbound"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the carriageway or lane which is outbound from the centre of the town or city."@en ] .

datex:LocationReferencing.DistanceAlongLinearElement
    a owl:Class ;
    rdfs:label "DistanceAlongLinearElement"@en ;
    skos:definition "Distance of a point along a linear element either measured from the start node or a defined referent on that linear element, where the start node is relative to the element definition rather than the direction of traffic flow."@en ;
    skos:prefLabel "distance along linear element"@en ;
    skos:altLabel "distancealonglinearelement"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/LinearReferencing/PointAlongLinearElement"@en ;
    ea:kind "class" .

datex:LocationReferencing.DistanceFromLinearElementReferent
    a owl:Class ;
    rdfs:label "DistanceFromLinearElementReferent"@en ;
    skos:definition "Distance of a point along a linear element measured from a \"from referent\" on the linear element, in the sense relative to the linear element definition rather than the direction of traffic flow or optionally towards a \"towards referent\"."@en ;
    skos:prefLabel "distance from linear element referent"@en ;
    skos:altLabel "distancefromlinearelementreferent"@en ;
    rdfs:subClassOf datex:LocationReferencing.DistanceAlongLinearElement ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/LinearReferencing/PointAlongLinearElement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "distanceAlong"@en ; ea:position 1 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A measure of distance along a linear element."@en ] .

datex:LocationReferencing.DistanceFromLinearElementReferent.fromReferent
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.DistanceFromLinearElementReferent ;
    rdfs:range datex:LocationReferencing.Referent ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:LocationReferencing.DistanceFromLinearElementReferent.towardsReferent
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.DistanceFromLinearElementReferent ;
    rdfs:range datex:LocationReferencing.Referent ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:LocationReferencing.DistanceFromLinearElementStart
    a owl:Class ;
    rdfs:label "DistanceFromLinearElementStart"@en ;
    skos:definition "Distance of a point along a linear element measured from the start node of the linear element, where start node is relative to the element definition rather than the direction of traffic flow."@en ;
    skos:prefLabel "distance from linear element start"@en ;
    skos:altLabel "distancefromlinearelementstart"@en ;
    rdfs:subClassOf datex:LocationReferencing.DistanceAlongLinearElement ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/LinearReferencing/PointAlongLinearElement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "distanceAlong"@en ; ea:position 1 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A measure of distance along a linear element."@en ] .

datex:LocationReferencing.ExternalReferencing
    a owl:Class ;
    rdfs:label "ExternalReferencing"@en ;
    skos:definition "A location defined by reference to an external/other referencing system."@en ;
    skos:prefLabel "external referencing"@en ;
    skos:altLabel "externalreferencing"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "externalReferencingSystem"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identification of the external/other location referencing system."@en ] ;
    ea:attribute [ ea:name "externalLocationCode"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A code in the external referencing system which defines the location."@en ] .

datex:LocationReferencing.GeographicCharacteristicEnum
    a owl:Class ;
    rdfs:label "GeographicCharacteristicEnum"@en ;
    skos:definition "Descriptor to help to identify a specific location."@en ;
    skos:prefLabel "geographic characteristic enum"@en ;
    skos:altLabel "geographiccharacteristicenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "aroundABendInRoad"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Around a bend in the road."@en ] ;
    ea:value [ ea:name "onBorder"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On border crossing."@en ] ;
    ea:value [ ea:name "onPass"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On mountain pass."@en ] ;
    ea:value [ ea:name "overCrestOfHill"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Over the crest of a hill."@en ] .

datex:LocationReferencing.GmlLineString
    a owl:Class ;
    rdfs:label "GmlLineString"@en ;
    skos:definition "Line string based on GML (EN ISO 19136) definition: a curve defined by a series of two or more coordinate tuples. Unlike GML may be self-intersecting. If srsName attribute is not present, posList is assumed to use \"ETRS89-LatLonh\" reference system."@en ;
    skos:prefLabel "gml line string"@en ;
    skos:altLabel "gmllinestring"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/Gml"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "srsDimension"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Provides the size of the tuple of coordinates of each point. This number is 2 or 3. By default when omitted the dimension shall be interpreted as 2."@en ] ;
    ea:attribute [ ea:name "srsName"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specifies the Coordinate Reference System (CRS) used to interpret the coordinates in this GmlLineString"@en ] ;
    ea:attribute [ ea:name "posList"@en ; ea:position 3 ; ea:type datex:LocationReferencing.GmlPosList ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "List of coordinate tuples define the geometry of this GmlLineString. There must be at least 2 tuples of coordinates. Form depends on coordinate reference system; typical form is space-separated pairs of latitude and longitude."@en ] .

datex:LocationReferencing.GmlLinearRing
    a owl:Class ;
    rdfs:label "GmlLinearRing"@en ;
    skos:definition "Closed line string not self-intersecting (i.e. having as last point the first point)"@en ;
    skos:prefLabel "gml linear ring"@en ;
    skos:altLabel "gmllinearring"@en ;
    rdfs:subClassOf datex:LocationReferencing.GmlLineString ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/Gml"@en ;
    ea:kind "class" .

datex:LocationReferencing.GmlMultiPolygon
    a owl:Class ;
    rdfs:label "GmlMultiPolygon"@en ;
    skos:definition "An area defined by a set of polygons acording to GML (EN ISO 19136)."@en ;
    skos:prefLabel "gml multi polygon"@en ;
    skos:altLabel "gmlmultipolygon"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/Gml"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "gmlAreaName"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of the multi-polygon area"@en ] .

datex:LocationReferencing.GmlMultiPolygon.GmlPolygon
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.GmlMultiPolygon ;
    rdfs:range datex:LocationReferencing.GmlPolygon ;
    ea:lowerBound "1" ;
    ea:upperBound "*" .

datex:LocationReferencing.GmlPolygon
    a owl:Class ;
    rdfs:label "GmlPolygon"@en ;
    skos:definition "Planar surface defined by 1 exterior boundary and 0 or more interior boundaries"@en ;
    skos:prefLabel "gml polygon"@en ;
    skos:altLabel "gmlpolygon"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/Gml"@en ;
    ea:kind "class" .

datex:LocationReferencing.GmlPolygon.exterior
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.GmlPolygon ;
    rdfs:range datex:LocationReferencing.GmlLinearRing ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:LocationReferencing.GmlPolygon.interior
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.GmlPolygon ;
    rdfs:range datex:LocationReferencing.GmlLinearRing ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:LocationReferencing.GmlPosList
    a owl:Class ;
    rdfs:label "GmlPosList"@en ;
    skos:definition "List of coordinates, space-separated, within the same coordinate reference system, defining a geometric entity. Modelled on DirectPositionListType in GML (EN ISO 19136), but constrained to represent a 2D or 3D polyline."@en ;
    skos:prefLabel "gml pos list"@en ;
    skos:altLabel "gmlposlist"@en ;
    rdfs:subClassOf datex:Common.LongString ;
    rdfs:comment "DATEX II data type in namespace LocationReferencing / DataTypes"@en ;
    ea:kind "data type" .

datex:LocationReferencing.HeightCoordinate
    a owl:Class ;
    rdfs:label "HeightCoordinate"@en ;
    skos:definition "Third coordinate for points defined geodetically"@en ;
    skos:prefLabel "height coordinate"@en ;
    skos:altLabel "heightcoordinate"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/PointCoordinates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "heightValue"@en ; ea:position 1 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Value in metres for the height measured vertically at to the planar coordinates the point corresponding."@en ] ;
    ea:attribute [ ea:name "heightType"@en ; ea:position 2 ; ea:type datex:LocationReferencing.HeightTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of measured height.When it is omitted it is supposed to be the ellipsoidal height."@en ] .

datex:LocationReferencing.HeightCoordinate.AltitudeConfidence
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.HeightCoordinate ;
    rdfs:range datex:LocationReferencing.AltitudeConfidence ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:LocationReferencing.HeightCoordinate.verticalPositionAccuracy
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.HeightCoordinate ;
    rdfs:range datex:LocationReferencing.PositionAccuracy ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:LocationReferencing.HeightGradeEnum
    a owl:Class ;
    rdfs:label "HeightGradeEnum"@en ;
    skos:definition "List of height or vertical gradings of road sections."@en ;
    skos:prefLabel "height grade enum"@en ;
    skos:altLabel "heightgradeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "aboveGrade"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Above or over the normal road grade elevation."@en ] ;
    ea:value [ ea:name "atGrade"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At the normal road grade elevation."@en ] ;
    ea:value [ ea:name "belowGrade"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Below or under the normal road grade elevation."@en ] .

datex:LocationReferencing.HeightTypeEnum
    a owl:Class ;
    rdfs:label "HeightTypeEnum"@en ;
    skos:definition "Coded value for type of height"@en ;
    skos:prefLabel "height type enum"@en ;
    skos:altLabel "heighttypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "ellipsoidalHeight"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Value measured vertically above the reference ellipsoid"@en ] ;
    ea:value [ ea:name "gravityRelatedHeight"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Height type corresponding a value measured along direction of gravity above the reference geoid i.e. equipotential surface of the Earth's gravity field which globally approximates mean sea level."@en ] ;
    ea:value [ ea:name "relativeHeight"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Height type corresponding to value masured vertically above the ground level at this point."@en ] .

datex:LocationReferencing.InfrastructureDescriptorEnum
    a owl:Class ;
    rdfs:label "InfrastructureDescriptorEnum"@en ;
    skos:definition "Descriptor identifying infrastructure to help to identify a specific location."@en ;
    skos:prefLabel "infrastructure descriptor enum"@en ;
    skos:altLabel "infrastructuredescriptorenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "atMotorwayInterchange"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At a motorway interchange."@en ] ;
    ea:value [ ea:name "atRestArea"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At rest area off the carriageway."@en ] ;
    ea:value [ ea:name "atServiceArea"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At service area."@en ] ;
    ea:value [ ea:name "atTollPlaza"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At toll plaza."@en ] ;
    ea:value [ ea:name "atTunnelEntryOrExit"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At entry or exit of tunnel."@en ] ;
    ea:value [ ea:name "inGallery"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In gallery."@en ] ;
    ea:value [ ea:name "inTunnel"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In tunnel."@en ] ;
    ea:value [ ea:name "onBridge"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On bridge."@en ] ;
    ea:value [ ea:name "onConnector"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On connecting carriageway between two different roads or road sections."@en ] ;
    ea:value [ ea:name "onElevatedSection"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On elevated section of road."@en ] ;
    ea:value [ ea:name "onFlyover"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On flyover, i.e. on section of road over another road."@en ] ;
    ea:value [ ea:name "onIceRoad"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On ice road."@en ] ;
    ea:value [ ea:name "onLevelCrossing"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On level-crossing."@en ] ;
    ea:value [ ea:name "onLinkRoad"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On road section linking two different roads."@en ] ;
    ea:value [ ea:name "onRoundabout"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On roundabout."@en ] ;
    ea:value [ ea:name "onTheRoadway"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the roadway."@en ] ;
    ea:value [ ea:name "onUndergroundSection"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On underground section of road."@en ] ;
    ea:value [ ea:name "onUnderpass"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On underpass, i.e. section of road which passes under another road."@en ] ;
    ea:value [ ea:name "withinJunction"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the main carriageway within a junction between exit slip road and entry slip road."@en ] .

datex:LocationReferencing.IsoNamedArea
    a owl:Class ;
    rdfs:label "IsoNamedArea"@en ;
    skos:definition "The ISO 3166-2 representation for the named area."@en ;
    skos:prefLabel "iso named area"@en ;
    skos:altLabel "isonamedarea"@en ;
    rdfs:subClassOf datex:LocationReferencing.NamedArea ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/NamedArea"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "subdivisionType"@en ; ea:position 1 ; ea:type datex:LocationReferencing.SubdivisionTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The ISO 3166-2 subdivison type for the named area."@en ] ;
    ea:attribute [ ea:name "subdivisionCode"@en ; ea:position 2 ; ea:type datex:LocationReferencing.SubdivisionCode ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The second part of an ISO 3166-2 subdivision code for the named area, which can be used along with the country attribute from the parent class to make a full ISO 3166-2 subdivision code."@en ] .

datex:LocationReferencing.Itinerary
    a owl:Class ;
    rdfs:label "Itinerary"@en ;
    skos:definition "Multiple (i.e. more than one) physically separate locations arranged as an ordered set that defines an itinerary or route."@en ;
    skos:prefLabel "itinerary"@en ;
    rdfs:subClassOf datex:LocationReferencing.LocationReference ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" .

datex:LocationReferencing.Itinerary.routeDestination
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.Itinerary ;
    rdfs:range datex:LocationReferencing.Destination ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:LocationReferencing.ItineraryByIndexedLocations
    a owl:Class ;
    rdfs:label "ItineraryByIndexedLocations"@en ;
    skos:definition "Multiple physically separate locations arranged as an ordered set that defines an itinerary or route. The index qualifier indicates the order."@en ;
    skos:prefLabel "itinerary by indexed locations"@en ;
    skos:altLabel "itinerarybyindexedlocations"@en ;
    rdfs:subClassOf datex:LocationReferencing.Itinerary ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" .

datex:LocationReferencing.ItineraryByIndexedLocations.locationContainedInItinerary
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.ItineraryByIndexedLocations ;
    rdfs:range datex:LocationReferencing.Location ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:LocationReferencing.ItineraryByReference
    a owl:Class ;
    rdfs:label "ItineraryByReference"@en ;
    skos:definition "Multiple (i.e. more than one) physically separate locations which are ordered that constitute an itinerary or route where they are defined by reference to a predefined itinerary."@en ;
    skos:prefLabel "itinerary by reference"@en ;
    skos:altLabel "itinerarybyreference"@en ;
    rdfs:subClassOf datex:LocationReferencing.Itinerary ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "predefinedItineraryReference"@en ; ea:position 1 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A reference to a versioned instance of a predefined itinerary as specified in a PredefinedLocationsPublication."@en ] .

datex:LocationReferencing.Lane
    a owl:Class ;
    rdfs:label "Lane"@en ;
    skos:definition "Indicates a specific lane or group of lanes."@en ;
    skos:prefLabel "lane"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/SupplementaryPositionalDescription"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "laneNumber"@en ; ea:position 1 ; ea:type datex:Common.Integer ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of the lane, where 1 is nearest the hard shoulder/verge and the numbers increase towards the central reservation/road centreline including the lane on the centreline in case of an odd number of lanes for a single carriageway road."@en ] ;
    ea:attribute [ ea:name "laneUsage"@en ; ea:position 2 ; ea:type datex:LocationReferencing.LaneEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates the specific lane to which the location relates."@en ] .

datex:LocationReferencing.LaneEnum
    a owl:Class ;
    rdfs:label "LaneEnum"@en ;
    skos:definition "List of descriptors identifying specific lanes."@en ;
    skos:prefLabel "lane enum"@en ;
    skos:altLabel "laneenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "allLanesCompleteCarriageway"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In all lanes of the carriageway."@en ] ;
    ea:value [ ea:name "busLane"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the bus lane."@en ] ;
    ea:value [ ea:name "busStop"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the bus stop lane."@en ] ;
    ea:value [ ea:name "carPoolLane"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the carpool lane."@en ] ;
    ea:value [ ea:name "centralReservation"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the central reservation separating the two directional carriageways of the highway."@en ] ;
    ea:value [ ea:name "crawlerLane"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the crawler lane - a lane that should be used by slower vehicles."@en ] ;
    ea:value [ ea:name "cycleLane"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Part of a carriageway designated for cycles. A cycle lane is distinguished from the rest of the carriageway by longitudinal road markings."@en ] ;
    ea:value [ ea:name "emergencyLane"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the emergency lane."@en ] ;
    ea:value [ ea:name "escapeLane"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the escape lane."@en ] ;
    ea:value [ ea:name "expressLane"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the express lane."@en ] ;
    ea:value [ ea:name "hardShoulder"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the hard shoulder."@en ] ;
    ea:value [ ea:name "heavyVehicleLane"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the heavy vehicle lane."@en ] ;
    ea:value [ ea:name "layBy"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In a lay-by."@en ] ;
    ea:value [ ea:name "leftHandTurningLane"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the left hand turning lane."@en ] ;
    ea:value [ ea:name "leftLane"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the left lane."@en ] ;
    ea:value [ ea:name "localTrafficLane"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the local traffic lane."@en ] ;
    ea:value [ ea:name "middleLane"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the middle lane."@en ] ;
    ea:value [ ea:name "overtakingLane"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the overtaking lane."@en ] ;
    ea:value [ ea:name "rightHandTurningLane"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the right hand turning lane."@en ] ;
    ea:value [ ea:name "rightLane"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the right lane."@en ] ;
    ea:value [ ea:name "rushHourLane"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the lane dedicated for use during the rush (peak) hour."@en ] ;
    ea:value [ ea:name "setDownArea"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the area/lane reserved for passenger pick-up or set-down."@en ] ;
    ea:value [ ea:name "slowVehicleLane"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In a lane dedicated to vehicles that are not permitted to exceed a fixed slow speed."@en ] ;
    ea:value [ ea:name "throughTrafficLane"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the through traffic lane."@en ] ;
    ea:value [ ea:name "tidalFlowLane"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the lane dedicated for use as a tidal flow lane."@en ] ;
    ea:value [ ea:name "turningLane"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the turning lane."@en ] ;
    ea:value [ ea:name "verge"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the verge."@en ] .

datex:LocationReferencing.LinearDirectionEnum
    a owl:Class ;
    rdfs:label "LinearDirectionEnum"@en ;
    skos:definition "Directions of traffic flow relative to the direction in which the linear element is defined."@en ;
    skos:prefLabel "linear direction enum"@en ;
    skos:altLabel "lineardirectionenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "both"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates that both directions of traffic flow are affected by the situation or relate to the traffic data."@en ] ;
    ea:value [ ea:name "opposite"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates that the direction of traffic flow affected by the situation or related to the traffic data is in the opposite sense to the direction in which the linear element is defined."@en ] ;
    ea:value [ ea:name "aligned"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates that the direction of traffic flow affected by the situation or related to the traffic data is in the same sense as the direction in which the linear element is defined."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates that the direction of traffic flow affected by the situation or related to the traffic data is unknown."@en ] .

datex:LocationReferencing.LinearElement
    a owl:Class ;
    rdfs:label "LinearElement"@en ;
    skos:definition "A linear element along a single linear object, consistent with EN ISO 19148 definitions."@en ;
    skos:prefLabel "linear element"@en ;
    skos:altLabel "linearelement"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/LinearReferencing/PointAlongLinearElement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "roadName"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of the road"@en ] ;
    ea:attribute [ ea:name "roadNumber"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identifier/number of the road"@en ] ;
    ea:attribute [ ea:name "linearElementReferenceModel"@en ; ea:position 3 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The identifier of a road network reference model which segments the road network according to specific business rules."@en ] ;
    ea:attribute [ ea:name "linearElementReferenceModelVersion"@en ; ea:position 4 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The version of the identified road network reference model."@en ] ;
    ea:attribute [ ea:name "linearElementNature"@en ; ea:position 5 ; ea:type datex:LocationReferencing.LinearElementNatureEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An indication of the nature of the linear element."@en ] .

datex:LocationReferencing.LinearElementByCode
    a owl:Class ;
    rdfs:label "LinearElementByCode"@en ;
    skos:definition "A linear element along a single linear object defined by its identifier or code in a road network reference model (specified in LinearElement class) which segments the road network according to specific business rules."@en ;
    skos:prefLabel "linear element by code"@en ;
    skos:altLabel "linearelementbycode"@en ;
    rdfs:subClassOf datex:LocationReferencing.LinearElement ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/LinearReferencing/PointAlongLinearElement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "linearElementIdentifier"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An identifier or code of a linear element (or link) in the road network reference model that is specified in the LinearElement class."@en ] .

datex:LocationReferencing.LinearElementByLineString
    a owl:Class ;
