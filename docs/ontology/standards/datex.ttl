    ea:attribute [ ea:name "yearOfLastRegistration"@en ; ea:position 3 ; ea:type datex:Common.Year ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The year in which the car was last registered on the current owner."@en ] .

