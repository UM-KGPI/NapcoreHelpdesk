datex:Vms.VmsControllerFault
    a owl:Class ;
    rdfs:label "VmsControllerFault"@en ;
    skos:definition "Details of the fault which is being reported for the specified variable message sign control unit."@en ;
    skos:prefLabel "vms controller fault"@en ;
    skos:altLabel "vmscontrollerfault"@en ;
    rdfs:subClassOf datex:Common.Fault ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsFault"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "vmsControllerFault"@en ; ea:position 1 ; ea:type datex:Vms.VmsControllerFaultEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of fault which is being reported for the VMS unit."@en ] .

datex:Vms.VmsControllerFaultEnum
    a owl:Class ;
    rdfs:label "VmsControllerFaultEnum"@en ;
    skos:definition "Types of variable message sign controller faults."@en ;
    skos:prefLabel "vms controller fault enum"@en ;
    skos:altLabel "vmscontrollerfaultenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "communicationsFailure"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Communications failure affecting VMS controller"@en ] ;
    ea:value [ ea:name "powerFailure"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Power to VMS controller has failed."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "unknown"@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "unknown"@en ] .

datex:Vms.VmsControllerStatus
    a owl:Class ;
    rdfs:label "VmsControllerStatus"@en ;
    skos:definition "Status of a VMS controller unit"@en ;
    skos:prefLabel "vms controller status"@en ;
    skos:altLabel "vmscontrollerstatus"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsStatus"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "statusUpdateTime"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time at which this VMS controller unit status was updated"@en ] ;
    ea:attribute [ ea:name "vmsControllerTableReference"@en ; ea:position 2 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A reference to a versioned VMS controller unit table."@en ] ;
    ea:attribute [ ea:name "vmsControllerReference"@en ; ea:position 3 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A reference to a versioned VMS controller record in a VMS controller table which defines the characteristics of the VMS controller unit."@en ] .

