    rdfs:comment "DATEX II data type in namespace LocationReferencing / DataTypes"@en ;
    ea:kind "data type" .

datex:LocationReferencing.NutsCodeTypeEnum
    a owl:Class ;
    rdfs:label "NutsCodeTypeEnum"@en ;
    skos:definition "Types of NUTS codes (Nomenclature of territorial units for statistics) including LAU codes (Local Administrative Units)."@en ;
    skos:prefLabel "nuts code type enum"@en ;
    skos:altLabel "nutscodetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "nuts1Code"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "NUTS 1 code"@en ] ;
    ea:value [ ea:name "nuts2Code"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "NUTS 2 code"@en ] ;
    ea:value [ ea:name "nuts3Code"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "NUTS 3 code"@en ] ;
    ea:value [ ea:name "lau1Code"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "LAU 1 code"@en ] ;
    ea:value [ ea:name "lau2Code"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "LAU 2 code"@en ] .

datex:LocationReferencing.NutsNamedArea
    a owl:Class ;
    rdfs:label "NutsNamedArea"@en ;
    skos:definition "The NUTS-Code representation for the named area (Nomenclature of territorial units for statistics) or its LAU code representation (Local Administrative Unit)."@en ;
    skos:prefLabel "nuts named area"@en ;
    skos:altLabel "nutsnamedarea"@en ;
    rdfs:subClassOf datex:LocationReferencing.NamedArea ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/NamedArea"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "nutsCodeType"@en ; ea:position 1 ; ea:type datex:LocationReferencing.NutsCodeTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The NUTS code type for the named area."@en ] ;
    ea:attribute [ ea:name "nutsCode"@en ; ea:position 2 ; ea:type datex:LocationReferencing.NutsCode ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The NUTS code for the named area."@en ] .

datex:LocationReferencing.OffsetDistance
    a owl:Class ;
    rdfs:label "OffsetDistance"@en ;
    skos:definition "The non-negative offset distance from the ALERT-C referenced point to the actual point."@en ;
    skos:prefLabel "offset distance"@en ;
    skos:altLabel "offsetdistance"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "offsetDistance"@en ; ea:position 1 ; ea:type datex:Common.MetresAsNonNegativeInteger ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The non-negative offset distance from the ALERT-C referenced point to the actual point. The ALERT-C locations in the primary and secondary locations must always encompass the linear section being specified, thus offset distance is towards the other point."@en ] .

datex:LocationReferencing.OpenlrAreaLocationReference
    a owl:Class ;
    rdfs:label "OpenlrAreaLocationReference"@en ;
    skos:definition "A two-dimensional part of the surface of the earth which is bounded by a closed curve. An area location may cover parts of the road network but does not necessarily need to. It is represented according to the OpenLR standard for Area Locations"@en ;
    skos:prefLabel "openlr area location reference"@en ;
    skos:altLabel "openlrarealocationreference"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/OpenLR/OpenlrArea"@en ;
    ea:kind "class" .

datex:LocationReferencing.OpenlrBasePointLocation
    a owl:Class ;
    rdfs:label "OpenlrBasePointLocation"@en ;
    skos:definition "Holds common data that are used both in OpenlrPointAccessPoint and OpenlrPointAlongLine."@en ;
    skos:prefLabel "openlr base point location"@en ;
    skos:altLabel "openlrbasepointlocation"@en ;
    rdfs:subClassOf datex:LocationReferencing.OpenlrPointLocationReference ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/OpenLR/OpenlrPoint"@en ;
