    ea:attribute [ ea:name "type"@en ; ea:position 12 ; ea:type datex:Facilities.OrganisationTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Information whether the organisation in question belongs to the public or private sector."@en ] ;
    ea:attribute [ ea:name "nationalOrganisationNumber"@en ; ea:position 13 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The national organisation number in the specified national register, if applicable."@en ] ;
