    ea:value [ ea:name "inNonVehicularUnderpass"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In an underpass open to several modes of travel, but not vehicles."@en ] ;
    ea:value [ ea:name "inPedestrianUnderpass"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In an underpass specifically used by pedestrians."@en ] ;
    ea:value [ ea:name "onBicycleBridge"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On a bridge specifically used by bicycles."@en ] ;
    ea:value [ ea:name "onBicycleCrossing"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On crossing specifically used by bicycles."@en ] ;
    ea:value [ ea:name "onFootBridge"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On a bridge specifically used by pedestrians."@en ] ;
    ea:value [ ea:name "onGuidedBusWayCrossing"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On crossing with a physically separated guided bus way."@en ] ;
    ea:value [ ea:name "onHorseCrossing"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On crossing with a bridle path."@en ] ;
    ea:value [ ea:name "onLightRailCrossing"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On crossing with light rail tracks."@en ] ;
    ea:value [ ea:name "onMixedUseCrossing"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On crossing of multimodal usage."@en ] ;
    ea:value [ ea:name "onNonVehicularBridge"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On a bridge open to several modes of travel, but not vehicles."@en ] ;
    ea:value [ ea:name "onPedestrianCrossing"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On crossing specifically used by pedestrians."@en ] ;
    ea:value [ ea:name "onTramCrossing"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On crossing with tram tracks (includes both: vehicles that run on rails and rubber-tired trams)."@en ] .

datex:UrbanExtensions.LaneEnumExtendedUrban
