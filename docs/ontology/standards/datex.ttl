    ea:value [ ea:name "octane98"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "petrol with 98 octanes"@en ] ;
    ea:value [ ea:name "leaded"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "leaded petrol"@en ] ;
    ea:value [ ea:name "unleaded"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unleaded petrol"@en ] ;
    ea:value [ ea:name "superE5"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Super E5 petrol"@en ] ;
    ea:value [ ea:name "superE10"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Super E10 petrol"@en ] ;
