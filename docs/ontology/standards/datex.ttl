datex:Vms.VmsFault
    a owl:Class ;
    rdfs:label "VmsFault"@en ;
    skos:definition "Details of the fault which is being reported for the specified variable message sign panel."@en ;
    skos:prefLabel "vms fault"@en ;
    skos:altLabel "vmsfault"@en ;
    rdfs:subClassOf datex:Common.Fault ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsFault"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "vmsFault"@en ; ea:position 1 ; ea:type datex:Vms.VmsFaultEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of fault which is being reported for the specified variable message sign panel."@en ] .

datex:Vms.VmsFaultEnum
    a owl:Class ;
    rdfs:label "VmsFaultEnum"@en ;
    skos:definition "Types of variable message sign faults."@en ;
    skos:prefLabel "vms fault enum"@en ;
    skos:altLabel "vmsfaultenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "incorrectMessageDisplayed"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Incorrect message is being displayed."@en ] ;
    ea:value [ ea:name "incorrectPictogramDisplayed"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Incorrect pictogram is being displayed."@en ] ;
    ea:value [ ea:name "outOfService"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Not currently in service (e.g. intentionally disconnected or switched off during roadworks)."@en ] ;
    ea:value [ ea:name "unableToClearDown"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unable to clear down information displayed on VMS."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unknown VMS fault."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Vms.VmsMessage
    a owl:Class ;
    rdfs:label "VmsMessage"@en ;
    skos:definition "A message displayed on a VMS which can comprise one or more sequentially displayed text pages and/or pictograms with supplementary details."@en ;
    skos:prefLabel "vms message"@en ;
    skos:altLabel "vmsmessage"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "associatedTrafficManagementPlan"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The identification of the traffic management plan or diversion plan with which the message is associated."@en ] ;
    ea:attribute [ ea:name "messageSetBy"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The organisation or authority which set the message currently being displayed."@en ] ;
    ea:attribute [ ea:name "setBySystem"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates whether the message has been set automatically by a system. True = automatically set."@en ] ;
    ea:attribute [ ea:name "reasonForSetting"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The reason why the sign has been set."@en ] ;
    ea:attribute [ ea:name "codedReasonForSetting"@en ; ea:position 5 ; ea:type datex:Vms.SettingReasonEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The reason, in terms of a high-level coded classification, why the sign has been set."@en ] ;
    ea:attribute [ ea:name "messageInformationType"@en ; ea:position 6 ; ea:type datex:Vms.MessageInformationTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Type of information being displayed."@en ] ;
    ea:attribute [ ea:name "primarySetting"@en ; ea:position 7 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identifies whether the message setting is primary (explicitly requested) or is secondary (derived according to an algorithm as the result of setting other signs). True = a primary setting."@en ] ;
    ea:attribute [ ea:name "mareNostrumCompliant"@en ; ea:position 8 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication that the displayed message (text and pictogram) conforms with the formulation recommended by the Mare Nostrum project."@en ] ;
    ea:attribute [ ea:name "timeLastSet"@en ; ea:position 9 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The date/time at which the sign was last set."@en ] ;
    ea:attribute [ ea:name "requestedBy"@en ; ea:position 10 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The authority, organisation or system which requested the setting of the message. This may be different from the authority or system which actually set the message on behalf of the requestor."@en ] ;
    ea:attribute [ ea:name "relatedSituation"@en ; ea:position 11 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "A reference to the managed situation to which the set message relates."@en ] ;
    ea:attribute [ ea:name "relatedSituationRecord"@en ; ea:position 12 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "A reference to the situation record within a managed situation to which the set message relates."@en ] ;
    ea:attribute [ ea:name "distanceFromClosestSituationRecord"@en ; ea:position 13 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Distance of the VMS from the location of the closest situation record. If the VMS is located within the extent of the situation record this should be set to zero."@en ] ;
    ea:attribute [ ea:name "sequencingInterval"@en ; ea:position 14 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The time duration that each text page or pictogram within a message is displayed for before the VMS displays the next text page and/or pictogram in the message."@en ] .

datex:Vms.VmsMessage.DisplayAreaSettings
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.VmsMessage ;
    rdfs:range datex:Vms.DisplayAreaSettings ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:Vms.VmsMessage.Image
    a owl:ObjectProperty ;
