datex:AfirFacilities.RateAvailabilityTypeEnum
    a owl:Class ;
    rdfs:label "RateAvailabilityTypeEnum"@en ;
    skos:definition "A list of rate availability types."@en ;
    skos:prefLabel "rate availability type enum"@en ;
    skos:altLabel "rateavailabilitytypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirFacilities / RatesPublication/Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "private"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Where parking access limited to known and authorized individuals."@en ] ;
    ea:value [ ea:name "public"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Open to the public."@en ] ;
    ea:value [ ea:name "restricted"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Open to the public but need a direct purpose or permission to use from the owner (e.g. doctor's surgery, storefront)."@en ] .

datex:AfirFacilities.RateDiscount
    a owl:Class ;
    rdfs:label "RateDiscount"@en ;
    skos:definition "Class defining discount rates to be applied to a RateTable."@en ;
    skos:prefLabel "rate discount"@en ;
    skos:altLabel "ratediscount"@en ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / RatesPublication/Right"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "discountRate"@en ; ea:position 1 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Proportionate discount (-) or surcharge (+) to be applied to all values in the referenced RateTable."@en ] .

datex:AfirFacilities.RateDiscount.fixedValue
    a owl:ObjectProperty ;
    rdfs:domain datex:AfirFacilities.RateDiscount ;
