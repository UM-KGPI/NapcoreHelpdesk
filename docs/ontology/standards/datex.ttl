datex:LocationReferencing.PointCoordinates
    a owl:Class ;
    rdfs:label "PointCoordinates"@en ;
    skos:definition "A pair of planar coordinates defining the geodetic position of a single point using the European Terrestrial Reference System 1989 (ETRS89)."@en ;
    skos:prefLabel "point coordinates"@en ;
    skos:altLabel "pointcoordinates"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/PointCoordinates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "latitude"@en ; ea:position 1 ; ea:type datex:Common.Float ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Latitude in decimal degrees using the European Terrestrial Reference System 1989 (ETRS89)."@en ] ;
    ea:attribute [ ea:name "longitude"@en ; ea:position 2 ; ea:type datex:Common.Float ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Longitude in decimal degrees using the European Terrestrial Reference System 1989 (ETRS89)."@en ] .

datex:LocationReferencing.PointCoordinates.HeightCoordinate
    a owl:ObjectProperty ;
