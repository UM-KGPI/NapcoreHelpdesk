datex:Situation.RoadOrCarriagewayOrLaneManagementTypeEnum
    a owl:Class ;
    rdfs:label "RoadOrCarriagewayOrLaneManagementTypeEnum"@en ;
    skos:definition "Management actions relating to road, carriageway or lane usage."@en ;
    skos:prefLabel "road or carriageway or lane management type enum"@en ;
    skos:altLabel "roadorcarriagewayorlanemanagementtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "carPoolLaneInOperation"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dedicated car pool lane(s) are in operation for vehicles carrying at least the specified number of occupants."@en ] ;
    ea:value [ ea:name "carriagewayClosures"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Carriageway closures are in operation at the specified location."@en ] ;
    ea:value [ ea:name "clearALaneForEmergencyVehicles"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Clear a lane for emergency vehicles."@en ] ;
    ea:value [ ea:name "clearALaneForSnowploughsAndGrittingVehicles"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Clear a lane for snow ploughs and gritting vehicles."@en ] ;
    ea:value [ ea:name "closedPermanentlyForTheWinter"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road is closed to vehicles with the specified characteristics or all, if none defined, for the duration of the winter."@en ] ;
    ea:value [ ea:name "contraflow"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Two-way traffic is temporarily sharing a single carriageway."@en ] ;
    ea:value [ ea:name "doNotUseSpecifiedLanesOrCarriageways"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Do not use the specified lane(s) or carriageway(s)."@en ] ;
    ea:value [ ea:name "hardShoulderRunningInOperation"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The hard shoulder is open as an operational lane."@en ] ;
    ea:value [ ea:name "hardShoulderRunningNotInOperation"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "the hardshoulder used for dynamic hardshoulder management is closed to vehicles i.e. not running"@en ] ;
    ea:value [ ea:name "heightRestrictionInOperation"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A height restriction is in operation."@en ] ;
    ea:value [ ea:name "intermittentShortTermClosures"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Road closures occur intermittently on the specified road in the specified direction for short durations."@en ] ;
    ea:value [ ea:name "keepToTheLeft"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Keep to the left."@en ] ;
    ea:value [ ea:name "keepToTheRight"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Keep to the right."@en ] ;
    ea:value [ ea:name "laneClosures"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lane closures are in operation at the specified location for vehicles with the specified characteristics or all, if none defined, in the specified direction."@en ] ;
    ea:value [ ea:name "lanesDeviated"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lane deviations are in operation at the specified location."@en ] ;
    ea:value [ ea:name "narrowLanes"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Normal lane widths are temporarily reduced."@en ] ;
    ea:value [ ea:name "newRoadworksLayout"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A new layout of lanes/carriageway has been implemented associated with roadworks."@en ] ;
    ea:value [ ea:name "overnightClosures"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Every night the road is closed to vehicles with the specified characteristics or all, if none defined, in the specified direction by decision of the appropriate authorities."@en ] ;
    ea:value [ ea:name "roadCleared"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road has been cleared of earlier reported problems."@en ] ;
    ea:value [ ea:name "roadClosed"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road is closed to vehicles with the specified characteristics or all, if none defined, in the specified direction."@en ] ;
    ea:value [ ea:name "rollingRoadBlock"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic officers or police are driving slowly in front of a queue of traffic to create a gap in the traffic to allow for clearance activities to take place in safety on the road ahead."@en ] ;
    ea:value [ ea:name "rushHourLaneInOperation"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dedicated rush (peak) hour lane(s) are in operation."@en ] ;
    ea:value [ ea:name "singleAlternateLineTraffic"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic is being controlled to move in alternate single lines. This control may be undertaken by traffic lights or flagman."@en ] ;
    ea:value [ ea:name "tidalFlowLaneInOperation"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dedicated tidal flow lane(s) are in operation in the specified direction."@en ] ;
    ea:value [ ea:name "turnAroundInOperation"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic is being directed back down the opposite carriageway, possibly requiring the temporary removal of the central crash barrier."@en ] ;
    ea:value [ ea:name "useOfSpecifiedLanesOrCarriagewaysAllowed"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified lane(s) or carriageway(s) may be used. The normal lane(s) or carriageway(s) restrictions are not currently in force."@en ] ;
    ea:value [ ea:name "useSpecifiedLanesOrCarriageways"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Use the specified lane(s) or carriageway(s)."@en ] ;
    ea:value [ ea:name "vehicleStorageInOperation"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles are being stored on the roadway and/or at a rest area or service area at the specified location."@en ] ;
    ea:value [ ea:name "weightRestrictionInOperation"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A weight restriction is in operation."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 30 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.RoadSurfaceConditions
    a owl:Class ;
    rdfs:label "RoadSurfaceConditions"@en ;
    skos:definition "Conditions of the road surface which may affect driving conditions. These may be related to the weather (e.g. ice, snow etc.) or to other conditions (e.g. oil, mud, leaves etc. on the road)"@en ;
    skos:prefLabel "road surface conditions"@en ;
    skos:altLabel "roadsurfaceconditions"@en ;
    rdfs:subClassOf datex:Situation.Conditions ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement/Conditions"@en ;
    ea:kind "class" .

datex:Situation.RoadsideAssistance
    a owl:Class ;
    rdfs:label "RoadsideAssistance"@en ;
    skos:definition "Details of road side assistance required or being given."@en ;
    skos:prefLabel "roadside assistance"@en ;
    skos:altLabel "roadsideassistance"@en ;
    rdfs:subClassOf datex:Situation.OperatorAction ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/OperatorAction"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "roadsideAssistanceType"@en ; ea:position 1 ; ea:type datex:Situation.RoadsideAssistanceTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the nature of the road side assistance that will be, is or has been provided."@en ] .

datex:Situation.RoadsideAssistanceTypeEnum
    a owl:Class ;
    rdfs:label "RoadsideAssistanceTypeEnum"@en ;
    skos:definition "Types of road side assistance."@en ;
    skos:prefLabel "roadside assistance type enum"@en ;
    skos:altLabel "roadsideassistancetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "airAmbulance"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Air ambulance assistance."@en ] ;
    ea:value [ ea:name "busPassengerAssistance"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Bus passenger assistance."@en ] ;
    ea:value [ ea:name "emergencyServices"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Emergency services assistance."@en ] ;
    ea:value [ ea:name "firstAid"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "First aid assistance."@en ] ;
    ea:value [ ea:name "foodDelivery"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Food delivery."@en ] ;
    ea:value [ ea:name "helicopterRescue"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Helicopter rescue."@en ] ;
    ea:value [ ea:name "vehicleRepair"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle repair assistance."@en ] ;
    ea:value [ ea:name "vehicleRecovery"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle recovery."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.Roadworks
    a owl:Class ;
    rdfs:label "Roadworks"@en ;
    skos:definition "Road maintenance, installation and construction activities, works in the road, or other construction or maintenance actions that may affect normal operation of a road."@en ;
    skos:prefLabel "roadworks"@en ;
    rdfs:subClassOf datex:Situation.OperatorAction ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/OperatorAction/Roadworks"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "publicTransportAlternative"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Describes an available public transport alternative to the normal route"@en ] ;
    ea:attribute [ ea:name "roadworksIdentifier"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An external identifier for the roadworks"@en ] ;
    ea:attribute [ ea:name "roadworksDurationClassification"@en ; ea:position 3 ; ea:type datex:Situation.RoadworksDurationEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates in general terms the expected duration of the roadworks."@en ] ;
    ea:attribute [ ea:name "roadworksScale"@en ; ea:position 4 ; ea:type datex:Situation.RoadworksScaleEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Grade of complexity of the roadworks according to the responsible road operator. For example determined by size, duration and/or traffic disruption."@en ] ;
    ea:attribute [ ea:name "underTraffic"@en ; ea:position 5 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates that the road section where the roadworks are located is under traffic or not under traffic. 'True' indicates the road is under traffic."@en ] ;
    ea:attribute [ ea:name "urgentRoadworks"@en ; ea:position 6 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication of whether the roadworks are considered to be urgent whereby emergency work is being, or needs to be, undertaken to mitigate safety concerns. 'True' indicates they are urgent."@en ] .

datex:Situation.Roadworks.MaintenanceVehicles
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.Roadworks ;
    rdfs:range datex:Situation.MaintenanceVehicles ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Situation.Roadworks.Mobility
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.Roadworks ;
    rdfs:range datex:Situation.Mobility ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Situation.Roadworks.Subjects
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.Roadworks ;
    rdfs:range datex:Situation.Subjects ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Situation.RoadworksDurationEnum
    a owl:Class ;
    rdfs:label "RoadworksDurationEnum"@en ;
    skos:definition "Expected durations of roadworks in general terms."@en ;
    skos:prefLabel "roadworks duration enum"@en ;
    skos:altLabel "roadworksdurationenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "longTerm"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The roadworks are expected to last for a long term (according to a classification scheme used by the responsible road operator)"@en ] ;
    ea:value [ ea:name "mediumTerm"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The roadworks are expected to last for a medium term (according to a classification scheme used by the responsible road operator)"@en ] ;
    ea:value [ ea:name "shortTerm"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The roadworks are expected to last for a short term (according to a classification scheme used by the responsible road operator)"@en ] .

datex:Situation.RoadworksScaleEnum
    a owl:Class ;
    rdfs:label "RoadworksScaleEnum"@en ;
    skos:definition "Grade of complexity of the roadworks according to the responsible road operator. For example determined by size, duration and/or traffic disruption."@en ;
    skos:prefLabel "roadworks scale enum"@en ;
    skos:altLabel "roadworksscaleenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "major"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The roadworks scale is major according to the responsible road operator."@en ] ;
    ea:value [ ea:name "medium"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The roadworks scale is medium according to the responsible road operator."@en ] ;
    ea:value [ ea:name "minor"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The roadworks scale is minor according to the responsible road operator."@en ] .

datex:Situation.ServiceDisruption
    a owl:Class ;
    rdfs:label "ServiceDisruption"@en ;
    skos:definition "Details of disruption to normal services which may include roadside services such as those available at designated service areas, or any other relevant services such as nearby parking."@en ;
    skos:prefLabel "service disruption"@en ;
    skos:altLabel "servicedisruption"@en ;
    rdfs:subClassOf datex:Situation.ServiceInformation ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/ServiceInformation"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "serviceDisruptionType"@en ; ea:position 1 ; ea:type datex:Situation.ServiceDisruptionTypeEnum ; ea:lowerBound "1" ; ea:upperBound "*" ; ea:definition "The type of service which is disrupted."@en ] .

datex:Situation.ServiceDisruptionTypeEnum
    a owl:Class ;
    rdfs:label "ServiceDisruptionTypeEnum"@en ;
    skos:definition "Types of disruption to services relevant to road users."@en ;
    skos:prefLabel "service disruption type enum"@en ;
    skos:altLabel "servicedisruptiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "barClosed"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Bar closed."@en ] ;
    ea:value [ ea:name "dieselShortage"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is a shortage of diesel at the specified location."@en ] ;
    ea:value [ ea:name "fuelShortage"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is a shortage of fuel (of one or more types) at the specified location."@en ] ;
    ea:value [ ea:name "lpgShortage"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is a shortage of liquid petroleum gas at the specified location."@en ] ;
    ea:value [ ea:name "methaneShortage"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is a shortage of methane at the specified location."@en ] ;
    ea:value [ ea:name "noDieselForHeavyVehicles"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is no diesel available for heavy goods vehicles at the specified location."@en ] ;
    ea:value [ ea:name "noDieselForLightVehicles"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is no diesel available for light vehicles at the specified location."@en ] ;
    ea:value [ ea:name "noParkingAvailability"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is little or no availbility of parking"@en ] ;
    ea:value [ ea:name "noPublicTelephones"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There are no available public telephones at the specified location."@en ] ;
    ea:value [ ea:name "noToiletFacilities"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There are no available public toilet facilities at the specified location."@en ] ;
    ea:value [ ea:name "noVehicleRepairFacilities"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There are no available vehicle repair facilities at the specified location."@en ] ;
    ea:value [ ea:name "petrolShortage"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is a shortage of petrol at the specified location."@en ] ;
    ea:value [ ea:name "restAreaBusy"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The rest area at the specified location is busy."@en ] ;
    ea:value [ ea:name "restAreaClosed"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The rest area at the specified location is closed."@en ] ;
    ea:value [ ea:name "restAreaOvercrowdedDriveToAnotherRestArea"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The rest area at the specified location is close to capacity and motorists are advised to seek an alternative."@en ] ;
    ea:value [ ea:name "serviceAreaBusy"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The service area at the specified location is close to capacity."@en ] ;
    ea:value [ ea:name "serviceAreaClosed"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The service area at the specified location is closed."@en ] ;
    ea:value [ ea:name "serviceAreaFuelStationClosed"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The fuel station at the specified service area is closed."@en ] ;
    ea:value [ ea:name "serviceAreaOvercrowdedDriveToAnotherServiceArea"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The service area at the specified location is close to capacity and motorists are advised to seek an alternative."@en ] ;
    ea:value [ ea:name "serviceAreaRestaurantClosed"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The restaurant at the specified service area is closed."@en ] ;
    ea:value [ ea:name "someCommercialServicesClosed"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some commercial services are closed at the specified location."@en ] ;
    ea:value [ ea:name "waterShortage"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is a shortage of water at the specified location."@en ] .

datex:Situation.ServiceInformation
    a owl:Class ;
    rdfs:label "ServiceInformation"@en ;
    skos:definition "Information about a service which may influence the behaviour of drivers and hence the characteristics of the traffic flow."@en ;
    skos:prefLabel "service information"@en ;
    skos:altLabel "serviceinformation"@en ;
    rdfs:subClassOf datex:Situation.SituationRecord ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/ServiceInformation"@en ;
    ea:kind "class" .

datex:Situation.SeverityEnum
    a owl:Class ;
    rdfs:label "SeverityEnum"@en ;
    skos:definition "Levels of severity of a situation as whole assessed by the impact that the situation may have on traffic flow as perceived by the supplier."@en ;
    skos:prefLabel "severity enum"@en ;
    skos:altLabel "severityenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "highest"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Perceived by supplier as being of the highest level."@en ] ;
    ea:value [ ea:name "high"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Perceived by supplier as being of a high level."@en ] ;
    ea:value [ ea:name "medium"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Perceived by supplier as being of a medium level."@en ] ;
    ea:value [ ea:name "low"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Perceived by supplier as being of a low level."@en ] ;
    ea:value [ ea:name "lowest"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Perceived by supplier as being of the lowest discernible level."@en ] ;
    ea:value [ ea:name "none"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Perceived by supplier as having a severity rating of none."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Perceived by supplier as being of an unknown level."@en ] .

datex:Situation.Situation
    a owl:Class ;
    rdfs:label "Situation"@en ;
    skos:definition "An identifiable instance of a traffic/travel situation comprising one or more traffic/travel circumstances which are linked by one or more causal relationships. Each traffic/travel circumstance is represented by a Situation Record."@en ;
    skos:prefLabel "situation"@en ;
    rdfs:comment "DATEX II class in namespace Situation / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "overallSeverity"@en ; ea:position 1 ; ea:type datex:Situation.SeverityEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The overall assessment of the impact (in terms of severity) that the situation as a whole is having, or will have, on the traffic flow as perceived by the supplier."@en ] ;
    ea:attribute [ ea:name "situationVersionTime"@en ; ea:position 2 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The date/time that this current version of the Situation was written into the database of the supplier which is involved in the data exchange. Identity and version of the situation are defined by the class stereotype implementation."@en ] .

datex:Situation.Situation.HeaderInformation
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.Situation ;
    rdfs:range datex:Common.HeaderInformation ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

