    ea:lowerBound "0" ;
    ea:upperBound "2" .

datex:Common.VehicleCharacteristics.WidthCharacteristic
    a owl:ObjectProperty ;
    rdfs:domain datex:Common.VehicleCharacteristics ;
    rdfs:range datex:Common.WidthCharacteristic ;
    ea:lowerBound "0" ;
    ea:upperBound "2" .

datex:Common.VehicleEquipmentEnum
    a owl:Class ;
    rdfs:label "VehicleEquipmentEnum"@en ;
    skos:definition "Types of vehicle equipment in use or on board."@en ;
    skos:prefLabel "vehicle equipment enum"@en ;
    skos:altLabel "vehicleequipmentenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "notUsingSnowChains"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle not using snow chains."@en ] ;
    ea:value [ ea:name "notUsingSnowChainsOrTyres"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle not using either snow tyres or snow chains."@en ] ;
    ea:value [ ea:name "snowChainsInUse"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle using snow chains."@en ] ;
    ea:value [ ea:name "snowTyresInUse"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle using snow tyres."@en ] ;
    ea:value [ ea:name "snowChainsOrTyresInUse"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle using snow tyres or snow chains."@en ] ;
    ea:value [ ea:name "withoutSnowTyresOrChainsOnBoard"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle which is not carrying on board snow tyres or chains."@en ] .

datex:Common.VehicleFlowValue
    a owl:Class ;
    rdfs:label "VehicleFlowValue"@en ;
    skos:definition "A measured or calculated value of the flow rate of vehicles."@en ;
    skos:prefLabel "vehicle flow value"@en ;
    skos:altLabel "vehicleflowvalue"@en ;
    rdfs:subClassOf datex:Common.DataValue ;
    rdfs:comment "DATEX II class in namespace Common / Classes/DataValue"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "vehicleFlowRate"@en ; ea:position 1 ; ea:type datex:Common.VehiclesPerHour ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A value of vehicle flow rate expressed in vehicles per hour."@en ] .

datex:Common.VehicleStatusEnum
    a owl:Class ;
    rdfs:label "VehicleStatusEnum"@en ;
    skos:definition "The status of a vehicle."@en ;
    skos:prefLabel "vehicle status enum"@en ;
    skos:altLabel "vehiclestatusenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "abandoned"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Abandoned vehicle."@en ] ;
    ea:value [ ea:name "brokenDown"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Broken down vehicle (i.e. it is immobile due to mechanical breakdown)."@en ] ;
    ea:value [ ea:name "burntOut"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Burnt out vehicle, but fire is extinguished."@en ] ;
    ea:value [ ea:name "damaged"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle is damaged following an incident or collision. It may be able or not to move by itself."@en ] ;
    ea:value [ ea:name "damagedAndImmobilized"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle is damaged following an incident or collision. It is immobilized and therefore needs assistance to be moved."@en ] ;
    ea:value [ ea:name "inDitch"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle has left roadway and ended in a ditch next to the roadway"@en ] ;
    ea:value [ ea:name "jacknifed"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The pulling vehicle is in a jackknifed position with its trailer"@en ] ;
    ea:value [ ea:name "offRoad"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle has left the carriageway"@en ] ;
    ea:value [ ea:name "onFire"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle is on fire."@en ] ;
    ea:value [ ea:name "onTopOfCrashBarrier"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle is on top of the crash barrier, and cannot leave that position autonomously"@en ] ;
    ea:value [ ea:name "onWheels"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle is in its upright position after the accident. No special lifting equipment is needed to put it on its wheels"@en ] ;
    ea:value [ ea:name "overturned"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle is on its side or upside down"@en ] ;
    ea:value [ ea:name "rollable"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The vehicle can be rolled on its own wheels. There is no special equipment needed to lift the vehicle, because of blocked wheels or other mechanical problems."@en ] ;
    ea:value [ ea:name "spunAround"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle has come to rest not facing its intended line of travel."@en ] .

datex:Common.VehicleTypeEnum
    a owl:Class ;
    rdfs:label "VehicleTypeEnum"@en ;
    skos:definition "Types of vehicle."@en ;
    skos:prefLabel "vehicle type enum"@en ;
    skos:altLabel "vehicletypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "agriculturalVehicle"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle normally used for agricultural purposes, e.g. tractor, combined harvester etc."@en ] ;
    ea:value [ ea:name "anyVehicle"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle of any type."@en ] ;
    ea:value [ ea:name "articulatedBus"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Articulated bus"@en ] ;
    ea:value [ ea:name "articulatedTrolleyBus"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Articulated trolley bus"@en ] ;
    ea:value [ ea:name "articulatedVehicle"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Articulated vehicle."@en ] ;
    ea:value [ ea:name "bicycle"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Bicycle."@en ] ;
    ea:value [ ea:name "bus"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Bus."@en ] ;
    ea:value [ ea:name "car"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles designed and constructed for the carriage of passengers and comprising no more than eight seats in addition to the driver’s seat, and having a maximum mass (“technically permissible maximum laden mass”) not exceeding 3.5 tons (M1)."@en ] ;
    ea:value [ ea:name "caravan"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Caravan."@en ] ;
    ea:value [ ea:name "carOrLightVehicle"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Car or light vehicle."@en ] ;
    ea:value [ ea:name "carWithCaravan"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Car towing a caravan."@en ] ;
    ea:value [ ea:name "carWithTrailer"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Car towing a trailer."@en ] ;
    ea:value [ ea:name "constructionOrMaintenanceVehicle"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle normally used for construction or maintenance purposes, e.g. digger, excavator, bulldozer, lorry mounted crane etc."@en ] ;
    ea:value [ ea:name "fourWheelDrive"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Four wheel drive vehicle."@en ] ;
    ea:value [ ea:name "heavyGoodsVehicle"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles with a total weight above 3,500 kg (vehicle and load)."@en ] ;
    ea:value [ ea:name "heavyGoodsVehicleWithTrailer"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Heavy goods vehicle with trailer"@en ] ;
    ea:value [ ea:name "heavyDutyTransporter"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A transporter for heavy duty (usually with abnormal dimensions)."@en ] ;
