    ea:upperBound "1" .

datex:LocationReferencing.SubdivisionCode
    a owl:Class ;
    rdfs:label "SubdivisionCode"@en ;
    skos:definition "The second part of an ISO 3166-2 country sub-division code (up to 3 characters) which may be used along with a CountryCode to make a full ISO 3166-2 subdivision code."@en ;
    skos:prefLabel "subdivision code"@en ;
    skos:altLabel "subdivisioncode"@en ;
    rdfs:subClassOf datex:Common.String ;
    rdfs:comment "DATEX II data type in namespace LocationReferencing / DataTypes"@en ;
    ea:kind "data type" .

datex:LocationReferencing.SubdivisionTypeEnum
    a owl:Class ;
    rdfs:label "SubdivisionTypeEnum"@en ;
    skos:definition "ISO 3166-2 subdivison types."@en ;
    skos:prefLabel "subdivision type enum"@en ;
    skos:altLabel "subdivisiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
