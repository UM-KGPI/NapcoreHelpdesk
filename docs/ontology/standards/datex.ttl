    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:AfirFacilities.RateLine
    a owl:Class ;
    rdfs:label "RateLine"@en ;
    skos:definition "A specific rate element of a rate line collection within a specific rate table."@en ;
    skos:prefLabel "rate line"@en ;
    skos:altLabel "rateline"@en ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / RatesPublication/Rates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "sequence"@en ; ea:position 1 ; ea:type datex:Common.Integer ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The ordered sequence of this RateLine instance within the RateLineCollection."@en ] ;
    ea:attribute [ ea:name "rateLineType"@en ; ea:position 2 ; ea:type datex:AfirFacilities.RateLineTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the nature of the rate line."@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text description associated with this rate line."@en ] ;
    ea:attribute [ ea:name "durationStart"@en ; ea:position 4 ; ea:type datex:Common.Time ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "If used, indicates the start time for the applicability of the specific rate line, generally with respect to the start of the parking or other mobility session. e.g. the start of a time-based tier charge rate."@en ] ;
    ea:attribute [ ea:name "durationEnd"@en ; ea:position 5 ; ea:type datex:Common.Time ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "If used, indicates the end time for the applicability of the specific rate line, generally with respect to the start of the parking or other mobility session. e.g. the end of a time-based tier charge rate."@en ] ;
    ea:attribute [ ea:name "incrementPeriod"@en ; ea:position 6 ; ea:type datex:AfirFacilities.Duration ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The time period for incrementing the rate line charge. If set to the same as the duration of the period between the durationStart and durationEnd, the increment will occur once per period, i.e. a flat rate time-based tier charge rate."@en ] ;
    ea:attribute [ ea:name "value"@en ; ea:position 7 ; ea:type datex:AfirFacilities.AmountOfMoney ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The value of the fee to be charged in respect of this rate line."@en ] ;
    ea:attribute [ ea:name "minValue"@en ; ea:position 8 ; ea:type datex:AfirFacilities.AmountOfMoney ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The minimum monetary amount to be applied in conjunction with use of this rate line collection."@en ] ;
    ea:attribute [ ea:name "maxValue"@en ; ea:position 9 ; ea:type datex:AfirFacilities.AmountOfMoney ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The maximum monetary amount to be applied in conjunction with use of this rate line collection."@en ] ;
    ea:attribute [ ea:name "usageCondition"@en ; ea:position 10 ; ea:type datex:AfirFacilities.RateLineUsageConditionsTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates conditions on the use of this rate line."@en ] ;
    ea:attribute [ ea:name "usageDurationLimitation"@en ; ea:position 11 ; ea:type datex:AfirFacilities.Duration ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A maximum duration limitation for this rate line. When using this element, usageCondition should be set to fixedDuration."@en ] ;
    ea:attribute [ ea:name "usageCountLimitation"@en ; ea:position 12 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum number of uses for this rate line. When using this element, usageCondition should be set to fixedNumber."@en ] .

datex:AfirFacilities.RateLine.RateLineTax
    a owl:ObjectProperty ;
    rdfs:domain datex:AfirFacilities.RateLine ;
    rdfs:range datex:AfirFacilities.RateLineTax ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:AfirFacilities.RateLine.Surcharge
    a owl:ObjectProperty ;
    rdfs:domain datex:AfirFacilities.RateLine ;
    rdfs:range datex:AfirFacilities.Surcharge ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:AfirFacilities.RateLineCollection
    a owl:Class ;
    rdfs:label "RateLineCollection"@en ;
    skos:definition "A group of rate line elements that logically group together within one rate table,e.g. such as the rate lines for the different tiers of a time-based tier rate table."@en ;
    skos:prefLabel "rate line collection"@en ;
    skos:altLabel "ratelinecollection"@en ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / RatesPublication/Rates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "collectionSequence"@en ; ea:position 1 ; ea:type datex:Common.Integer ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An indicator giving the place in sequence of this rate line collection."@en ] ;
    ea:attribute [ ea:name "applicableCurrency"@en ; ea:position 2 ; ea:type datex:AfirFacilities.CurrencyCode ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The monetary currency that rates are specified in this rate line collection."@en ] ;
    ea:attribute [ ea:name "minValueCollection"@en ; ea:position 3 ; ea:type datex:AfirFacilities.AmountOfMoney ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The minimum monetary amount to be applied in conjunction with use of this rate line collection."@en ] ;
    ea:attribute [ ea:name "maxValueCollection"@en ; ea:position 4 ; ea:type datex:AfirFacilities.AmountOfMoney ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The maximum monetary amount to be applied in conjunction with use of this rate line collection."@en ] ;
    ea:attribute [ ea:name "validStart"@en ; ea:position 5 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The start time for the validity of this rate line collection."@en ] ;
    ea:attribute [ ea:name "validEnd"@en ; ea:position 6 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The end time for the validity of this rate line collection."@en ] ;
    ea:attribute [ ea:name "minTime"@en ; ea:position 7 ; ea:type datex:AfirFacilities.Duration ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A minimum parking session duration to be applied to this rate line collection."@en ] ;
    ea:attribute [ ea:name "maxTime"@en ; ea:position 8 ; ea:type datex:AfirFacilities.Duration ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A maximum parking session duration to be applied to this rate line collection."@en ] ;
    ea:attribute [ ea:name "resetTime"@en ; ea:position 9 ; ea:type datex:Common.Time ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time that rate resets."@en ] ;
    ea:attribute [ ea:name "taxIncluded"@en ; ea:position 10 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "[TRUE] Indication that tax to be applied is included within the total rate associated with this rate line collection. [FALSE] indicates that the tax is added additionally to the total."@en ] ;
    ea:attribute [ ea:name "taxRate"@en ; ea:position 11 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The percentage rate of tax to be applied."@en ] ;
    ea:attribute [ ea:name "taxValue"@en ; ea:position 12 ; ea:type datex:AfirFacilities.AmountOfMoney ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The monetary amount of tax to be applied."@en ] ;
    ea:attribute [ ea:name "relativeTimes"@en ; ea:position 13 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "[TRUE] Indicates whether times relative to the start of an external event are used as the basis for rate calculation. [FALSE] indicates that rate calculation definitions are based on local or UTC times (for example the duration of a parking session)."@en ] .

datex:AfirFacilities.RateLineCollection.RateLine
    a owl:ObjectProperty ;
    rdfs:domain datex:AfirFacilities.RateLineCollection ;
    rdfs:range datex:AfirFacilities.RateLine ;
    ea:lowerBound "1" ;
    ea:upperBound "*" .

datex:AfirFacilities.RateLineTax
    a owl:Class ;
    rdfs:label "RateLineTax"@en ;
    skos:definition "Class containing details of tax to be applied to a RateLine."@en ;
    skos:prefLabel "rate line tax"@en ;
    skos:altLabel "ratelinetax"@en ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / RatesPublication/Rates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "taxValue"@en ; ea:position 1 ; ea:type datex:AfirFacilities.AmountOfMoney ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The monetary amount of tax to be applied."@en ] ;
    ea:attribute [ ea:name "taxRate"@en ; ea:position 2 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The percentage rate of tax to be applied."@en ] ;
    ea:attribute [ ea:name "taxIncluded"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "[TRUE] Indication that tax to be applied is included within the total rate associated with this rate line. [FALSE] indicates that the tax is added additionally to the total."@en ] ;
    ea:attribute [ ea:name "trigger"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text definition of boundary condition setting applicability of the tax."@en ] ;
    ea:attribute [ ea:name "labelForDisplay"@en ; ea:position 5 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text for display on a receipt and/or in a user interface."@en ] .

datex:AfirFacilities.RateLineTypeEnum
    a owl:Class ;
    rdfs:label "RateLineTypeEnum"@en ;
    skos:definition "A list of rate line types."@en ;
    skos:prefLabel "rate line type enum"@en ;
    skos:altLabel "ratelinetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirFacilities / RatesPublication/Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "flatRate"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A rate applied to the rate line which is not time/duration dependent. i.e. a single fixed payment."@en ] ;
    ea:value [ ea:name "incrementingRate"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A charge rate that increases by a defined amount in a defined time."@en ] ;
    ea:value [ ea:name "flatRateTier"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A flat rate charge rate associated with a specific time-based tier. This is a special case of an incrementing rate."@en ] ;
    ea:value [ ea:name "perUnit"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A charge rate that is calculated per unit (the unit should be specified, for example in RefillPoint)."@en ] .

datex:AfirFacilities.RateLineUsageConditionsTypeEnum
    a owl:Class ;
    rdfs:label "RateLineUsageConditionsTypeEnum"@en ;
    skos:definition "A list of supported rate line usage condition types."@en ;
    skos:prefLabel "rate line usage conditions type enum"@en ;
    skos:altLabel "ratelineusageconditionstypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirFacilities / RatesPublication/Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "fixedDuration"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Usage of this rate line has a fixed duration, which should be specified in usageDurationLimitation."@en ] ;
    ea:value [ ea:name "fixedNumber"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is a fixed maximum number of uses for this rate line which should be specified in usageCountLimitation."@en ] ;
    ea:value [ ea:name "once"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "This rate line can only be applied once."@en ] ;
    ea:value [ ea:name "unlimited"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "This rate line can be applied unlimited times."@en ] .

datex:AfirFacilities.RateMatrix
    a owl:Class ;
    rdfs:label "RateMatrix"@en ;
    skos:definition "A collection of rateTables as supplied by the data supplier. These may relate to different locations."@en ;
    skos:prefLabel "rate matrix"@en ;
    skos:altLabel "ratematrix"@en ;
