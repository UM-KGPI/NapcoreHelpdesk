    ea:value [ ea:name "payAndExit"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pay directly at the exit with a payment card or other means of payment (usually, this payment card must have been used when entering as well)."@en ] ;
