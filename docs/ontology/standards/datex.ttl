    ea:attribute [ ea:name "dateOfCertification"@en ; ea:position 2 ; ea:type datex:Common.Date ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Date of certification."@en ] .

datex:Parking.Characteristics
    a owl:Class ;
    rdfs:label "Characteristics"@en ;
    skos:definition "A class defining information concerning characteristics relating to a parking facility."@en ;
    skos:prefLabel "characteristics"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/CommonComponents"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "activationMode"@en ; ea:position 1 ; ea:type datex:Parking.SessionActivationModeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Modes or credentials that can be used to activate a parking session or other operation (delivery, loading, etc.)."@en ] ;
    ea:attribute [ ea:name "structureType"@en ; ea:position 2 ; ea:type datex:Parking.StructureTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Defines the type of parking structure."@en ] ;
    ea:attribute [ ea:name "structureGrade"@en ; ea:position 3 ; ea:type datex:Parking.StructureGradeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Defines the parking structure with respect to ground level."@en ] ;
    ea:attribute [ ea:name "robotic"@en ; ea:position 4 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates existence of a robotic parking system - a parking structure where customer leaves vehicle at drop off area and robots move the vehicle to parking location in structure. Default or absence of value indicates [FALSE] = no robotic parking system."@en ] ;
    ea:attribute [ ea:name "accessControlled"@en ; ea:position 5 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates facility has physical access control (e.g. barriers, gates) [TRUE] or no access control [FALSE]"@en ] ;
    ea:attribute [ ea:name "staffed"@en ; ea:position 6 ; ea:type datex:Parking.StaffEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates facility has on-site staff [TRUE] or no on-site staff [FALSE] for the majority, but not all, of the open valid operating times."@en ] ;
    ea:attribute [ ea:name "coveredType"@en ; ea:position 7 ; ea:type datex:Parking.CoveredEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specifies the type of covering of a place. Covered can include roof, canopy and other structures that protect the place from the environment."@en ] ;
    ea:attribute [ ea:name "openToPublic"@en ; ea:position 8 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "identifies if this facility is accessible to public use [TRUE] or private use only [FALSE]."@en ] ;
    ea:attribute [ ea:name "spacesNonDedicated"@en ; ea:position 9 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Number of parking spaces that are not assigned for a particular purpose."@en ] ;
    ea:attribute [ ea:name "spacesTotal"@en ; ea:position 10 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Total number of parking spaces."@en ] ;
    ea:attribute [ ea:name "accessForPersonsWithDisabilities"@en ; ea:position 11 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Specifies, whether easy access is possible for persons with disabilities."@en ] .

