    skos:altLabel "axleweight"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/Vehicle"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "axlePositionIdentifier"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the position of the axle on the vehicle numbered from front to back (i.e. 1, 2, 3...). This cannot exceed the numberOfAxles if provided as part of VehicleCharacteristics."@en ] ;
    ea:attribute [ ea:name "axleWeight"@en ; ea:position 2 ; ea:type datex:Common.Tonnes ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The weight of the specific axle, indicated by the axleSequenceIdentifier, on the vehicle numbered from front to back of the vehicle."@en ] ;
    ea:attribute [ ea:name "maximumPermittedAxleWeight"@en ; ea:position 3 ; ea:type datex:Common.Tonnes ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The maximum permitted weight of this specific axle on the vehicle."@en ] .

datex:Common.AxlesPerHour
    a owl:Class ;
    rdfs:label "AxlesPerHour"@en ;
    skos:definition "Vehicle axles per hour."@en ;
    skos:prefLabel "axles per hour"@en ;
    skos:altLabel "axlesperhour"@en ;
    rdfs:subClassOf datex:Common.NonNegativeInteger ;
