datex:Parking.AccessEquipmentEnum
    a owl:Class ;
    rdfs:label "AccessEquipmentEnum"@en ;
    skos:definition "Specifies additional equipment for this access."@en ;
    skos:prefLabel "access equipment enum"@en ;
    skos:altLabel "accessequipmentenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "barrier"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is a barrier on this entrance or exit. Usually access is granted through tickets, buttons or electronic systems."@en ] ;
    ea:value [ ea:name "trafficSignal"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is a traffic signal installation controlling this access."@en ] ;
    ea:value [ ea:name "ticketButtonMachine"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A machine at this entrance provides a parking ticket by pressing a button."@en ] ;
    ea:value [ ea:name "ticketCardMachine"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A machine at this entrance provides a parking ticket by inserting some payment or identity card."@en ] ;
    ea:value [ ea:name "payAndExitMachine"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A machine at this exit enables payment directly by inserting a payment or identity card."@en ] ;
    ea:value [ ea:name "staircase"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is a staircase associated with this access."@en ] ;
    ea:value [ ea:name "elevator"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is an elevator associated with this access."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

