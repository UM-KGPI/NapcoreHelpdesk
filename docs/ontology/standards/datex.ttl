datex:LocationReferencing.OpenlrPathAttributes
    a owl:Class ;
    rdfs:label "OpenlrPathAttributes"@en ;
    skos:definition "Properties of the path from the associated location reference point to the next location reference point, which are specified to assist correct identification of the point in an external map data source."@en ;
    skos:prefLabel "openlr path attributes"@en ;
    skos:altLabel "openlrpathattributes"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/OpenLR"@en ;
