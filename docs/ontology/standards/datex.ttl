    ea:attribute [ ea:name "laneType"@en ; ea:position 2 ; ea:type datex:Parking.AccessLaneTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Provides characterisation of the nature of the access lane (e.g. entry lane, exit lane, reversible lane)."@en ] .

