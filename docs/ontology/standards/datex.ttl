    skos:prefLabel "strategy by reference"@en ;
    skos:altLabel "strategybyreference"@en ;
    rdfs:subClassOf datex:TrafficManagementPlan.Strategy ;
    rdfs:comment "DATEX II class in namespace TrafficManagementPlan / Classes/TmplanTable/Scenario"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "strategyReference"@en ; ea:position 1 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A reference to a Traffic Management Plan strategy."@en ] .

datex:TrafficManagementPlan.StrategyDefinition
    a owl:Class ;
    rdfs:label "StrategyDefinition"@en ;
    skos:definition "Element of a Traffic Management Plan table which refers to the definition of a strategy."@en ;
    skos:prefLabel "strategy definition"@en ;
    skos:altLabel "strategydefinition"@en ;
    rdfs:subClassOf datex:TrafficManagementPlan.Strategy ;
    rdfs:comment "DATEX II class in namespace TrafficManagementPlan / Classes/TmplanTable/Scenario"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "externalIdentification"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An external identifier for a strategy defined shared between data supplier and recipient during the Traffic Management Plan design phase."@en ] ;
    ea:attribute [ ea:name "priority"@en ; ea:position 2 ; ea:type datex:Common.Integer ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Priority of this strategy compared to all other strategies that may exist. The higher the number, the higher the priority."@en ] ;
    ea:attribute [ ea:name "shortName"@en ; ea:position 3 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Short human readable name"@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Description of the strategy in natural language."@en ] .

