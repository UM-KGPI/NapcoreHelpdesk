datex:TrafficManagementPlan.TmplanOperationPublication.TmplanOperation
    a owl:ObjectProperty ;
    rdfs:domain datex:TrafficManagementPlan.TmplanOperationPublication ;
    rdfs:range datex:TrafficManagementPlan.TmplanOperation ;
    ea:lowerBound "1" ;
    ea:upperBound "*" .

datex:TrafficManagementPlan.TmplanOperationStatusEnum
    a owl:Class ;
    rdfs:label "TmplanOperationStatusEnum"@en ;
    skos:definition "The status of operation for a Traffic Management Plan."@en ;
    skos:prefLabel "tmplan operation status enum"@en ;
    skos:altLabel "tmplanoperationstatusenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace TrafficManagementPlan / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "agreementRequested"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A Traffic Management Plan agreement request is proposed to road operators before it can be implemented"@en ] ;
    ea:value [ ea:name "scheduled"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The plan is scheduled for operation"@en ] ;
    ea:value [ ea:name "schedulingAborted"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Scheduling of the plan has been aborted"@en ] ;
    ea:value [ ea:name "schedulingRejected"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Proposed scheduling of the plan has been rejected"@en ] ;
    ea:value [ ea:name "schedulingRequested"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Scheduling of this plan is proposed."@en ] ;
    ea:value [ ea:name "externalAgreementRequested"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The activation has been approved in the original proposing system and now agreement is sought from collaborating systems or organisations."@en ] ;
    ea:value [ ea:name "agreementRejected"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The Traffic Management Plan request has been rejected"@en ] ;
    ea:value [ ea:name "agreementTimeout"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The activation service request had been not answered in the allowed time period"@en ] ;
    ea:value [ ea:name "agreementApproved"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic Management Plan request proposed had been approved."@en ] ;
    ea:value [ ea:name "implementationRequested"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Request for implementation is raised, whenever no need of proposal is needed, or a previous proposal have been agreed."@en ] ;
    ea:value [ ea:name "implementationTimeout"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No information on implementation of some Traffic Management Plan action had been received in an agreed timeout after the Traffic Management Plan implementation request."@en ] ;
    ea:value [ ea:name "implementationAborted"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The implementation of this Traffic Management Plan has been aborted."@en ] ;
    ea:value [ ea:name "implemented"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic Management Plan is implemented on road network"@en ] ;
    ea:value [ ea:name "activationRequested"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Activation of this Traffic Management Plan was requested."@en ] ;
    ea:value [ ea:name "activationCancelled"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The activation of the Traffic Management Plan was cancelled."@en ] ;
    ea:value [ ea:name "activationTerminated"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The activation of this Traffic Management Plan was terminated."@en ] ;
    ea:value [ ea:name "activated"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The Traffic Management Plan was activated."@en ] ;
    ea:value [ ea:name "terminationRequested"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Request to terminate the Traffic Management Plan during implementation phase"@en ] ;
    ea:value [ ea:name "cancellationRequested"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "request to cancel the Traffic Management Plan Activation before implementation phase"@en ] ;
    ea:value [ ea:name "terminated"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The Traffic Management Plan activation service is terminated"@en ] ;
    ea:value [ ea:name "cancelled"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The Traffic Management Plan activation request has been cancelled"@en ] .

