datex:RoadTrafficData.TrafficStatus
    a owl:Class ;
    rdfs:label "TrafficStatus"@en ;
    skos:definition "The status of traffic conditions on a specific section or at a specific point on the road network."@en ;
    skos:prefLabel "traffic status"@en ;
    skos:altLabel "trafficstatus"@en ;
    rdfs:subClassOf datex:RoadTrafficData.BasicData ;
    rdfs:comment "DATEX II class in namespace RoadTrafficData / Classes/TrafficStatus"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "trafficTrendType"@en ; ea:position 1 ; ea:type datex:Common.TrafficTrendTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A characterization of the trend in the traffic conditions at the specified location and direction."@en ] .

datex:RoadTrafficData.TrafficStatus.trafficStatus
    a owl:ObjectProperty ;
    rdfs:domain datex:RoadTrafficData.TrafficStatus ;
    rdfs:range datex:RoadTrafficData.TrafficStatusValue ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:RoadTrafficData.TrafficStatusEnum
    a owl:Class ;
    rdfs:label "TrafficStatusEnum"@en ;
    skos:definition "List of terms used to describe traffic conditions."@en ;
    skos:prefLabel "traffic status enum"@en ;
    skos:altLabel "trafficstatusenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace RoadTrafficData / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "stationary"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic is stationary, or very near stationary, at the specified location (i.e. average speed is less than 10% of its free-flow level)."@en ] ;
    ea:value [ ea:name "queuing"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic is queuing at the specified location, although there is still some traffic movement (i.e. average speed is between 10% and 25% of its free-flow level)."@en ] ;
    ea:value [ ea:name "slow"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic is slow moving at the specified location, but not yet forming queues (i.e. average speed is between 25% and 75% of its free-flow level)."@en ] ;
    ea:value [ ea:name "heavy"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic in the specified direction is heavier than usual making driving conditions more difficult than normal."@en ] ;
    ea:value [ ea:name "unspecifiedAbnormal"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There are abnormal traffic conditions of an unspecified nature at the specified location."@en ] ;
    ea:value [ ea:name "freeFlow"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic at the specified location is free-flowing."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic conditions are unknown."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:RoadTrafficData.TrafficStatusValue
    a owl:Class ;
    rdfs:label "TrafficStatusValue"@en ;
    skos:definition "A measured or calculated value of the status of traffic conditions on a section of road in a specified direction."@en ;
    skos:prefLabel "traffic status value"@en ;
    skos:altLabel "trafficstatusvalue"@en ;
    rdfs:subClassOf datex:Common.DataValue ;
    rdfs:comment "DATEX II class in namespace RoadTrafficData / Classes/DataValue"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "trafficStatusValue"@en ; ea:position 1 ; ea:type datex:RoadTrafficData.TrafficStatusEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A status value of traffic conditions on the identified section of road in the specified direction."@en ] .

datex:RoadTrafficData.TravelTimeData
    a owl:Class ;
    rdfs:label "TravelTimeData"@en ;
    skos:definition "Derived/computed travel time information relating to a linear section of the road network; forecast = true means a forecast for a vehicle at the start of the specified location, forecast = false means calculation/measurement at the end."@en ;
    skos:prefLabel "travel time data"@en ;
    skos:altLabel "traveltimedata"@en ;
    rdfs:subClassOf datex:RoadTrafficData.BasicData ;
    rdfs:comment "DATEX II class in namespace RoadTrafficData / Classes/TravelTimeData"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "travelTimeTrendType"@en ; ea:position 1 ; ea:type datex:RoadTrafficData.TravelTimeTrendTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The current trend in the travel time between the defined locations in the specified direction."@en ] ;
    ea:attribute [ ea:name "travelTimeType"@en ; ea:position 2 ; ea:type datex:RoadTrafficData.TravelTimeTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication of the way in which the travel time is derived."@en ] ;
    ea:attribute [ ea:name "vehicleType"@en ; ea:position 3 ; ea:type datex:Common.VehicleTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Vehicle type."@en ] .

datex:RoadTrafficData.TravelTimeData.freeFlowSpeed
    a owl:ObjectProperty ;
    rdfs:domain datex:RoadTrafficData.TravelTimeData ;
