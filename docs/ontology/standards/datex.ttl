    ea:value [ ea:name "atHighAltitudes"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At high altitudes."@en ] ;
    ea:value [ ea:name "atRestAreas"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At rest areas"@en ] ;
    ea:value [ ea:name "atServiceAreas"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At service areas"@en ] ;
    ea:value [ ea:name "atTollPlazas"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At toll plazas."@en ] ;
    ea:value [ ea:name "inBuiltUpAreas"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In built up areas, i.e. villages, towns and cities."@en ] ;
    ea:value [ ea:name "inContraflowSections"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In sections of the road where contraflow is in operation."@en ] ;
    ea:value [ ea:name "inForestedAreas"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On sections of the road where it runs through or adjacent to forested areas."@en ] ;
    ea:value [ ea:name "inGalleries"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In galleries."@en ] ;
    ea:value [ ea:name "inLowLyingAreas"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In low lying areas."@en ] ;
    ea:value [ ea:name "inRoadworksAreas"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In roadworks areas."@en ] ;
    ea:value [ ea:name "inRuralAreas"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In rural areas, i.e. outside villages, towns and cities."@en ] ;
    ea:value [ ea:name "inShadedAreas"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In shaded areas."@en ] ;
    ea:value [ ea:name "inTheInnerCityAreas"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the inner city areas."@en ] ;
    ea:value [ ea:name "inTheCityCentre"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the city centre."@en ] ;
    ea:value [ ea:name "inTunnels"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In tunnels."@en ] ;
    ea:value [ ea:name "onBridges"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On bridges."@en ] ;
    ea:value [ ea:name "onDownHillSections"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On down hill sections of the road."@en ] ;
    ea:value [ ea:name "onDualCarriagewaySections"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On dual carriageway sections of the road."@en ] ;
    ea:value [ ea:name "onElevatedSections"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On elevated sections of the road."@en ] ;
    ea:value [ ea:name "onEnteringOrLeavingTunnels"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On entering or leaving tunnels."@en ] ;
    ea:value [ ea:name "onEnteringTheCountry"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On entry into the country."@en ] ;
    ea:value [ ea:name "onFlyovers"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On flyover sections of the road, i.e. sections of the road which pass over another road."@en ] ;
    ea:value [ ea:name "onLeavingTheCountry"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On leaving the country."@en ] ;
