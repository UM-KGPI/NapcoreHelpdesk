datex:Common.WeatherRelatedRoadConditionTypeEnum
    a owl:Class ;
    rdfs:label "WeatherRelatedRoadConditionTypeEnum"@en ;
    skos:definition "Types of road surface conditions which are related to the weather."@en ;
    skos:prefLabel "weather related road condition type enum"@en ;
    skos:altLabel "weatherrelatedroadconditiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Common / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "blackIce"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Severe skid risk due to black ice (i.e. clear ice, which is impossible or very difficult to see)."@en ] ;
    ea:value [ ea:name "deepSnow"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Deep snow on the roadway."@en ] ;
    ea:value [ ea:name "dry"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is no humidity over the sensor."@en ] ;
    ea:value [ ea:name "freezingOfWetRoads"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The wet road surface is subject to freezing."@en ] ;
    ea:value [ ea:name "freezingPavements"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The pavements for pedestrians are subject to freezing."@en ] ;
    ea:value [ ea:name "freezingRain"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Severe skid risk due to rain falling on sub-zero temperature road surface and freezing."@en ] ;
    ea:value [ ea:name "freshSnow"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fresh snow (with little or no traffic yet) on the roadway."@en ] ;
    ea:value [ ea:name "glaze"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Glaze of the road surface."@en ] ;
    ea:value [ ea:name "ice"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Increased skid risk due to ice (of any kind)."@en ] ;
    ea:value [ ea:name "iceBuildUp"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Ice is building up on the roadway causing a serious skid hazard."@en ] ;
    ea:value [ ea:name "iceWithWheelBarTracks"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Ice on the road frozen in the form of wheel tracks."@en ] ;
    ea:value [ ea:name "icyPatches"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Severe skid risk due to icy patches (i.e. intermittent ice on roadway)."@en ] ;
    ea:value [ ea:name "looseSnow"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Powdery snow on the road which is subject to being blown by the wind."@en ] ;
    ea:value [ ea:name "moist"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "From (0,01 mm) water film thickness over the sensor"@en ] ;
    ea:value [ ea:name "normalWinterConditionsForPedestrians"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Conditions for pedestrians are consistent with those normally expected in winter."@en ] ;
    ea:value [ ea:name "notDry"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road surface is not dry."@en ] ;
    ea:value [ ea:name "packedSnow"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Packed snow (heavily trafficked) on the roadway."@en ] ;
    ea:value [ ea:name "rime"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fresh snow (with little or no traffic yet) on the roadway."@en ] ;
    ea:value [ ea:name "roadSurfaceMelting"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road surface is melting, or has melted due to abnormally high temperatures."@en ] ;
    ea:value [ ea:name "slippery"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Detection at least of the presence of partly or wholly solidified aqueous solution over the sensor."@en ] ;
    ea:value [ ea:name "slushOnRoad"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Increased skid risk due to melting snow (slush) on road."@en ] ;
    ea:value [ ea:name "slushStrings"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Melting snow (slush) on the roadway is formed into wheel tracks."@en ] ;
    ea:value [ ea:name "snow"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fresh snow (with little or no traffic yet) on the roadway."@en ] ;
    ea:value [ ea:name "snowDrifts"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Snow drifting is in progress or patches of deep snow are present due to earlier drifting."@en ] ;
    ea:value [ ea:name "snowOnPavement"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Snow is on the pedestrian pavement."@en ] ;
    ea:value [ ea:name "wetAndIcyRoad"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Increased skid risk due to partly thawed, wet road with packed snow and ice, or rain falling on packed snow and ice."@en ] ;
    ea:value [ ea:name "snowOnTheRoad"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Snow is lying on the road surface."@en ] ;
    ea:value [ ea:name "wetIcyPavement"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Partly thawed, wet pedestrian pavement with packed snow and ice, or rain falling on packed snow and ice."@en ] ;
    ea:value [ ea:name "streamingWater"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "From (2 mm) water film thickness over the sensor."@en ] ;
    ea:value [ ea:name "surfaceWater"@en ; ea:position 30 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Water is resting on the roadway which provides an increased hazard to vehicles."@en ] ;
    ea:value [ ea:name "wet"@en ; ea:position 31 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "From (0,2 mm) water film thickness over the sensor"@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 32 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

