    skos:prefLabel "speed management definition"@en ;
    skos:altLabel "speedmanagementdefinition"@en ;
    rdfs:subClassOf datex:TrafficManagementPlan.NetworkManagementDefinition ;
    rdfs:comment "DATEX II class in namespace TrafficManagementPlan / Classes/OperatorActionDefinition"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "speedManagementType"@en ; ea:position 1 ; ea:type datex:Situation.SpeedManagementTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Type of speed management action instigated by operator."@en ] ;
    ea:attribute [ ea:name "temporarySpeedLimit"@en ; ea:position 2 ; ea:type datex:Common.KilometresPerHour ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Temporary limit defining the maximum advisory or mandatory speed of vehicles."@en ] .

datex:TrafficManagementPlan.Strategy
    a owl:Class ;
    rdfs:label "Strategy"@en ;
    skos:definition "A coherent set of one or more traffic management measures that aims to achieve some overall effect in response to a traffic management scenario."@en ;
    skos:prefLabel "strategy"@en ;
    rdfs:comment "DATEX II class in namespace TrafficManagementPlan / Classes/TmplanTable/Scenario"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "versionTime"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time stamp indicating when this version of the strategy was created or updated."@en ] .

datex:TrafficManagementPlan.Strategy.Measure
    a owl:ObjectProperty ;
    rdfs:domain datex:TrafficManagementPlan.Strategy ;
    rdfs:range datex:TrafficManagementPlan.Measure .

datex:TrafficManagementPlan.StrategyByReference
    a owl:Class ;
    rdfs:label "StrategyByReference"@en ;
