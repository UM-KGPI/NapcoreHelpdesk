datex:UrbanExtensions.InfrastructureDescriptorEnumExtendedUrban
    a owl:Class ;
    rdfs:label "InfrastructureDescriptorEnumExtendedUrban"@en ;
    skos:definition "Urban extensions for infrastructure description."@en ;
    skos:prefLabel "infrastructure descriptor enum extended urban"@en ;
    skos:altLabel "infrastructuredescriptorenumextendedurban"@en ;
