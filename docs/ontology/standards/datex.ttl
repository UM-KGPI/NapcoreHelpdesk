datex:Situation.PoorEnvironmentConditions
    a owl:Class ;
    rdfs:label "PoorEnvironmentConditions"@en ;
    skos:definition "Any environmental conditions which may be affecting the driving conditions on the road."@en ;
    skos:prefLabel "poor environment conditions"@en ;
    skos:altLabel "poorenvironmentconditions"@en ;
    rdfs:subClassOf datex:Situation.Conditions ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement/Conditions"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "poorEnvironmentType"@en ; ea:position 1 ; ea:type datex:Situation.PoorEnvironmentTypeEnum ; ea:lowerBound "1" ; ea:upperBound "*" ; ea:definition "The type of environment condition which is affecting driving conditions."@en ] .

datex:Situation.PoorEnvironmentConditions.Humidity
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.PoorEnvironmentConditions ;
    rdfs:range datex:Common.Humidity ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Situation.PoorEnvironmentConditions.Pollution
    a owl:ObjectProperty ;
