datex:TrafficRegulation.ReasonForRegulationEnum
    a owl:Class ;
    rdfs:label "ReasonForRegulationEnum"@en ;
    skos:definition "This enumeration lists possible reasons for a road traffic authority to issue a traffic regulation order."@en ;
    skos:prefLabel "reason for regulation enum"@en ;
    skos:altLabel "reasonforregulationenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace TrafficRegulation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "other"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Regulation due to a reason not covered by the other literals."@en ] ;
    ea:value [ ea:name "protectionOfNoiseAndEmissions"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Regulation to protect resident population against noise and emissions."@en ] ;
    ea:value [ ea:name "protectionOfRoad"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Regulation to prevent extraordinary damage to the road."@en ] ;
    ea:value [ ea:name "protectionOfWaters"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Regulation to protect waters in the area."@en ] ;
    ea:value [ ea:name "publicSafety"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Regulation to maintain public safety."@en ] ;
    ea:value [ ea:name "researchAndTest"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Regulation intended to research accident incidents, traffic behaviour, traffic flows and to test planned traffic safety or traffic regulation measures."@en ] ;
    ea:value [ ea:name "roadworks"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Regulation due to roadworks."@en ] ;
    ea:value [ ea:name "trafficOrder"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Regulation due to traffic order concerns."@en ] ;
    ea:value [ ea:name "trafficSafety"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Regulation due to safety concerns."@en ] .

