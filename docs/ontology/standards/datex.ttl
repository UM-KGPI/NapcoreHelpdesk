datex:Parking.SafetyStandardClassification
    a owl:Class ;
    rdfs:label "SafetyStandardClassification"@en ;
    skos:definition "Use this class to classification type/level for security schemes for this place"@en ;
    skos:prefLabel "safety standard classification"@en ;
    skos:altLabel "safetystandardclassification"@en ;
