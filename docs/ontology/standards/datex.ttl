    ea:value [ ea:name "selfService"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Self Service for fuelling"@en ] ;
    ea:value [ ea:name "unattended"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unattended station, fuelling and payment to be done without assistance."@en ] .

