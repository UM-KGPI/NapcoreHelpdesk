    ea:value [ ea:name "restaurantSelfService"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A restaurant where people arrange and fetch their meal themselves, this might enclose a buffet."@en ] ;
