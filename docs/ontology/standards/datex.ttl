    ea:attribute [ ea:name "heaviestAxleWeight"@en ; ea:position 2 ; ea:type datex:Common.Tonnes ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The weight of the heaviest axle on the vehicle."@en ] .

datex:Common.Hectopascal
    a owl:Class ;
