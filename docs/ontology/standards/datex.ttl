    ea:attribute [ ea:name "green"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The green value of the RGB colour (0..255)."@en ] ;
    ea:attribute [ ea:name "blue"@en ; ea:position 3 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The blue value of the RGB colour (0..255)."@en ] ;
