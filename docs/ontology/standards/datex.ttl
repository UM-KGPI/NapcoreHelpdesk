    ea:attribute [ ea:name "publicHolidayName"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specification of a specific public holiday by its name."@en ] .

datex:Common.Reference
    a owl:Class ;
