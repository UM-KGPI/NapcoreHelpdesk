    ea:attribute [ ea:name "involvedVehicleType"@en ; ea:position 2 ; ea:type datex:Common.VehicleTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of vehicle involved"@en ] ;
    ea:attribute [ ea:name "vehicleProblemCause"@en ; ea:position 3 ; ea:type datex:Situation.VehicleProblemCauseEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The component of the vehicle that has the problem"@en ] .

datex:Situation.VehicleObstruction.obstructingVehicle
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.VehicleObstruction ;
    rdfs:range datex:Common.Vehicle ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Situation.VehicleObstructionTypeEnum
    a owl:Class ;
    rdfs:label "VehicleObstructionTypeEnum"@en ;
    skos:definition "Types of obstructions involving vehicles."@en ;
    skos:prefLabel "vehicle obstruction type enum"@en ;
    skos:altLabel "vehicleobstructiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "abandonedVehicle"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Abandoned vehicle(s) on the roadway which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "abnormalLoad"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle(s) carrying exceptional load(s) which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "brokenDownVehicle"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Broken down vehicle(s) on the carriageway which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "convoy"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A group of vehicles moving together in formation which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "damagedVehicle"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Damaged vehicle(s) on the carriageway which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "dangerousSlowMovingVehicle"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dangerous slow moving vehicles which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "emergencyVehicle"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Emergency service vehicles on the roadway in response to an emergency situation."@en ] ;
    ea:value [ ea:name "highSpeedEmergencyVehicle"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Emergency service vehicles progressing at high speed along the roadway in response to or en route from an emergency situation."@en ] ;
    ea:value [ ea:name "longLoad"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vehicle of length greater than that normally allowed which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "highSpeedChase"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Authorised and unauthorised vehicles are travelling at high speeds along the roadway. This may present a hazard to other vehicles."@en ] ;
    ea:value [ ea:name "medicalEmergency"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle has stopped due a medical issue of a driver or passenger"@en ] ;
    ea:value [ ea:name "militaryConvoy"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A group of military vehicles moving together in formation which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "overheightVehicle"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles of height greater than normally allowed which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "prohibitedVehicleOnTheRoad"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles not normally permitted on the motorway are present which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "recklessDriver"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vehicle being driven without due care and attention is causing a hazard to other vehicles."@en ] ;
    ea:value [ ea:name "slowVehicle"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vehicle travelling at well below normal highway speeds which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "specialPermitTransport"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Special type of load or vehicle size, or even speed, that is allowed on the road only with special permission. The presence of this transport may cause traffic disruption."@en ] ;
    ea:value [ ea:name "trackedVehicle"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Carterpillar tracked vehicles are in use which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "unlitVehicleOnTheRoad"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles without lights are in use which may present a hazard to road users."@en ] ;
    ea:value [ ea:name "vehicleOnFire"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vehicle is or has been on fire and may cause traffic disruption."@en ] ;
    ea:value [ ea:name "vehicleCarryingHazardousMaterials"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicles carrying materials of a hazardous nature are present and these could expose road users to additional hazards."@en ] ;
    ea:value [ ea:name "vehicleInDifficulty"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vehicle is experiencing difficulties (e.g. manoeuvring or propulsion difficulties) which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "vehicleOnWrongCarriageway"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vehicle is travelling the wrong way along a divided highway (i.e. on the wrong side)."@en ] ;
    ea:value [ ea:name "vehicleStuck"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "One or more vehicles are stuck (i.e. unable to move) due to environmental conditions such as a snow drift or severe icy road."@en ] ;
    ea:value [ ea:name "vehicleWithOverheightLoad"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An over-height vehicle which may present a hazard to road users."@en ] ;
    ea:value [ ea:name "vehicleWithOverwideLoad"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vehicle of width greater than that normally allowed which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "winterMaintetanceVehicleInTransfer"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Winter maintenance vehicle is on the road, not doing its specific work. Its presence may cause traffic disruption."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

