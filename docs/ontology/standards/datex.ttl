    skos:altLabel "devicecomponentenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace FaultAndStatus / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "ambientLightMonitor"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Ambient light monitor"@en ] ;
    ea:value [ ea:name "cabinet"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Cabinet providing housing for equipment"@en ] ;
    ea:value [ ea:name "communicationsEquipment"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Communuications equipment"@en ] ;
    ea:value [ ea:name "controller"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A device controller"@en ] ;
    ea:value [ ea:name "display"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A display of a device"@en ] ;
    ea:value [ ea:name "fan"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fan for device cooling"@en ] ;
    ea:value [ ea:name "generalPurposeIoPort"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "General-purpose I/O port"@en ] ;
    ea:value [ ea:name "heater"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Heater to maintain operational temperature for a device"@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other type of device component"@en ] ;
    ea:value [ ea:name "powerSupply"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Power supply for a device"@en ] ;
    ea:value [ ea:name "processor"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Processor component of a device"@en ] ;
    ea:value [ ea:name "sensor"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Sensor component of a device"@en ] .

datex:FaultAndStatus.DeviceFault
    a owl:Class ;
    rdfs:label "DeviceFault"@en ;
    skos:definition "Information about a fault relating to a specific device"@en ;
    skos:prefLabel "device fault"@en ;
    skos:altLabel "devicefault"@en ;
    rdfs:subClassOf datex:Common.Fault ;
    rdfs:comment "DATEX II class in namespace FaultAndStatus / FaultPublication"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "faultComponentType"@en ; ea:position 1 ; ea:type datex:FaultAndStatus.DeviceComponentEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The fault comes from a component of this device, of the identified component type."@en ] ;
    ea:attribute [ ea:name "faultType"@en ; ea:position 2 ; ea:type datex:FaultAndStatus.FaultTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of fault."@en ] ;
    ea:attribute [ ea:name "faultInstructions"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Instructions to rectify this fault."@en ] ;
    ea:attribute [ ea:name "faultImpactOnData"@en ; ea:position 4 ; ea:type datex:FaultAndStatus.FaultImpactOnDataEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The impact on data of this fault."@en ] ;
    ea:attribute [ ea:name "faultComponent"@en ; ea:position 5 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identity of the component (if any), in which the fault occurred."@en ] .

datex:FaultAndStatus.DeviceFault.faultObjectInformation
    a owl:ObjectProperty ;
