datex:Facilities.RateLine
    a owl:Class ;
    rdfs:label "RateLine"@en ;
    skos:definition "A specific rate element of a rate line collection within a specific rate table."@en ;
    skos:prefLabel "rate line"@en ;
    skos:altLabel "rateline"@en ;
    rdfs:comment "DATEX II class in namespace Facilities / RatesPublication/Rates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "sequence"@en ; ea:position 1 ; ea:type datex:Common.Integer ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The ordered sequence of this RateLine instance within the RateLineCollection"@en ] ;
    ea:attribute [ ea:name "rateLineType"@en ; ea:position 2 ; ea:type datex:Facilities.RateLineTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the nature of the rate line"@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text description associated with this rate line."@en ] ;
    ea:attribute [ ea:name "durationStart"@en ; ea:position 4 ; ea:type datex:Common.Time ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "If used, indicates the start time for the applicability of the specific rate line, generally with respect to the start of the parking or other mobility session. e.g. the start of a time-based tier charge rate."@en ] ;
    ea:attribute [ ea:name "durationEnd"@en ; ea:position 5 ; ea:type datex:Common.Time ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "If used, indicates the end time for the applicability of the specific rate line, generally with respect to the start of the parking or other mobility session. e.g. the end of a time-based tier charge rate."@en ] ;
    ea:attribute [ ea:name "incrementPeriod"@en ; ea:position 6 ; ea:type datex:Facilities.Duration ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The time period for incrementing the rate line charge. If set to the same as the duration of the period between the durationStart and durationEnd, the increment will occur once per period, i.e. a flat rate time-based tier charge rate."@en ] ;
    ea:attribute [ ea:name "value"@en ; ea:position 7 ; ea:type datex:Facilities.AmountOfMoney ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The value of the fee to be charged in respect of this rate line"@en ] ;
    ea:attribute [ ea:name "minValue"@en ; ea:position 8 ; ea:type datex:Facilities.AmountOfMoney ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The minimum monetary amount to be applied in conjunction with use of this rate line collection."@en ] ;
    ea:attribute [ ea:name "maxValue"@en ; ea:position 9 ; ea:type datex:Facilities.AmountOfMoney ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The maximum monetary amount to be applied in conjunction with use of this rate line collection."@en ] ;
    ea:attribute [ ea:name "usageCondition"@en ; ea:position 10 ; ea:type datex:Facilities.RateUsageConditionsTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates conditions on the use of this rate line"@en ] .

