    ea:attribute [ ea:name "alertCDirectionNamed"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "ALERT-C name of a direction e.g. Brussels -> Lille."@en ] ;
    ea:attribute [ ea:name "alertCAffectedDirection"@en ; ea:position 3 ; ea:type datex:LocationReferencing.LinearDirectionEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The direction(s) of traffic flow to which the situation, traffic data or information is related."@en ] .

datex:LocationReferencing.AlertCDirectionEnum
    a owl:Class ;
    rdfs:label "AlertCDirectionEnum"@en ;
    skos:definition "Direction used to reach the primary location from the secondary location in ALERT-C location table, as defined in CEN ISO 14819-1"@en ;
