    ea:attribute [ ea:name "lastUpdated"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The date/time at which this information was last updated."@en ] ;
    ea:attribute [ ea:name "name"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Name of the organisation."@en ] ;
    ea:attribute [ ea:name "externalCode"@en ; ea:position 3 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An external code to identify the organisation."@en ] ;
    ea:attribute [ ea:name "legalName"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The legal name of the organisation."@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 5 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A description of the organisation."@en ] ;
    ea:attribute [ ea:name "linkToGeneralInformation"@en ; ea:position 6 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An internet address from where further relevant information about this organisation may be obtained."@en ] ;
    ea:attribute [ ea:name "linkToLogo"@en ; ea:position 7 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An internet address from where the logo of this organisation may be obtained."@en ] ;
    ea:attribute [ ea:name "linkToWebform"@en ; ea:position 8 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An internet address pointing to a webform, which people can use to send messages to this organisation."@en ] ;
    ea:attribute [ ea:name "available24hours"@en ; ea:position 9 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specifies if the availability is 24 hours a day. If omitted, this information is unknown or heterogeneous."@en ] ;
