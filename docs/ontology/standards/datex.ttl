datex:Vms.VmsTypeEnum
    a owl:Class ;
    rdfs:label "VmsTypeEnum"@en ;
    skos:definition "Type of variable message sign."@en ;
    skos:prefLabel "vms type enum"@en ;
    skos:altLabel "vmstypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "colourGraphic"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A colour graphic display."@en ] ;
    ea:value [ ea:name "rotatingPrismSign"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A sign implementing fixed messages which are made visible to drivers by electromechanical means e.g. a fixed sign parallel to traffic flow and therefore not legible is rotated to be orthogonal to traffic flow and becomes legible."@en ] ;
    ea:value [ ea:name "monochromeGraphic"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A monochrome graphic display."@en ] ;
    ea:value [ ea:name "simpleMatrixSign"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Simple display made up of a fixed matrix of pixels (e.g. sets of LEDs or lights) capable of showing a limited set of aspects (or matrix images). The display area is regarded as a pictogram area in DATEX II."@en ] ;
    ea:value [ ea:name "fullMatrixSign"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A full-matrix sign."@en ] ;
    ea:value [ ea:name "rollerBlindSign"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Continuous sign using a roller blind."@en ] ;
    ea:value [ ea:name "virtualVms"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Not a physical VMS but a conceptual one used in the electronic distribution of information"@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Vms.WorkingStatusEnum
    a owl:Class ;
    rdfs:label "WorkingStatusEnum"@en ;
    skos:definition "Identifies the working status of a VMS."@en ;
    skos:prefLabel "working status enum"@en ;
    skos:altLabel "workingstatusenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "blank"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The VMS is blank"@en ] ;
    ea:value [ ea:name "covered"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The VMS is physically covered so no messages can be seen."@en ] ;
    ea:value [ ea:name "notWorking"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The VMS is not working"@en ] ;
    ea:value [ ea:name "working"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The VMS is working"@en ] .
