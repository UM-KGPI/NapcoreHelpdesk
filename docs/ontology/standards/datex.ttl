    ea:kind "class" ;
    ea:attribute [ ea:name "withReservation"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates whether a reservation is required. [TRUE] reservation required"@en ] ;
    ea:attribute [ ea:name "noFeeToUse"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specific facility is free or not. [TRUE] (e.g. free to park)"@en ] ;
    ea:attribute [ ea:name "propulsionEnergyType"@en ; ea:position 3 ; ea:type datex:Facilities.EnergySourceEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Indicates eligible fuel types for applicable vehicles"@en ] ;
    ea:attribute [ ea:name "activeAssignedRight"@en ; ea:position 4 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication of an assigned right."@en ] ;
    ea:attribute [ ea:name "withMembership"@en ; ea:position 5 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates that a membership is required. [TRUE] membership required"@en ] ;
    ea:attribute [ ea:name "membershipName"@en ; ea:position 6 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Free-text description of the membership"@en ] ;
    ea:attribute [ ea:name "memberOfOtherRateTable"@en ; ea:position 7 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates if this qualification can be used in combination with the use of another rate table. [TRUE]= member of (i.e., used) another rate table."@en ] ;
