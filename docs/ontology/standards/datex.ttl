    skos:prefLabel "linear element by points"@en ;
    skos:altLabel "linearelementbypoints"@en ;
    rdfs:subClassOf datex:LocationReferencing.LinearElement ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/LinearReferencing/PointAlongLinearElement"@en ;
    ea:kind "class" .

datex:LocationReferencing.LinearElementByPoints.endPointOfLinearElement
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.LinearElementByPoints ;
    rdfs:range datex:LocationReferencing.Referent ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:LocationReferencing.LinearElementByPoints.intermediatePointOnLinearElement
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.LinearElementByPoints ;
    rdfs:range datex:LocationReferencing.Referent ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:LocationReferencing.LinearElementByPoints.startPointOfLinearElement
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.LinearElementByPoints ;
    rdfs:range datex:LocationReferencing.Referent ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:LocationReferencing.LinearElementNatureEnum
    a owl:Class ;
    rdfs:label "LinearElementNatureEnum"@en ;
    skos:definition "List of indicative natures of linear elements."@en ;
    skos:prefLabel "linear element nature enum"@en ;
    skos:altLabel "linearelementnatureenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "road"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The nature of the linear element is a road."@en ] ;
    ea:value [ ea:name "roadSection"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The nature of the linear element is a section of a road."@en ] ;
    ea:value [ ea:name "slipRoad"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The nature of the linear element is a slip road."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:LocationReferencing.LinearLocation
    a owl:Class ;
