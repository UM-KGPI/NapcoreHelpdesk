    skos:altLabel "groupofpeopleinvolved"@en ;
    rdfs:comment "DATEX II class in namespace Situation / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "numberOfPeople"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of people of this group that are involved."@en ] ;
    ea:attribute [ ea:name "injuryStatusType"@en ; ea:position 2 ; ea:type datex:Situation.InjuryStatusTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The injury status of the people involved."@en ] ;
    ea:attribute [ ea:name "involvementRole"@en ; ea:position 3 ; ea:type datex:Situation.InvolvementRolesEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The involvement role of the people."@en ] ;
    ea:attribute [ ea:name "categoryOfPeopleInvolved"@en ; ea:position 4 ; ea:type datex:Situation.PersonCategoryEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The category of persons involved."@en ] .

datex:Situation.Impact
    a owl:Class ;
    rdfs:label "Impact"@en ;
    skos:definition "An assessment of the impact that an event or operator action defined by the situation record has on the driving conditions."@en ;
    skos:prefLabel "impact"@en ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/Impact"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "capacityRemaining"@en ; ea:position 1 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The ratio of current capacity to the normal (free flow) road capacity in the defined direction, expressed as a percentage. Capacity is the maximum number of vehicles that can pass a specified point on the road, in unit time given the specified conditions."@en ] ;
    ea:attribute [ ea:name "numberOfLanesRestricted"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of normally usable lanes on the carriageway which are now restricted either fully or partially (this may include the hard shoulder if it is normally available for operational use, e.g. in hard shoulder running schemes)."@en ] ;
    ea:attribute [ ea:name "numberOfOperationalLanes"@en ; ea:position 3 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of usable lanes in the specified direction which remain fully operational (this may include the hard shoulder if it is being used as an operational lane)."@en ] ;
    ea:attribute [ ea:name "residualLaneWidth"@en ; ea:position 4 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The width of lanes after any lane narrowing"@en ] ;
    ea:attribute [ ea:name "residualRoadWidth"@en ; ea:position 5 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The total width of the combined operational lanes in the specified direction."@en ] .

datex:Situation.Impact.Delays
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.Impact ;
    rdfs:range datex:Situation.Delays ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Situation.InfrastructureDamageObstruction
    a owl:Class ;
    rdfs:label "InfrastructureDamageObstruction"@en ;
    skos:definition "An obstruction on the road resulting from the failure or damage of infrastructure on, under, above or close to the road."@en ;
    skos:prefLabel "infrastructure damage obstruction"@en ;
    skos:altLabel "infrastructuredamageobstruction"@en ;
    rdfs:subClassOf datex:Situation.Obstruction ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement/Obstruction"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "infrastructureDamageType"@en ; ea:position 1 ; ea:type datex:Situation.InfrastructureDamageTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Characterization of an obstruction on the road resulting from the failure or damage of infrastructure on, under, above or close to the road."@en ] .

datex:Situation.InfrastructureDamageTypeEnum
    a owl:Class ;
    rdfs:label "InfrastructureDamageTypeEnum"@en ;
    skos:definition "Types of infrastructure damage which may have an effect on the road network."@en ;
    skos:prefLabel "infrastructure damage type enum"@en ;
    skos:altLabel "infrastructuredamagetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "burstPipe"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road surface has sunken or collapsed in places due to burst pipes."@en ] ;
    ea:value [ ea:name "burstWaterMain"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic may be disrupted due to local flooding and/or subsidence because of a broken water main."@en ] ;
    ea:value [ ea:name "collapsedSewer"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road surface has sunken or collapsed in places due to sewer failure."@en ] ;
    ea:value [ ea:name "damagedBridge"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Damage to a bridge that may cause traffic disruption."@en ] ;
    ea:value [ ea:name "damagedCrashBarrier"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Damage to a crash barrier that may cause traffic disruption."@en ] ;
    ea:value [ ea:name "damagedFlyover"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Damage to an elevated section of the carriageway over another carriageway that may cause traffic disruption."@en ] ;
    ea:value [ ea:name "damagedGallery"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Damage to a gallery that may cause traffic disruption."@en ] ;
    ea:value [ ea:name "damagedGantry"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Damage to a gantry above the roadway that may cause traffic disruption."@en ] ;
    ea:value [ ea:name "damagedRoadSurface"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Damage to the road surface that may cause traffic disruption."@en ] ;
    ea:value [ ea:name "damagedTunnel"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Damage to a tunnel that may cause traffic disruption."@en ] ;
    ea:value [ ea:name "damagedViaduct"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Damage to a viaduct that may cause traffic disruption."@en ] ;
    ea:value [ ea:name "fallenPowerCables"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road is obstructed or partially obstructed by one or more fallen power cables."@en ] ;
    ea:value [ ea:name "gasLeak"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic may be disrupted due to an explosion hazard from gas escaping in or near the roadway."@en ] ;
    ea:value [ ea:name "weakBridge"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Weak bridge capable of carrying a reduced load, typically with a reduced weight limit restriction imposed."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.InjuryStatusTypeEnum
    a owl:Class ;
    rdfs:label "InjuryStatusTypeEnum"@en ;
    skos:definition "Types of injury status of people."@en ;
    skos:prefLabel "injury status type enum"@en ;
    skos:altLabel "injurystatustypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "dead"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dead."@en ] ;
    ea:value [ ea:name "injured"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Injured requiring medical treatment."@en ] ;
    ea:value [ ea:name "seriouslyInjured"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Seriously injured requiring urgent hospital treatment."@en ] ;
    ea:value [ ea:name "slightlyInjured"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Slightly injured requiring medical treatment."@en ] ;
    ea:value [ ea:name "uninjured"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Uninjured."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Injury status unknown."@en ] .

datex:Situation.InvolvementRolesEnum
    a owl:Class ;
    rdfs:label "InvolvementRolesEnum"@en ;
    skos:definition "Involvement role of a person in event."@en ;
    skos:prefLabel "involvement roles enum"@en ;
    skos:altLabel "involvementrolesenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "cyclist"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Cyclist."@en ] ;
    ea:value [ ea:name "motorcyclist"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motorcyclist"@en ] ;
    ea:value [ ea:name "pedestrian"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pedestrian."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Involvement role is unknown."@en ] ;
    ea:value [ ea:name "vehicleDriver"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle driver."@en ] ;
    ea:value [ ea:name "vehicleOccupant"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle occupant (driver or passenger not specified)."@en ] ;
    ea:value [ ea:name "vehiclePassenger"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle passenger."@en ] ;
    ea:value [ ea:name "witness"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Witness."@en ] .

datex:Situation.MaintenanceVehicleActionsEnum
    a owl:Class ;
    rdfs:label "MaintenanceVehicleActionsEnum"@en ;
    skos:definition "Types of maintenance vehicle actions associated with roadworks."@en ;
    skos:prefLabel "maintenance vehicle actions enum"@en ;
    skos:altLabel "maintenancevehicleactionsenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "maintenanceAction"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Maintenance vehicles are performing maintenance action"@en ] ;
    ea:value [ ea:name "maintenanceVehiclesMergingIntoTrafficFlow"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Maintenance vehicles are merging into the traffic flow creating a potential hazard for road users."@en ] ;
    ea:value [ ea:name "slowMoving"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Maintenance vehicles are slow moving."@en ] ;
    ea:value [ ea:name "stoppingToServiceEquipments"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Maintenance vehicles are stopping to service equipments on or next to the roadway."@en ] .

datex:Situation.MaintenanceVehicles
    a owl:Class ;
    rdfs:label "MaintenanceVehicles"@en ;
    skos:definition "Details of the maintenance vehicles involved in the roadworks activity."@en ;
    skos:prefLabel "maintenance vehicles"@en ;
    skos:altLabel "maintenancevehicles"@en ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/OperatorAction/Roadworks"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "numberOfMaintenanceVehicles"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of maintenance vehicles associated with the roadworks activities at the specified location."@en ] ;
    ea:attribute [ ea:name "maintenanceVehicleActions"@en ; ea:position 2 ; ea:type datex:Situation.MaintenanceVehicleActionsEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The actions of the maintenance vehicles associated with the roadworks activities."@en ] .

datex:Situation.MaintenanceWorks
    a owl:Class ;
    rdfs:label "MaintenanceWorks"@en ;
    skos:definition "Roadworks involving the maintenance or installation of infrastructure."@en ;
    skos:prefLabel "maintenance works"@en ;
    skos:altLabel "maintenanceworks"@en ;
    rdfs:subClassOf datex:Situation.Roadworks ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/OperatorAction/Roadworks"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "roadMaintenanceType"@en ; ea:position 1 ; ea:type datex:Situation.RoadMaintenanceTypeEnum ; ea:lowerBound "1" ; ea:upperBound "*" ; ea:definition "The type of road maintenance or installation work at the specified location."@en ] .

datex:Situation.Mobility
    a owl:Class ;
    rdfs:label "Mobility"@en ;
    skos:definition "An indication of whether the associated instance of a SituationRecord is mobile (e.g. a march or parade moving along a road) or stationary."@en ;
    skos:prefLabel "mobility"@en ;
    rdfs:comment "DATEX II class in namespace Situation / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "mobilityType"@en ; ea:position 1 ; ea:type datex:Situation.MobilityTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An indication of whether the associated instance of a SituationRecord is mobile (e.g. a march or parade moving along a road) or stationary."@en ] ;
    ea:attribute [ ea:name "speed"@en ; ea:position 2 ; ea:type datex:Common.KilometresPerHour ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Speed of the mobile entity."@en ] .

datex:Situation.MobilityTypeEnum
    a owl:Class ;
    rdfs:label "MobilityTypeEnum"@en ;
    skos:definition "Types of mobility relating to a situation element defined by a SituationRecord."@en ;
    skos:prefLabel "mobility type enum"@en ;
    skos:altLabel "mobilitytypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "mobile"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The described element of a situation is moving."@en ] ;
    ea:value [ ea:name "stationary"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The described element of a situation is stationary."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The mobility of the described element of a situation is unknown."@en ] .

datex:Situation.NetworkManagement
    a owl:Class ;
    rdfs:label "NetworkManagement"@en ;
    skos:definition "Network management action which is applicable to the road network and its users."@en ;
    skos:prefLabel "network management"@en ;
    skos:altLabel "networkmanagement"@en ;
    rdfs:subClassOf datex:Situation.OperatorAction ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/OperatorAction/NetworkManagement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "complianceOption"@en ; ea:position 1 ; ea:type datex:Situation.ComplianceOptionEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Defines whether the network management instruction or the control resulting from a network management action is advisory or mandatory."@en ] ;
    ea:attribute [ ea:name "applicableForTrafficDirection"@en ; ea:position 2 ; ea:type datex:LocationReferencing.DirectionEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The ultimate traffic direction to which the network management is applicable."@en ] ;
    ea:attribute [ ea:name "applicableForTrafficType"@en ; ea:position 3 ; ea:type datex:Situation.TrafficTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The type of traffic to which the network management is applicable."@en ] ;
    ea:attribute [ ea:name "placesAtWhichApplicable"@en ; ea:position 4 ; ea:type datex:Situation.PlacesEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Places, in generic terms, at which the network management applies."@en ] ;
    ea:attribute [ ea:name "automaticallyInitiated"@en ; ea:position 5 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Defines whether the network management is initiated by an automatic system."@en ] .

datex:Situation.NetworkManagement.forVehiclesWithCharacteristicsOf
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.NetworkManagement ;
    rdfs:range datex:Common.VehicleCharacteristics ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Situation.NonWeatherRelatedRoadConditionTypeEnum
    a owl:Class ;
    rdfs:label "NonWeatherRelatedRoadConditionTypeEnum"@en ;
    skos:definition "Types of road surface conditions which are not related to the weather."@en ;
    skos:prefLabel "non weather related road condition type enum"@en ;
    skos:altLabel "nonweatherrelatedroadconditiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "dieselOnRoad"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Increased skid risk due to diesel on the road."@en ] ;
    ea:value [ ea:name "leavesOnRoad"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Increased skid risk due to leaves on road."@en ] ;
    ea:value [ ea:name "looseChippings"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Increased skid risk and injury risk due to loose chippings on road."@en ] ;
    ea:value [ ea:name "looseSandOnRoad"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Increased skid risk due to loose sand on road."@en ] ;
    ea:value [ ea:name "mudOnRoad"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Increased skid risk due to mud on road."@en ] ;
    ea:value [ ea:name "oilOnRoad"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Increased skid risk due to oil on road."@en ] ;
    ea:value [ ea:name "petrolOnRoad"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Increased skid risk due to petrol on road."@en ] ;
    ea:value [ ea:name "roadMarkingNotPresent"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Road markings are not present due to maintenance works in progress"@en ] ;
    ea:value [ ea:name "roadSurfaceInPoorCondition"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road surface is damaged, severely rutted or potholed (i.e. it is in a poor state of repair)."@en ] ;
    ea:value [ ea:name "slipperyRoad"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road surface is slippery due to an unspecified non-weather related cause."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.NonWeatherRelatedRoadConditions
    a owl:Class ;
    rdfs:label "NonWeatherRelatedRoadConditions"@en ;
    skos:definition "Road surface conditions that are not related to the weather but which may affect driving conditions."@en ;
    skos:prefLabel "non weather related road conditions"@en ;
    skos:altLabel "nonweatherrelatedroadconditions"@en ;
    rdfs:subClassOf datex:Situation.RoadSurfaceConditions ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement/Conditions"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "nonWeatherRelatedRoadConditionType"@en ; ea:position 1 ; ea:type datex:Situation.NonWeatherRelatedRoadConditionTypeEnum ; ea:lowerBound "1" ; ea:upperBound "*" ; ea:definition "The type of road conditions which are not related to the weather."@en ] .

datex:Situation.Obstruction
    a owl:Class ;
    rdfs:label "Obstruction"@en ;
    skos:definition "Any stationary or moving obstacle of a physical nature (e.g. obstacles or vehicles from an earlier accident, shed loads on carriageway, rock fall, abnormal or dangerous loads, or animals etc.) which could disrupt or endanger traffic."@en ;
    skos:prefLabel "obstruction"@en ;
    rdfs:subClassOf datex:Situation.TrafficElement ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement/Obstruction"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "numberOfObstructions"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of obstructions that are partly or wholly blocking the road."@en ] .

datex:Situation.Obstruction.mobilityOfObstruction
    a owl:ObjectProperty ;
    rdfs:domain datex:Situation.Obstruction ;
    rdfs:range datex:Situation.Mobility ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Situation.ObstructionTypeEnum
    a owl:Class ;
    rdfs:label "ObstructionTypeEnum"@en ;
    skos:definition "Types of obstructions on the roadway."@en ;
    skos:prefLabel "obstruction type enum"@en ;
    skos:altLabel "obstructiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "airCrash"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An air crash adjacent to the roadway which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "childrenOnRoadway"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Children on the roadway which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "clearanceWork"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Clearance work associated with an earlier traffic problem which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "craneOperating"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A crane is operating either on or adjacent to the road which may cause an obstruction to traffic."@en ] ;
    ea:value [ ea:name "cyclistsOnRoadway"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Cyclists on the roadway which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "debris"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Scattered fragments of wreckage or other material on the road."@en ] ;
    ea:value [ ea:name "explosion"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation where an explosive or incendiary device has gone off."@en ] ;
    ea:value [ ea:name "explosionHazard"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A situation where there is danger of an explosion which may cause disruption to traffic."@en ] ;
    ea:value [ ea:name "hazardsOnTheRoad"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unspecified hazard(s) on the road which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "incident"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Incidents are chance occurrences involving vehicles from the traffic stream, which could present potential hazards to road users. This item excludes accidents."@en ] ;
    ea:value [ ea:name "industrialAccident"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Industrial accident near the roadway which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "objectOnTheRoad"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road may be obstructed or traffic hindered due to objects laying on the roadway."@en ] ;
    ea:value [ ea:name "objectsFallingFromMovingVehicle"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Objects falling from moving vehicles which are presenting a hazard to other vehicles."@en ] ;
    ea:value [ ea:name "obstructionOnTheRoad"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unspecified obstruction on the roadway which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "peopleOnRoadway"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "People on the roadway which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "railCrash"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A rail crash adjacent to the roadway which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "rescueAndRecoveryWork"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Work is being undertaken by emergency services which may present a hazard to road users."@en ] ;
    ea:value [ ea:name "severeFrostDamagedRoadway"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Severe frost damage to the roadway causing an obstruction to traffic."@en ] ;
    ea:value [ ea:name "shedLoad"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Spillage of transported goods on the roadway which may cause traffic disruption."@en ] ;
    ea:value [ ea:name "snowAndIceDebris"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Snow and ice debris on the roadway which may present a hazard to road users."@en ] ;
    ea:value [ ea:name "spillageOccurringFromMovingVehicle"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Substances are spilling out from a moving vehicle which is presenting a hazard to other road users."@en ] ;
    ea:value [ ea:name "spillageOnTheRoad"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Includes all situations where a spillage has occurred on the roadway due to an earlier incident."@en ] ;
    ea:value [ ea:name "unprotectedAccidentArea"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An accident area which has not been protected and may present a hazard to road users."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Situation.OperatorAction
    a owl:Class ;
    rdfs:label "OperatorAction"@en ;
    skos:definition "Actions that an authorised operator can decide to implement to prevent or help correct dangerous or poor driving conditions, or any actions affecting normal operation of a road."@en ;
    skos:prefLabel "operator action"@en ;
    skos:altLabel "operatoraction"@en ;
    rdfs:subClassOf datex:Situation.SituationRecord ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/OperatorAction"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "actionOrigin"@en ; ea:position 1 ; ea:type datex:Situation.OperatorActionOriginEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates whether the actions to be undertaken by the operator are the result of an internal operation or external influence."@en ] ;
    ea:attribute [ ea:name "actionPlanIdentifier"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The identifier of the traffic management action plan to which this action relates."@en ] ;
    ea:attribute [ ea:name "operatorActionStatus"@en ; ea:position 3 ; ea:type datex:Situation.OperatorActionStatusEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The status of the defined operator action."@en ] .

datex:Situation.OperatorActionOriginEnum
    a owl:Class ;
    rdfs:label "OperatorActionOriginEnum"@en ;
    skos:definition "Origins of operator actions."@en ;
    skos:prefLabel "operator action origin enum"@en ;
    skos:altLabel "operatoractionoriginenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "external"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Operator action originated externally to the authority which is taking the action."@en ] ;
    ea:value [ ea:name "internal"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Operator action originated within the authority which is taking the action."@en ] .

datex:Situation.OperatorActionStatusEnum
    a owl:Class ;
    rdfs:label "OperatorActionStatusEnum"@en ;
    skos:definition "List of statuses associated with operator actions."@en ;
    skos:prefLabel "operator action status enum"@en ;
    skos:altLabel "operatoractionstatusenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "requested"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A request, either internal or external, has been received to implement an action. It has neither been approved nor has any activity yet been undertaken to implement the action."@en ] ;
    ea:value [ ea:name "approved"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The action has been approved by the recipient of the request but activity to implement the action has not yet commenced."@en ] ;
    ea:value [ ea:name "beingImplemented"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The action is in the process of being implemented."@en ] ;
    ea:value [ ea:name "implemented"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The action is fully implemented."@en ] ;
    ea:value [ ea:name "rejected"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The action has been rejected by the recipient of the request and hence is not implemented."@en ] ;
    ea:value [ ea:name "terminationRequested"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A request, either internal or external, has been received to terminate the action, but activity to terminate the action has not yet commenced."@en ] ;
    ea:value [ ea:name "beingTerminated"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The action is in the process of being terminated either because the action has reached the end of its validity period or because new circumstances have arisen and its termination has been requested, e.g. because of a traffic jam on the alternative route."@en ] .

datex:Situation.PersonCategoryEnum
    a owl:Class ;
    rdfs:label "PersonCategoryEnum"@en ;
    skos:definition "Categories of person."@en ;
    skos:prefLabel "person category enum"@en ;
    skos:altLabel "personcategoryenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "adult"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Adult."@en ] ;
    ea:value [ ea:name "child"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Child (age 4 to 17)."@en ] ;
    ea:value [ ea:name "emergencyServicesPerson"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A member of the emergency services, other than the police."@en ] ;
    ea:value [ ea:name "fireman"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A member of the fire service."@en ] ;
    ea:value [ ea:name "infant"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Infant (age 0 to 3)."@en ] ;
    ea:value [ ea:name "medicalStaff"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A member of the medical service."@en ] ;
    ea:value [ ea:name "memberOfThePublic"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A member of the general public."@en ] ;
    ea:value [ ea:name "policeman"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A member of the police force."@en ] ;
    ea:value [ ea:name "politician"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A politician."@en ] ;
    ea:value [ ea:name "publicTransportPassenger"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A passenger on or from a public transport vehicle."@en ] ;
    ea:value [ ea:name "sickPerson"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A sick person."@en ] ;
    ea:value [ ea:name "trafficOfficer"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A traffic patrol officer of the road authority."@en ] ;
    ea:value [ ea:name "trafficWarden"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A member of the local traffic warden service."@en ] ;
    ea:value [ ea:name "veryImportantPerson"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A very important person."@en ] .

