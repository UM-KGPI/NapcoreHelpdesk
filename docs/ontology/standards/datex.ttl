datex:RoadTrafficData.MeasurementSpecificCharacteristics
    a owl:Class ;
    rdfs:label "MeasurementSpecificCharacteristics"@en ;
    skos:definition "Characteristics which are specific to an individual measurement type (specified in a known order) at the given measurement site."@en ;
    skos:prefLabel "measurement specific characteristics"@en ;
    skos:altLabel "measurementspecificcharacteristics"@en ;
    rdfs:comment "DATEX II class in namespace RoadTrafficData / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "accuracy"@en ; ea:position 1 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The extent to which the value is expected to be free from error, measured as a percentage of the data value. 100% means fully accurate."@en ] ;
    ea:attribute [ ea:name "defaultMeasurementHeight"@en ; ea:position 2 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Default height, above (positive value) or below (negative value) ground level, at which measurements are made. For example in wind measurement this could be the height of an anemometer."@en ] ;
    ea:attribute [ ea:name "computationMethod"@en ; ea:position 3 ; ea:type datex:Common.ComputationMethodEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Method of computation which is used to compute the measured value at the measurement site."@en ] ;
    ea:attribute [ ea:name "period"@en ; ea:position 4 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The time elapsed between the beginning and the end of the sampling or measurement period. This item may differ from the unit attribute; e.g. an hourly flow can be estimated from a 5-minute measurement period."@en ] ;
    ea:attribute [ ea:name "smoothingFactor"@en ; ea:position 5 ; ea:type datex:Common.Float ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Coefficient required when a moving average is computed to give specific weights to the former average and the new data. A typical formula is, F being the smoothing factor: New average = (old average) F + (new data) (1 - F)."@en ] ;
    ea:attribute [ ea:name "specificMeasurementValueType"@en ; ea:position 6 ; ea:type datex:RoadTrafficData.MeasuredOrDerivedDataTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of this specific measurement at the measurement site."@en ] ;
    ea:attribute [ ea:name "measurementSide"@en ; ea:position 7 ; ea:type datex:LocationReferencing.DirectionEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Side of the road on which measurements are acquired, corresponding to the direction of the road."@en ] .

