datex:AfirFacilities.AssignedRightTimeRelative
    a owl:Class ;
    rdfs:label "AssignedRightTimeRelative"@en ;
    skos:definition "Time-based qualification criteria,linked to the possession of a specified Right Specification. Example: permitting a return stay at a specified rate,within defined time window (start and end time windows may be defined)."@en ;
    skos:prefLabel "assigned right time relative"@en ;
    skos:altLabel "assignedrighttimerelative"@en ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / RatesPublication/Eligibility"@en ;
    ea:kind "class" .

datex:AfirFacilities.AssociatedFacility
    a owl:Class ;
    rdfs:label "AssociatedFacility"@en ;
    skos:definition "Another infrastructure site which is either associated or nearby."@en ;
    skos:prefLabel "associated facility"@en ;
    skos:altLabel "associatedfacility"@en ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / Facility"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "type"@en ; ea:position 1 ; ea:type datex:AfirFacilities.FacilityTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specifies the type of facility or infrastructure this facility is associated with, i.e. they are located on the same property and may share entrance and exit."@en ] ;
    ea:attribute [ ea:name "facilityReference"@en ; ea:position 2 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A reference to the associated facility."@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Any additional description of the associated facility."@en ] .

datex:AfirFacilities.AvailabilityEnum
    a owl:Class ;
    rdfs:label "AvailabilityEnum"@en ;
    skos:definition "An enumeration which states if something is available or not."@en ;
    skos:prefLabel "availability enum"@en ;
    skos:altLabel "availabilityenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirFacilities / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "available"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The element in question is available."@en ] ;
    ea:value [ ea:name "notAvailable"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The element in question is not available."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is no information about whether the element in question is available or not."@en ] .

datex:AfirFacilities.ClosureInformation
    a owl:Class ;
    rdfs:label "ClosureInformation"@en ;
    skos:definition "Information about temporary or permanent closure."@en ;
    skos:prefLabel "closure information"@en ;
    skos:altLabel "closureinformation"@en ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / OperatingHoursPublication"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "permananentlyClosed"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Permanently closed, i.e. it is not intended to open again."@en ] ;
    ea:attribute [ ea:name "temporarilyClosed"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Temporarily closed for an unspecified period."@en ] ;
    ea:attribute [ ea:name "closedFrom"@en ; ea:position 3 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Permanently or temporarily closed from the given date on. May lie in the future - in this case the scene is not closed now."@en ] ;
    ea:attribute [ ea:name "temporarilyClosedUntil"@en ; ea:position 4 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Temporarily closed until the given date (i.e. closure still includes this date)."@en ] .

datex:AfirFacilities.ContactInformation
    a owl:Class ;
