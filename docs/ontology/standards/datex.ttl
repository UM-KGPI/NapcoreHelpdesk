datex:LocationReferencing.PercentageDistanceAlongLinearElement
    a owl:Class ;
    rdfs:label "PercentageDistanceAlongLinearElement"@en ;
    skos:definition "Distance of a point along a linear element measured from the start node expressed as a percentage of the whole length of the linear element, where start node is relative to the element definition rather than the direction of traffic flow."@en ;
    skos:prefLabel "percentage distance along linear element"@en ;
    skos:altLabel "percentagedistancealonglinearelement"@en ;
    rdfs:subClassOf datex:LocationReferencing.DistanceAlongLinearElement ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/LinearReferencing/PointAlongLinearElement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "percentageDistanceAlong"@en ; ea:position 1 ; ea:type datex:Common.Percentage ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A measure of distance along a linear element from the start of the element expressed as a percentage of the total length of the linear object. The value 0 represents the starting point of the linear element; 100 represents the end."@en ] .

datex:LocationReferencing.PointAlongLinearElement
    a owl:Class ;
    rdfs:label "PointAlongLinearElement"@en ;
    skos:definition "A point on a linear element where the linear element is either a part of or the whole of a linear object (i.e. a road), consistent with EN ISO 19148 definitions."@en ;
    skos:prefLabel "point along linear element"@en ;
    skos:altLabel "pointalonglinearelement"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/LinearReferencing/PointAlongLinearElement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "administrativeAreaOfPoint"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identification of the road administration area which contains the specified point."@en ] ;
    ea:attribute [ ea:name "directionAtPoint"@en ; ea:position 2 ; ea:type datex:LocationReferencing.DirectionEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The direction of traffic flow at the specified point in terms of general destination direction."@en ] ;
    ea:attribute [ ea:name "directionRelativeAtPoint"@en ; ea:position 3 ; ea:type datex:LocationReferencing.LinearDirectionEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The direction of traffic flow at the specified point relative to the direction in which the linear element is defined."@en ] ;
    ea:attribute [ ea:name "heightGradeOfPoint"@en ; ea:position 4 ; ea:type datex:LocationReferencing.HeightGradeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identification of whether the point on the linear element is at, above or below the normal elevation of a linear element of that type (e.g. road or road section) at that location, typically used to indicate \"grade\" separation."@en ] .

datex:LocationReferencing.PointAlongLinearElement.DistanceAlongLinearElement
    a owl:ObjectProperty ;
