    rdfs:label "OpenlrLineAttributes"@en ;
    skos:definition "Line attributes are part of a location reference point and consists of functional road class (FRC),form of way (FOW) and bearing (BEAR) data."@en ;
    skos:prefLabel "openlr line attributes"@en ;
    skos:altLabel "openlrlineattributes"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/OpenLR"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "openlrFunctionalRoadClass"@en ; ea:position 1 ; ea:type datex:LocationReferencing.OpenlrFunctionalRoadClassEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Certain aspects of the physical form that a Road Element takes. It is based on a number of certain physical and traffic properties. (EN ISO 14825 § 7.2.85)"@en ] ;
    ea:attribute [ ea:name "openlrFormOfWay"@en ; ea:position 2 ; ea:type datex:LocationReferencing.OpenlrFormOfWayEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A classification based on the importance of the role that the Road Element (or Ferry Connection) performs in the connectivity of the total road network. (EN ISO 14825 § 7.2.88)"@en ] ;
    ea:attribute [ ea:name "openlrBearing"@en ; ea:position 3 ; ea:type datex:Common.AngleInDegrees ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "defines the bearing field as an integer value between 0 and 359"@en ] .

