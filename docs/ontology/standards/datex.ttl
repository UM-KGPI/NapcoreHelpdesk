    ea:attribute [ ea:name "description"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Free-text description of a RightSpecification."@en ] ;
    ea:attribute [ ea:name "expiry"@en ; ea:position 3 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Date/time showing the timestamp for when a RightSpecification ceases to be valid."@en ] ;
    ea:attribute [ ea:name "financialReference"@en ; ea:position 4 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Creator defined free-text reference to financial transactions associated to the specific Right Specification."@en ] ;
    ea:attribute [ ea:name "issuer"@en ; ea:position 5 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The issuer of this right."@en ] ;
    ea:attribute [ ea:name "noFeeToUse"@en ; ea:position 6 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "If TRUE Indicates that the related RightSpecification may be used without charge or cost. If FALSE costs and charges apply"@en ] .

datex:Facilities.RightSpecification.Credential
    a owl:ObjectProperty ;
    rdfs:domain datex:Facilities.RightSpecification ;
    rdfs:range datex:Facilities.Credential ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Facilities.RightSpecification.validity
    a owl:ObjectProperty ;
    rdfs:domain datex:Facilities.RightSpecification ;
    rdfs:range datex:Common.Validity ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Facilities.RightTypeEnum
    a owl:Class ;
    rdfs:label "RightTypeEnum"@en ;
    skos:definition "A list of the supported RightSpecification types available for reference."@en ;
    skos:prefLabel "right type enum"@en ;
    skos:altLabel "righttypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Facilities / RatesPublication/Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "oneTimeUseParking"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "RightSpecification intended for one time or limited parking usage."@en ] ;
    ea:value [ ea:name "permitParking"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "RightSpecification intended for multi-use parking usage."@en ] ;
    ea:value [ ea:name "loadingUnloading"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "RightSpecification intended granting permissions to load and unload vehicles."@en ] ;
    ea:value [ ea:name "setdownPickup"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "RightSpecification intended for passenger setdown and pickup."@en ] ;
    ea:value [ ea:name "waiting"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "RightSpecification intended to grant permission for an accompanied vehicle to wait."@en ] ;
    ea:value [ ea:name "accessPermission"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "RightSpecification intended grant access permission."@en ] ;
    ea:value [ ea:name "doingReservation"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "RightSpecification intended granting doing a reservation (e.g. for parking or electric charging)"@en ] ;
    ea:value [ ea:name "electricCharging"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "RightSpecification intended grant electric charging"@en ] .

datex:Facilities.ServiceFacilityTypeEnum
    a owl:Class ;
