datex:Situation.ConstructionWorkTypeEnum
    a owl:Class ;
    rdfs:label "ConstructionWorkTypeEnum"@en ;
    skos:definition "Types of works relating to construction."@en ;
    skos:prefLabel "construction work type enum"@en ;
    skos:altLabel "constructionworktypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "blastingWork"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Blasting or quarrying work at the specified location."@en ] ;
