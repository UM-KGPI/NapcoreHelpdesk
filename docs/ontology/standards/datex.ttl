datex:LocationReferencing.Location
    a owl:Class ;
    rdfs:label "Location"@en ;
    skos:definition "The specification of a location either on a network (as a point or a linear location) or as an area. This may be provided in one or more referencing systems."@en ;
    skos:prefLabel "location"@en ;
    rdfs:subClassOf datex:LocationReferencing.LocationReference ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" .

datex:LocationReferencing.Location.ExternalReferencing
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.Location ;
    rdfs:range datex:LocationReferencing.ExternalReferencing ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:LocationReferencing.Location.coordinatesForDisplay
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.Location ;
    rdfs:range datex:LocationReferencing.PointCoordinates ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:LocationReferencing.LocationByReference
    a owl:Class ;
    rdfs:label "LocationByReference"@en ;
    skos:definition "A location defined by reference to a predefined location."@en ;
    skos:prefLabel "location by reference"@en ;
    skos:altLabel "locationbyreference"@en ;
    rdfs:subClassOf datex:LocationReferencing.Location ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "predefinedLocationReference"@en ; ea:position 1 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A reference to a versioned predefined location."@en ] .

datex:LocationReferencing.LocationGroup
    a owl:Class ;
    rdfs:label "LocationGroup"@en ;
    skos:definition "Multiple (i.e. more than one) physically separate locations which have no specific order."@en ;
    skos:prefLabel "location group"@en ;
    skos:altLabel "locationgroup"@en ;
    rdfs:subClassOf datex:LocationReferencing.LocationReference ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" .

datex:LocationReferencing.LocationGroupByList
    a owl:Class ;
    rdfs:label "LocationGroupByList"@en ;
    skos:definition "A group of (i.e. more than one) physically separate locations which have no specific order and where each location is explicitly listed."@en ;
    skos:prefLabel "location group by list"@en ;
    skos:altLabel "locationgroupbylist"@en ;
    rdfs:subClassOf datex:LocationReferencing.LocationGroup ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" .

datex:LocationReferencing.LocationGroupByList.locationContainedInGroup
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.LocationGroupByList ;
    rdfs:range datex:LocationReferencing.Location ;
    ea:lowerBound "2" ;
    ea:upperBound "*" .

datex:LocationReferencing.LocationGroupByReference
    a owl:Class ;
    rdfs:label "LocationGroupByReference"@en ;
    skos:definition "A group of (i.e. more than one) physically separate locations which have no specific order that are defined by reference to a predefined non ordered location group."@en ;
    skos:prefLabel "location group by reference"@en ;
    skos:altLabel "locationgroupbyreference"@en ;
    rdfs:subClassOf datex:LocationReferencing.LocationGroup ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "predefinedLocationGroupReference"@en ; ea:position 1 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A reference to a versioned instance of a predefined location group as specified in a PredefinedLocationsPublication."@en ] .

datex:LocationReferencing.LocationReference
    a owl:Class ;
    rdfs:label "LocationReference"@en ;
    skos:definition "Represents one or more physically separate locations. Multiple locations may be related, as in an itinerary or route, or may be unrelated. One LocationReference should not use multiple Location objects to represent the same physical location."@en ;
    skos:prefLabel "location reference"@en ;
    skos:altLabel "locationreference"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference"@en ;
    ea:kind "class" .

datex:LocationReferencing.NamedArea
    a owl:Class ;
    rdfs:label "NamedArea"@en ;
    skos:definition "An area defined by a name and/or in terms of known boundaries, such as country or county boundaries or allocated control area of particular authority. The attributes do not form a union; instead, the smallest intersection forms the resulting area."@en ;
    skos:prefLabel "named area"@en ;
    skos:altLabel "namedarea"@en ;
    rdfs:subClassOf datex:Common.NamedArea ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/NamedArea"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "areaName"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The name of the area."@en ] ;
    ea:attribute [ ea:name "namedAreaType"@en ; ea:position 2 ; ea:type datex:LocationReferencing.NamedAreaTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The type of the area."@en ] ;
    ea:attribute [ ea:name "country"@en ; ea:position 3 ; ea:type datex:Common.CountryCode ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "EN ISO 3166-1 two-character country code."@en ] .

datex:LocationReferencing.NamedAreaTypeEnum
    a owl:Class ;
    rdfs:label "NamedAreaTypeEnum"@en ;
    skos:definition "Types of areas."@en ;
    skos:prefLabel "named area type enum"@en ;
    skos:altLabel "namedareatypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "applicationRegion"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Application region"@en ] ;
    ea:value [ ea:name "continent"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Continent"@en ] ;
    ea:value [ ea:name "country"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Country"@en ] ;
    ea:value [ ea:name "countryGroup"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Group of countries."@en ] ;
    ea:value [ ea:name "carParkArea"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Car park area"@en ] ;
    ea:value [ ea:name "carpoolArea"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Carpool area"@en ] ;
    ea:value [ ea:name "fuzzyArea"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fuzzy area"@en ] ;
    ea:value [ ea:name "industrialArea"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Industrial area"@en ] ;
    ea:value [ ea:name "lake"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lake"@en ] ;
    ea:value [ ea:name "meteorologicalArea"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Meteorological area"@en ] ;
    ea:value [ ea:name "metropolitanArea"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Metropolitan area"@en ] ;
    ea:value [ ea:name "municipality"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Municipality"@en ] ;
    ea:value [ ea:name "parkAndRideSite"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A park and ride site"@en ] ;
    ea:value [ ea:name "ruralCounty"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rural county"@en ] ;
    ea:value [ ea:name "sea"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Sea"@en ] ;
    ea:value [ ea:name "touristArea"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Tourist area"@en ] ;
    ea:value [ ea:name "trafficArea"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic area"@en ] ;
    ea:value [ ea:name "urbanCounty"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Urban county"@en ] ;
    ea:value [ ea:name "order1AdministrativeArea"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Order 1 administrative area"@en ] ;
    ea:value [ ea:name "order2AdministrativeArea"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Order 2 administrative area"@en ] ;
    ea:value [ ea:name "order3AdministrativeArea"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Order 3 administrative area"@en ] ;
    ea:value [ ea:name "order4AdministrativeArea"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Order 4 administrative area"@en ] ;
    ea:value [ ea:name "order5AdministrativeArea"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Order 5 administrative area"@en ] ;
    ea:value [ ea:name "policeForceControlArea"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Police force control area"@en ] ;
    ea:value [ ea:name "roadOperatorControlArea"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Road operator control area"@en ] ;
    ea:value [ ea:name "waterArea"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Water area"@en ] .

datex:LocationReferencing.NetworkLocation
    a owl:Class ;
    rdfs:label "NetworkLocation"@en ;
