    ea:value [ ea:name "demolitionWork"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Demolition work associated with the construction work."@en ] ;
    ea:value [ ea:name "roadImprovementOrUpgrading"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Construction work associated with improvements to the road or its layout or with it upgrading."@en ] ;
    ea:value [ ea:name "roadWideningWork"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Road widening work at the specified location."@en ] .

datex:Situation.ConstructionWorks
