    ea:attribute [ ea:name "facilityReference"@en ; ea:position 2 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A reference to the associated facility."@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Any additional description of the associated facility."@en ] .

datex:Facilities.AvailabilityEnum
