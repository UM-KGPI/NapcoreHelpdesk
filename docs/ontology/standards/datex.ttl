    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:RoadTrafficData.TravelTimeTrendTypeEnum
    a owl:Class ;
    rdfs:label "TravelTimeTrendTypeEnum"@en ;
    skos:definition "List of terms used to describe the trend in travel times."@en ;
    skos:prefLabel "travel time trend type enum"@en ;
    skos:altLabel "traveltimetrendtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace RoadTrafficData / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "decreasing"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Travel times are decreasing."@en ] ;
    ea:value [ ea:name "increasing"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Travel times are increasing."@en ] ;
    ea:value [ ea:name "stable"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Travel times are stable."@en ] .

datex:RoadTrafficData.TravelTimeTypeEnum
    a owl:Class ;
    rdfs:label "TravelTimeTypeEnum"@en ;
    skos:definition "List of ways in which travel times are derived."@en ;
    skos:prefLabel "travel time type enum"@en ;
    skos:altLabel "traveltimetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace RoadTrafficData / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "best"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Travel time is derived from the best out of a monitored sample."@en ] ;
    ea:value [ ea:name "estimated"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Travel time is an automated estimate."@en ] ;
    ea:value [ ea:name "instantaneous"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Travel time is derived from instantaneous measurements."@en ] ;
    ea:value [ ea:name "reconstituted"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Travel time is reconstituted from other measurements."@en ] ;
    ea:value [ ea:name "predictor"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Travel time is the output of a predictor, for example a blend of current and historical data, or a traffic flow model using current measurements."@en ] ;
    ea:value [ ea:name "profile"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Travel time is based on past observations, without use of current measurements."@en ] ;
    ea:value [ ea:name "sum"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Travel time is the sum of current travel times on subsections of the specified location."@en ] .

datex:RoadTrafficData.VehiclesPerDay
    a owl:Class ;
    rdfs:label "VehiclesPerDay"@en ;
    skos:definition "A rate of vehicle flow in units of vehicles per day"@en ;
    skos:prefLabel "vehicles per day"@en ;
    skos:altLabel "vehiclesperday"@en ;
    rdfs:subClassOf datex:Common.NonNegativeInteger ;
    rdfs:comment "DATEX II data type in namespace RoadTrafficData / DataTypes"@en ;
    ea:kind "data type" .

datex:RoadTrafficData.VisibilityInformation
    a owl:Class ;
    rdfs:label "VisibilityInformation"@en ;
    skos:definition "Measurements of atmospheric visibility."@en ;
    skos:prefLabel "visibility information"@en ;
    skos:altLabel "visibilityinformation"@en ;
    rdfs:subClassOf datex:RoadTrafficData.WeatherData ;
    rdfs:comment "DATEX II class in namespace RoadTrafficData / Classes/WeatherData"@en ;
    ea:kind "class" .

datex:RoadTrafficData.VisibilityInformation.Visibility
    a owl:ObjectProperty ;
    rdfs:domain datex:RoadTrafficData.VisibilityInformation ;
    rdfs:range datex:Common.Visibility ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:RoadTrafficData.WeatherData
    a owl:Class ;
    rdfs:label "WeatherData"@en ;
    skos:definition "Measured or derived values relating to the weather at a specific location or locations."@en ;
    skos:prefLabel "weather data"@en ;
    skos:altLabel "weatherdata"@en ;
    rdfs:subClassOf datex:RoadTrafficData.BasicData ;
    rdfs:comment "DATEX II class in namespace RoadTrafficData / Classes/WeatherData"@en ;
    ea:kind "class" .

datex:RoadTrafficData.WindInformation
    a owl:Class ;
    rdfs:label "WindInformation"@en ;
    skos:definition "Measurements of wind conditions."@en ;
    skos:prefLabel "wind information"@en ;
    skos:altLabel "windinformation"@en ;
    rdfs:subClassOf datex:RoadTrafficData.WeatherData ;
    rdfs:comment "DATEX II class in namespace RoadTrafficData / Classes/WeatherData"@en ;
