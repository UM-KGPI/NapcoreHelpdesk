    ea:attribute [ ea:name "roofed"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The facility has got a roof."@en ] ;
    ea:attribute [ ea:name "illuminatedRechargingParkingNearby"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "There is a illuminated recharging or refuelling parking location in the immediate surrounding of the facility."@en ] ;
    ea:attribute [ ea:name "roofedRechargingParkingNearby"@en ; ea:position 4 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "There is a roofed recharging or refuelling parking location in the immediate surrounding of the facility."@en ] .

datex:AfirFacilities.AmountInCurrency
    a owl:Class ;
    rdfs:label "AmountInCurrency"@en ;
