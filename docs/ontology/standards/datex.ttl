datex:TrafficManagementPlan.StrategyMeasure
    a owl:Class ;
    rdfs:label "StrategyMeasure"@en ;
    skos:definition "A measure and how it is to be used within context of a strategy"@en ;
    skos:prefLabel "strategy measure"@en ;
    skos:altLabel "strategymeasure"@en ;
    rdfs:comment "DATEX II class in namespace TrafficManagementPlan / Classes/TmplanTable/Scenario"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "essentialForStrategy"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether the Measure is essential for this Strategy, i.e. whether if the Measure cannot be implemented then the Stragegy shall not be implemented (or if running, shall not continue)."@en ] ;
    ea:attribute [ ea:name "processingIndex"@en ; ea:position 2 ; ea:type datex:Common.Integer ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates the order of processing of Measures within a Strategy. When implementing the Strategy, the Measure for a StrategyMeasure with a low processing index should be processed before that for a StrategyMeasure with a higher processing index."@en ] .

datex:TrafficManagementPlan.StrategyMeasure.ActivationConditions
