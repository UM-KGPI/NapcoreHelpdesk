    ea:upperBound "*" .

datex:LocationReferencing.SingleRoadLinearLocation.LinearWithinLinearElement
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.SingleRoadLinearLocation ;
    rdfs:range datex:LocationReferencing.LinearWithinLinearElement ;
