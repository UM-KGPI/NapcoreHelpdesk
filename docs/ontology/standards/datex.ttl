    ea:upperBound "1" .

datex:ReroutingManagementEnhanced.FacilityTypeEnum
    a owl:Class ;
    rdfs:label "FacilityTypeEnum"@en ;
    skos:definition "A collection of different facilities a route might lead to."@en ;
    skos:prefLabel "facility type enum"@en ;
    skos:altLabel "facilitytypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace ReroutingManagementEnhanced / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "carPark"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A car park"@en ] ;
    ea:value [ ea:name "parking"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An area for parking"@en ] ;
    ea:value [ ea:name "publicTransport"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A public transport station or hub"@en ] ;
    ea:value [ ea:name "parkAndDrive"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking for users that share their cars"@en ] ;
    ea:value [ ea:name "parkAndRide"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking for public transport users."@en ] ;
    ea:value [ ea:name "parkAndCycle"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking site for people who continue their journey by bike."@en ] ;
    ea:value [ ea:name "parkAndWalk"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking site for people who continue to walk."@en ] ;
    ea:value [ ea:name "kissAndRide"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking site with possibility for very short parking to drop off (or drop on) passengers for public transport."@en ] ;
    ea:value [ ea:name "liftshare"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking site for people who are sharing their cars."@en ] ;
    ea:value [ ea:name "carSharing"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking site for people who are sharing cars organised by a car sharing company.."@en ] ;
    ea:value [ ea:name "restArea"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a rest area, i.e. people can relax some time outside their car there. Note that the presence of some bench, picnic place or toilet is already sufficient; there is no need for a restaurant or a building."@en ] ;
    ea:value [ ea:name "serviceArea"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site is associated with a service area."@en ] ;
    ea:value [ ea:name "eventParking"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking is associated with an event. Use 'eventParkingType' to specify the event."@en ] ;
    ea:value [ ea:name "dropOff"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site or space(s) are designed for drop off only."@en ] ;
    ea:value [ ea:name "overnightParking"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking site or space(s) are designed for overnight parking. Note that the absence of this scenario does not automatically mean a prohibition of overnight parking. See also PermitsAndProhibitions."@en ] ;
    ea:value [ ea:name "pointOfInterest"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A specific point of interest."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some other usage scenario."@en ] .

datex:ReroutingManagementEnhanced.OccupantCondition
    a owl:Class ;
    rdfs:label "OccupantCondition"@en ;
    skos:definition "Conditions for the occupants of a vehicle."@en ;
    skos:prefLabel "occupant condition"@en ;
    skos:altLabel "occupantcondition"@en ;
    rdfs:subClassOf datex:ReroutingManagementEnhanced.Condition ;
    rdfs:comment "DATEX II class in namespace ReroutingManagementEnhanced / Classes/Allocation"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "disabledWithPermit"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Occupant is disabled with permit."@en ] ;
    ea:attribute [ ea:name "numberOfOccupants"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Total number of occupants including the driver."@en ] .

datex:ReroutingManagementEnhanced.PriorityIndex
    a owl:Class ;
    rdfs:label "PriorityIndex"@en ;
    skos:definition "A priority index for routes with 0 = no priority; up to 10 = highest priority."@en ;
    skos:prefLabel "priority index"@en ;
    skos:altLabel "priorityindex"@en ;
    rdfs:subClassOf datex:Common.NonNegativeInteger ;
    rdfs:comment "DATEX II data type in namespace ReroutingManagementEnhanced / DataTypes"@en ;
    ea:kind "data type" .

datex:ReroutingManagementEnhanced.PtSchedule
    a owl:Class ;
    rdfs:label "PtSchedule"@en ;
    skos:definition "A rough schedule for one or more public transport lines from this stop"@en ;
    skos:prefLabel "pt schedule"@en ;
    skos:altLabel "ptschedule"@en ;
    rdfs:comment "DATEX II class in namespace ReroutingManagementEnhanced / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "lastUpdated"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The timestamp of the latest update of this information."@en ] ;
    ea:attribute [ ea:name "line"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Line or multiple lines for which this schedule is valid"@en ] ;
    ea:attribute [ ea:name "nextDepartures"@en ; ea:position 3 ; ea:type datex:Common.Time ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The next departures for this line / these lines"@en ] ;
    ea:attribute [ ea:name "destination"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A destination that can be reached from this stop"@en ] ;
    ea:attribute [ ea:name "interval"@en ; ea:position 5 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The interval for reaching the destination from this stop"@en ] ;
    ea:attribute [ ea:name "travelTimeToDestination"@en ; ea:position 6 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The travel time to reach the destination from this stop"@en ] ;
    ea:attribute [ ea:name "ptType"@en ; ea:position 7 ; ea:type datex:ReroutingManagementEnhanced.PublicTransportTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The type of public transport"@en ] ;
    ea:attribute [ ea:name "ptVehicleType"@en ; ea:position 8 ; ea:type datex:ReroutingManagementEnhanced.PublicTransportVehicleType ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The type of public transport vehicle."@en ] ;
    ea:attribute [ ea:name "ptVehicleName"@en ; ea:position 9 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A name of the specific vehicle type, for example \"Railjet\"."@en ] ;
    ea:attribute [ ea:name "ptOperator"@en ; ea:position 10 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Information about the operator of this public transport."@en ] .

datex:ReroutingManagementEnhanced.PtSchedule.Validity
    a owl:ObjectProperty ;
    rdfs:domain datex:ReroutingManagementEnhanced.PtSchedule ;
    rdfs:range datex:Common.Validity ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:ReroutingManagementEnhanced.PublicTransportTypeEnum
    a owl:Class ;
    rdfs:label "PublicTransportTypeEnum"@en ;
    skos:definition "Special measures in the context of public transport."@en ;
    skos:prefLabel "public transport type enum"@en ;
    skos:altLabel "publictransporttypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace ReroutingManagementEnhanced / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "freePublicTransport"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Use of public transport is free at all."@en ] ;
    ea:value [ ea:name "nonFreePublicTransport"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "For the use of this public transport a fee must be paid / a ticket must be purchased"@en ] ;
    ea:value [ ea:name "onDemandTraffic"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "This service is running only on demand"@en ] ;
    ea:value [ ea:name "railReplacementService"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is a replacement service for rail traffic in place, usually served by buses."@en ] ;
    ea:value [ ea:name "shuttleService"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Shuttle services are in place, usually to reach a specific destination or event."@en ] .

datex:ReroutingManagementEnhanced.PublicTransportVehicleType
    a owl:Class ;
    rdfs:label "PublicTransportVehicleType"@en ;
    skos:definition "Types of public transport vehicles"@en ;
    skos:prefLabel "public transport vehicle type"@en ;
    skos:altLabel "publictransportvehicletype"@en ;
    rdfs:comment "DATEX II enumeration in namespace ReroutingManagementEnhanced / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "bus"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A bus"@en ] ;
    ea:value [ ea:name "coach"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A coach"@en ] ;
    ea:value [ ea:name "miniBus"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A small bus"@en ] ;
    ea:value [ ea:name "subway"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A subway"@en ] ;
    ea:value [ ea:name "taxi"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A taxi"@en ] ;
    ea:value [ ea:name "train"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A train"@en ] ;
    ea:value [ ea:name "tram"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A tram"@en ] .

datex:ReroutingManagementEnhanced.ReroutingAdviceTypeEnum
    a owl:Class ;
    rdfs:label "ReroutingAdviceTypeEnum"@en ;
    skos:definition "Advices related to rerouting."@en ;
    skos:prefLabel "rerouting advice type enum"@en ;
    skos:altLabel "reroutingadvicetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace ReroutingManagementEnhanced / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "doNotFollowDiversionSigns"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Do not follow diversion signs."@en ] ;
    ea:value [ ea:name "doNotUseEntry"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is not to use the specified entry onto the identified road to commence the alternative route."@en ] ;
    ea:value [ ea:name "doNotUseExit"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is not to use the specified exit from the identified road to commence the alternative route."@en ] ;
    ea:value [ ea:name "doNotUseIntersectionOrJunction"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is not to use the specified intersection or junction."@en ] ;
    ea:value [ ea:name "followDiversionSigns"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is to follow the diversion signs."@en ] ;
    ea:value [ ea:name "followLocalDiversion"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is to follow local diversion."@en ] ;
    ea:value [ ea:name "followSpecialMarkers"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is to follow the special diversion markers."@en ] ;
    ea:value [ ea:name "useEntry"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is to use the specified entry onto the identified road to commence the alternative route."@en ] ;
    ea:value [ ea:name "useExit"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is to use the specified exit from the identified road to commence the alternative route."@en ] ;
    ea:value [ ea:name "useIntersectionOrJunction"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is to use the specified intersection or junction to commence the alternative route."@en ] .

datex:ReroutingManagementEnhanced.ReroutingManagementEnhanced
    a owl:Class ;
    rdfs:label "ReroutingManagementEnhanced"@en ;
    skos:definition "Description of one or more alternative routes (and additional measures) which are differentiated from the original route that may be congested, blocked or closed."@en ;
    skos:prefLabel "rerouting management enhanced"@en ;
    skos:altLabel "reroutingmanagementenhanced"@en ;
    rdfs:subClassOf datex:Situation.NetworkManagement ;
    rdfs:comment "DATEX II class in namespace ReroutingManagementEnhanced / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "name"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A given name for the specific route management."@en ] ;
    ea:attribute [ ea:name "type"@en ; ea:position 2 ; ea:type datex:ReroutingManagementEnhanced.ReroutingTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The type of rerouting."@en ] ;
    ea:attribute [ ea:name "bindingTrafficRegulation"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates that the rerouting information is a binding traffic regulation (i.e. shall be followed)."@en ] ;
    ea:attribute [ ea:name "preventiveMeasure"@en ; ea:position 4 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates an action that is taken in advance (e.g. before an incident or traffic disruption occurs)."@en ] .

