    ea:attribute [ ea:name "openlrDistanceToNextLRPoint"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The DNP attribute measures the distance in meters between two consecutive location reference-points along the location reference path described in the corresponding enumeration"@en ] .

datex:LocationReferencing.OpenlrPoiWithAccessPoint
    a owl:Class ;
    rdfs:label "OpenlrPoiWithAccessPoint"@en ;
    skos:definition "A point of interest (POI) along a line with access is a point location which is defined by a linear reference path, an offset value (defining the access point) from the starting node of this path and a coordinate pair that defines the POI itself."@en ;
    skos:prefLabel "openlr poi with access point"@en ;
    skos:altLabel "openlrpoiwithaccesspoint"@en ;
    rdfs:subClassOf datex:LocationReferencing.OpenlrBasePointLocation ;
