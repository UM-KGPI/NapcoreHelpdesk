datex:RoadTrafficData.ReferenceSettings
    a owl:Class ;
    rdfs:label "ReferenceSettings"@en ;
    skos:definition "Specification of default values for locations on the road network. Where a default status value is supplied, it shall apply for all specified locations, unless the publication includes an additional status value for a specified location."@en ;
    skos:prefLabel "reference settings"@en ;
    skos:altLabel "referencesettings"@en ;
    rdfs:comment "DATEX II class in namespace RoadTrafficData / Classes"@en ;
