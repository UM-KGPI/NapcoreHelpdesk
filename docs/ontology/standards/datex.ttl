datex:Parking.ParkingRouteTypeEnum
    a owl:Class ;
    rdfs:label "ParkingRouteTypeEnum"@en ;
    skos:definition "The type of the parking route."@en ;
    skos:prefLabel "parking route type enum"@en ;
    skos:altLabel "parkingroutetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "pedestrian"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking route for pedestrian."@en ] ;
    ea:value [ ea:name "bicycle"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking route for bicycles."@en ] ;
    ea:value [ ea:name "lorry"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking route for lorries."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Another type of parking route."@en ] .

datex:Parking.ParkingSafetyEnum
    a owl:Class ;
    rdfs:label "ParkingSafetyEnum"@en ;
    skos:definition "Safety requirements for truck parking sites according to European Secure Parking Organisation."@en ;
    skos:prefLabel "parking safety enum"@en ;
    skos:altLabel "parkingsafetyenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "clearDistinctionCarsHGV"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Separate parking for cars and HGVs clearly indicated."@en ] ;
    ea:value [ ea:name "clearSafetySigns"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Clear signs that promote a safe traffic situation at the Truck Parking Area. Signs preferably with pictograms."@en ] ;
    ea:value [ ea:name "emergencySafety"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Contingency plan / management available / emergency contacts known to the staff. Examples of contacts: police, fire brigade, first aid, doctor."@en ] ;
    ea:value [ ea:name "pedestrianSafety"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pedestrian safety on Truck Parking Area."@en ] ;
    ea:value [ ea:name "safeDecelerationAndAcceleration"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Safe deceleration at entrance/ acceleration at exit."@en ] ;
    ea:value [ ea:name "seperatedDangerousGood"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Separate dangerous goods parking and cargo registration."@en ] .

datex:Parking.ParkingSecurityEnum
    a owl:Class ;
    rdfs:label "ParkingSecurityEnum"@en ;
    skos:definition "Specifies security measures related to the parking site or particular spaces."@en ;
    skos:prefLabel "parking security enum"@en ;
    skos:altLabel "parkingsecurityenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "socialControl"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Social control e.g. parking situated in a neighbourhood."@en ] ;
    ea:value [ ea:name "securityStaff"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Security staff."@en ] ;
    ea:value [ ea:name "externalSecurity"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "External security, e.g. police or staff not directly belonging to the parking."@en ] ;
    ea:value [ ea:name "cctv"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "CCTV (camera observation)."@en ] ;
    ea:value [ ea:name "dog"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dog."@en ] ;
    ea:value [ ea:name "guard24hours"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "24/24 guard."@en ] ;
    ea:value [ ea:name "lighting"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Site is illuminated in a normal way (but not as strong as 'floodLight')."@en ] ;
    ea:value [ ea:name "floodLight"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Flood light (stronger than lighting)."@en ] ;
    ea:value [ ea:name "fences"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fences."@en ] ;
    ea:value [ ea:name "areaSeperatedFromSurroundings"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Site is separated from its surroundings. Can also be used to express a space for noise-producing vehicles, e.g. lorries with cooling generators."@en ] ;
    ea:value [ ea:name "none"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There are no security measures."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unknown."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "None of the values in this enumeration applies. Use 'parkingAdditionalSecurity' instead."@en ] .

datex:Parking.ParkingSpaceConvenienceEnum
    a owl:Class ;
    rdfs:label "ParkingSpaceConvenienceEnum"@en ;
    skos:definition "Facilities for persons with disabilities."@en ;
    skos:prefLabel "parking space convenience enum"@en ;
    skos:altLabel "parkingspaceconvenienceenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "extraSpaceLeftSide"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is some extra space on the left side of the parking space (in parking direction point of view), for example to improve the situation for wheelchair users."@en ] ;
    ea:value [ ea:name "extraSpaceRightSide"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is some extra space on the right side of the parking space (in parking direction point of view), for example to improve the situation for wheelchair users."@en ] ;
    ea:value [ ea:name "nearbyPedestrianExit"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The parking space is quite near to a pedestrian exit. Note: Can be more exactly defined by using 'dedicatedAccess'."@en ] ;
    ea:value [ ea:name "bordersMarked"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The border of the parking space is marked (painted on the ground)."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

datex:Parking.ParkingSpaceOccupancyDetectionEnum
    a owl:Class ;
    rdfs:label "ParkingSpaceOccupancyDetectionEnum"@en ;
    skos:definition "A list of supported methods for detection of occupancy by a vehicle in a parking space."@en ;
    skos:prefLabel "parking space occupancy detection enum"@en ;
    skos:altLabel "parkingspaceoccupancydetectionenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "visual"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Operator/owner makes periodic visual counts of the facility."@en ] ;
    ea:value [ ea:name "anpr"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Automated License Plate Recognition information is tracked for inbound and outbound traffic. The difference between in and out counts enables an occupancy count."@en ] ;
    ea:value [ ea:name "imageAnalytics"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Image analytics are used to evaluate a picture with known parking space geography and computer vision is used to determine occupancy at a point in time."@en ] ;
    ea:value [ ea:name "videoAnalytics"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Video analytics are used to evaluate a video stream to identify objects (vehicles) and direction of travel. The difference between the inbound objects and outbound objects determines occupancy."@en ] ;
    ea:value [ ea:name "videoSpace"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Video analytics or ANPR technologies are used to evaluate a video stream with known space geometry to identify objects (vehicles or license plates) occupying specific spaces."@en ] ;
    ea:value [ ea:name "spaceSensor"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A sensor in each space detects the presence of a vehicle."@en ] ;
    ea:value [ ea:name "userDeclaration"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "User self-declared, where the user enters a space identifier and/or vehicle registration number, typically at the start of a parking session."@en ] ;
    ea:value [ ea:name "balancing"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Counting and balancing incoming and outcoming traffic amount ('indirect' method)."@en ] ;
    ea:value [ ea:name "modelBased"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Occupancy detection is based on some model, i.e. hydrograph, forecasting or estimation."@en ] ;
    ea:value [ ea:name "none"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No occupancy detection available."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unknown."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

datex:Parking.ParkingStatusInformation
    a owl:Class ;
    rdfs:label "ParkingStatusInformation"@en ;
    skos:definition "General status information for parking related objects. Can also be historical or forecasted data. In this case, 'StatusValidity' must be specified."@en ;
    skos:prefLabel "parking status information"@en ;
    skos:altLabel "parkingstatusinformation"@en ;
    rdfs:subClassOf datex:Facilities.FacilityStatus ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/ParkingStatus"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "queueingTime"@en ; ea:position 1 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The current queuing time (duration) for entering the parking site."@en ] ;
    ea:attribute [ ea:name "parkingConditions"@en ; ea:position 2 ; ea:type datex:Parking.ParkingConditionsEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Defines if normal parking conditions are suspended or special parking conditions are in force."@en ] ;
    ea:attribute [ ea:name "blurredAvailability"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "When true, availability and occupancy information (free spaces etc.) is withheld or only published roughly, usually because of business competition."@en ] ;
    ea:attribute [ ea:name "parkingFault"@en ; ea:position 4 ; ea:type datex:Parking.ParkingFaultEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "A fault indicator for the parking site."@en ] ;
    ea:attribute [ ea:name "winterEquipmentManagementType"@en ; ea:position 5 ; ea:type datex:Common.WinterEquipmentManagementTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Type of winter equipment management action instigated by operator."@en ] .

