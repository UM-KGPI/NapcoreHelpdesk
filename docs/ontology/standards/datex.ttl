datex:TrafficManagementPlan.TmplanImplementingAction
    a owl:Class ;
    rdfs:label "TmplanImplementingAction"@en ;
    skos:definition "Represents the information of an OperatorAction which has been implemented or is planned based on a Traffic Management Plan activation request."@en ;
    skos:prefLabel "tmplan implementing action"@en ;
    skos:altLabel "tmplanimplementingaction"@en ;
    rdfs:comment "DATEX II class in namespace TrafficManagementPlan / Classes/TmplanImplementingAction"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "nonPredefinedActionIdReference"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The common reference to an external identifier for a non-predefined action, shared between data supplier and recepient, defined during the Traffic Management Plan design phase."@en ] ;
    ea:attribute [ ea:name "predefinedActionReference"@en ; ea:position 2 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The reference to the specific action defined in a predefined Traffic Management Plan for which the SituationRecord is an implementation."@en ] ;
    ea:attribute [ ea:name "predefinedMeasureReference"@en ; ea:position 3 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The reference to the specific measure chosen to be implemented."@en ] ;
    ea:attribute [ ea:name "predefinedStrategyReference"@en ; ea:position 4 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Reference to a strategy chosen to be implemented."@en ] .

datex:TrafficManagementPlan.TmplanOperation
    a owl:Class ;
    rdfs:label "TmplanOperation"@en ;
    skos:definition "The operation status in the lifecycle of a specific real-time Traffic Management Plan which is needed to manage after some scenario is running in the road network."@en ;
    skos:prefLabel "tmplan operation"@en ;
    skos:altLabel "tmplanoperation"@en ;
    rdfs:comment "DATEX II class in namespace TrafficManagementPlan / Classes/TmplanOperation"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "creationTime"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Creation time of the Traffic Management Plan life cycle, i.e. the time when either an agreement or an implementation was requested."@en ] ;
    ea:attribute [ ea:name "versionTime"@en ; ea:position 2 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Timestamp for this current version of the operational status."@en ] ;
    ea:attribute [ ea:name "expiryTime"@en ; ea:position 3 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A timestamp after which the Traffic Management Plan is no further to be implemented."@en ] ;
    ea:attribute [ ea:name "status"@en ; ea:position 4 ; ea:type datex:TrafficManagementPlan.TmplanOperationStatusEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The operational status of the Traffic Management Plan."@en ] ;
    ea:attribute [ ea:name "statusReason"@en ; ea:position 5 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Textual description for the reason of the current Traffic Management Plan operation status."@en ] ;
    ea:attribute [ ea:name "involvedRoadOperatorConsensusRate"@en ; ea:position 6 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Ratio of agreement to participation of all partners affected by the TMP in the coordination process. Partners are those organisations whose approval is required to enact the TMP."@en ] .

datex:TrafficManagementPlan.TmplanOperation.HeaderInformation
    a owl:ObjectProperty ;
    rdfs:domain datex:TrafficManagementPlan.TmplanOperation ;
    rdfs:range datex:Common.HeaderInformation ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:TrafficManagementPlan.TmplanOperationPublication
    a owl:Class ;
    rdfs:label "TmplanOperationPublication"@en ;
