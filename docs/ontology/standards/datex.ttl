    ea:attribute [ ea:name "roadOrCarriagewayOrLaneStatus"@en ; ea:position 2 ; ea:type datex:TrafficRegulation.RoadOrCarriagewayOrLaneStatus ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The status of the road or carriageway or lane."@en ] ;
    ea:attribute [ ea:name "temporaryMarkings"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "This flag indicates whether the alternate road/carriageway/lane layout is indicated by temporary markings."@en ] .

datex:TrafficRegulation.AlternateRoadOrCarriagewayOrLaneLayout.SpeedLimit
    a owl:ObjectProperty ;
