datex:LocationReferencing.OpenlrOffsets
    a owl:Class ;
    rdfs:label "OpenlrOffsets"@en ;
    skos:definition "Offsets are used to locate the start and end of a location more precisely than bounding to the nodes in a network."@en ;
    skos:prefLabel "openlr offsets"@en ;
    skos:altLabel "openlroffsets"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/OpenLR"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "openlrPositiveOffset"@en ; ea:position 1 ; ea:type datex:Common.MetresAsNonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The positive offset along the line of the location measured along the line reference path between the start point of the location reference and the starting node of the line reference path."@en ] ;
    ea:attribute [ ea:name "openlrNegativeOffset"@en ; ea:position 2 ; ea:type datex:Common.MetresAsNonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The negative offset along the line of the location measured along the line reference path between the end point of the location reference and the ending node of the line reference path."@en ] .

