datex:FaultAndStatus.OperationalDeviceStateEnum
    a owl:Class ;
    rdfs:label "OperationalDeviceStateEnum"@en ;
    skos:definition "This enumeration provides information on the operational state of a device."@en ;
    skos:prefLabel "operational device state enum"@en ;
    skos:altLabel "operationaldevicestateenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace FaultAndStatus / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "maintenanceMode"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device is undergoing maintenance activities and is not available for operational use."@en ] ;
    ea:value [ ea:name "on"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device is powered on and ready to act"@en ] ;
    ea:value [ ea:name "off"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device is powered off."@en ] ;
    ea:value [ ea:name "powerSafeMode"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device is in a special mode to save power until full functionality is needed."@en ] ;
    ea:value [ ea:name "specialMode"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device is operating in some special mode (for example traffic lights being in a night mode)."@en ] ;
    ea:value [ ea:name "temporarilyDeactivated"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device is set out of operation for limited time."@en ] ;
    ea:value [ ea:name "permanentlyDeactivated"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device is set out of order and will not be reactivated."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The operational status is unknown."@en ] .

