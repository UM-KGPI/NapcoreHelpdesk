    ea:kind "enumeration" ;
    ea:value [ ea:name "pricePerMinute"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The given price is per minute of charging."@en ] ;
    ea:value [ ea:name "pricePerKg"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The given price is per kilogram of gas."@en ] ;
    ea:value [ ea:name "pricePerKWh"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The given price is per kWh of electric energy."@en ] ;
    ea:value [ ea:name "basePrice"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The given price is a base price, which has to be added."@en ] ;
    ea:value [ ea:name "flatRate"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The given price is a flatrate price, independent of the fueled amunt."@en ] ;
    ea:value [ ea:name "free"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Charging or refueling is free."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other method of pricing."@en ] .

datex:AfirEnergyInfrastructure.RatePolicyEnum
    a owl:Class ;
