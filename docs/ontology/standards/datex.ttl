    ea:value [ ea:name "animalUnderGuidance"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An animal that is guided, singly or in herds or flocks or draught or pack or saddled animal on a road."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Non-vehicular road user other than specified."@en ] .

datex:UrbanExtensions.NonVehicularRoadUsers
    a owl:Class ;
    rdfs:label "NonVehicularRoadUsers"@en ;
    skos:definition "Road users who are not users of vehicles (e.g. pedestrians)"@en ;
