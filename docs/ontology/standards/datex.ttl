    ea:attribute [ ea:name "lastStateUpdate"@en ; ea:position 4 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The time the operational state information was last updated."@en ] .

