    skos:altLabel "alertcdirectionenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "negative"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The direction of navigation in an ALERT-C table that corresponds to the negative offset usage to go from the secondary location to the primary location within the ALERT-C location table."@en ] ;
    ea:value [ ea:name "positive"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The direction of navigation in an ALERT-C table that corresponds to the positive offset usage to go from the secondary location to the primary location within the ALERT-C location table."@en ] .

