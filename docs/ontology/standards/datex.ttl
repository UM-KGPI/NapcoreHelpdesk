datex:LocationReferencing.NetworkLocation.SupplementaryPositionalDescription
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.NetworkLocation ;
    rdfs:range datex:LocationReferencing.SupplementaryPositionalDescription ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:LocationReferencing.NutsCode
    a owl:Class ;
    rdfs:label "NutsCode"@en ;
