    ea:value [ ea:name "motorwayRestaurantSmall"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Smaller type of restaurant located on a motorway rest area. Might be with limited offers."@en ] ;
    ea:value [ ea:name "overnightAccommodation"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An accommodation to stay overnight."@en ] ;
    ea:value [ ea:name "petrolStation"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates whether it is possible to get petrol."@en ] ;
    ea:value [ ea:name "pharmacy"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pharmacy."@en ] ;
    ea:value [ ea:name "payDesk"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A manned possibility to pay."@en ] ;
    ea:value [ ea:name "police"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates whether a police station is on site or very close."@en ] ;
