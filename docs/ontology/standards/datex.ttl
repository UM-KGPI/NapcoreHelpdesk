    ea:value [ ea:name "longTermParkers"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Long-term parker."@en ] ;
    ea:value [ ea:name "members"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Members."@en ] ;
    ea:value [ ea:name "men"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Men."@en ] ;
    ea:value [ ea:name "overnightParkers"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Overnight parker."@en ] ;
