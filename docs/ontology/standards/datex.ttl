datex:Parking.AdditionalCharacteristics
    a owl:Class ;
    rdfs:label "AdditionalCharacteristics"@en ;
    skos:definition "Common additional characteristics for campus, (sub)places and spaces."@en ;
    skos:prefLabel "additional characteristics"@en ;
    skos:altLabel "additionalcharacteristics"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/CommonComponents"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "floor"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The floor on which the described place, subplace or space is located. The numbering or lettering scheme may follow local conventions."@en ] ;
    ea:attribute [ ea:name "weightLimit"@en ; ea:position 2 ; ea:type datex:Common.Tonnes ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Weight limit for the space."@en ] ;
    ea:attribute [ ea:name "additionalConvenience"@en ; ea:position 3 ; ea:type datex:Parking.ParkingSpaceConvenienceEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Further facilities for persons with disabilities."@en ] ;
    ea:attribute [ ea:name "structuralCharacteristics"@en ; ea:position 4 ; ea:type datex:Parking.ParkingStructuralCharacteristicsEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Structural characteristics of a parking space or this parking area."@en ] ;
    ea:attribute [ ea:name "parkingMode"@en ; ea:position 5 ; ea:type datex:Parking.ParkingModeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The arrangement of the parking space(s) in relation to the road."@en ] ;
    ea:attribute [ ea:name "distanceFromPrimaryRoad"@en ; ea:position 6 ; ea:type datex:Common.MetresAsNonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specifies the distance from the primary road in metres. Especially useful, if parking is located on a smaller type of road."@en ] ;
    ea:attribute [ ea:name "occupancyDetection"@en ; ea:position 7 ; ea:type datex:Parking.ParkingSpaceOccupancyDetectionEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates the form of detection that is used to determine space occupancy"@en ] ;
    ea:attribute [ ea:name "temporarilyParking"@en ; ea:position 8 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates that this campus, (sub)place or space only exists on a temporarily basis. It might close permanently within short notice or might only be partially equipped. The physical parking possibilities might be provisional, too."@en ] .

