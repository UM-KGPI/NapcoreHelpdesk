    skos:altLabel "physicalquantityfault"@en ;
    rdfs:subClassOf datex:Common.Fault ;
    rdfs:comment "DATEX II class in namespace RoadTrafficData / Classes/PhysicalQuantity"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "physicalQuantityFaultType"@en ; ea:position 1 ; ea:type datex:RoadTrafficData.PhysicalQuantityFaultEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of fault related to the measurement or calculation of the physical quantity"@en ] .

datex:RoadTrafficData.PhysicalQuantityFaultEnum
    a owl:Class ;
    rdfs:label "PhysicalQuantityFaultEnum"@en ;
    skos:definition "Types of faults that may affect the measurement or calculation of physical quantities"@en ;
    skos:prefLabel "physical quantity fault enum"@en ;
    skos:altLabel "physicalquantityfaultenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace RoadTrafficData / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "intermittentDataValues"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Data values are being produced at intermittent intervals which are not consistent with the expected reporting interval."@en ] ;
    ea:value [ ea:name "noDataValuesAvailable"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No measured or calculated data values are currently available."@en ] ;
    ea:value [ ea:name "spuriousUnreliableDataValues"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Spurious or unreliable data values are being produced."@en ] ;
    ea:value [ ea:name "unspecifiedOrUnknownFault"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An unspecified or unknown fault exists in the process which is generating the measured or calculated data."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

