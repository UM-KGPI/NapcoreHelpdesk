    skos:prefLabel "energy source enum"@en ;
    skos:altLabel "energysourceenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Facilities / RatesPublication/Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "all"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "All sort of fuel is accepted."@en ] ;
    ea:value [ ea:name "battery"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Battery."@en ] ;
    ea:value [ ea:name "biodiesel"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Biodiesel."@en ] ;
    ea:value [ ea:name "diesel"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fuel used for compression-ignition (CI) engines."@en ] ;
    ea:value [ ea:name "dieselBatteryHybrid"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Diesel and battery hybrid."@en ] ;
    ea:value [ ea:name "ethanol"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Ethanol."@en ] ;
    ea:value [ ea:name "hydrogen"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Hydrogen."@en ] ;
    ea:value [ ea:name "liquidGas"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Liquid gas of any type including LPG."@en ] ;
    ea:value [ ea:name "lpg"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Liquid petroleum gas."@en ] ;
    ea:value [ ea:name "methane"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Methane gas."@en ] ;
    ea:value [ ea:name "petrol"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fuel used for positive-ignition (PI) engines."@en ] ;
    ea:value [ ea:name "petrol95Octane"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Petrol with 95 octane."@en ] ;
    ea:value [ ea:name "petrol98Octane"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Petrol with 98 octane."@en ] ;
    ea:value [ ea:name "petrolBatteryHybrid"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Petrol and battery hybrid."@en ] ;
    ea:value [ ea:name "petrolLeaded"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Leaded petrol."@en ] ;
    ea:value [ ea:name "petrolUnleaded"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unleaded petrol."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The sort of fuel is not known."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

datex:Facilities.EquipmentTypeEnum
    a owl:Class ;
    rdfs:label "EquipmentTypeEnum"@en ;
    skos:definition "Types of equipment."@en ;
    skos:prefLabel "equipment type enum"@en ;
    skos:altLabel "equipmenttypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Facilities / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "bikeParking"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Bike parking."@en ] ;
    ea:value [ ea:name "cashMachine"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Cash machine."@en ] ;
    ea:value [ ea:name "copyMachineOrService"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A possibility to create copies of documents."@en ] ;
    ea:value [ ea:name "defibrillator"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Medical equipment to provide first aid after heart attacks."@en ] ;
    ea:value [ ea:name "dsrcReceiver"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A system to manage digital short range communication (radio beacon transceivers), e.g. for tolling roadside equipment."@en ] ;
    ea:value [ ea:name "dumpingStation"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Possibility to get rid of sewage (especially for motorhomes)."@en ] ;
    ea:value [ ea:name "electricChargingStation"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "For charging vehicles, motorhome supply etc. The quantity attribute specifies the number of charging stations."@en ] ;
    ea:value [ ea:name "elevator"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indication of the availability of elevators."@en ] ;
    ea:value [ ea:name "faxMachineOrService"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A possibility to send and/or receive faxes."@en ] ;
    ea:value [ ea:name "fireExtinguisher"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fire extinguisher"@en ] ;
    ea:value [ ea:name "fireHose"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A hose for water transport in case of fire."@en ] ;
    ea:value [ ea:name "fireHydrant"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fire hydrant"@en ] ;
    ea:value [ ea:name "firstAidEquipment"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Equipment to support first aid on injured people. Note that 'defibrillator' is a separate literal."@en ] ;
    ea:value [ ea:name "iceFreeScaffold"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A technical equipment to remove ice and snow from the roof of lorries."@en ] ;
    ea:value [ ea:name "informationPoint"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An information point with employees."@en ] ;
    ea:value [ ea:name "informationStele"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An unmanned information point."@en ] ;
    ea:value [ ea:name "internetTerminal"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Public internet terminal. Charges may be specified using the TariffsAndPayment section."@en ] ;
    ea:value [ ea:name "internetWireless"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Public wireless internet. Specifying an amount would be the number of hotspots/access points. Charges may be specified using the TariffsAndPayment section."@en ] ;
    ea:value [ ea:name "luggageLocker"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Possibility to deposit luggage in a safe way."@en ] ;
    ea:value [ ea:name "paymentMachine"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A payment machine, for example a parking ticket machine."@en ] ;
    ea:value [ ea:name "picnicFacilities"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indication of whether any picnicking facilities, such as tables, chairs and shaded areas, are available."@en ] ;
    ea:value [ ea:name "playground"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A playground for children."@en ] ;
    ea:value [ ea:name "publicCardPhone"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates whether there is a public telephone available that can be used with a card."@en ] ;
    ea:value [ ea:name "publicCoinPhone"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates whether there is a public telephone available that can be used with coins."@en ] ;
    ea:value [ ea:name "publicPhone"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates whether there is a public telephone available."@en ] ;
    ea:value [ ea:name "refuseBin"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Refuse bins for small amounts of garbage (see also 'wasteDisposal')."@en ] ;
    ea:value [ ea:name "safeDeposit"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A possibility to store valuable possession in a safe way."@en ] ;
    ea:value [ ea:name "shelter"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A shelter (against wind, sun, ....)."@en ] ;
    ea:value [ ea:name "shower"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates whether there are shower facilities available."@en ] ;
    ea:value [ ea:name "snowAndIceRemovalEquipment"@en ; ea:position 30 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Equipment to remove snow and ice."@en ] ;
    ea:value [ ea:name "toilet"@en ; ea:position 31 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates whether there are toilets available."@en ] ;
    ea:value [ ea:name "tollTerminal"@en ; ea:position 32 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A terminal, where toll charges can be paid manually (this does not mean a toll gate on the road)"@en ] ;
    ea:value [ ea:name "tyreAirPressureEquipment"@en ; ea:position 33 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Equipment to measure and refill tyre air pressure."@en ] ;
    ea:value [ ea:name "waterBasin"@en ; ea:position 34 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A water basin to wash hands, clothes or dishes."@en ] ;
    ea:value [ ea:name "vendingMachine"@en ; ea:position 35 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A vending machine for snacks, coffee etc. (without manpower)."@en ] ;
    ea:value [ ea:name "waterSupply"@en ; ea:position 36 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Supply of fresh water, e.g. for motorhomes."@en ] ;
    ea:value [ ea:name "wasteDisposal"@en ; ea:position 37 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Possibility to get rid of waste in a legal way (e.g. for truckers or motorhomes). Normal refuse bins are not intended here."@en ] ;
    ea:value [ ea:name "waterTap"@en ; ea:position 38 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fresh water out of a tap."@en ] ;
    ea:value [ ea:name "none"@en ; ea:position 39 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "None."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 40 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unknown."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 41 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some other equipment. Use the description attribute to specify it."@en ] .

datex:Facilities.Facility
    a owl:Class ;
    rdfs:label "Facility"@en ;
    skos:definition "Provides information about a facility, which may represent any kind of site, building, or structure, and may be a composite facility that includes supplemental facilities."@en ;
    skos:prefLabel "facility"@en ;
    rdfs:subClassOf datex:Facilities.FacilityObject ;
    rdfs:comment "DATEX II class in namespace Facilities / Facility"@en ;
    ea:kind "class" .

datex:Facilities.Facility.SupplementalFacility
    a owl:ObjectProperty ;
    rdfs:domain datex:Facilities.Facility ;
    rdfs:range datex:Facilities.SupplementalFacility ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Facilities.FacilityObject
    a owl:Class ;
    rdfs:label "FacilityObject"@en ;
    skos:definition "Provides information about a facility object, which may represent any kind of site, building, or structure, including those which supplement a main facility."@en ;
    skos:prefLabel "facility object"@en ;
    skos:altLabel "facilityobject"@en ;
    rdfs:comment "DATEX II class in namespace Facilities / Facility"@en ;
    ea:kind "class" ;
