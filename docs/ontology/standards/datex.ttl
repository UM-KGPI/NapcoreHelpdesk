datex:FaultAndStatus.DeviceTypeEnum
    a owl:Class ;
    rdfs:label "DeviceTypeEnum"@en ;
    skos:definition "This enumeration provides information on types of field devices."@en ;
    skos:prefLabel "device type enum"@en ;
    skos:altLabel "devicetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace FaultAndStatus / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "accessControl"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Access control equipment"@en ] ;
    ea:value [ ea:name "camera"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "camera"@en ] ;
    ea:value [ ea:name "fireDetection"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fire detection device"@en ] ;
    ea:value [ ea:name "firefightingDevice"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Firefighting device such as a sprinkler system"@en ] ;
    ea:value [ ea:name "itsStation"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An ITS station unit as defined in ISO 21217"@en ] ;
    ea:value [ ea:name "lighting"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Illumination device"@en ] ;
    ea:value [ ea:name "meteorological"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Meteorological equipment"@en ] ;
    ea:value [ ea:name "roadsideTelephone"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "roadside emergency telephone"@en ] ;
    ea:value [ ea:name "tollingDevice"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Device used for road tolling"@en ] ;
    ea:value [ ea:name "trafficDetector"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A device that detects vehicles"@en ] ;
    ea:value [ ea:name "ventilation"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Ventilation device"@en ] ;
    ea:value [ ea:name "parkingGuidance"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A device offering parking guidance"@en ] ;
    ea:value [ ea:name "parkingManagement"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A device involved in parking management"@en ] ;
    ea:value [ ea:name "roadsideEquipment"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Roadside equipment"@en ] ;
    ea:value [ ea:name "trafficSignal"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A traffic signal (controller and potentially multiple traffic lights)"@en ] ;
    ea:value [ ea:name "transportLink"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An instrumented transport link, considered as a single data service"@en ] ;
    ea:value [ ea:name "transportRoute"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An instrumented transport route, considered as a single data service"@en ] ;
