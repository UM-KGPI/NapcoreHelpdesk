datex:LocationReferencing.SupplementaryPositionalDescription
    a owl:Class ;
    rdfs:label "SupplementaryPositionalDescription"@en ;
    skos:definition "A collection of supplementary positional information which improves the precision of the location."@en ;
    skos:prefLabel "supplementary positional description"@en ;
    skos:altLabel "supplementarypositionaldescription"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/SupplementaryPositionalDescription"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "directionPurpose"@en ; ea:position 1 ; ea:type datex:LocationReferencing.DirectionPurposeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identifies the main purpose of the road at the location"@en ] ;
    ea:attribute [ ea:name "geographicDescriptor"@en ; ea:position 2 ; ea:type datex:LocationReferencing.GeographicCharacteristicEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Descriptor which identifies a geographic characteristic to help identify the specific location"@en ] ;
    ea:attribute [ ea:name "infrastructureDescriptor"@en ; ea:position 3 ; ea:type datex:LocationReferencing.InfrastructureDescriptorEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Descriptor which identifies infrastructure to help identify the specific location."@en ] ;
    ea:attribute [ ea:name "locationDescription"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Supplementary human-readable description of the location"@en ] ;
    ea:attribute [ ea:name "lengthAffected"@en ; ea:position 5 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "This indicates the length (measured in metres) of carriageway (and lanes) affected by the associated traffic element."@en ] ;
    ea:attribute [ ea:name "positionOnCarriageway"@en ; ea:position 6 ; ea:type datex:LocationReferencing.RelativePositionOnCarriagewayEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Relative position across carriageway"@en ] ;
    ea:attribute [ ea:name "locationPrecision"@en ; ea:position 7 ; ea:type datex:Common.MetresAsNonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates that the location is given with a precision which is better than the stated value in metres."@en ] ;
    ea:attribute [ ea:name "sequentialRampNumber"@en ; ea:position 8 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The sequential number of an exit/entrance ramp from a given location in a given direction (normally used to indicate a specific exit/entrance in a complex junction/intersection)."@en ] .

