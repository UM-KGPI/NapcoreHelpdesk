    ea:attribute [ ea:name "parkingPlaceFullAtFloor"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The parking place is full at the specified floor(s)."@en ] ;
    ea:attribute [ ea:name "declarationValidNow"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specifies, if this place or subplace declaration is valid now. If specified, this overrides any static validity information."@en ] .

