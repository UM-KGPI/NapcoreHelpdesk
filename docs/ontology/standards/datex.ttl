    ea:attribute [ ea:name "trafficStatusDefault"@en ; ea:position 2 ; ea:type datex:RoadTrafficData.TrafficStatusEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The default value of traffic status that can be assumed to apply to the locations defined by the associated predefined location set."@en ] .

