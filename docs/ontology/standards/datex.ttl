    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Situation.SituationPublication
    a owl:Class ;
    rdfs:label "SituationPublication"@en ;
    skos:definition "A publication containing zero or more traffic/travel situations."@en ;
    skos:prefLabel "situation publication"@en ;
    skos:altLabel "situationpublication"@en ;
    rdfs:subClassOf datex:Common.PayloadPublication ;
    rdfs:comment "DATEX II class in namespace Situation / SituationPublication"@en ;
