datex:AfirFacilities.AnOrganisation
    a owl:Class ;
    rdfs:label "AnOrganisation"@en ;
    skos:definition "An organisation. It can be specialised to be referenceable."@en ;
    skos:prefLabel "an organisation"@en ;
    skos:altLabel "anorganisation"@en ;
    rdfs:subClassOf datex:AfirFacilities.Organisation ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / OrganisationPublication"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "lastUpdated"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The date/time at which this information was last updated."@en ] ;
    ea:attribute [ ea:name "name"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Name of the organisation."@en ] ;
    ea:attribute [ ea:name "legalName"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The legal name of the organisation."@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A description of the organisation."@en ] ;
    ea:attribute [ ea:name "linkToGeneralInformation"@en ; ea:position 5 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An internet address from where further relevant information about this organisation may be obtained."@en ] ;
    ea:attribute [ ea:name "linkToLogo"@en ; ea:position 6 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An internet address from where the logo of this organisation may be obtained."@en ] ;
    ea:attribute [ ea:name "linkToWebform"@en ; ea:position 7 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An internet address pointing to a webform, which people can use to send messages to this organisation."@en ] ;
    ea:attribute [ ea:name "available24hours"@en ; ea:position 8 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specifies if the availability is 24 hours a day. If omitted, this information is unknown or heterogeneous."@en ] ;
    ea:attribute [ ea:name "responsibility"@en ; ea:position 9 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Specification of services or other duties the organisation is responsible for."@en ] ;
    ea:attribute [ ea:name "publishingAgreement"@en ; ea:position 10 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication whether the organisation accepted publishing its information."@en ] ;
    ea:attribute [ ea:name "type"@en ; ea:position 11 ; ea:type datex:AfirFacilities.OrganisationTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Information whether the organisation in question belongs to the public or private sector."@en ] ;
    ea:attribute [ ea:name "nationalOrganisationNumber"@en ; ea:position 12 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The national organisation number in the specified national register, if applicable."@en ] ;
    ea:attribute [ ea:name "nationalRegister"@en ; ea:position 13 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A national register where the organisation is registered."@en ] ;
    ea:attribute [ ea:name "vatIdentificationNumber"@en ; ea:position 14 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The VAT identification number of the organisation."@en ] .

