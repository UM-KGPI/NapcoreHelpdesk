    skos:definition "An integer number whose value space is the set {0, 1, 2, ..., 2147483645, 2147483646, 2147483647}."@en ;
    skos:prefLabel "non negative integer"@en ;
    skos:altLabel "nonnegativeinteger"@en ;
    rdfs:subClassOf datex:Common.Integer ;
