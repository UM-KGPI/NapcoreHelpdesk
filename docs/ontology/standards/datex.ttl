datex:FaultAndStatus.FaultTypeEnum
    a owl:Class ;
    rdfs:label "FaultTypeEnum"@en ;
    skos:definition "This enumeration provides information on types of faults."@en ;
    skos:prefLabel "fault type enum"@en ;
    skos:altLabel "faulttypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace FaultAndStatus / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "internalCommunicationFault"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Device may be connected but has a communications fault that may prevent a required communication function performing within specified requirements."@en ] ;
    ea:value [ ea:name "synchronizationFault"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fault in the process of synchronisation with the device"@en ] ;
    ea:value [ ea:name "componentFault"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A fault located in a component of the device (other components could still work well)."@en ] ;
    ea:value [ ea:name "configurationError"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An error in the configuration or supply data of the device."@en ] ;
    ea:value [ ea:name "disconnected"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device or component has no connection"@en ] ;
    ea:value [ ea:name "electronicsFault"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A fault in the electronics part of the device."@en ] ;
    ea:value [ ea:name "generalSystemError"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A general system error."@en ] ;
    ea:value [ ea:name "hardwareFault"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A hardware-related fault."@en ] ;
    ea:value [ ea:name "controlFault"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An invalid state was called by the control unit."@en ] ;
    ea:value [ ea:name "intermittentlyWorking"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device or component cannot always perform its tasks as required."@en ] ;
    ea:value [ ea:name "mechanicalFault"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A fault of a mechanical part of the device."@en ] ;
    ea:value [ ea:name "notWorking"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device or component cannot perform its tasks."@en ] ;
    ea:value [ ea:name "operatingSystemFault"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A fault in the operating system of the device."@en ] ;
    ea:value [ ea:name "powerFailure"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is no power supply for the device or component."@en ] ;
    ea:value [ ea:name "securityFault"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A fault that causes a security issue or harms security related services."@en ] ;
    ea:value [ ea:name "softwareFault"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A software-related fault."@en ] ;
    ea:value [ ea:name "timeOrClockFault"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The device clock does not work properly or reports inconsistent time keeping."@en ] ;
    ea:value [ ea:name "unspecifiedFault"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The fault cannot be specified."@en ] ;
    ea:value [ ea:name "unknownFault"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The fault is unknown."@en ] ;
    ea:value [ ea:name "otherFault"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The fault is not included in this enumeration."@en ] .

