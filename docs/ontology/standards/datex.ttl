datex:CommonExtension.EuBodyworkCodeEnum
    a owl:Class ;
    rdfs:label "EuBodyworkCodeEnum"@en ;
    skos:definition "Bodywork codes according to REGULATION (EU) 2018/858."@en ;
    skos:prefLabel "eu bodywork code enum"@en ;
    skos:altLabel "eubodyworkcodeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace CommonExtension / Final"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "aa"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Saloon - A vehicle defined in term 3.1.1.1 of international standard ISO 3833:1977, fitted with at least four side windows."@en ] ;
    ea:value [ ea:name "ab"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Hatchback - A saloon as defined in REGULATION (EU) 2018/858 Annex 1 Part C Ref. 2.1 with a hatch at the rear end of the vehicle."@en ] ;
    ea:value [ ea:name "ac"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Station wagon - A vehicle defined in term 3.1.1.4 of international standard ISO 3833:1977."@en ] ;
    ea:value [ ea:name "ad"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Coupé - A vehicle defined in term 3.1.1.5 of international standard ISO 3833:1977."@en ] ;
    ea:value [ ea:name "ae"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Convertible - A vehicle defined in terms No 3.1.1.6 of international standard ISO 3833:1977. However, a convertible may have no door."@en ] ;
    ea:value [ ea:name "af"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Multi-purpose - A vehicle other than AG and those mentioned in AA to AE in tended for carrying persons and their luggage or occasionally goods, in a single compartment."@en ] ;
    ea:value [ ea:name "ag"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Truck station wagon-Vehicle defined in term No 3.1.1.4.1 of ISO 3833:1977. The luggage compartment must be compl. sepated from the passenger compartment. And the ref. point of the driver's seating pos. must be min. 750mm above the surface supp. the veh."@en ] ;
    ea:value [ ea:name "ba"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lorry - A vehicle that is designed and constructed exclusively or principally for conveying goods. It may also tow a trailer."@en ] ;
    ea:value [ ea:name "bb"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Van - A lorry with the compartment where the driver is located and cargo area within a single unit."@en ] ;
    ea:value [ ea:name "bc"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Tractor unit for semi-trailer - A towing vehicle that is designed and constructed exclusively or principally to tow semi-trailers."@en ] ;
    ea:value [ ea:name "bd"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Road tractor - A towing vehicle that is designed and constructed exclusively to tow trailers other than semi-trailers."@en ] ;
    ea:value [ ea:name "be"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pick-up truck - A vehicle of a maximum mass not exceeding 3 500 kg in which the seating positions and the cargo area are not located in a single compartment."@en ] ;
    ea:value [ ea:name "bx"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Chassis-cab or chassis-cowl - An incomplete vehicle with just a cabin (complete or partial), chassis rails, power train, axles, which is intended to be completed with bodywork, customised to the needs of the transport operator."@en ] ;
    ea:value [ ea:name "ca"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Single-deck vehicle - A vehicle where the spaces provided for persons are arranged in a single level or in a way that they do not constitute two superimposed levels."@en ] ;
    ea:value [ ea:name "cb"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Double-deck vehicle - A vehicle defined in paragraph 2.1.6 of UN Regulation No 107."@en ] ;
    ea:value [ ea:name "cc"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Single-deck articulated vehicle - A vehicle defined in paragraph 2.1.3 of UN Regulation No 107 with a single deck."@en ] ;
    ea:value [ ea:name "cd"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Double-deck articulated vehicle - A vehicle defined in paragraph 2.1.3.1 of UN Regulation No 107."@en ] ;
    ea:value [ ea:name "ce"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Low-floor single-deck vehicle - A vehicle defined in paragraph 2.1.4 of UN Regulation No 107 with a single deck."@en ] ;
    ea:value [ ea:name "cf"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Low-floor double-deck vehicle - A vehicle defined in paragraph 2.1.4 of UN Regulation No 107 with a double deck."@en ] ;
    ea:value [ ea:name "cg"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Articulated low-floor single-deck vehicle - A vehicle that combines the technical features of codes CC and CE."@en ] ;
    ea:value [ ea:name "ch"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Articulated low-floor double-deck vehicle - A vehicle that combines the technical features of codes CD and CF."@en ] ;
    ea:value [ ea:name "ci"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Open top single deck vehicle - A vehicle with partial roof or without roof."@en ] ;
    ea:value [ ea:name "cj"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Open top double deck vehicle - A vehicle without roof over all or part of its upper deck."@en ] ;
    ea:value [ ea:name "cx"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Bus chassis - An incomplete vehicle with just chassis rails or tube assembly, power train, axles, that is intended to be completed with bodywork, customised to the needs of the transport operator."@en ] ;
    ea:value [ ea:name "da"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Semi-trailer-Trailer that is des. and constr. to be coupled to a tractor unit or converter dolly and to impose a subst. vertical load on the towing vehicle or converter dolly. The coupling for a vehicle comb. shall consist of a king pin and a fifth wheel."@en ] ;
    ea:value [ ea:name "db"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Drawbar trailer-Trailer having at least two axles, with at least one is a steered axle:(a)equipped with a towing device which can move vertically (in relation to trailer); (b)that transmits less than 100daN as static vertical load to the towing vehicle."@en ] ;
    ea:value [ ea:name "dc"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Centre-axle trailer- see definition in REGULATION (EU) 2018/858 Annex 1 Part C Ref. 5.3."@en ] ;
    ea:value [ ea:name "de"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rigid drawbar trailer- see definition in REGULATION (EU) 2018/858 Annex 1 Part C Ref. 5.4."@en ] .

