datex:LocationReferencing.LinearWithinLinearElement
    a owl:Class ;
    rdfs:label "LinearWithinLinearElement"@en ;
    skos:definition "A linear section along a linear element where the linear element is either a part of or the whole of a linear object (i.e. a road), consistent with ISO 19148 definitions."@en ;
    skos:prefLabel "linear within linear element"@en ;
    skos:altLabel "linearwithinlinearelement"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/LinearReferencing/LinearWithinLinearElement"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "administrativeAreaOfLinearSection"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identification of the road administration area which contains the specified linear section."@en ] ;
    ea:attribute [ ea:name "directionOnLinearSection"@en ; ea:position 2 ; ea:type datex:LocationReferencing.DirectionEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The direction of traffic flow on the linear section in terms of general destination direction."@en ] ;
    ea:attribute [ ea:name "directionRelativeOnLinearSection"@en ; ea:position 3 ; ea:type datex:LocationReferencing.LinearDirectionEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The direction of traffic flow on the linear section relative to the direction in which the linear element is defined."@en ] ;
    ea:attribute [ ea:name "heightGradeOfLinearSection"@en ; ea:position 4 ; ea:type datex:LocationReferencing.HeightGradeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identification of whether the linear section that is part of the linear element is at, above or below the normal elevation of a linear element of that type (e.g. road or road section) at that location, typically used to indicate \"grade\" separation."@en ] .

datex:LocationReferencing.LinearWithinLinearElement.LinearElement
    a owl:ObjectProperty ;
