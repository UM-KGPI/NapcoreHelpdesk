    ea:value [ ea:name "owner"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Contact details for the owner of a facility or specific entity."@en ] ;
    ea:value [ ea:name "emergencyContact"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Contact details for emergency assistance or support for a facility or specific entity specifically related to parking operations"@en ] ;
    ea:value [ ea:name "securityService"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Contact details for security services for a facility or specific entity."@en ] ;
    ea:value [ ea:name "customerService"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Contact details for parking customer support for a facility or specific entity."@en ] ;
    ea:value [ ea:name "propertyManager"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Contact details for the property manager of a facility or related facility."@en ] ;
    ea:value [ ea:name "reservationService"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Contact details for a reservation service of a facility or related facility."@en ] ;
    ea:value [ ea:name "responsibleAuthority"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Contact details for a responsible authority of a facility or related facility."@en ] ;
    ea:value [ ea:name "servicePartner"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Contact details for a service partner of a facility or related facility."@en ] .

datex:Parking.CoveredEnum
    a owl:Class ;
    rdfs:label "CoveredEnum"@en ;
    skos:definition "Defines the supported lists of different types describing roof coverage of the facility or entity"@en ;
    skos:prefLabel "covered enum"@en ;
    skos:altLabel "coveredenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "covered"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates that the facility or specific entity has a roof to provide protection from direct overhead sun or adverse weather"@en ] ;
    ea:value [ ea:name "notCovered"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates that the facility or specific entity has no roof to provide protection from direct overhead sun or adverse weather"@en ] ;
    ea:value [ ea:name "partiallyCovered"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates that the facility or specific entity has a roof offering partial coverage to provide protection from direct overhead sun or adverse weather"@en ] ;
    ea:value [ ea:name "topLevelNotCovered"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates that in a multi-level facility or specific entity the top level(s) have no roof to provide protection from direct overhead sun or adverse weather"@en ] .

datex:Parking.DedicatedAccess
    a owl:Class ;
    rdfs:label "DedicatedAccess"@en ;
    skos:definition "Reference to an access of any type (vehicles, pedestrian, ...)."@en ;
    skos:prefLabel "dedicated access"@en ;
    skos:altLabel "dedicatedaccess"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/CommonComponents"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "dedicatedAccess"@en ; ea:position 1 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A reference to a VehicularAccess or PedestrianAccess."@en ] ;
    ea:attribute [ ea:name "distanceFromParkingSpace"@en ; ea:position 2 ; ea:type datex:Common.MetresAsNonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Distance from this access to the parking space or group of parking spaces. Especially interesting for persons with disabilities or in case of the need of changing the side of a motorway."@en ] .

datex:Parking.DemandSpaceType
    a owl:Class ;
    rdfs:label "DemandSpaceType"@en ;
    skos:definition "Defines when a specific space within a place is occupied, for how long, and the total amount for this space for this time. Includes when occupancy was determined. This class includes actual and estimated start and end times of occupancy."@en ;
    skos:prefLabel "demand space type"@en ;
    skos:altLabel "demandspacetype"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/SupplyAndDemand"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "spaceId"@en ; ea:position 1 ; ea:type datex:Common.Reference ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Name of space, specifically identifies each individual space in an area."@en ] ;
    ea:attribute [ ea:name "actualStart"@en ; ea:position 2 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The actual time a space is initially occupied."@en ] ;
    ea:attribute [ ea:name "actualEnd"@en ; ea:position 3 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The actual Time space is vacated."@en ] ;
    ea:attribute [ ea:name "detectionUpdateTime"@en ; ea:position 4 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time of update, from detector which is typically a space sensor or camera."@en ] ;
    ea:attribute [ ea:name "estimatedStart"@en ; ea:position 5 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The estimated time a space is expected to be occupied, typically based on a reservation."@en ] ;
    ea:attribute [ ea:name "estimatedEnd"@en ; ea:position 6 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The estimated time a space is expected to be vacated, typically based on a reservation."@en ] .

datex:Parking.DemandSpaceType.OccupancyLevel
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.DemandSpaceType ;
    rdfs:range datex:Parking.OccupancyLevel ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Parking.DemandTable
    a owl:Class ;
    rdfs:label "DemandTable"@en ;
    skos:definition "Table structure which defines the parameters of reporting actual usage of parking in a Hierarchy Element"@en ;
    skos:prefLabel "demand table"@en ;
    skos:altLabel "demandtable"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/SupplyAndDemand"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "frequency"@en ; ea:position 1 ; ea:type datex:Facilities.Duration ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "How frequently the demand data is revised."@en ] ;
    ea:attribute [ ea:name "timestamp"@en ; ea:position 2 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Timestamp when the demand table data was compiled."@en ] .

datex:Parking.DemandTable.DemandSpaceType
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.DemandTable ;
    rdfs:range datex:Parking.DemandSpaceType ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Parking.DemandTable.DemandType
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.DemandTable ;
    rdfs:range datex:Parking.DemandType ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Parking.DemandType
    a owl:Class ;
    rdfs:label "DemandType"@en ;
    skos:definition "Defines occupancy at a hierarchy element without specific space details. This is an aggregate count of demand activity within the Place hierarchy."@en ;
    skos:prefLabel "demand type"@en ;
    skos:altLabel "demandtype"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/SupplyAndDemand"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "creationTime"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "When data in the record was compiled."@en ] ;
    ea:attribute [ ea:name "occupancyCalculation"@en ; ea:position 2 ; ea:type datex:Parking.CalculationTypeEnum ; ea:lowerBound "1" ; ea:upperBound "*" ; ea:definition "Is occupancy based on physical count, derived (calculated), or a verified report (high confidence report)"@en ] ;
    ea:attribute [ ea:name "count"@en ; ea:position 3 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Number of utilized or occupied spaces."@en ] ;
    ea:attribute [ ea:name "percentage"@en ; ea:position 4 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Percent of spaces occupied or utilized."@en ] .

datex:Parking.ElementDescriptorEnum
    a owl:Class ;
    rdfs:label "ElementDescriptorEnum"@en ;
    skos:definition "A list of the supported parking element descriptors (e.g. floor,row)."@en ;
    skos:prefLabel "element descriptor enum"@en ;
    skos:altLabel "elementdescriptorenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "floorOrLevel"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "describes a place identified as a \"floor\", with typical use to describe a floor or level in a multi-level structure"@en ] ;
    ea:value [ ea:name "row"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "describes a place identified as a \"row\", with typical use to describe a quasi-line parking or other feature of common characteristics"@en ] ;
    ea:value [ ea:name "street"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "describes a place identified as a \"street\", with typical use to describe a part of a road sharing a common given name."@en ] ;
    ea:value [ ea:name "building"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A description for a building."@en ] ;
    ea:value [ ea:name "statisticsOnly"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "This area provides statistical figures only, for example 60 spaces for lorries in total. Usually, this kind of group does not use georeference information. It is not a complete description of parking spaces."@en ] ;
    ea:value [ ea:name "mixedUsage"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A definition for mixed usage for this area (e.g. by time). This means there are more definitions for this area or for sub- or supersets of it."@en ] ;
    ea:value [ ea:name "singleParameters"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "This area provides some single features for a selected number of spaces. For example, you can define all spaces, where electric charging stations are provided. It is not a complete description of the parking spaces."@en ] ;
    ea:value [ ea:name "logicalStructure"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some other logical or operational structure of parking spaces or parking areas."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some other kind of subplace element."@en ] .

datex:Parking.EsporgStandardLevelEnum
    a owl:Class ;
    rdfs:label "EsporgStandardLevelEnum"@en ;
    skos:definition "Classification according to the technical specifications of the European secure parking organisation."@en ;
    skos:prefLabel "esporg standard level enum"@en ;
    skos:altLabel "esporgstandardlevelenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "bronze"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "ESPORG Bronze Level"@en ] ;
    ea:value [ ea:name "silver"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "ESPORG Silver Level"@en ] ;
    ea:value [ ea:name "gold"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "ESPORG Gold Level"@en ] ;
    ea:value [ ea:name "platinum"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "ESPORG Platinum Level"@en ] .

datex:Parking.HierarchyElementGeneral
    a owl:Class ;
    rdfs:label "HierarchyElementGeneral"@en ;
    skos:definition "A generalised component of a place hierarchy, that forms one element in the tree-like hierarchy."@en ;
    skos:prefLabel "hierarchy element general"@en ;
    skos:altLabel "hierarchyelementgeneral"@en ;
    rdfs:subClassOf datex:Facilities.Facility ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/PlaceHierarchy"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "layer"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicator of the position of this hierarchy element in the specific hierarchy, with the top of the hierarchy numbered layer 0."@en ] ;
    ea:attribute [ ea:name "type"@en ; ea:position 2 ; ea:type datex:Parking.HierarchyElementTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifies the type of the hierarchy element"@en ] ;
    ea:attribute [ ea:name "parentId"@en ; ea:position 3 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The identity of a parent node in the next layer up of the hierarchy - for the hierarchy element at layer 0 no parent id shall be defined."@en ] ;
    ea:attribute [ ea:name "childId"@en ; ea:position 4 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The identity of one or several child node directly related to this hierarchy element."@en ] ;
    ea:attribute [ ea:name "operatorDefinedReference"@en ; ea:position 5 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Allows a data owner to associate to a data owner internal used location identification"@en ] .

datex:Parking.HierarchyElementGeneral.OccupancyLevel
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.HierarchyElementGeneral ;
    rdfs:range datex:Parking.OccupancyLevel ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Parking.HierarchyElementGeneral.OperatorDefinedPlace
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.HierarchyElementGeneral ;
    rdfs:range datex:Parking.OperatorDefinedPlace ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Parking.HierarchyElementGeneral.ResponsibilityRoleAssignment
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.HierarchyElementGeneral ;
    rdfs:range datex:Parking.ResponsibilityRoleAssignment ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Parking.HierarchyElementGeneral.Supply
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.HierarchyElementGeneral ;
    rdfs:range datex:Parking.Supply ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Parking.HierarchyElementTypeEnum
    a owl:Class ;
    rdfs:label "HierarchyElementTypeEnum"@en ;
    skos:definition "Defines the supported lists of types of parking hierarchy elements permissible"@en ;
    skos:prefLabel "hierarchy element type enum"@en ;
    skos:altLabel "hierarchyelementtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "campus"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Typically defines a large facility (such as a university campus, or an airport), or a large geographic zone (such as a city or a town), which may contain numerous places that can be logically reported together."@en ] ;
    ea:value [ ea:name "place"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A place or location used for parking, loading, unloading, standing, or some other mobility or transport related activity."@en ] ;
    ea:value [ ea:name "subplaceElement"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A sub-division of a place for the convenience of the operator to segment the place and identify varied uses for parking and mobility related operations or other purposes."@en ] ;
    ea:value [ ea:name "identifiedArea"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An identifiable discrete bounded geographic zone that shares common characteristics and is used for parking and mobility related operations or other purposes."@en ] ;
    ea:value [ ea:name "space"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A single space for parking or other mobility related purposes, usually designed for one vehicle, which may, but not necessarily, be denoted by painted or other road surface marker."@en ] .

datex:Parking.IdentifiedArea
    a owl:Class ;
    rdfs:label "IdentifiedArea"@en ;
    skos:definition "An identifiable discrete bounded geographic zone that shares common characteristics and is used for parking and mobility related operations or other purposes."@en ;
    skos:prefLabel "identified area"@en ;
    skos:altLabel "identifiedarea"@en ;
    rdfs:subClassOf datex:Parking.HierarchyElementGeneral ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/IdentifiedArea"@en ;
    ea:kind "class" .

datex:Parking.IdentifiedArea.AdditionalCharacteristics
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.IdentifiedArea ;
    rdfs:range datex:Parking.AdditionalCharacteristics ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Parking.IdentifiedArea.OperatingPattern
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.IdentifiedArea ;
    rdfs:range datex:Parking.OperatingPattern ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Parking.ImageAlbum
    a owl:Class ;
    rdfs:label "ImageAlbum"@en ;
    skos:definition "A class defining information relating to images for a parking facility."@en ;
    skos:prefLabel "image album"@en ;
    skos:altLabel "imagealbum"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/CommonComponents"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "photo"@en ; ea:position 1 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specifies a URL at which a photo of the object in concern can be found."@en ] ;
    ea:attribute [ ea:name "caption"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Free-text string providing user context to the logo or picture"@en ] ;
    ea:attribute [ ea:name "logoImage"@en ; ea:position 3 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "URL to location of logo(s) the parking operator wishes to associate with this parking facility (e.g. their logo, schemes [ParkMark])"@en ] .

datex:Parking.JunctionClassificationEnum
    a owl:Class ;
    rdfs:label "JunctionClassificationEnum"@en ;
    skos:definition "Explicit type of a junction."@en ;
    skos:prefLabel "junction classification enum"@en ;
    skos:altLabel "junctionclassificationenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "threeWayInterchange"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "One motorway merging into another (with three legs in total)."@en ] ;
    ea:value [ ea:name "interchange"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Usually two crossing motorways (four legs, but can be even more)."@en ] ;
    ea:value [ ea:name "motorwayConnection"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Beginning or end of a motorway (e.g. changeover to smaller road)."@en ] ;
    ea:value [ ea:name "junction"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Entrance and exit on a motorway."@en ] ;
    ea:value [ ea:name "temporarilyJunction"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Entrance and exit on a motorway, reserved either for emergency and service or on a temporarily basis."@en ] ;
    ea:value [ ea:name "borderCrossing"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Motorway crossing a border (between counties, countries, states, ...)."@en ] ;
    ea:value [ ea:name "junctionInOneDirection"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Entry and Exit on a motorway, where just one direction of the motorway is accessible."@en ] ;
    ea:value [ ea:name "operationalServiceJunction"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Junction accessible only for operational services."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

datex:Parking.JunctionInformation
    a owl:Class ;
    rdfs:label "JunctionInformation"@en ;
    skos:definition "Information on a junction (on a highway), can also be an interchange or if applicable also a motorway service station (see junctionClassification)."@en ;
    skos:prefLabel "junction information"@en ;
    skos:altLabel "junctioninformation"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/JunctionAndRoad"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "junctionClassification"@en ; ea:position 1 ; ea:type datex:Parking.JunctionClassificationEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Explicit type of junction."@en ] ;
    ea:attribute [ ea:name "junctionName"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Name of the junction."@en ] ;
    ea:attribute [ ea:name "junctionNumber"@en ; ea:position 3 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Number of the junction, might also include letters (example: 23A)."@en ] .

datex:Parking.JunctionInformation.intersectionDestinationMotorway
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.JunctionInformation ;
    rdfs:range datex:LocationReferencing.RoadInformation ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Parking.JunctionInformation.motorway
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.JunctionInformation ;
    rdfs:range datex:LocationReferencing.RoadInformation ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Parking.LayoutEnum
    a owl:Class ;
    rdfs:label "LayoutEnum"@en ;
    skos:definition "Types of layout of this (parking) place."@en ;
    skos:prefLabel "layout enum"@en ;
    skos:altLabel "layoutenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "layBy"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An area along a road that offers temporarily parking."@en ] ;
    ea:value [ ea:name "openSpace"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A normal ground level parking place."@en ] ;
    ea:value [ ea:name "nested"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking space within a complex structure of buildings or surrounded by buildings."@en ] ;
    ea:value [ ea:name "field"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A non-bituminized parking space (e.g. for events or as extension)."@en ] ;
    ea:value [ ea:name "building"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A building"@en ] .

datex:Parking.Marketing
    a owl:Class ;
    rdfs:label "Marketing"@en ;
    skos:definition "Universal resource locator (URI) that points towards a web site carrying marketing material supplied."@en ;
    skos:prefLabel "marketing"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/CommonComponents"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "webUrl"@en ; ea:position 1 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Universal Resource Identifier (URI) linking to marketing material."@en ] .

datex:Parking.Marketing.ImageAlbum
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.Marketing ;
    rdfs:range datex:Parking.ImageAlbum ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Parking.Occupancy
    a owl:Class ;
    rdfs:label "Occupancy"@en ;
    skos:definition "Information on the used and remaining parking capacity."@en ;
    skos:prefLabel "occupancy"@en ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/ParkingStatus"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "numberOfSpacesOverride"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Possibility to override the static value 'parkingNumberOfSpaces'."@en ] ;
    ea:attribute [ ea:name "numberOfVacantSpaces"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The total number of currently vacant parking spaces available in the specified parking site, group of parking sites or group of parking spaces."@en ] ;
    ea:attribute [ ea:name "numberOfVacantSpacesLowerThan"@en ; ea:position 3 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of vacant parking spaces is lower than the given value (example: Less than 10 spaces are free)."@en ] ;
    ea:attribute [ ea:name "numberOfVacantSpacesHigherThan"@en ; ea:position 4 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of vacant parking spaces is higher than the given value (example: More than 10 spaces are free)."@en ] ;
    ea:attribute [ ea:name "numberOfVacantSpacesGraded"@en ; ea:position 5 ; ea:type datex:Parking.ParkingVacantSpacesEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Number of vacant spaces by grading (enumeration)."@en ] ;
    ea:attribute [ ea:name "numberOfOccupiedSpaces"@en ; ea:position 6 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of currently occupied spaces in the specified parking site, group of parking sites or assigned parking."@en ] ;
    ea:attribute [ ea:name "numberOfVehicles"@en ; ea:position 7 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Number of vehicles (of specified type) on the specified area. Parking too narrow or too wide may affect differences to the 'occupiedSpaces' value. Should not include petrol station traffic."@en ] ;
    ea:attribute [ ea:name "occupancy"@en ; ea:position 8 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The percentage value of parking spaces occupied in the specified parking site, group of parking sites or assigned parking."@en ] ;
    ea:attribute [ ea:name "occupancyGraded"@en ; ea:position 9 ; ea:type datex:Parking.ParkingOccupancyEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Occupied parking spaces by a percentage-grading (enumeration)."@en ] ;
    ea:attribute [ ea:name "occupancyTrend"@en ; ea:position 10 ; ea:type datex:Parking.ParkingOccupancyTrendEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The trend of the occupancy of the parking spaces in the specified parking site, group of parking sites or assigned parking."@en ] ;
    ea:attribute [ ea:name "parkingNotAllowed"@en ; ea:position 11 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "In case of 'true', parking is not allowed (e.g. abnormal closure)."@en ] .

datex:Parking.Occupancy.VehicleCountAndRate
    a owl:ObjectProperty ;
    rdfs:domain datex:Parking.Occupancy ;
    rdfs:range datex:Parking.VehicleCountAndRate ;
    ea:lowerBound "0" ;
