datex:Common.HeightCharacteristic
    a owl:Class ;
    rdfs:label "HeightCharacteristic"@en ;
    skos:definition "Height characteristic of a vehicle."@en ;
    skos:prefLabel "height characteristic"@en ;
    skos:altLabel "heightcharacteristic"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/VehicleCharacteristics"@en ;
    ea:kind "class" ;
