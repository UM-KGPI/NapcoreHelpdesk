    ea:upperBound "*" .

datex:ReroutingManagementEnhanced.DetailedAllocation
    a owl:Class ;
    rdfs:label "DetailedAllocation"@en ;
    skos:definition "Allocation using the full Condition model of namespace TrafficRegulations"@en ;
    skos:prefLabel "detailed allocation"@en ;
    skos:altLabel "detailedallocation"@en ;
    rdfs:subClassOf datex:ReroutingManagementEnhanced.RouteAllocation ;
