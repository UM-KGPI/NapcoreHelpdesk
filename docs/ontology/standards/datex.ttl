datex:LocationReferencing.PositionAccuracy
    a owl:Class ;
    rdfs:label "PositionAccuracy"@en ;
    skos:definition "Horizontal position accuracy parameters defined according to EN 16803-1"@en ;
    skos:prefLabel "position accuracy"@en ;
    skos:altLabel "positionaccuracy"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/PointCoordinates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "accuracyPercentile50"@en ; ea:position 1 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Accuracy defined by the 50th percentile of the cumulative distribution of position errors."@en ] ;
    ea:attribute [ ea:name "accuracyPercentile75"@en ; ea:position 2 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Accuracy defined by the 75th percentile of the cumulative distribution of position errors"@en ] ;
    ea:attribute [ ea:name "accuracyPercentile95"@en ; ea:position 3 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Accuracy defined by the 95th percentile of the cumulative distribution of position errors"@en ] .

datex:LocationReferencing.PositionConfidenceCodedErrorEnum
    a owl:Class ;
    rdfs:label "PositionConfidenceCodedErrorEnum"@en ;
    skos:definition "Error code for horizontal or vertical position confidence"@en ;
    skos:prefLabel "position confidence coded error enum"@en ;
    skos:altLabel "positionconfidencecodederrorenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace LocationReferencing / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "outOfRange"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the accuracy is out of range, i.e. greater than 4 093 cm for horizontal position."@en ] ;
    ea:value [ ea:name "unavailable"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates the accuracy information is unavailable."@en ] .

datex:LocationReferencing.PositionConfidenceEllipse
    a owl:Class ;
    rdfs:label "PositionConfidenceEllipse"@en ;
    skos:definition "Confidence ellipse position defined in a shape of ellipse with a predefined confidence level (e.g. 95 %). The centre of the ellipse shape corresponds to the reference position point for which the position accuracy is evaluated."@en ;
    skos:prefLabel "position confidence ellipse"@en ;
    skos:altLabel "positionconfidenceellipse"@en ;
    rdfs:comment "DATEX II class in namespace LocationReferencing / LocationReference/PointCoordinates"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "semiMajorAxisLength"@en ; ea:position 1 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Half of length of the major axis, i.e. distance between the centre point and major axis point of the position accuracy ellipse."@en ] ;
    ea:attribute [ ea:name "semiMajorAxisLengthCodedError"@en ; ea:position 2 ; ea:type datex:LocationReferencing.PositionConfidenceCodedErrorEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Provides a coded error in case the semi-major axis length is not defined"@en ] ;
    ea:attribute [ ea:name "semiMinorAxisLength"@en ; ea:position 3 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Half of length of the minor axis, i.e. distance between the centre point and minor axis point of the position accuracy ellipse"@en ] ;
    ea:attribute [ ea:name "semiMinorAxisLengthCodedError"@en ; ea:position 4 ; ea:type datex:LocationReferencing.PositionConfidenceCodedErrorEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Provides a coded error in case the semi-minor axis length is not defined"@en ] ;
    ea:attribute [ ea:name "semiMajorAxisOrientation"@en ; ea:position 5 ; ea:type datex:Common.AngleInDegrees ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Orientation direction of the ellipse major axis of the position accuracy ellipse with regards to the geographic north."@en ] ;
    ea:attribute [ ea:name "semiMajorAxisOrientationError"@en ; ea:position 6 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates whether the ellipse orientation is unavailable (True) or not (False)"@en ] .

datex:LocationReferencing.PredefinedItinerary
    a owl:Class ;
    rdfs:label "PredefinedItinerary"@en ;
