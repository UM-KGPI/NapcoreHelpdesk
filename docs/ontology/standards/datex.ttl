datex:Common.NumberOfAxlesCharacteristic
    a owl:Class ;
    rdfs:label "NumberOfAxlesCharacteristic"@en ;
    skos:definition "Number of axles characteristic of a vehicle."@en ;
    skos:prefLabel "number of axles characteristic"@en ;
    skos:altLabel "numberofaxlescharacteristic"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/VehicleCharacteristics"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "comparisonOperator"@en ; ea:position 1 ; ea:type datex:Common.ComparisonOperatorEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The operator to be used in the vehicle characteristic comparison operation."@en ] ;
    ea:attribute [ ea:name "numberOfAxles"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The total number of axles of an individual vehicle."@en ] .

datex:Common.OverallPeriod
    a owl:Class ;
    rdfs:label "OverallPeriod"@en ;
    skos:definition "A continuous or discontinuous period of validity defined by overall bounding start and end times and the possible intersection of valid periods (potentially recurring) with the complement of exception periods (also potentially recurring)."@en ;
    skos:prefLabel "overall period"@en ;
    skos:altLabel "overallperiod"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/Validity"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "overallStartTime"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Start of bounding period of validity defined by date and time."@en ] ;
    ea:attribute [ ea:name "overallEndTime"@en ; ea:position 2 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "End of bounding period of validity defined by date and time."@en ] .

datex:Common.OverallPeriod.exceptionPeriod
    a owl:ObjectProperty ;
    rdfs:domain datex:Common.OverallPeriod ;
    rdfs:range datex:Common.Period ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Common.OverallPeriod.validPeriod
    a owl:ObjectProperty ;
    rdfs:domain datex:Common.OverallPeriod ;
    rdfs:range datex:Common.Period ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Common.PayloadPublication
    a owl:Class ;
    rdfs:label "PayloadPublication"@en ;
    skos:definition "A payload publication of traffic related information or associated management information created at a specific point in time that can be exchanged via a DATEX II interface."@en ;
    skos:prefLabel "payload publication"@en ;
    skos:altLabel "payloadpublication"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes"@en ;
    ea:kind "class" ;
