    ea:attribute [ ea:name "vehicleHeight"@en ; ea:position 2 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The height of the highest part, excluding antennae, of an individual vehicle above the road surface, in metres."@en ] .

datex:Common.Humidity
    a owl:Class ;
    rdfs:label "Humidity"@en ;
    skos:definition "Details of atmospheric humidity."@en ;
    skos:prefLabel "humidity"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/WeatherRelated"@en ;
    ea:kind "class" .

datex:Common.Humidity.relativeHumidity
    a owl:ObjectProperty ;
    rdfs:domain datex:Common.Humidity ;
