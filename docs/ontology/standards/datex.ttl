datex:ReroutingManagementEnhanced.ReroutingTypeEnum
    a owl:Class ;
    rdfs:label "ReroutingTypeEnum"@en ;
    skos:definition "Types of rerouting management."@en ;
    skos:prefLabel "rerouting type enum"@en ;
    skos:altLabel "reroutingtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace ReroutingManagementEnhanced / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "alternative"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A general alternative rerouting."@en ] ;
    ea:value [ ea:name "kpiForNavigationServices"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A rerouting for navigation services to match defined key performance indicators, for example reduce of traffic."@en ] ;
    ea:value [ ea:name "parkAndRide"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A rerouting in combination with park & ride."@en ] ;
    ea:value [ ea:name "parkingGuidance"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A parking guidance rerouting."@en ] ;
    ea:value [ ea:name "strategyConform"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A strategy conform rerouting."@en ] ;
    ea:value [ ea:name "urbanCompatible"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An urban compatible rerouting."@en ] .

datex:ReroutingManagementEnhanced.RouteAllocation
    a owl:Class ;
    rdfs:label "RouteAllocation"@en ;
    skos:definition "Supports the allocation of traffic by proportion for a specific route against other alternative routes that perform the same functional purpose. This may also include the original route."@en ;
    skos:prefLabel "route allocation"@en ;
    skos:altLabel "routeallocation"@en ;
    rdfs:comment "DATEX II class in namespace ReroutingManagementEnhanced / Classes/Allocation"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "routeProportion"@en ; ea:position 1 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The weight of this specific route against other alternative routes (and possibly the original route) that have identical specific applied characteristics in their route allocation. Those sets of weights should always sum up to 100%."@en ] ;
    ea:attribute [ ea:name "reroutingAdvice"@en ; ea:position 2 ; ea:type datex:ReroutingManagementEnhanced.ReroutingAdviceTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Type of rerouting advice instigated by operator."@en ] ;
    ea:attribute [ ea:name "complianceOptionOverride"@en ; ea:position 3 ; ea:type datex:Situation.ComplianceOptionEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Override the compliance option for the specific route to make it mandatory or advisory."@en ] ;
    ea:attribute [ ea:name "routeEffectivlyClosedForAllocation"@en ; ea:position 4 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "For the specification given in this particular allocation set, the route is closed."@en ] .

datex:ReroutingManagementEnhanced.RouteDescription
    a owl:Class ;
    rdfs:label "RouteDescription"@en ;
    skos:definition "Description of a route (original/alternatives), the location of which is defined by an Itinerary."@en ;
    skos:prefLabel "route description"@en ;
    skos:altLabel "routedescription"@en ;
    rdfs:comment "DATEX II class in namespace ReroutingManagementEnhanced / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "nameOfRoute"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Human oriented name or identifier for the route for better usability."@en ] ;
    ea:attribute [ ea:name "routeClosed"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether the route is closed for all kind of traffic"@en ] ;
    ea:attribute [ ea:name "isPublicTransportRoute"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication, if the route itself is a public transport route. A schedule may be offered."@en ] ;
    ea:attribute [ ea:name "troReference"@en ; ea:position 4 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "A reference to a coresponding traffic regulation order"@en ] ;
    ea:attribute [ ea:name "priorityIndex"@en ; ea:position 5 ; ea:type datex:ReroutingManagementEnhanced.PriorityIndex ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A priority index for this route. 0 = no priority; up to 10 = highest priority."@en ] ;
    ea:attribute [ ea:name "capacityAvailable"@en ; ea:position 6 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates that capacities are still available on this route (or not)."@en ] ;
    ea:attribute [ ea:name "signedRerouting"@en ; ea:position 7 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication of whether the rerouting is signed with road traffic signs."@en ] ;
    ea:attribute [ ea:name "entry"@en ; ea:position 8 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The specified entry on to a road, not forming part of the original route, at which the alternative route commences."@en ] ;
    ea:attribute [ ea:name "exit"@en ; ea:position 9 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The specified exit from the normal route/road at which this specific alternative route commences."@en ] ;
    ea:attribute [ ea:name "roadOrJunctionNumber"@en ; ea:position 10 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The intersecting road or the junction at which this specific alternative route commences."@en ] ;
    ea:attribute [ ea:name "trafficConstriction"@en ; ea:position 11 ; ea:type datex:Situation.TrafficConstrictionTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Traffic constriction for this route."@en ] ;
    ea:attribute [ ea:name "routeLength"@en ; ea:position 12 ; ea:type datex:Common.MetresAsNonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The length of the route."@en ] .

