    ea:value [ ea:name "prewarning"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "advanced notifcation of traffic-affecting conditions or actions"@en ] ;
    ea:value [ ea:name "trafficCondition"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "further response conditionally activated when needed due to the evolving traffic condition"@en ] .

