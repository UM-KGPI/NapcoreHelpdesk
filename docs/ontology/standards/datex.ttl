    rdfs:comment "DATEX II class in namespace AfirFacilities / RatesPublication/Payment"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "paymentMode"@en ; ea:position 1 ; ea:type datex:AfirFacilities.PaymentModeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Defines the timing of the parking or other mobility related payment."@en ] ;
    ea:attribute [ ea:name "paymentMeans"@en ; ea:position 2 ; ea:type datex:AfirFacilities.MeansOfPaymentEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The means of payment available."@en ] ;
    ea:attribute [ ea:name "otherPaymentMeans"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Other means of payment that are available."@en ] ;
    ea:attribute [ ea:name "brandsAccepted"@en ; ea:position 4 ; ea:type datex:AfirFacilities.PaymentBrandsEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Accepted brands for payment cards."@en ] ;
    ea:attribute [ ea:name "otherBrandsAccepted"@en ; ea:position 5 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Further accepted brands for payment cards."@en ] .

datex:AfirFacilities.PaymentBrandsEnum
    a owl:Class ;
    rdfs:label "PaymentBrandsEnum"@en ;
    skos:definition "Brands for payment cards."@en ;
    skos:prefLabel "payment brands enum"@en ;
    skos:altLabel "paymentbrandsenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirFacilities / RatesPublication/Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "americanExpress"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "American Express."@en ] ;
    ea:value [ ea:name "applePay"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Apple pay."@en ] ;
    ea:value [ ea:name "cirrus"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Cirrus"@en ] ;
    ea:value [ ea:name "dinersClub"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Diners Club."@en ] ;
    ea:value [ ea:name "discoverCard"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Discover Card."@en ] ;
    ea:value [ ea:name "giroCard"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Giro card."@en ] ;
    ea:value [ ea:name "maestro"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Maestro"@en ] ;
    ea:value [ ea:name "masterCard"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Master Card."@en ] ;
    ea:value [ ea:name "visa"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Visa"@en ] ;
    ea:value [ ea:name "vpay"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "VPay"@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Another brand."@en ] .

datex:AfirFacilities.PaymentModeEnum
    a owl:Class ;
    rdfs:label "PaymentModeEnum"@en ;
    skos:definition "Details of when payment is required."@en ;
    skos:prefLabel "payment mode enum"@en ;
    skos:altLabel "paymentmodeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirFacilities / RatesPublication/Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "prepay"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pay before entry."@en ] ;
    ea:value [ ea:name "payOnEntry"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pay at start of the parking session (e.g. for pay and display)."@en ] ;
    ea:value [ ea:name "payPriorToExit"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pay at machine on foot prior to returning to vehicle and use payment ticket to exit."@en ] ;
    ea:value [ ea:name "payAndExit"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pay directly at the exit with a payment card or other means of payment (usually, this payment card must have been used when entering as well)."@en ] ;
    ea:value [ ea:name "payAfterExit"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Payment on account."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

datex:AfirFacilities.Qualification
    a owl:Class ;
    rdfs:label "Qualification"@en ;
    skos:definition "A singular set of criteria used to test eligibility for use of a rate table."@en ;
    skos:prefLabel "qualification"@en ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / RatesPublication/Eligibility"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "withReservation"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates whether a reservation is required. [TRUE] reservation required."@en ] ;
    ea:attribute [ ea:name "noFeeToUse"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specific facility is free or not. [TRUE] (e.g. free to park)."@en ] ;
    ea:attribute [ ea:name "propulsionEnergyType"@en ; ea:position 3 ; ea:type datex:AfirFacilities.EnergySourceEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Indicates eligible fuel types for applicable vehicles."@en ] ;
    ea:attribute [ ea:name "activeAssignedRight"@en ; ea:position 4 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication of an assigned right."@en ] ;
    ea:attribute [ ea:name "withMembership"@en ; ea:position 5 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates that a membership is required. [TRUE] membership required."@en ] ;
    ea:attribute [ ea:name "membershipName"@en ; ea:position 6 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Free-text description of the membership."@en ] ;
    ea:attribute [ ea:name "memberOfOtherRateTable"@en ; ea:position 7 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates if this qualification can be used in combination with the use of another rate table. [TRUE]= member of (i.e., used) another rate table."@en ] ;
    ea:attribute [ ea:name "rateTableMember"@en ; ea:position 8 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Reference to another rate table membership."@en ] .

