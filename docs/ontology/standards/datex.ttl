datex:Parking.OperatingRestriction
    a owl:Class ;
    rdfs:label "OperatingRestriction"@en ;
    skos:definition "A class defining an operating restriction."@en ;
    skos:prefLabel "operating restriction"@en ;
    skos:altLabel "operatingrestriction"@en ;
    rdfs:subClassOf datex:Parking.OperatingPattern ;
    rdfs:comment "DATEX II class in namespace Parking / Classes/OperatingPattern"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "context"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free-text definition of the nature of operating restrictions."@en ] ;
    ea:attribute [ ea:name "type"@en ; ea:position 2 ; ea:type datex:Parking.OperatingRestrictionsEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Defines the type of operating restriction applicable in this case."@en ] .

datex:Parking.OperatingRestrictionsEnum
    a owl:Class ;
    rdfs:label "OperatingRestrictionsEnum"@en ;
    skos:definition "Defines operating restrictions to use the of a facility."@en ;
    skos:prefLabel "operating restrictions enum"@en ;
    skos:altLabel "operatingrestrictionsenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "carpoolOnly"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only carpool vehicles are permitted."@en ] ;
    ea:value [ ea:name "commercialVehicleOnly"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only commercial vehicles are permitted."@en ] ;
    ea:value [ ea:name "freeParking"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No fee for parking"@en ] ;
    ea:value [ ea:name "busOnly"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only buses are permitted."@en ] ;
    ea:value [ ea:name "busStop"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "This is a stopping place of bus pick-up or drop-off; not to be used for parking."@en ] ;
    ea:value [ ea:name "disabledPersonPermitOnly"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only vehicles of registered disabled person permit holders permitted."@en ] ;
    ea:value [ ea:name "electricVehicleOnly"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only electric vehicles permitted."@en ] ;
    ea:value [ ea:name "governmentVehicleOnly"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only government vehicles permitted."@en ] ;
    ea:value [ ea:name "loadingZone"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "This is a loading zone; not to be used for parking."@en ] ;
    ea:value [ ea:name "loadingZoneCommercial"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only government vehicles permitted."@en ] ;
    ea:value [ ea:name "media"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only for use by the media"@en ] ;
    ea:value [ ea:name "residentialPermitOnly"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only for use by residential permit holders only"@en ] ;
    ea:value [ ea:name "snow"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Snow clearing zone; no parking"@en ] ;
    ea:value [ ea:name "streetCleaning"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Street cleansing zone; no parking"@en ] ;
    ea:value [ ea:name "parkingTimeLimit"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time limited parking."@en ] ;
    ea:value [ ea:name "taxiOnly"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only taxis are permitted."@en ] ;
    ea:value [ ea:name "valetOnly"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Only valet service vehicles are permitted."@en ] ;
    ea:value [ ea:name "noParking"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No parking permitted"@en ] ;
    ea:value [ ea:name "noWaiting"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "No waiting or parking of vehicles is permitted"@en ] ;
    ea:value [ ea:name "temporaryParking"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking is only allowed at the specified times (or, if no times are provided, in general not allowed all the time)."@en ] .

datex:Parking.OperatorDefinedPlace
    a owl:Class ;
    rdfs:label "OperatorDefinedPlace"@en ;
    skos:definition "Class providing an operator specified name or identifier for a place hierarchy element - this may be distinct from the name for the HierarchyElement supplied by the data supplier."@en ;
    skos:prefLabel "operator defined place"@en ;
