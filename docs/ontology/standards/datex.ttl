datex:Parking.ParkingStructuralCharacteristicsEnum
    a owl:Class ;
    rdfs:label "ParkingStructuralCharacteristicsEnum"@en ;
    skos:definition "Specifies some structural characteristics of a parking space or a group of parking spaces."@en ;
    skos:prefLabel "parking structural characteristics enum"@en ;
    skos:altLabel "parkingstructuralcharacteristicsenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "driveThrough"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Entering as well as leaving the parking space can be done straight in the direction of parking."@en ] ;
    ea:value [ ea:name "openAir"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is no roof and not another storey on top of the parking space, which could prevent from rain, for example."@en ] ;
    ea:value [ ea:name "evenSurface"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Even surface enables safe truck manoeuvring."@en ] ;
    ea:value [ ea:name "kerbside"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking on the kerbside."@en ] ;
    ea:value [ ea:name "softShoulder"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking on the soft shoulder."@en ] .

datex:Parking.ParkingSupervisionEnum
    a owl:Class ;
    rdfs:label "ParkingSupervisionEnum"@en ;
    skos:definition "Defines the kind of supervision of the parking site."@en ;
    skos:prefLabel "parking supervision enum"@en ;
    skos:altLabel "parkingsupervisionenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Parking / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "remote"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Remote."@en ] ;
    ea:value [ ea:name "onSite"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On site."@en ] ;
    ea:value [ ea:name "controlCentreOnSite"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Control centre on site."@en ] ;
    ea:value [ ea:name "controlCentreOffSite"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Control centre off site."@en ] ;
    ea:value [ ea:name "patrol"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Patrol."@en ] ;
    ea:value [ ea:name "none"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "None."@en ] ;
