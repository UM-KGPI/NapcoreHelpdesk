datex:Situation.VehicleObstruction
    a owl:Class ;
    rdfs:label "VehicleObstruction"@en ;
    skos:definition "An obstruction on the road caused by one or more vehicles."@en ;
    skos:prefLabel "vehicle obstruction"@en ;
    skos:altLabel "vehicleobstruction"@en ;
    rdfs:subClassOf datex:Situation.Obstruction ;
    rdfs:comment "DATEX II class in namespace Situation / Classes/TrafficElement/Obstruction"@en ;
    ea:kind "class" ;
