    ea:attribute [ ea:name "feedDescription"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A description of the information which is to be found in the publications originating from the particular feed (URL)."@en ] ;
