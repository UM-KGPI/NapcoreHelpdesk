datex:TrafficRegulation.ActivationStatusEnum
    a owl:Class ;
    rdfs:label "ActivationStatusEnum"@en ;
    skos:definition "Implementation lifecycle values for traffic regulations."@en ;
    skos:prefLabel "activation status enum"@en ;
    skos:altLabel "activationstatusenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace TrafficRegulation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "active"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The regulation(s) is/are currently implemented."@en ] ;
    ea:value [ ea:name "beingSetUp"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The regulation(s) is/are currently in the process of being set up."@en ] ;
    ea:value [ ea:name "beingShutDown"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The regulation(s) is/are currently in the process of being taken away."@en ] ;
    ea:value [ ea:name "inactive"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The regulation(s) is/are currently inactive."@en ] ;
    ea:value [ ea:name "scheduled"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The regulation(s) is/are planned for the future."@en ] .

datex:TrafficRegulation.AdHocTrafficRegulation
    a owl:Class ;
    rdfs:label "AdHocTrafficRegulation"@en ;
