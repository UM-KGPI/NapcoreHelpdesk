    ea:value [ ea:name "adHoc"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Prices are for ad hoc refueling."@en ] .

datex:AfirEnergyInfrastructure.RefillPoint
    a owl:Class ;
    rdfs:label "RefillPoint"@en ;
    skos:definition "Technical infrastructure at a specific location that facilitates an energy refilling process being connected to max. one vehicle at a time."@en ;
    skos:prefLabel "refill point"@en ;
    skos:altLabel "refillpoint"@en ;
    rdfs:subClassOf datex:AfirFacilities.Facility ;
    rdfs:comment "DATEX II class in namespace AfirEnergyInfrastructure / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "deliveryUnit"@en ; ea:position 1 ; ea:type datex:AfirEnergyInfrastructure.DeliveryUnitEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Measurement unit that is used for delivery and accounting the energy provided at this refill point."@en ] ;
    ea:attribute [ ea:name "maximumDeliveryAmount"@en ; ea:position 2 ; ea:type datex:AfirEnergyInfrastructure.Units ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum delivery amount."@en ] ;
    ea:attribute [ ea:name "minimumDeliveryAmount"@en ; ea:position 3 ; ea:type datex:AfirEnergyInfrastructure.Units ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Minimum delivery amount."@en ] ;
    ea:attribute [ ea:name "modelType"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A description of the refill point model type."@en ] ;
    ea:attribute [ ea:name "reservation"@en ; ea:position 5 ; ea:type datex:AfirFacilities.ReservationTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Information regarding options for reservation of a time frame."@en ] .

