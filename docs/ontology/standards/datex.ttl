    ea:value [ ea:name "inspectionArea"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dedicated to an inspection area"@en ] ;
    ea:value [ ea:name "laneControlSystem"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dedicated to the purpose of lane control"@en ] ;
    ea:value [ ea:name "parkingInformation"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dedicated to displaying parking information"@en ] ;
    ea:value [ ea:name "rampMetering"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dedicated to ramp metering"@en ] ;
    ea:value [ ea:name "tunnelManagement"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Dedicated to tunnel management"@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other dedicated usage"@en ] .

datex:Vms.DisplayArea
    a owl:Class ;
    rdfs:label "DisplayArea"@en ;
    skos:definition "Configuration (static or dynamic) of a display area."@en ;
    skos:prefLabel "display area"@en ;
    skos:altLabel "displayarea"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsConfiguration"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "sequencingCapable"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates whether the display area on the VMS is capable of sequencing through multiple pages. True = capable."@en ] ;
    ea:attribute [ ea:name "maxNumberOfSequentialPages"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum number of pages which the VMS is capable of scrolling through sequentially (2 to n)."@en ] ;
    ea:attribute [ ea:name "positionXAbsolute"@en ; ea:position 3 ; ea:type datex:Vms.PositionXAbsoluteEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The horizontal position of the area in which the pictogram is displayed, i.e. at the left, or right of the VMS display."@en ] ;
    ea:attribute [ ea:name "positionXRelativeToPrevious"@en ; ea:position 4 ; ea:type datex:Vms.PositionXRelativeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The horizontal position of the area in which the pictogram is displayed relative to the previous display in the collection (e.g. to the left, to the right ....)."@en ] ;
    ea:attribute [ ea:name "positionYAbsolute"@en ; ea:position 5 ; ea:type datex:Vms.PositionYAbsoluteEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The vertical position of the area in which the area is displayed, i.e. at the top or bottom of the VMS display."@en ] ;
    ea:attribute [ ea:name "positionYRelativeToPrevious"@en ; ea:position 6 ; ea:type datex:Vms.PositionYRelativeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The horizontal position of the area in which the pictogram is displayed relative to the previous display area in the collection (i.e.above or below)."@en ] .

datex:Vms.DisplayArea.DisplayGeometry
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.DisplayArea ;
    rdfs:range datex:Vms.DisplayGeometry ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Vms.DisplayArea.overriddenLaneAssociation
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.DisplayArea ;
    rdfs:range datex:LocationReferencing.Lane ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:Vms.DisplayAreaSettings
    a owl:Class ;
    rdfs:label "DisplayAreaSettings"@en ;
    skos:definition "A display of pictograms or text on one area on a VMS."@en ;
    skos:prefLabel "display area settings"@en ;
    skos:altLabel "displayareasettings"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "isBlank"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identifies whether this display area is blank. The absence of this attribute has no semantics."@en ] ;
    ea:attribute [ ea:name "legalBasis"@en ; ea:position 2 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identifies any legal basis for the elements displayed"@en ] ;
    ea:attribute [ ea:name "legallyBinding"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The semantics of this display are legally binding for road users"@en ] .

datex:Vms.DisplayGeometry
    a owl:Class ;
    rdfs:label "DisplayGeometry"@en ;
    skos:definition "Characteristics of the geometry of a display"@en ;
    skos:prefLabel "display geometry"@en ;
    skos:altLabel "displaygeometry"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsConfiguration"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "pixelsAcross"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Number of pixels horizontally across the display area."@en ] ;
    ea:attribute [ ea:name "pixelsDown"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Number of pixels vertically down the display area."@en ] ;
    ea:attribute [ ea:name "displayHeight"@en ; ea:position 3 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The vertical height measured in metres of the display area."@en ] ;
    ea:attribute [ ea:name "displayWidth"@en ; ea:position 4 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The horizontal width measured in metres of the display area."@en ] ;
    ea:attribute [ ea:name "positionX"@en ; ea:position 5 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The X-coordinate (horizontal) position of this specific display area measured from the top left of the sign's overall display area to the top left of this specific display area"@en ] ;
    ea:attribute [ ea:name "positionY"@en ; ea:position 6 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The Y-coordinate (vertical) position of this specific display area measured from the top left of the sign's overall display area to the top left of this specific display area"@en ] .

datex:Vms.DisplayedNumericalInformation
    a owl:Class ;
    rdfs:label "DisplayedNumericalInformation"@en ;
    skos:definition "Numerical information displayed on a sign"@en ;
    skos:prefLabel "displayed numerical information"@en ;
    skos:altLabel "displayednumericalinformation"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "numericalInformationType"@en ; ea:position 1 ; ea:type datex:Vms.DisplayedNumericalInformationTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Type of numerical information displayed"@en ] ;
    ea:attribute [ ea:name "numericValue"@en ; ea:position 2 ; ea:type datex:Common.Decimal ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The value displayed. In the special case where the unit of measure is feet and inches, the part of the number after the decimal separator is the number of inches."@en ] ;
    ea:attribute [ ea:name "unitOfMeasure"@en ; ea:position 3 ; ea:type datex:Vms.UnitOfMeasureEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The unit of measure for the numeric value. This may be displayed or predefined for a type of sign."@en ] .

datex:Vms.DisplayedNumericalInformationTypeEnum
    a owl:Class ;
    rdfs:label "DisplayedNumericalInformationTypeEnum"@en ;
    skos:definition "Type of numerical information displayed"@en ;
    skos:prefLabel "displayed numerical information type enum"@en ;
    skos:altLabel "displayednumericalinformationtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "distance"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A distance"@en ] ;
    ea:value [ ea:name "height"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A height e.g. for a vehicle height restriction"@en ] ;
    ea:value [ ea:name "length"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A length e.g. for a vehicle length restriction"@en ] ;
    ea:value [ ea:name "rateOfIncline"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A rate of incline"@en ] ;
    ea:value [ ea:name "sectionLength"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A road section length"@en ] ;
    ea:value [ ea:name "speed"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A speed e.g. for a vehicle speed limit"@en ] ;
    ea:value [ ea:name "weight"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A weight e.g. for a vehicle weight restriction"@en ] ;
    ea:value [ ea:name "weightPerAxle"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "An axle weight e.g. for an axle weight restriction"@en ] ;
    ea:value [ ea:name "width"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A width e.g. for a vehicle width restriction"@en ] .

datex:Vms.GddPictogramAttributes
    a owl:Class ;
    rdfs:label "GddPictogramAttributes"@en ;
    skos:definition "ISO 14823 Graphic Data Dictionary attributes with textual or numeric data to supplement a pictogram identification."@en ;
    skos:prefLabel "gdd pictogram attributes"@en ;
    skos:altLabel "gddpictogramattributes"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/GraphicDataDictionary"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "attributes"@en ; ea:position 1 ; ea:type datex:Common.Base64Binary ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "ISO 14823 \"attributes\" data frame which augments the basic identification of the type of pictogram with further textual or numeric data. The encoding shall follow unaligned packed encoding rules (UPER) [ISO/IEC 8825-2:2015]"@en ] .

datex:Vms.GddPictogramCategoryCode
    a owl:Class ;
    rdfs:label "GddPictogramCategoryCode"@en ;
    skos:definition "A 3-digit code to identify a pictogram, as defined in EN ISO 14823-1 Graphic Data Dictionary. That standard is inconsistent in its definition of the value range; this model uses the more permissive definition where the bounds are 100 and 999."@en ;
    skos:prefLabel "gdd pictogram category code"@en ;
    skos:altLabel "gddpictogramcategorycode"@en ;
    rdfs:comment "DATEX II data type in namespace Vms / DataTypes"@en ;
    ea:kind "data type" .

datex:Vms.GddPictogramIdentification
    a owl:Class ;
    rdfs:label "GddPictogramIdentification"@en ;
    skos:definition "Group of codes that uniquely identifies a kind of pictogram, according to the EN ISO 14823-1 Graphic Data Dictionary"@en ;
    skos:prefLabel "gdd pictogram identification"@en ;
    skos:altLabel "gddpictogramidentification"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/GraphicDataDictionary"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "country"@en ; ea:position 1 ; ea:type datex:Common.CountryCode ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Country code used to either allow associating a country-specific rendering with the coded pictogram or distinguish nationally-defined pictogram codes."@en ] ;
    ea:attribute [ ea:name "serviceCategory"@en ; ea:position 2 ; ea:type datex:Vms.GddServiceCategoryEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Category used to group pictograms for a given usage"@en ] ;
    ea:attribute [ ea:name "pictogramCategoryCode"@en ; ea:position 3 ; ea:type datex:Vms.GddPictogramCategoryCode ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Code that identifies a pictogram for a given country and service category."@en ] .

datex:Vms.GddServiceCategoryEnum
    a owl:Class ;
    rdfs:label "GddServiceCategoryEnum"@en ;
    skos:definition "Type of service offered by the pictogram, as defined in EN ISO 14823-1."@en ;
    skos:prefLabel "gdd service category enum"@en ;
    skos:altLabel "gddservicecategoryenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "dangerWarning"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Danger warning sign information (GDD service category 11)."@en ] ;
    ea:value [ ea:name "regulatory"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Informing of special obligations, restrictions or prohibitions (GDD service category 12)."@en ] ;
    ea:value [ ea:name "informative"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Informative, advisory, or guiding (GDD service category 13)."@en ] ;
    ea:value [ ea:name "publicFacilities"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Informing of a certain public facility and its service (GDD service category 21)."@en ] ;
    ea:value [ ea:name "ambientConditions"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Notifying of road-related ambient conditions and events on route (GDD service category 31)."@en ] ;
    ea:value [ ea:name "roadConditions"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Notifying of road-related conditions and events on route (GDD service category 32)."@en ] .

datex:Vms.GddStructure
    a owl:Class ;
    rdfs:label "GddStructure"@en ;
    skos:definition "Graphic Data Dictionary structure, to identify a pictogram by code and optional supplementary attributes"@en ;
    skos:prefLabel "gdd structure"@en ;
    skos:altLabel "gddstructure"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/GraphicDataDictionary"@en ;
    ea:kind "class" .

datex:Vms.GddStructure.GddPictogramAttributes
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.GddStructure ;
    rdfs:range datex:Vms.GddPictogramAttributes ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Vms.GddStructure.GddPictogramIdentification
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.GddStructure ;
    rdfs:range datex:Vms.GddPictogramIdentification ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:Vms.Image
    a owl:Class ;
    rdfs:label "Image"@en ;
    skos:definition "An image, with encoded data and identification of format"@en ;
    skos:prefLabel "image"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "imageData"@en ; ea:position 1 ; ea:type datex:Common.Base64Binary ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Encoded image data"@en ] ;
    ea:attribute [ ea:name "imageFormat"@en ; ea:position 2 ; ea:type datex:Vms.ImageFormatEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identifies the image format of the associated image data"@en ] .

datex:Vms.ImageFormatEnum
    a owl:Class ;
    rdfs:label "ImageFormatEnum"@en ;
    skos:definition "Identifies an image format"@en ;
    skos:prefLabel "image format enum"@en ;
    skos:altLabel "imageformatenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "bmp"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The bmp image format"@en ] ;
    ea:value [ ea:name "gif"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The gif image format"@en ] ;
    ea:value [ ea:name "jpeg"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The jpeg image format"@en ] ;
    ea:value [ ea:name "png"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The png image format"@en ] ;
    ea:value [ ea:name "tiff"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The TIFF image format"@en ] .

datex:Vms.InformationTypeEnum
    a owl:Class ;
    rdfs:label "InformationTypeEnum"@en ;
    skos:definition "Type of text characterisation."@en ;
    skos:prefLabel "information type enum"@en ;
    skos:altLabel "informationtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "situationInformation"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Information about the situation"@en ] ;
    ea:value [ ea:name "warning"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The information is a warning"@en ] ;
    ea:value [ ea:name "prohibition"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The information is a prohibition"@en ] ;
    ea:value [ ea:name "obligation"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The information is an obligation"@en ] ;
    ea:value [ ea:name "destination"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The information is a destination"@en ] ;
    ea:value [ ea:name "travelTime"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The information is travel time"@en ] ;
    ea:value [ ea:name "delay"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Delay information"@en ] ;
    ea:value [ ea:name "location"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Location information"@en ] ;
    ea:value [ ea:name "vehicleType"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The information is about vehicle type"@en ] ;
    ea:value [ ea:name "generalInformation"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "General information"@en ] ;
    ea:value [ ea:name "blank"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There is no information content"@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other kind of information"@en ] .

datex:Vms.ManagedLogicalLocation
    a owl:Class ;
    rdfs:label "ManagedLogicalLocation"@en ;
    skos:definition "The logical location (e.g. a car park, a section of road, a junction etc.) which a VMS contributes to the management of."@en ;
    skos:prefLabel "managed logical location"@en ;
    skos:altLabel "managedlogicallocation"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "managedLogicalLocation"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identification of the logical location (e.g. a car park, a section of road , a junction etc.) which this sign contributes to the management of."@en ] ;
    ea:attribute [ ea:name "distanceFromLogicalLocation"@en ; ea:position 2 ; ea:type datex:Common.MetresAsNonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Distance in metres of the VMS from the logical location which this sign contributes to the management of."@en ] .

datex:Vms.ManagedLogicalLocation.managedLocation
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.ManagedLogicalLocation ;
    rdfs:range datex:LocationReferencing.Location ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Vms.MessageInformationTypeEnum
    a owl:Class ;
    rdfs:label "MessageInformationTypeEnum"@en ;
    skos:definition "Types of information displayable on a VMS."@en ;
    skos:prefLabel "message information type enum"@en ;
    skos:altLabel "messageinformationtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "campaignMessage"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Campaign type information which is non time specific that may request certain actions (e.g. \"do not drink and drive\") or which is intended to influence drivers' behaviour."@en ] ;
    ea:value [ ea:name "dateTime"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Current date and/or time information."@en ] ;
    ea:value [ ea:name "futureInformation"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Information which informs road users about future situations which can potentially cause congestion or influence future travel plans (e.g. future roadworks, closures, sporting events, public concerts, suspension of train or ferry services)."@en ] ;
    ea:value [ ea:name "instructionOrMessage"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Instructions or messages to road users which are relevant at the current time, (e.g. \"do not throw out any burning objects\" or an Amber alert message)."@en ] ;
    ea:value [ ea:name "situationWarning"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Information warning of a current situation likely to affect traffic on the road ahead."@en ] ;
    ea:value [ ea:name "temperature"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Temperature information."@en ] ;
    ea:value [ ea:name "trafficManagement"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Information comprising traffic management instructions."@en ] ;
    ea:value [ ea:name "travelTime"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Travel time information."@en ] .

datex:Vms.MultiPageDisplay
    a owl:Class ;
    rdfs:label "MultiPageDisplay"@en ;
    skos:definition "A display of multiple pages, sequentially displayed in order of their \"pageNumber\"."@en ;
    skos:prefLabel "multi page display"@en ;
    skos:altLabel "multipagedisplay"@en ;
    rdfs:subClassOf datex:Vms.DisplayAreaSettings ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "sequenceGroupNumber"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Where MultiPageDisplay instances have the same sequenceGroupNumber, the timed progression through their pages is synchronised."@en ] .

datex:Vms.MultiPageDisplay.DisplayAreaSettings
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.MultiPageDisplay ;
    rdfs:range datex:Vms.DisplayAreaSettings ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:Vms.PhysicalSupportEnum
    a owl:Class ;
    rdfs:label "PhysicalSupportEnum"@en ;
    skos:definition "The ways in which equipments such as VMS are mounted or deployed on the road."@en ;
    skos:prefLabel "physical support enum"@en ;
    skos:altLabel "physicalsupportenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "centralReservationMounted"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Equipment mounted in the central reservation."@en ] ;
    ea:value [ ea:name "gantryMounted"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Equipment mounted on an overhead gantry across the carriageway."@en ] ;
    ea:value [ ea:name "overheadBridgeMounted"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Equipment mounted overhead on a bridge structure."@en ] ;
    ea:value [ ea:name "roadsideCantileverMounted"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Equipment mounted on a cantilever from the roadside."@en ] ;
    ea:value [ ea:name "roadsideMounted"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Equipment mounted at the roadside."@en ] ;
    ea:value [ ea:name "trailerMounted"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Equipment mounted on a movable trailer."@en ] ;
    ea:value [ ea:name "tunnelEntranceMounted"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Equipment mounted on the entrance to a tunnel."@en ] ;
    ea:value [ ea:name "vehicleMounted"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Equipment mounted on a vehicle."@en ] .

datex:Vms.Pictogram
    a owl:Class ;
    rdfs:label "Pictogram"@en ;
    skos:definition "A main pictogram displayable on the VMS panel. Note a main pictogram may have an associated supplementary panel which may itself contain a further pictogram and line of text."@en ;
    skos:prefLabel "pictogram"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "customPictogramCode"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "If a custom code list (not based on GDD) is being used, this is the code of the pictogram using the pictogram code list identified in the corresponding PictogramDisplayArea object"@en ] ;
    ea:attribute [ ea:name "pictogramInformationType"@en ; ea:position 2 ; ea:type datex:Vms.InformationTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Allows characterising the type of displayed information"@en ] ;
    ea:attribute [ ea:name "additionalDescription"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Additional description of the pictogram."@en ] ;
    ea:attribute [ ea:name "pictogramFlashing"@en ; ea:position 4 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication of whether the pictogram is flashing."@en ] ;
    ea:attribute [ ea:name "pictogramInInverseColour"@en ; ea:position 5 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The pictogram is displayed in inverse colour (i.e. the colours are the inverse of normal)."@en ] ;
    ea:attribute [ ea:name "viennaConventionCompliant"@en ; ea:position 6 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates that the displayed pictogram conforms with the Vienna Convention defined pictogram list as modified by \"UNECE Consolidated Resolution on Road Signs and Signals\"."@en ] .

datex:Vms.Pictogram.GddStructure
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.Pictogram ;
    rdfs:range datex:Vms.GddStructure ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Vms.PictogramDisplay
    a owl:Class ;
    rdfs:label "PictogramDisplay"@en ;
    skos:definition "A display of a pictogram on one area on a VMS, potentially with associated supplemental information or instructions."@en ;
    skos:prefLabel "pictogram display"@en ;
    skos:altLabel "pictogramdisplay"@en ;
    rdfs:subClassOf datex:Vms.DisplayAreaSettings ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "isPrimaryPictogram"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates if the given pictogram display area is considered as the primary pictogram (= True) or not (= False)."@en ] ;
    ea:attribute [ ea:name "pictogramDisplayUrl"@en ; ea:position 2 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Reference to a URL from where an image of the displayed pictogram can be be obtained."@en ] .

datex:Vms.PictogramDisplay.Image
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.PictogramDisplay ;
    rdfs:range datex:Vms.Image ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Vms.PictogramDisplay.Pictogram
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.PictogramDisplay ;
    rdfs:range datex:Vms.Pictogram ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:Vms.PictogramDisplay.SupplementaryInformationDisplay
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.PictogramDisplay ;
    rdfs:range datex:Vms.SupplementaryInformationDisplay ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Vms.PictogramDisplayArea
    a owl:Class ;
    rdfs:label "PictogramDisplayArea"@en ;
    skos:definition "Characteristics specific to a pictogram display area on the VMS."@en ;
    skos:prefLabel "pictogram display area"@en ;
    skos:altLabel "pictogramdisplayarea"@en ;
    rdfs:subClassOf datex:Vms.DisplayArea ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsConfiguration"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "pictogramCodeListIdentifier"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates which pictogram code list is referenced. This may be ISO 14823 or a custom list."@en ] ;
    ea:attribute [ ea:name "pictogramNumberOfColours"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of colours the pictogram display area is capable of rendering."@en ] .

datex:Vms.PictogramEnum
    a owl:Class ;
    rdfs:label "PictogramEnum"@en ;
    skos:definition "Types of pictogram not currently covered by ISO 14823 Graphic Data Dictionary"@en ;
    skos:prefLabel "pictogram enum"@en ;
    skos:altLabel "pictogramenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "blankVoid"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Blank or void."@en ] ;
    ea:value [ ea:name "bridgeClosed"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Bridge closed."@en ] ;
    ea:value [ ea:name "carParkFull"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Car park full."@en ] ;
    ea:value [ ea:name "carParkSpacesAvailable"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Spaces available in car park."@en ] ;
    ea:value [ ea:name "corridorForEmergencyVehicleAccess"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Corridor for emergency vehicle access"@en ] ;
    ea:value [ ea:name "curveArrowToLeft"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Single curve arrow to the left corresponding to an exit (without fork)."@en ] ;
    ea:value [ ea:name "curveArrowToRight"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Single curve arrow to the right corresponding to an exit (without fork)."@en ] ;
    ea:value [ ea:name "dangerOfFire"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Danger of fire."@en ] ;
    ea:value [ ea:name "doubleExitToLeft"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Triple arrow corresponding to two sequential exits to the left."@en ] ;
    ea:value [ ea:name "doubleExitToRight"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Triple arrow corresponding to two sequential exits to the right."@en ] ;
    ea:value [ ea:name "endOfAdvisorySpeed"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "End of advisory speed."@en ] ;
    ea:value [ ea:name "fastenChildrensSeatBelts"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fasten the seat belts of children."@en ] ;
    ea:value [ ea:name "fastenYourSeatBelt"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fasten your seat belt."@en ] ;
    ea:value [ ea:name "fire"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fire."@en ] ;
    ea:value [ ea:name "footballMatch"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Football match (current or anticipated disruption due to football match)."@en ] ;
    ea:value [ ea:name "hardShoulderNotRunning"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The hard shoulder is not being used as a regular traffic lane but is reserved as a hard shoulder."@en ] ;
    ea:value [ ea:name "hardShoulderRunning"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The hard shoulder is being used as a regular traffic lane i.e. the lane is not acting as a hard shoulder."@en ] ;
    ea:value [ ea:name "horizontalDiversionToLeft"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Correspond to the horizontal orange (to the left) sign for diversion"@en ] ;
    ea:value [ ea:name "horizontalDiversionToRight"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Correspond to the horizontal orange (to the right) sign for diversion"@en ] ;
    ea:value [ ea:name "keepASafeDistance"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Keep a safe distance."@en ] ;
    ea:value [ ea:name "keepLeft"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Keep left."@en ] ;
    ea:value [ ea:name "keepRight"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Keep right."@en ] ;
    ea:value [ ea:name "lane1ClosedOf2"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lane 1 closed on a 2 lane carriageway. Lanes numbered from nearside (next to hard shoulder on motorway) to central median."@en ] ;
    ea:value [ ea:name "lane2ClosedOf2"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lane 2 closed on a 2 lane carriageway. Lanes numbered from nearside (next to hard shoulder on motorway) to central median."@en ] ;
    ea:value [ ea:name "lane1ClosedOf3"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lane 1 closed on a 3 lane carriageway. Lanes numbered from nearside (next to hard shoulder on motorway) to central median."@en ] ;
    ea:value [ ea:name "lane3ClosedOf3"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lane 3 closed on a 3 lane carriageway. Lanes numbered from nearside (next to hard shoulder on motorway) to central median."@en ] ;
    ea:value [ ea:name "lanes1And2ClosedOf3"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lanes 1 and 2 closed on a 3 lane carriageway. Lanes numbered from nearside (next to hard shoulder on motorway) to central median."@en ] ;
    ea:value [ ea:name "lanes2And3ClosedOf3"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lanes 2 and 3 closed on a 3 lane carriageway. Lanes numbered from nearside (next to hard shoulder on motorway) to central median."@en ] ;
    ea:value [ ea:name "lane1ClosedOf4"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lane 1 closed on a 4 lane carriageway. Lanes numbered from nearside (next to hard shoulder on motorway) to central median."@en ] ;
    ea:value [ ea:name "lane4ClosedOf4"@en ; ea:position 30 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lane 4 closed on a 4 lane carriageway. Lanes numbered from nearside (next to hard shoulder on motorway) to central median."@en ] ;
    ea:value [ ea:name "lanes1And2ClosedOf4"@en ; ea:position 31 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lanes 1 and 2 closed on a 4 lane carriageway. Lanes numbered from nearside (next to hard shoulder on motorway) to central median."@en ] ;
    ea:value [ ea:name "lanes3And4ClosedOf4"@en ; ea:position 32 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lanes 3 and 4 closed on a 4 lane carriageway. Lanes numbered from nearside (next to hard shoulder on motorway) to central median."@en ] ;
    ea:value [ ea:name "lanes1And2And3ClosedOf4"@en ; ea:position 33 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lanes 1, 2 and 3 closed on a 4 lane carriageway. Lanes numbered from nearside (next to hard shoulder on motorway) to central median."@en ] ;
    ea:value [ ea:name "lanes2And3And4ClosedOf4"@en ; ea:position 34 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Lanes 2, 3 and 4 closed on a 4 lane carriageway. Lanes numbered from nearside (next to hard shoulder on motorway) to central median."@en ] ;
    ea:value [ ea:name "leftHandLaneClosed"@en ; ea:position 35 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Left-hand lane closed ahead."@en ] ;
    ea:value [ ea:name "narrowLanesAhead"@en ; ea:position 36 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Narrow lanes ahead."@en ] ;
    ea:value [ ea:name "obliqueArrowToLeft"@en ; ea:position 37 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Single oblique straight arrow to the left corresponding to an exit (without fork)."@en ] ;
    ea:value [ ea:name "obliqueArrowToRight"@en ; ea:position 38 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Single oblique straight arrow to the right corresponding to an exit (without fork)."@en ] ;
    ea:value [ ea:name "pollutionOrSmogAlert"@en ; ea:position 39 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Pollution or smog alert."@en ] ;
    ea:value [ ea:name "rightHandLaneClosed"@en ; ea:position 40 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Right-hand lane closed ahead."@en ] ;
    ea:value [ ea:name "singleExitToLeft"@en ; ea:position 41 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Double arrow corresponding to a single exit to the left."@en ] ;
    ea:value [ ea:name "singleExitToRight"@en ; ea:position 42 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Double arrow corresponding to a single exit to the right."@en ] ;
    ea:value [ ea:name "smoke"@en ; ea:position 43 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Smoke."@en ] ;
    ea:value [ ea:name "snowPloughInAction"@en ; ea:position 44 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Snow plough(s) in action."@en ] ;
    ea:value [ ea:name "speedCamerasInAction"@en ; ea:position 45 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Speed cameras in action."@en ] ;
    ea:value [ ea:name "straightVerticalArrow"@en ; ea:position 46 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Straight vertical arrow (towards top)."@en ] ;
    ea:value [ ea:name "trafficDeviatedToOppositeCarriagewayAhead"@en ; ea:position 47 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "All traffic is diverted to the opposite carriageway ahead in a contraflow layout."@en ] ;
    ea:value [ ea:name "trafficPartiallyDeviatedToOppositeCarriagewayAhead"@en ; ea:position 48 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic is partially diverted to the opposite carriageway ahead in a contraflow layout."@en ] ;
    ea:value [ ea:name "tunnelClosed"@en ; ea:position 49 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Tunnel closed."@en ] ;
    ea:value [ ea:name "verticalDiversion"@en ; ea:position 50 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Correspond to the vertical orange sign for diversion."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 51 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Vms.PositionXAbsoluteEnum
    a owl:Class ;
    rdfs:label "PositionXAbsoluteEnum"@en ;
    skos:definition "Absolute horizontal positions of an item within an assigned space."@en ;
    skos:prefLabel "position x absolute enum"@en ;
    skos:altLabel "positionxabsoluteenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "onLeft"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the left of the assigned space."@en ] ;
    ea:value [ ea:name "inTheMiddle"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the middle of the assigned space."@en ] ;
    ea:value [ ea:name "onRight"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "On the right of the assigned space."@en ] .

datex:Vms.PositionXRelativeEnum
    a owl:Class ;
    rdfs:label "PositionXRelativeEnum"@en ;
    skos:definition "Relative horizontal positions of one item to another."@en ;
    skos:prefLabel "position x relative enum"@en ;
    skos:altLabel "positionxrelativeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "toTheLeft"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Positioned to the left of relative item."@en ] ;
    ea:value [ ea:name "alignedOnTheLeftSide"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The left side of the area is aligned on the left side of the relative area."@en ] ;
    ea:value [ ea:name "centred"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The area is vertically centred on the relative area."@en ] ;
    ea:value [ ea:name "alignedOnTheRightSide"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The right side of the area is aligned on the right side of the relative area."@en ] ;
    ea:value [ ea:name "toTheRight"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Positioned to the right of relative item."@en ] .

datex:Vms.PositionYAbsoluteEnum
    a owl:Class ;
    rdfs:label "PositionYAbsoluteEnum"@en ;
    skos:definition "Absolute verticals positions of an item within an assigned space."@en ;
    skos:prefLabel "position y absolute enum"@en ;
    skos:altLabel "positionyabsoluteenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "atTop"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At the top of the assigned space."@en ] ;
    ea:value [ ea:name "inTheMiddle"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In the middle of the assigned space."@en ] ;
    ea:value [ ea:name "atBottom"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "At the bottom of the assigned space."@en ] .

datex:Vms.PositionYRelativeEnum
    a owl:Class ;
    rdfs:label "PositionYRelativeEnum"@en ;
    skos:definition "Relative vertical positions of one item to another."@en ;
    skos:prefLabel "position y relative enum"@en ;
    skos:altLabel "positionyrelativeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "above"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Positioned above relative item."@en ] ;
    ea:value [ ea:name "alignedOnTheTopSide"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The top side of the area is aligned on the top side of the relative area."@en ] ;
    ea:value [ ea:name "centred"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The area is horizontally centred on the relative area."@en ] ;
    ea:value [ ea:name "alignedOnTheBottomSide"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The bottom side of the area is aligned on the bottom side of the relative area."@en ] ;
    ea:value [ ea:name "below"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Positioned below relative item."@en ] .

datex:Vms.RegularPictogram
    a owl:Class ;
    rdfs:label "RegularPictogram"@en ;
    skos:definition "A regular pictogram displayable on a VMS panel."@en ;
    skos:prefLabel "regular pictogram"@en ;
    skos:altLabel "regularpictogram"@en ;
    rdfs:subClassOf datex:Vms.Pictogram ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "pictogramDescription"@en ; ea:position 1 ; ea:type datex:Vms.PictogramEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Description of the pictogram."@en ] ;
    ea:attribute [ ea:name "presenceOfRedTriangle"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication of the presence of a red triangle around the pictogram, often used to indicate imminence, typically within 2 km, of signed danger."@en ] .

datex:Vms.RegularPictogram.DisplayedNumericalInformation
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.RegularPictogram ;
    rdfs:range datex:Vms.DisplayedNumericalInformation ;
    ea:lowerBound "0" ;
    ea:upperBound "2" .

datex:Vms.SettingReasonEnum
    a owl:Class ;
    rdfs:label "SettingReasonEnum"@en ;
    skos:definition "Coded reasons why a message has been selected for display on the sign."@en ;
    skos:prefLabel "setting reason enum"@en ;
    skos:altLabel "settingreasonenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "situation"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Message selected as the result of a situation occuring either on or off the road which might affect road users."@en ] ;
    ea:value [ ea:name "operatorCreated"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Message selected by operator as the result of an unmanaged event or situation."@en ] ;
    ea:value [ ea:name "trafficManagement"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Message selected as part of the implementation of a traffic management action. This can be part of a specific traffic management or diversion plan."@en ] ;
    ea:value [ ea:name "travelTime"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The VMS is currently selected to display travel times."@en ] ;
    ea:value [ ea:name "campaign"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The VMS is currently selected to display a campaign message."@en ] ;
    ea:value [ ea:name "default"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The VMS is currently selected to display default information (e.g. time, date, temperature)."@en ] .

datex:Vms.SupplementalPictogramEnum
    a owl:Class ;
    rdfs:label "SupplementalPictogramEnum"@en ;
    skos:definition "Types of pictograms displayable in supplementary panels (normally below the main pictogram display which it qualifies)."@en ;
    skos:prefLabel "supplemental pictogram enum"@en ;
    skos:altLabel "supplementalpictogramenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "distanceToTheBeginningOfTheApplicationZone"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Distance to the beginning of the application zone."@en ] ;
    ea:value [ ea:name "exceptAnyPowerDrivenVehicleDrawingTrailer"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Except any power-driven vehicle drawing a trailer."@en ] ;
    ea:value [ ea:name "exceptBus"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Except for buses."@en ] ;
    ea:value [ ea:name "exceptGoodsVehicles"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Except for goods vehicles."@en ] ;
    ea:value [ ea:name "exceptSemitrailer"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Except for semitrailers (i.e. any trailer designed to be coupled to a motor vehicle in such a way that part of its weight and that of its load is borne by the motor vehicle)."@en ] ;
    ea:value [ ea:name "exceptVehiclesCarryingDangerousGoods"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Except for vehicles carrying dangerous goods (i.e. for which special sign plating is prescribed)."@en ] ;
    ea:value [ ea:name "inCaseOfIceOrSnow"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "In case of ice or snow."@en ] ;
    ea:value [ ea:name "lengthOfTheApplicationZone"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Length of the applicable zone."@en ] ;
    ea:value [ ea:name "restrictedToAnyPowerDrivenVehicleDrawingTrailer"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Restricted to any power driven vehicle drawing a trailer."@en ] ;
    ea:value [ ea:name "restrictedToBus"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Restricted to buses."@en ] ;
    ea:value [ ea:name "restrictedToGoodsVehicles"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Restricted to goods vehicles."@en ] ;
    ea:value [ ea:name "restrictedToSemiTrailer"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Restricted to semi trailers (i.e. any trailer designed to be coupled to a motor vehicle in such a way that part of its weight and that of its load is borne by the motor vehicle)."@en ] ;
    ea:value [ ea:name "restrictedToVehiclesCarryingDangerousGoods"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Restricted to vehicles carrying dangerous goods (i.e. for which special sign plating is prescribed)."@en ] ;
    ea:value [ ea:name "maintenanceVehicles"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Maintenance vehicles."@en ] ;
    ea:value [ ea:name "snowPloughs"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Snow ploughs."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

datex:Vms.SupplementaryInformationDisplay
    a owl:Class ;
    rdfs:label "SupplementaryInformationDisplay"@en ;
    skos:definition "A display of information or a regulatory instruction which is supplemental to the associated pictogram, comprising either an additional line of text or a pictogram or both."@en ;
    skos:prefLabel "supplementary information display"@en ;
    skos:altLabel "supplementaryinformationdisplay"@en ;
    rdfs:subClassOf datex:Vms.DisplayAreaSettings ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" .

datex:Vms.SupplementaryPanelArea
    a owl:Class ;
    rdfs:label "SupplementaryPanelArea"@en ;
    skos:definition "Characteristics of a panel which can display details (sometimes regulatory in nature) that are supplementary to one pictogram, comprising an additional line of text or another pictogram."@en ;
    skos:prefLabel "supplementary panel area"@en ;
    skos:altLabel "supplementarypanelarea"@en ;
    rdfs:subClassOf datex:Vms.DisplayArea ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsConfiguration"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "relatedPictogramArea"@en ; ea:position 1 ; ea:type datex:Common.Integer ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The displayAreaIndex associated with the pictogram display area that this supplementary display area is designed to supplement."@en ] ;
    ea:attribute [ ea:name "supplementaryPictogramCodeListIdentifier"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates which supplementary pictogram code list is referenced. This may be ISO 14823 or a custom list."@en ] .

datex:Vms.SupplementaryPictogram
    a owl:Class ;
    rdfs:label "SupplementaryPictogram"@en ;
    skos:definition "An additional pictogram that is displayed in the panel which is supplemental to the associated pictogram display."@en ;
    skos:prefLabel "supplementary pictogram"@en ;
    skos:altLabel "supplementarypictogram"@en ;
    rdfs:subClassOf datex:Vms.SupplementaryInformationDisplay ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "pictogramDescription"@en ; ea:position 1 ; ea:type datex:Vms.SupplementalPictogramEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of the displayed supplementary pictogram."@en ] ;
    ea:attribute [ ea:name "pictogramCode"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The code of the supplementary pictogram from the supplementary pictogram code list referenced in the corresponding SupplementaryPanelArea."@en ] ;
    ea:attribute [ ea:name "pictogramInformationType"@en ; ea:position 3 ; ea:type datex:Vms.InformationTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Allows characterising the type of displayed information"@en ] ;
    ea:attribute [ ea:name "pictogramUrl"@en ; ea:position 4 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Reference to a URL from where an image of the displayed supplementary pictogram can be obtained."@en ] ;
    ea:attribute [ ea:name "additionalDescription"@en ; ea:position 5 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Additional free text description of the supplementary pictogram."@en ] ;
    ea:attribute [ ea:name "pictogramFlashing"@en ; ea:position 6 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication of whether the pictogram is flashing."@en ] .

datex:Vms.SupplementaryText
    a owl:Class ;
    rdfs:label "SupplementaryText"@en ;
    skos:definition "Text used in a supplementary display associated with a pictogram"@en ;
    skos:prefLabel "supplementary text"@en ;
    skos:altLabel "supplementarytext"@en ;
    rdfs:subClassOf datex:Vms.SupplementaryInformationDisplay ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" .

datex:Vms.SupplementaryText.TextLine
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.SupplementaryText ;
    rdfs:range datex:Vms.TextLine ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:Vms.TextDisplay
    a owl:Class ;
    rdfs:label "TextDisplay"@en ;
    skos:definition "A page of text (comprising one or more ordered lines) that are displayed simultaneously on the VMS."@en ;
    skos:prefLabel "text display"@en ;
    skos:altLabel "textdisplay"@en ;
    rdfs:subClassOf datex:Vms.DisplayAreaSettings ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "textCode"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The code of the specific text, from the defined code list."@en ] ;
    ea:attribute [ ea:name "textImageUrl"@en ; ea:position 2 ; ea:type datex:Common.Url ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Reference to a URL from where an image of the displayed text can be obtained."@en ] .

datex:Vms.TextDisplay.TextLine
    a owl:ObjectProperty ;
    rdfs:domain datex:Vms.TextDisplay ;
    rdfs:range datex:Vms.TextLine ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Vms.TextDisplayArea
    a owl:Class ;
    rdfs:label "TextDisplayArea"@en ;
    skos:definition "Characteristics specific to the textual display area on the VMS."@en ;
    skos:prefLabel "text display area"@en ;
    skos:altLabel "textdisplayarea"@en ;
    rdfs:subClassOf datex:Vms.DisplayArea ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsConfiguration"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "proportionalFont"@en ; ea:position 1 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Whether the VMS supports proportional fonts"@en ] ;
    ea:attribute [ ea:name "maxNumberOfCharacters"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum number of displayable characters on a single line in the textual display area of the VMS."@en ] ;
    ea:attribute [ ea:name "maxNumberOfRows"@en ; ea:position 3 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum number of rows of displayable characters in the textual display area of the VMS."@en ] ;
    ea:attribute [ ea:name "textCodeListIdentifier"@en ; ea:position 4 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates which textual message code list is referenced. This may be specific to the VMS type defined by vmsTypeCode."@en ] ;
    ea:attribute [ ea:name "maxFontHeight"@en ; ea:position 5 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum font height in pixels."@en ] ;
    ea:attribute [ ea:name "minFontHeight"@en ; ea:position 6 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Minimum font height in pixels."@en ] ;
    ea:attribute [ ea:name "maxFontWidth"@en ; ea:position 7 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum font width in pixels."@en ] ;
    ea:attribute [ ea:name "minFontWidth"@en ; ea:position 8 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Minimum font width in pixels."@en ] ;
    ea:attribute [ ea:name "maxFontSpacing"@en ; ea:position 9 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Maximum font spacing in pixels."@en ] ;
    ea:attribute [ ea:name "minFontSpacing"@en ; ea:position 10 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Minimum font spacing in pixels."@en ] .

datex:Vms.TextLine
    a owl:Class ;
    rdfs:label "TextLine"@en ;
    skos:definition "A single line of text displayed on a text display area or supplementary panel or corresponding to a displayed text. It may correspond to the entire text in the case that text segmentation in lines is not available."@en ;
    skos:prefLabel "text line"@en ;
    skos:altLabel "textline"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes/VmsMessage"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "textLine"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A free-text string that is displayed on a single line on the text display area. It may correspond to the entire text in the case that text segmentation in lines is not available."@en ] ;
    ea:attribute [ ea:name "lineLanguage"@en ; ea:position 2 ; ea:type datex:Common.Language ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The language of the displayed text, specified by an ISO 639-1 language code."@en ] ;
    ea:attribute [ ea:name "lineColour"@en ; ea:position 3 ; ea:type datex:Vms.ColourEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The colour of the displayed text."@en ] ;
    ea:attribute [ ea:name "lineFlashing"@en ; ea:position 4 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indication of whether the displayed text is flashing."@en ] ;
    ea:attribute [ ea:name "lineHtml"@en ; ea:position 5 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The displayed line of text defined by an HTML string showing text formatting tags."@en ] ;
    ea:attribute [ ea:name "isExactTextOnSign"@en ; ea:position 6 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Confirms whether the specified text is exactly as displayed, or whether it is just a semantic equivalent."@en ] ;
    ea:attribute [ ea:name "textInformationType"@en ; ea:position 7 ; ea:type datex:Vms.InformationTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Allows characterising the type of displayed information"@en ] .

datex:Vms.UnitOfMeasureEnum
    a owl:Class ;
    rdfs:label "UnitOfMeasureEnum"@en ;
    skos:definition "Identifies a unit of measure for a physical quantity"@en ;
    skos:prefLabel "unit of measure enum"@en ;
    skos:altLabel "unitofmeasureenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Vms / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "feet"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The imperial unit feet"@en ] ;
    ea:value [ ea:name "feetAndInches"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The imperial units feet and inches"@en ] ;
    ea:value [ ea:name "kilometres"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The metric unit kilometres"@en ] ;
    ea:value [ ea:name "kilometresPerHour"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The unit kilometres per hour"@en ] ;
    ea:value [ ea:name "metres"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The metric unit metres"@en ] ;
    ea:value [ ea:name "miles"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The imperial unit miles"@en ] ;
    ea:value [ ea:name "milesPerHour"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The unit miles per hour"@en ] ;
    ea:value [ ea:name "percentage"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A percentage"@en ] ;
    ea:value [ ea:name "tonnes"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The metric unit tonnes"@en ] ;
    ea:value [ ea:name "yards"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The imperial unit yards"@en ] .

datex:Vms.Vms
    a owl:Class ;
    rdfs:label "Vms"@en ;
    skos:definition "Variable message sign - a display panel used to display one or more messages (text, symbols, pictograms or combinations) that can be changed or switched on or off as required"@en ;
    skos:prefLabel "vms"@en ;
    rdfs:comment "DATEX II class in namespace Vms / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "dedicatedUsage"@en ; ea:position 1 ; ea:type datex:Vms.DedicatedUsageEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Type of usage to which this VMS is dedicated"@en ] ;
    ea:attribute [ ea:name "lanternsPresent"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Indicates whether the VMS is equipped with flashing lights (called lanterns in some countries) outside the text or pictogram display areas"@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The description of the VMS (possibly giving a description of its location or its normal use)."@en ] ;
    ea:attribute [ ea:name "owner"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Owner (authority or organisation) of the VMS. This may not be the same as the authority or organisation which is currently controlling the VMS."@en ] ;
    ea:attribute [ ea:name "physicalSupport"@en ; ea:position 5 ; ea:type datex:Vms.PhysicalSupportEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Description of how the VMS is physically mounted or deployed on the road."@en ] ;
    ea:attribute [ ea:name "vmsType"@en ; ea:position 6 ; ea:type datex:Vms.VmsTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Broad classification of the type of variable message sign."@en ] ;
    ea:attribute [ ea:name "vmsTypeCode"@en ; ea:position 7 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Specification of the type of VMS defined by a code, normally country or even manufacturer specific (e.g. MS4)."@en ] ;
    ea:attribute [ ea:name "dynamicallyConfigurable"@en ; ea:position 8 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identifies (when True) that the VMS has a display area that may be dynamically configured to display different combinations of text and pictogram areas. The current configuration will normally be given with each published current VMS setting."@en ] ;
    ea:attribute [ ea:name "displayHeight"@en ; ea:position 9 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Height in metres of the sign's overall display area."@en ] ;
    ea:attribute [ ea:name "displayWidth"@en ; ea:position 10 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Width in metres of the sign's overall display area."@en ] ;
    ea:attribute [ ea:name "heightAboveCarriageway"@en ; ea:position 11 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Height in metres of the mounted sign above the carriageway, measured to the bottom of the display area."@en ] .

