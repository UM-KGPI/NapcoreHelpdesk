    ea:attribute [ ea:name "sourceType"@en ; ea:position 2 ; ea:type datex:FaultAndStatus.PowerSourceEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Type of power supply"@en ] .

datex:FaultAndStatus.DevicePublication
    a owl:Class ;
    rdfs:label "DevicePublication"@en ;
    skos:definition "This publication provides static information about devices, including its point-location. It can be used in case no specific publication for the type of device is available or suitable. Fault- and StatusPublication can reference to the specified devices."@en ;
    skos:prefLabel "device publication"@en ;
    skos:altLabel "devicepublication"@en ;
    rdfs:subClassOf datex:Common.PayloadPublication ;
