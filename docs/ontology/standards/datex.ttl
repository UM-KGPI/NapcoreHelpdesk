    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:RoadTrafficData.TravelTimeData.travelTimeDelay
    a owl:ObjectProperty ;
    rdfs:domain datex:RoadTrafficData.TravelTimeData ;
