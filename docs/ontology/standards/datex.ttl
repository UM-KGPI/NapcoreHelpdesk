datex:Common.TemperatureBelowOrAboveRoadSurface
    a owl:Class ;
    rdfs:label "TemperatureBelowOrAboveRoadSurface"@en ;
    skos:definition "Mesurement of temperature below or above the road surface."@en ;
    skos:prefLabel "temperature below or above road surface"@en ;
    skos:altLabel "temperaturebeloworaboveroadsurface"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/WeatherRelated"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "heightBelowOrAboveRoadSurface"@en ; ea:position 1 ; ea:type datex:Common.MetresAsFloat ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The height of the measurement either below (negative value) or above (positive value) the road surface."@en ] .

datex:Common.TemperatureBelowOrAboveRoadSurface.temperatureBelowOrAboveRoadSurface
    a owl:ObjectProperty ;
    rdfs:domain datex:Common.TemperatureBelowOrAboveRoadSurface ;
