    ea:kind "class" ;
    ea:attribute [ ea:name "name"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The (last) name of the contact person."@en ] ;
    ea:attribute [ ea:name "firstName"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The first name of the contact person."@en ] ;
    ea:attribute [ ea:name "title"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Title information of the contact person."@en ] ;
    ea:attribute [ ea:name "position"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The position of the contact person."@en ] .

datex:AfirFacilities.Credential
    a owl:Class ;
    rdfs:label "Credential"@en ;
    skos:definition "Class containing reference to a credential (identifiable persistent identity)."@en ;
    skos:prefLabel "credential"@en ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / RatesPublication/Right"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "type"@en ; ea:position 1 ; ea:type datex:AfirFacilities.CredentialTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Type of credential."@en ] ;
    ea:attribute [ ea:name "otherType"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Some other type of credential."@en ] .

datex:AfirFacilities.CredentialAssigned
    a owl:Class ;
    rdfs:label "CredentialAssigned"@en ;
    skos:definition "Information concerning a specific credential that is used for verification for one AssignedRight. Specialisation of a general credential."@en ;
    skos:prefLabel "credential assigned"@en ;
    skos:altLabel "credentialassigned"@en ;
    rdfs:subClassOf datex:AfirFacilities.Credential ;
    rdfs:comment "DATEX II class in namespace AfirFacilities / RatesPublication/Right"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "localIdentifier"@en ; ea:position 1 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Identifier issued by credential issuer."@en ] ;
    ea:attribute [ ea:name "issuer"@en ; ea:position 2 ; ea:type datex:Common.VersionedReference ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Identity of the credential issuer."@en ] .

datex:AfirFacilities.CredentialTypeEnum
    a owl:Class ;
    rdfs:label "CredentialTypeEnum"@en ;
    skos:definition "A list of the supported credential types available for reference."@en ;
    skos:prefLabel "credential type enum"@en ;
    skos:altLabel "credentialtypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirFacilities / RatesPublication/Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "hangtag"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Visible, often removable, credential indicator, with visible markings."@en ] ;
    ea:value [ ea:name "permit"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Issued credential, often in the form of an adhesive label, often placed on the windscreen, credential indicator, with visible markings."@en ] ;
    ea:value [ ea:name "licensePlate"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Fixed plate, in a defined format, used to identify a specific vehicle. Normally a permanent fixture."@en ] ;
    ea:value [ ea:name "ticket"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Typically issued paper with printed details, often with magnetic strips; typically single use disposable."@en ] ;
    ea:value [ ea:name "eticket"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Digital equivalent of a paper ticket, often presentable via smartphone or similar device for control."@en ] ;
    ea:value [ ea:name "barcode"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Barcode or QR digital print pattern held on any physical media."@en ] ;
    ea:value [ ea:name "bluetooth"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specific bluetooth or BLE identification chip used to associate a BLE receiver to a specific user. Used for both one time and permit uses."@en ] ;
    ea:value [ ea:name "rfid"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Specific RF identification associated to an RFID-related account. Used for permit uses."@en ] ;
    ea:value [ ea:name "qrCode"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Quick Reference (QR) code."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some other credential."@en ] .

datex:AfirFacilities.CurrencyCode
    a owl:Class ;
    rdfs:label "CurrencyCode"@en ;
