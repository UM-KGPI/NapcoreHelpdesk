datex:TrafficRegulation.AdvisorySpeed
    a owl:Class ;
    rdfs:label "AdvisorySpeed"@en ;
    skos:definition "Speed at which it is advisable to drive if circumstances permit and if the driver is not required to comply with a lower limit specific to his category of vehicle."@en ;
    skos:prefLabel "advisory speed"@en ;
    skos:altLabel "advisoryspeed"@en ;
    rdfs:subClassOf datex:TrafficRegulation.NumercialSpeedValue ;
