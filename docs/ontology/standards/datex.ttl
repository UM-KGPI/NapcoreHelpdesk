datex:Common.VehicleCharacteristics
    a owl:Class ;
    rdfs:label "VehicleCharacteristics"@en ;
    skos:definition "The characteristics of a vehicle, e.g. lorry of gross weight greater than 30 tonnes."@en ;
    skos:prefLabel "vehicle characteristics"@en ;
    skos:altLabel "vehiclecharacteristics"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/VehicleCharacteristics"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "fuelType"@en ; ea:position 1 ; ea:type datex:Common.FuelTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The type of fuel used by the vehicle."@en ] ;
    ea:attribute [ ea:name "loadType"@en ; ea:position 2 ; ea:type datex:Common.LoadTypeEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The type of load carried by the vehicle, especially in respect of hazardous loads."@en ] ;
    ea:attribute [ ea:name "vehicleEquipment"@en ; ea:position 3 ; ea:type datex:Common.VehicleEquipmentEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The type of equipment in use or on board the vehicle."@en ] ;
    ea:attribute [ ea:name "vehicleType"@en ; ea:position 4 ; ea:type datex:Common.VehicleTypeEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Vehicle type."@en ] ;
    ea:attribute [ ea:name "vehicleUsage"@en ; ea:position 5 ; ea:type datex:Common.VehicleUsageEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The type of usage of the vehicle (i.e. for what purpose is the vehicle being used)."@en ] ;
    ea:attribute [ ea:name "yearOfFirstRegistration"@en ; ea:position 6 ; ea:type datex:Common.Year ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Year of first registration of the vehicle"@en ] .

datex:Common.VehicleCharacteristics.Emissions
    a owl:ObjectProperty ;
    rdfs:domain datex:Common.VehicleCharacteristics ;
