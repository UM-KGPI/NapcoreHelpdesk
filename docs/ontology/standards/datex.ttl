datex:Situation.TrafficConstrictionTypeEnum
    a owl:Class ;
    rdfs:label "TrafficConstrictionTypeEnum"@en ;
    skos:definition "Types of constriction to which traffic is subjected as a result of an event."@en ;
    skos:prefLabel "traffic constriction type enum"@en ;
    skos:altLabel "trafficconstrictiontypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "carriagewayBlocked"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The carriageway is totally obstructed in the specified direction due to an unplanned event."@en ] ;
    ea:value [ ea:name "carriagewayPartiallyObstructed"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The carriageway is partially obstructed in the specified direction due to an unplanned event."@en ] ;
    ea:value [ ea:name "lanesBlocked"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "One or more lanes is totally obstructed in the specified direction due to an unplanned event."@en ] ;
    ea:value [ ea:name "lanesPartiallyObstructed"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "One or more lanes is partially obstructed in the specified direction due to an unplanned event."@en ] ;
    ea:value [ ea:name "roadBlocked"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road is totally obstructed, for all vehicles in both directions, due to an unplanned event."@en ] ;
    ea:value [ ea:name "roadPartiallyObstructed"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The road is partially obstructed in both directions due to an unplanned event."@en ] .

datex:Situation.TrafficElement
