datex:UrbanExtensions.ObstructionTypeEnumExtendedUrban
    a owl:Class ;
    rdfs:label "ObstructionTypeEnumExtendedUrban"@en ;
    skos:definition "Urban extensions for obstructions."@en ;
    skos:prefLabel "obstruction type enum extended urban"@en ;
    skos:altLabel "obstructiontypeenumextendedurban"@en ;
    rdfs:subClassOf datex:Situation.ObstructionTypeEnum ;
    rdfs:comment "DATEX II enumeration in namespace UrbanExtensions"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "buildingWork"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Work at a building that affects road users. Could include obstructions including scaffolding or skips."@en ] ;
    ea:value [ ea:name "firefightersInOperation"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Firefighters are in operation that cause obstruction to road users."@en ] ;
    ea:value [ ea:name "policeInOperation"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Police operation underway, which causes obstruction to road users."@en ] .

datex:UrbanExtensions.RoadOrCarriageWayOrLaneManagementTypeEnumExtendedUrban
    a owl:Class ;
    rdfs:label "RoadOrCarriageWayOrLaneManagementTypeEnumExtendedUrban"@en ;
    skos:definition "Urban extensions for road or carriageway or lane management."@en ;
    skos:prefLabel "road or carriage way or lane management type enum extended urban"@en ;
    skos:altLabel "roadorcarriagewayorlanemanagementtypeenumextendedurban"@en ;
    rdfs:subClassOf datex:Situation.RoadOrCarriagewayOrLaneManagementTypeEnum ;
    rdfs:comment "DATEX II enumeration in namespace UrbanExtensions"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "createOneDirectionWay"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Different from previous situation, the road is used in only one traffic direction now."@en ] ;
    ea:value [ ea:name "createTwoDirectionWay"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Different from previous situation, the road is used in two traffic directions now."@en ] ;
    ea:value [ ea:name "laneInOperation"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified lane(s) are in operation and can be used according to its regular functionality."@en ] ;
    ea:value [ ea:name "laneMoved"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified lane(s) have been moved, i.e. they are at a new location (for example cycle lane moved on the other side of the road). In contrast to lanesDeviated, laneMoved indicates extended and permanent changes in road layout."@en ] ;
    ea:value [ ea:name "laneNotInOperation"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The specified lane(s) are not in operation, for example a bus lane or a car pool lane which is no longer reserved specifically for these modes. This does not automatically imply a lane closure."@en ] ;
    ea:value [ ea:name "laneRestrictionInOperation"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some restrictions are in operation for the specified lane(s)."@en ] ;
    ea:value [ ea:name "parkingProhibitionInOperation"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Parking (i.e. with driver not being inside the vehicle) is not allowed."@en ] ;
    ea:value [ ea:name "reverseTrafficDirection"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The traffic direction on the road has changed. This could affect a one-way road or a separated one-way carriageway."@en ] ;
    ea:value [ ea:name "waitingProhibitionInOperation"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Waiting (i.e. with driver being still inside or in attendance of its vehicle) or parking is not allowed."@en ] .

