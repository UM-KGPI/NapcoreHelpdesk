    ea:value [ ea:name "laundry"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A possibility for washing clothes (might also be a laundromat with coins)."@en ] ;
    ea:value [ ea:name "leisureActivities"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "There are leisure activities offered on the site or in the very near surrounding. Use the additional description attribute to give details."@en ] ;
