    rdfs:comment "DATEX II enumeration in namespace ReroutingManagementEnhanced / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "additionalParkingBan"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A temporary additional parking ban or restriction shall be implemented, for example to improve traffic flow on the route."@en ] ;
    ea:value [ ea:name "alteredSignalPhasing"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Traffic signal phases are altered (i.e. different sequence or timing to the normal signal phases)."@en ] ;
    ea:value [ ea:name "alternatedSignalisedTraffic"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Alternated signalised traffic"@en ] ;
    ea:value [ ea:name "closedEntry"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Closed entry"@en ] ;
    ea:value [ ea:name "closedExit"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Closed exit"@en ] ;
    ea:value [ ea:name "closedLanes"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Closed lanes"@en ] ;
    ea:value [ ea:name "modifiedCycleLength"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The cycle time of specific traffic signals is modified."@en ] ;
    ea:value [ ea:name "modifiedGreenPeriod"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Green period of traffic signals is modified (extended or reduced)."@en ] ;
    ea:value [ ea:name "oneDirectionTraffic"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "One direction traffic"@en ] ;
    ea:value [ ea:name "oneDirectionTrafficReversed"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "One direction traffic reversed"@en ] ;
    ea:value [ ea:name "openedExtraLane"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicates that one or more extra lanes are opened."@en ] ;
    ea:value [ ea:name "reducingLocalAccess"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Local access is restricted (e.g. because of an event)."@en ] ;
    ea:value [ ea:name "synchronizedTrafficSignals"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Linked timing of a sequence of traffic signals on a specific route to improve passage through the traffic signals as a group, e.g. a green wave."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some other traffic management in operation."@en ] .

datex:ReroutingManagementEnhanced.CapacityManagementMeasure
    a owl:Class ;
    rdfs:label "CapacityManagementMeasure"@en ;
    skos:definition "A traffic management measure, possibly with concrete actions, which leads to an intended change (increase or decrease) of capacity for the specific route."@en ;
    skos:prefLabel "capacity management measure"@en ;
    skos:altLabel "capacitymanagementmeasure"@en ;
    rdfs:comment "DATEX II class in namespace ReroutingManagementEnhanced / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "measure"@en ; ea:position 1 ; ea:type datex:ReroutingManagementEnhanced.CapacityManagementMeasureEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of the capacity management measure"@en ] ;
    ea:attribute [ ea:name "action"@en ; ea:position 2 ; ea:type datex:ReroutingManagementEnhanced.CapacityManagementActionEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "Actions that belong to the capacity management measure"@en ] ;
    ea:attribute [ ea:name "description"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A description of the capacity management measure and its actions"@en ] ;
    ea:attribute [ ea:name "defaultGreenTimeAdjustment"@en ; ea:position 4 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Additional or reduced traffic signal green time as standard value for all traffic signals on the specified route. Each traffic signal can overwrite this value."@en ] ;
    ea:attribute [ ea:name "defaultCycleLength"@en ; ea:position 5 ; ea:type datex:Common.Seconds ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The default cycle time to complete one full sequence of the operation of traffic signals along a specified route."@en ] ;
    ea:attribute [ ea:name "recommendedSpeed"@en ; ea:position 6 ; ea:type datex:Common.KilometresPerHour ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Advice for the optimal vehicle speed, for example in case of a green wave."@en ] .

datex:ReroutingManagementEnhanced.CapacityManagementMeasure.TrafficSignal
    a owl:ObjectProperty ;
    rdfs:domain datex:ReroutingManagementEnhanced.CapacityManagementMeasure ;
    rdfs:range datex:ReroutingManagementEnhanced.TrafficSignal ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:ReroutingManagementEnhanced.CapacityManagementMeasure.affectedLocation
    a owl:ObjectProperty ;
    rdfs:domain datex:ReroutingManagementEnhanced.CapacityManagementMeasure ;
    rdfs:range datex:LocationReferencing.LocationReference ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:ReroutingManagementEnhanced.CapacityManagementMeasureEnum
    a owl:Class ;
    rdfs:label "CapacityManagementMeasureEnum"@en ;
    skos:definition "Types of capacity management measures."@en ;
    skos:prefLabel "capacity management measure enum"@en ;
    skos:altLabel "capacitymanagementmeasureenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace ReroutingManagementEnhanced / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "accessMeasures"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A temporary additional parking ban or restriction shall be implemented, for example to improve traffic flow on the route."@en ] ;
    ea:value [ ea:name "capacityIncrease"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Enhanced capacity"@en ] ;
    ea:value [ ea:name "capacityReduction"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Reduced capacity"@en ] ;
    ea:value [ ea:name "inflowReduction"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Reduce the inflow"@en ] ;
    ea:value [ ea:name "outflowIncrease"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Increase the outflow"@en ] ;
    ea:value [ ea:name "parkingMeasures"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A temporary additional parking ban or restriction shall be implemented, for example to improve traffic flow on the route."@en ] ;
    ea:value [ ea:name "signalMeasures"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A temporary additional parking ban or restriction shall be implemented, for example to improve traffic flow on the route."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Some other traffic management in operation."@en ] .

datex:ReroutingManagementEnhanced.CommentTypeEnumExtended
    a owl:Class ;
    rdfs:label "CommentTypeEnumExtended"@en ;
    skos:definition "Extension class to provide an additional type of comment."@en ;
    skos:prefLabel "comment type enum extended"@en ;
    skos:altLabel "commenttypeenumextended"@en ;
