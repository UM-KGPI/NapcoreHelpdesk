datex:AfirEnergyInfrastructure.ServiceTypeEnum
    a owl:Class ;
    rdfs:label "ServiceTypeEnum"@en ;
    skos:definition "A table of different service levels to be expected for fuelling/charging and payment."@en ;
    skos:prefLabel "service type enum"@en ;
    skos:altLabel "servicetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirEnergyInfrastructure / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "fullService"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Full fuelling service carried out by an employee."@en ] ;
    ea:value [ ea:name "physicalAttendance"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Presence of physical persons attending the recharging or refuelling station."@en ] ;
    ea:value [ ea:name "selfService"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Self-service for fuelling."@en ] ;
    ea:value [ ea:name "unattended"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unattended station, fuelling and payment to be done without assistance."@en ] .

datex:AfirEnergyInfrastructure.SmartRechargingServicesEnum
    a owl:Class ;
    rdfs:label "SmartRechargingServicesEnum"@en ;
    skos:definition "Smart recharging services."@en ;
    skos:prefLabel "smart recharging services enum"@en ;
    skos:altLabel "smartrechargingservicesenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirEnergyInfrastructure / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "remoteMonitoring"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Remote monitoring and control recharging (e.g. by app)."@en ] ;
    ea:value [ ea:name "powerOptimisationByUser"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "User preference configuration for recharging power optimization."@en ] ;
    ea:value [ ea:name "bidirectionalRecharging"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Bidirectional charging."@en ] ;
    ea:value [ ea:name "plugAndCharge"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Possibility of conducting automatic authentication and authorisation of the recharging session an the basis of a contract-based payment concluded between the end user and the mobility service provider in a recharging point as defined in ISO 15118-2 and -2"@en ] .

datex:AfirEnergyInfrastructure.TimeBasedApplicability
    a owl:Class ;
    rdfs:label "TimeBasedApplicability"@en ;
    skos:definition "Price is only valid within the given charging time boundaries in minutes."@en ;
    skos:prefLabel "time based applicability"@en ;
    skos:altLabel "timebasedapplicability"@en ;
    rdfs:comment "DATEX II class in namespace AfirEnergyInfrastructure / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "fromMinute"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Price is valid from the given minute."@en ] ;
    ea:attribute [ ea:name "toMinute"@en ; ea:position 2 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Price is valid up to the given minute."@en ] .

datex:AfirEnergyInfrastructure.Units
    a owl:Class ;
