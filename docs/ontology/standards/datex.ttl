    ea:value [ ea:name "categoryB"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Tunnel category B according to ADR regulation."@en ] ;
    ea:value [ ea:name "categoryC"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Tunnel category C according to ADR regulation."@en ] ;
    ea:value [ ea:name "categoryD"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Tunnel category D according to ADR regulation."@en ] ;
    ea:value [ ea:name "categoryE"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Tunnel category E according to ADR regulation."@en ] .

datex:TrafficRegulation.AccessCondition
    a owl:Class ;
    rdfs:label "AccessCondition"@en ;
