    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:RoadTrafficData.TravelTimeData.normallyExpectedTravelTime
    a owl:ObjectProperty ;
    rdfs:domain datex:RoadTrafficData.TravelTimeData ;
    rdfs:range datex:RoadTrafficData.DurationValue ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:RoadTrafficData.TravelTimeData.travelTime
    a owl:ObjectProperty ;
    rdfs:domain datex:RoadTrafficData.TravelTimeData ;
