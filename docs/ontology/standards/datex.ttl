datex:Facilities.MeansOfPaymentEnum
    a owl:Class ;
    rdfs:label "MeansOfPaymentEnum"@en ;
    skos:definition "Means of payment"@en ;
    skos:prefLabel "means of payment enum"@en ;
    skos:altLabel "meansofpaymentenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Facilities / RatesPublication/Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "paymentCreditCard"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Payment by electronic payment credit card which is a small plastic card issued by a bank, building society, or other financial institution (ISO/IEC 7813 and other related standards), allowing the holder to purchase goods or services on credit."@en ] ;
    ea:value [ ea:name "cashBillsOnly"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Cash payment using bills only."@en ] ;
    ea:value [ ea:name "cashCoinsOnly"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Cash payment with coins only."@en ] ;
    ea:value [ ea:name "tollTag"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Toll tag (RFID) or similar, with associated account."@en ] ;
    ea:value [ ea:name "mobileAccount"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Payment method using an app or other functions typically via a smartphone to a linked bank or card account."@en ] ;
    ea:value [ ea:name "cashCoinsAndBills"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Cash payment using bills and/or coins only."@en ] ;
    ea:value [ ea:name "prepay"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Advanced payment for parking right."@en ] ;
    ea:value [ ea:name "paymentDebitCard"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Payment by electronic payment debit card which is a small plastic card (ISO/IEC 7813 and other related standards), allowing the holder to transfer money electronically from their bank account when making a purchase."@en ] ;
    ea:value [ ea:name "paymentValueCard"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Payment by electronic payment debit card which is a small plastic card (ISO/IEC 7813 and other related standards) with a monetary value stored on the card itself, that may not be linked to an external account maintained by a financial institution."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unknown."@en ] .

