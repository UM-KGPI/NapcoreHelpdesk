    skos:definition "Restriction of direction to be followed."@en ;
    skos:prefLabel "direction restriction"@en ;
    skos:altLabel "directionrestriction"@en ;
    rdfs:subClassOf datex:TrafficRegulation.TypeOfRegulation ;
    rdfs:comment "DATEX II class in namespace TrafficRegulation / Classes/TypeOfRegulation"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "directionToBeFollowed"@en ; ea:position 1 ; ea:type datex:TrafficRegulation.DirectionRestrictionTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Indicating a mandatory route or turn to be followed."@en ] ;
    ea:attribute [ ea:name "respectBicycle"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Respect bicycles when turning into a priority road or following a priority road or driving on one-way road."@en ] ;
    ea:attribute [ ea:name "respectMotorisedPersonalTransportDevices"@en ; ea:position 3 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Respect motorised personal transport devices when turning into a priority road or following a priority road or driving on one-way road."@en ] ;
