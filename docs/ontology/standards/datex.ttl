datex:AfirFacilities.EnergySourceEnum
    a owl:Class ;
    rdfs:label "EnergySourceEnum"@en ;
    skos:definition "Type of fuel used by a vehicle."@en ;
    skos:prefLabel "energy source enum"@en ;
    skos:altLabel "energysourceenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace AfirFacilities / RatesPublication/Enumerations"@en ;
