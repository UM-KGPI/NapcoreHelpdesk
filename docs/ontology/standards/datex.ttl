datex:AfirEnergyInfrastructure.EnergyPrice
    a owl:Class ;
    rdfs:label "EnergyPrice"@en ;
    skos:definition "A price definition for energy refueling. All prices (of a rate) with the same group index belong together (for example base price AND price per kWh). Prices with a different group index are alternative to each other (for example price per minute OR flat r"@en ;
    skos:prefLabel "energy price"@en ;
    skos:altLabel "energyprice"@en ;
    rdfs:comment "DATEX II class in namespace AfirEnergyInfrastructure / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "priceGroupIndex"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "All prices (of a rate) with the same group index belong together (for example base price AND price per kWh). Prices with a different group index are alternative to each other (for example price per minute OR flat rate instead)."@en ] ;
    ea:attribute [ ea:name "priceType"@en ; ea:position 2 ; ea:type datex:AfirEnergyInfrastructure.PriceTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of price for the energy supply."@en ] ;
    ea:attribute [ ea:name "value"@en ; ea:position 3 ; ea:type datex:AfirFacilities.AmountOfMoney ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The price for the energy according to the price type."@en ] ;
    ea:attribute [ ea:name "priceCap"@en ; ea:position 4 ; ea:type datex:AfirFacilities.AmountOfMoney ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An upper cap for this price which will be charged at maximum."@en ] ;
    ea:attribute [ ea:name "taxIncluded"@en ; ea:position 5 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "[TRUE] Indication that tax to be applied is included [FALSE] indicates that the tax is added additionally to the total."@en ] ;
    ea:attribute [ ea:name "taxRate"@en ; ea:position 6 ; ea:type datex:Common.Percentage ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The percentage rate of tax to be applied."@en ] ;
    ea:attribute [ ea:name "additionalInformation"@en ; ea:position 7 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Free text field for additional information regarding the price."@en ] .

