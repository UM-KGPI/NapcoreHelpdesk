    skos:altLabel "measurementsite"@en ;
    rdfs:comment "DATEX II class in namespace RoadTrafficData / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "measurementSiteRecordVersionTime"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The date/time that this version of the measurement site record was defined. The identity and version of the measurement site record are defined by the class stereotype implementation."@en ] ;
    ea:attribute [ ea:name "measurementEquipmentReference"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The reference given to the measurement equipment at the site."@en ] ;
    ea:attribute [ ea:name "measurementEquipmentTypeUsed"@en ; ea:position 3 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The type of equipment used to gather the raw information from which the data values are determined, e.g. 'loop', 'ANPR' (automatic number plate recognition) or 'urban traffic management system' (such as SCOOT)."@en ] ;
    ea:attribute [ ea:name "measurementSiteName"@en ; ea:position 4 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Name of a measurement site."@en ] ;
