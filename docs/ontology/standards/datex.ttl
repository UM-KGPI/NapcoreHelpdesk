    ea:attribute [ ea:name "exclusive"@en ; ea:position 2 ; ea:type datex:Common.Boolean ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Lane or carriageway or road exclusive for mandatory traffic."@en ] ;
