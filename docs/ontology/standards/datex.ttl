    ea:value [ ea:name "followSpecialMarkers"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is to follow the special diversion markers."@en ] ;
    ea:value [ ea:name "useEntry"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is to use the specified entry onto the identified road to commence the alternative route."@en ] ;
    ea:value [ ea:name "useExit"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is to use the specified exit from the identified road to commence the alternative route."@en ] ;
    ea:value [ ea:name "useIntersectionOrJunction"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rerouted traffic is to use the specified intersection or junction to commence the alternative route."@en ] .

datex:Situation.RoadMaintenanceTypeEnum
    a owl:Class ;
    rdfs:label "RoadMaintenanceTypeEnum"@en ;
    skos:definition "Types of road maintenance."@en ;
    skos:prefLabel "road maintenance type enum"@en ;
    skos:altLabel "roadmaintenancetypeenum"@en ;
    rdfs:comment "DATEX II enumeration in namespace Situation / Enumerations"@en ;
    ea:kind "enumeration" ;
    ea:value [ ea:name "accidentRepairWork"@en ; ea:position 1 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "repairing works after an accident, not clearance work but rebuilding of infrastructure"@en ] ;
    ea:value [ ea:name "clearanceWork"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Clearance work of an unspecified nature."@en ] ;
    ea:value [ ea:name "controlledAvalanche"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Controlled avalanche work."@en ] ;
    ea:value [ ea:name "installationWork"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Installation of new equipments or systems on or along-side the roadway."@en ] ;
    ea:value [ ea:name "grassCuttingWork"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Grass cutting work."@en ] ;
    ea:value [ ea:name "litterClearance"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Work to collect litter from the roadway and/or adjacent verges."@en ] ;
    ea:value [ ea:name "maintenanceWork"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Maintenance of road, associated infrastructure or equipments."@en ] ;
    ea:value [ ea:name "maintenancePeopleOnRoad"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "People on road for general maintenance purpose"@en ] ;
    ea:value [ ea:name "overheadWorks"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Works which are overhead of the carriageway."@en ] ;
    ea:value [ ea:name "repairWork"@en ; ea:position 10 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Repair work to road, associated infrastructure or equipments."@en ] ;
    ea:value [ ea:name "resurfacingWork"@en ; ea:position 11 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Work associated with relaying or renewal of worn-out road surface (pavement)."@en ] ;
    ea:value [ ea:name "roadMarkingWork"@en ; ea:position 12 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Striping and repainting of road markings, plus placement or replacement of reflecting studs (cats' eyes)."@en ] ;
    ea:value [ ea:name "roadsideWork"@en ; ea:position 13 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Road side work of an unspecified nature."@en ] ;
    ea:value [ ea:name "roadworksClearance"@en ; ea:position 14 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Roadworks are completed and are being cleared."@en ] ;
    ea:value [ ea:name "roadworks"@en ; ea:position 15 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Road maintenance or improvement activity of an unspecified nature which may potentially cause traffic disruption."@en ] ;
    ea:value [ ea:name "rockFallPreventativeMaintenance"@en ; ea:position 16 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Rock fall preventative maintenance."@en ] ;
    ea:value [ ea:name "saltingInProgress"@en ; ea:position 17 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Spreading of salt and / or grit on the road surface to prevent or melt snow or ice."@en ] ;
    ea:value [ ea:name "snowploughsInUse"@en ; ea:position 18 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Snowploughs or other similar mechanical devices in use to clear snow from the road."@en ] ;
    ea:value [ ea:name "sweepingOfRoad"@en ; ea:position 19 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Sweeping of the roadway."@en ] ;
    ea:value [ ea:name "treeAndVegetationCuttingWork"@en ; ea:position 20 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Tree and vegetation cutting work adjacent to the roadway."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 21 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other than as defined in this enumeration."@en ] .

