datex:Common.GrossWeightCharacteristic
    a owl:Class ;
    rdfs:label "GrossWeightCharacteristic"@en ;
    skos:definition "Gross weight characteristic of a vehicle."@en ;
    skos:prefLabel "gross weight characteristic"@en ;
    skos:altLabel "grossweightcharacteristic"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes/VehicleCharacteristics"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "comparisonOperator"@en ; ea:position 1 ; ea:type datex:Common.ComparisonOperatorEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The operator to be used in the vehicle characteristic comparison operation."@en ] ;
    ea:attribute [ ea:name "grossVehicleWeight"@en ; ea:position 2 ; ea:type datex:Common.Tonnes ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The gross weight of the vehicle and its load, including any trailers."@en ] ;
    ea:attribute [ ea:name "typeOfWeight"@en ; ea:position 3 ; ea:type datex:Common.WeightTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The meaning of the weight value"@en ] .

datex:Common.GroupOfVehiclesInvolved
    a owl:Class ;
    rdfs:label "GroupOfVehiclesInvolved"@en ;
    skos:definition "Group of the vehicles involved having common characteristics and/or status."@en ;
    skos:prefLabel "group of vehicles involved"@en ;
    skos:altLabel "groupofvehiclesinvolved"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "numberOfVehicles"@en ; ea:position 1 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The number of vehicles of this group that are involved."@en ] ;
    ea:attribute [ ea:name "vehicleStatus"@en ; ea:position 2 ; ea:type datex:Common.VehicleStatusEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Vehicle status."@en ] .

datex:Common.GroupOfVehiclesInvolved.VehicleCharacteristics
    a owl:ObjectProperty ;
    rdfs:domain datex:Common.GroupOfVehiclesInvolved ;
    rdfs:range datex:Common.VehicleCharacteristics ;
    ea:lowerBound "0" ;
    ea:upperBound "1" .

datex:Common.HazardousMaterials
    a owl:Class ;
    rdfs:label "HazardousMaterials"@en ;
    skos:definition "Details of hazardous materials."@en ;
    skos:prefLabel "hazardous materials"@en ;
    skos:altLabel "hazardousmaterials"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "chemicalName"@en ; ea:position 1 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The chemical name of the hazardous substance carried by the vehicle."@en ] ;
    ea:attribute [ ea:name "dangerousGoodsFlashPoint"@en ; ea:position 2 ; ea:type datex:Common.TemperatureCelsius ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The temperature at which the vapour from a hazardous substance will ignite in air."@en ] ;
    ea:attribute [ ea:name "dangerousGoodsRegulations"@en ; ea:position 3 ; ea:type datex:Common.DangerousGoodsRegulationsEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The code defining the regulations, international or national, applicable for a means of transport."@en ] ;
    ea:attribute [ ea:name "hazardCodeIdentification"@en ; ea:position 4 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The dangerous goods description code."@en ] ;
    ea:attribute [ ea:name "hazardCodeVersionNumber"@en ; ea:position 5 ; ea:type datex:Common.NonNegativeInteger ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The version/revision number of date of issuance of the hazardous material code used."@en ] ;
    ea:attribute [ ea:name "hazardSubstanceItemPageNumber"@en ; ea:position 6 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A number giving additional hazard code classification of a goods item within the applicable dangerous goods regulation."@en ] ;
    ea:attribute [ ea:name "tremCardNumber"@en ; ea:position 7 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The identification of a transport emergency card giving advice for emergency actions."@en ] ;
    ea:attribute [ ea:name "undgNumber"@en ; ea:position 8 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "A unique serial number assigned within the United Nations to substances and articles contained in a list of the dangerous goods most commonly carried."@en ] ;
    ea:attribute [ ea:name "volumeOfDangerousGoods"@en ; ea:position 9 ; ea:type datex:Common.CubicMetres ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The volume of dangerous goods on the vehicle(s) reported in a traffic/travel situation."@en ] ;
    ea:attribute [ ea:name "weightOfDangerousGoods"@en ; ea:position 10 ; ea:type datex:Common.Tonnes ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The weight of dangerous goods on the vehicle(s) reported in a traffic/travel situation."@en ] .

datex:Common.HeaderInformation
    a owl:Class ;
    rdfs:label "HeaderInformation"@en ;
    skos:definition "Management information relating to the data contained within a publication."@en ;
    skos:prefLabel "header information"@en ;
    skos:altLabel "headerinformation"@en ;
    rdfs:comment "DATEX II class in namespace Common / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "confidentiality"@en ; ea:position 1 ; ea:type datex:Common.ConfidentialityValueEnum ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The extent to which the related information may be circulated, according to the recipient type."@en ] ;
    ea:attribute [ ea:name "allowedDeliveryChannel"@en ; ea:position 2 ; ea:type datex:Common.InformationDeliveryServicesEnum ; ea:lowerBound "0" ; ea:upperBound "*" ; ea:definition "The allowed delivery channel."@en ] ;
    ea:attribute [ ea:name "informationStatus"@en ; ea:position 3 ; ea:type datex:Common.InformationStatusEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The status of the related information (real, test, exercise ....)."@en ] .

datex:Common.HeaviestAxleWeightCharacteristic
    a owl:Class ;
