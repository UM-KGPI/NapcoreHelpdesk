    ea:value [ ea:name "flatTyre"@en ; ea:position 8 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Vehicle has one or more flat tyres"@en ] ;
    ea:value [ ea:name "fuelSystem"@en ; ea:position 9 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Problem with the fuel system of a vehicle"@en ] ;
