datex:LocationReferencing.LinearElementByLineString.GmlLineString
    a owl:ObjectProperty ;
    rdfs:domain datex:LocationReferencing.LinearElementByLineString ;
    rdfs:range datex:LocationReferencing.GmlLineString ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:LocationReferencing.LinearElementByPoints
    a owl:Class ;
