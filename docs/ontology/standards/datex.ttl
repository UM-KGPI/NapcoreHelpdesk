datex:Parking.OperatingPatternStatus
    a owl:Class ;
    rdfs:label "OperatingPatternStatus"@en ;
    skos:definition "The current status for this operating pattern."@en ;
    skos:prefLabel "operating pattern status"@en ;
    skos:altLabel "operatingpatternstatus"@en ;
