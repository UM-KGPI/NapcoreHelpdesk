    ea:value [ ea:name "gaseousHydrogen350barTruck"@en ; ea:position 2 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Gaseous hydrogen with 350 bar pressure for trucks."@en ] ;
    ea:value [ ea:name "gaseousHydrogen700barCar"@en ; ea:position 3 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Gaseous hydrogen with 700 bar pressure for cars."@en ] ;
    ea:value [ ea:name "gaseousHydrogen700barTruck"@en ; ea:position 4 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Gaseous hydrogen with 700 bar pressure for trucks."@en ] ;
    ea:value [ ea:name "liquidHydrogen"@en ; ea:position 5 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Liquid hydrogen"@en ] ;
    ea:value [ ea:name "cryoCompressedHydrogren"@en ; ea:position 6 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Cryo-compressed hydrogen."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 7 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The type of hydrogen is unknown."@en ] .

datex:EnergyInfrastructure.ServiceType
