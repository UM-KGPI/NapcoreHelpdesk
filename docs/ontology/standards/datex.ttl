    ea:value [ ea:name "seasonTicketHolders"@en ; ea:position 22 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Season ticket holders."@en ] ;
    ea:value [ ea:name "shoppers"@en ; ea:position 23 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Shoppers."@en ] ;
    ea:value [ ea:name "shortTermParkers"@en ; ea:position 24 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Short-term parker."@en ] ;
    ea:value [ ea:name "sportEventAwaySupporters"@en ; ea:position 25 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Sport event away supporters."@en ] ;
    ea:value [ ea:name "sportEventHomeSupporters"@en ; ea:position 26 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Sport event home supporters."@en ] ;
    ea:value [ ea:name "students"@en ; ea:position 27 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Students."@en ] ;
    ea:value [ ea:name "staff"@en ; ea:position 28 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Staff."@en ] ;
    ea:value [ ea:name "subscribers"@en ; ea:position 29 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Subscribers."@en ] ;
    ea:value [ ea:name "visitors"@en ; ea:position 30 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Visitors."@en ] ;
    ea:value [ ea:name "visuallyImpaired"@en ; ea:position 31 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "People with vision impairment"@en ] ;
    ea:value [ ea:name "wheelchairUsers"@en ; ea:position 32 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Wheelchair users."@en ] ;
    ea:value [ ea:name "women"@en ; ea:position 33 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Women."@en ] ;
    ea:value [ ea:name "unknown"@en ; ea:position 34 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Unknown."@en ] ;
    ea:value [ ea:name "other"@en ; ea:position 35 ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Other."@en ] .

datex:FaultAndStatus.AllFaultsOfSingleDevice
    a owl:Class ;
    rdfs:label "AllFaultsOfSingleDevice"@en ;
    skos:definition "A collection of all current faults of a service fulfilled by a single device. An empty structure means that there are no faults reported for the device."@en ;
    skos:prefLabel "all faults of single device"@en ;
    skos:altLabel "allfaultsofsingledevice"@en ;
    rdfs:comment "DATEX II class in namespace FaultAndStatus / FaultPublication"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "operatingProperlySince"@en ; ea:position 1 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Time, since when the device is working properly (without fault)."@en ] .

datex:FaultAndStatus.AllFaultsOfSingleDevice.DeviceFault
    a owl:ObjectProperty ;
    rdfs:domain datex:FaultAndStatus.AllFaultsOfSingleDevice ;
    rdfs:range datex:FaultAndStatus.DeviceFault ;
    ea:lowerBound "0" ;
    ea:upperBound "*" .

datex:FaultAndStatus.AllFaultsOfSingleDevice.DeviceReference
    a owl:ObjectProperty ;
    rdfs:domain datex:FaultAndStatus.AllFaultsOfSingleDevice ;
    rdfs:range datex:FaultAndStatus.DeviceReference ;
    ea:lowerBound "1" ;
    ea:upperBound "1" .

datex:FaultAndStatus.CatalogueInformation
    a owl:Class ;
    rdfs:label "CatalogueInformation"@en ;
    skos:definition "A reference to specific additional information by means of a predefined element out of a catalogue. The type of reference information depends on the data structure this class is aggregated to."@en ;
    skos:prefLabel "catalogue information"@en ;
    skos:altLabel "catalogueinformation"@en ;
    rdfs:comment "DATEX II class in namespace FaultAndStatus / Classes"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "catalogueReferenceByOID"@en ; ea:position 1 ; ea:type datex:FaultAndStatus.ObjectIdentifier ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "The reference to a catalogue by its OID according to ISO/IEC 8824-1:2015 using the dot-notation (example: \"1.2.250.1\")."@en ] ;
    ea:attribute [ ea:name "catalogueElement"@en ; ea:position 2 ; ea:type datex:Common.String ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "A reference to a specific element within the specified catalogue. The notation of this reference also depends on the specified catalogue."@en ] .

datex:FaultAndStatus.Component
    a owl:Class ;
    rdfs:label "Component"@en ;
    skos:definition "Components of a device which have some special interest such as having status and faults of their own"@en ;
    skos:prefLabel "component"@en ;
    rdfs:subClassOf datex:FaultAndStatus.Device ;
    rdfs:comment "DATEX II class in namespace FaultAndStatus / DevicePublication"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "componentType"@en ; ea:position 1 ; ea:type datex:FaultAndStatus.DeviceComponentEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Type of device component"@en ] .

datex:FaultAndStatus.Device
    a owl:Class ;
    rdfs:label "Device"@en ;
    skos:definition "Static information about a logical device that delivers a service. A device can announce itself, or the information can be enriched by operators."@en ;
    skos:prefLabel "device"@en ;
    rdfs:comment "DATEX II class in namespace FaultAndStatus / DevicePublication"@en ;
    ea:kind "class" ;
    ea:attribute [ ea:name "ipAddress"@en ; ea:position 1 ; ea:type datex:CommonExtension.IpAddress ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "IP address associated with the device"@en ] ;
    ea:attribute [ ea:name "portNumber"@en ; ea:position 2 ; ea:type datex:CommonExtension.PortNumber ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Primary TCP or UDP port number associated with device"@en ] ;
    ea:attribute [ ea:name "typeOfDevice"@en ; ea:position 3 ; ea:type datex:FaultAndStatus.DeviceTypeEnum ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Information about the type of the device."@en ] ;
    ea:attribute [ ea:name "lastUpdateOfDeviceInformation"@en ; ea:position 4 ; ea:type datex:Common.DateTime ; ea:lowerBound "1" ; ea:upperBound "1" ; ea:definition "Time of the last update of the device information, i.e. the time of the information in this class was last updated."@en ] ;
    ea:attribute [ ea:name "externalDeviceId"@en ; ea:position 5 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "An external id or name for the device."@en ] ;
    ea:attribute [ ea:name "lastDeviceCheck"@en ; ea:position 6 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "The time the device was last checked. Depending on local policies, this can be a physical check or just an online check."@en ] ;
    ea:attribute [ ea:name "softwareVersion"@en ; ea:position 7 ; ea:type datex:Common.String ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Information on the current software version of the device."@en ] ;
    ea:attribute [ ea:name "softwareVersionDate"@en ; ea:position 8 ; ea:type datex:Common.DateTime ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Information on the date of the current software version of the device."@en ] ;
    ea:attribute [ ea:name "additionalDeviceInformation"@en ; ea:position 9 ; ea:type datex:Common.MultilingualString ; ea:lowerBound "0" ; ea:upperBound "1" ; ea:definition "Any additional device information."@en ] .

