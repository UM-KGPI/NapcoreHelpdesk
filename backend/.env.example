# Required per deployment: Django secret used for signing and cryptographic operations.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required per deployment: JWT signing secret.
JWT_SECRET_KEY=change-me-jwt-secret-key-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=
# Customize if the deployment should allow more or fewer source repositories.
ALLOWED_SOURCE_REPOSITORIES=https://github.com/TransmodelEcosystem/NeTEx,https://github.com/TransmodelEcosystem/OpRa
INDEX_SCHEDULE_REPO_URL=
INDEX_SCHEDULE_REPO_PATH=
INDEX_SCHEDULE_PROFILE=netex
# Optional, but required for GitHub-backed generation or indexing workflows.
GITHUB_API_TOKEN=
GITHUB_API_VERIFY_SSL=True
GITHUB_CA_BUNDLE=
LLM_ENABLED=False
LLM_PROVIDER=openai-compatible
# GitHub Models (OpenAI-compatible endpoint)
LLM_API_BASE_URL=https://models.inference.ai.azure.com
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_VERIFY_SSL=True
LLM_CA_BUNDLE=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.2
# Optional request fields (helpdesk/services/llm_options.py). Keep True for vLLM/LiteLLM gateways.
# A gateway that accepts only plain non-streaming chat calls (e.g. a managed model-as-a-service
# profile) answers HTTP 400 to them: set all three to False. If its model always reasons before
# answering, give the reasoning tokens on top of every max_tokens with the allowance.
LLM_JSON_MODE=True
LLM_DISABLE_THINKING=True
LLM_STREAMING=True
LLM_REASONING_TOKEN_ALLOWANCE=0
# Claude via the Anthropic API: set LLM_PROVIDER=anthropic (and CONTROLLER_LLM_PROVIDER=anthropic for
# routing), LLM_MODEL / CONTROLLER_LLM_API_MODEL to a Claude model id (e.g. claude-opus-5-5) and the key
# below. Effort (low|medium|high|xhigh|max) sets how much the model thinks; give the thinking tokens room
# with LLM_REASONING_TOKEN_ALLOWANCE (e.g. 2000) and CONTROLLER_LLM_REASONING_TOKEN_ALLOWANCE (e.g. 1000).
# In docker-compose.dev.yml the two PROVIDER values come from the shell, not this file:
#   LLM_PROVIDER=anthropic CONTROLLER_LLM_PROVIDER=anthropic docker compose -f docker-compose.dev.yml ...
ANTHROPIC_API_KEY=
LLM_ANTHROPIC_EFFORT=low
# The routing, vocabulary-bridge and relevance calls use CONTROLLER_LLM_JSON_MODE,
# CONTROLLER_LLM_DISABLE_THINKING and CONTROLLER_LLM_REASONING_TOKEN_ALLOWANCE; unset, they follow
# the LLM_* values above.
# Retrieval vectors: hash (default) or semantic. Semantic needs the embedding service
# (COMPOSE_PROFILES=semantic) and every chunk re-embedded; see docs/production-deployment.md.
EMBEDDING_BACKEND=hash
EMBEDDING_SERVICE_URL=http://embedder:8090
EMBEDDING_SERVICE_TIMEOUT_SECONDS=120
GRAPH_RAG_ENABLED=False
SEMANTIC_LOW_CONFIDENCE_THRESHOLD=0.60
# Ask the controller LLM whether a question naming no standard or artifact is about the standards.
RELEVANCE_CHECK_ENABLED=False
RELEVANCE_CHECK_TIMEOUT_SECONDS=10
EVIDENCE_GATE_ENABLED=False
EVIDENCE_GATE_MIN_ALIGNMENT=0.30
EVIDENCE_GATE_MIN_CHUNKS=1
EVIDENCE_GATE_MIN_REPOSITORIES_MULTI_SCOPE=2
POLICY_STRICT_CLAIM_GUARD=False
GRAPHDB_ENABLED=False
GRAPHDB_SPARQL_ENDPOINT=
GRAPHDB_REPOSITORY=
GRAPHDB_USER=
GRAPHDB_PASSWORD=
GRAPHDB_TIMEOUT_SECONDS=5
GRAPH_EXPANSION_MAX_CONCEPTS=64
GRAPH_EXPANSION_MAX_CANDIDATE_CHUNKS=40
RETRIEVAL_DIVERSITY_ENABLED=True
RETRIEVAL_MAX_SAME_SOURCE_PATH=2
RETRIEVAL_MMR_LAMBDA=0.92
RETRIEVAL_KEYWORD_TRAP_PENALTY=0.60
# If True, fail fast when ontology YAML schema is invalid (recommended for CI)
NAPCORE_ONTOLOGY_STRICT_VALIDATION=False
POSTGRES_DB=napcore_helpdesk
POSTGRES_USER=napcore
# Required per deployment: database password for the PostgreSQL instance.
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Shared Docker PostgreSQL mode (used by docker-compose.external-postgres.yml):
# POSTGRES_HOST=host.docker.internal
# POSTGRES_PORT=5432
# Keep app-specific names when sharing one PostgreSQL instance across multiple apps:
# POSTGRES_DB=napcore_helpdesk
# POSTGRES_USER=napcore
# POSTGRES_PASSWORD=change-me
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
